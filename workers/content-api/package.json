{
  "name": "content-api-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8788 --var ETERNITY_DEV:true",
    "deploy": "wrangler deploy",
    "ship": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply eternity-content --local",
    "db:migrate:remote": "wrangler d1 migrations apply eternity-content --remote",
    "db:migrate:test": "wrangler d1 migrations apply eternity-content-test --remote --env test",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.6",
    "@cloudflare/workers-types": "^4.20241127.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.58.0"
  }
}
