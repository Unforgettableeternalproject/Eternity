---
/**
 * ThemeToggle Component
 * A button to toggle between light and dark mode with smooth transitions
 */
---

<button
  id="theme-toggle"
  class="relative inline-flex items-center h-6 w-12 rounded-full transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900 bg-slate-300 dark:bg-slate-600"
  title="Toggle theme"
  aria-label="Toggle dark mode"
  role="switch"
>
  <!-- Switch Track Background -->
  <span class="sr-only">Toggle theme</span>

  <!-- Switch Circle with Icon -->
  <span
    class="theme-toggle-circle inline-flex items-center justify-center h-5 w-5 transform transition-transform duration-200 bg-white dark:bg-slate-800 rounded-full shadow-md translate-x-0.5 dark:translate-x-[26px]"
  >
    <!-- Sun icon (shown in light mode) -->
    <svg
      class="w-3 h-3 theme-icon-light text-yellow-500"
      fill="currentColor"
      viewBox="0 0 20 20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
      ></path>
    </svg>

    <!-- Moon icon (shown in dark mode) -->
    <svg
      class="w-3 h-3 theme-icon-dark hidden text-slate-200"
      fill="currentColor"
      viewBox="0 0 20 20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
      ></path>
    </svg>
  </span>
</button>

<script>
  function initThemeToggle() {
    const themeToggle = document.getElementById('theme-toggle');
    if (!themeToggle) return;

    const lightIcon = themeToggle.querySelector('.theme-icon-light');
    const darkIcon = themeToggle.querySelector('.theme-icon-dark');
    const toggleCircle = themeToggle.querySelector('.theme-toggle-circle');

    if (!lightIcon || !darkIcon || !toggleCircle) return;

    // Update icon visibility and switch position based on current theme
    function updateThemeIcon(isDark: boolean) {
      if (isDark) {
        // Dark mode: show moon, hide sun
        lightIcon.classList.add('hidden');
        darkIcon.classList.remove('hidden');
        toggleCircle.classList.remove('translate-x-0.5');
        toggleCircle.classList.add('translate-x-[26px]');
        themeToggle.setAttribute('aria-checked', 'true');
      } else {
        // Light mode: show sun, hide moon
        lightIcon.classList.remove('hidden');
        darkIcon.classList.add('hidden');
        toggleCircle.classList.remove('translate-x-[26px]');
        toggleCircle.classList.add('translate-x-0.5');
        themeToggle.setAttribute('aria-checked', 'false');
      }
    }

    // Initialize icon based on current theme
    const isDark = document.documentElement.classList.contains('dark');
    updateThemeIcon(isDark);

    // Handle toggle click
    themeToggle.addEventListener('click', () => {
      const currentIsDark = document.documentElement.classList.contains('dark');
      const newTheme = currentIsDark ? 'light' : 'dark';

      // Toggle dark class
      document.documentElement.classList.toggle('dark');

      // Update icon and switch position
      updateThemeIcon(!currentIsDark);

      // Save preference
      localStorage.setItem('theme', newTheme);

      // Dispatch custom event for other components to listen to
      window.dispatchEvent(
        new CustomEvent('theme-change', {
          detail: { theme: newTheme },
        })
      );
    });
  }

  // Run on initial load
  initThemeToggle();

  // Re-run after view transitions (if using)
  document.addEventListener('astro:after-swap', initThemeToggle);
</script>
