---
/**
 * Footer Component
 * Site footer with social links and copyright
 */

interface Props {
  currentLocale?: 'zh-tw' | 'en';
  translations?: {
    copyright: string;
  };
  featuredLinks?: Array<{
    title: string;
    url: string;
    icon?: string;
  }>;
}

const {
  currentLocale = 'zh-tw',
  translations = {
    copyright: 'Bernie. All rights reserved.',
  },
  featuredLinks = [],
} = Astro.props;

const currentYear = new Date().getFullYear();

