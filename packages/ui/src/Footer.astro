  };
  return icons[iconName?.toLowerCase() || ''] || icons['link'];
};
---

<footer
  class="relative w-full bg-slate-50 dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 mt-16"
>
  <div
    class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-primary-500/40 to-transparent"
  >
  </div>
  <div
    class="absolute -left-10 -top-10 h-40 w-40 rounded-full bg-primary-500/10 blur-3xl"
  >
  </div>
  <div
    class="absolute right-0 bottom-0 h-48 w-48 rounded-full bg-secondary-500/10 blur-3xl"
  >
  </div>

  <div class="container-custom py-12 relative z-10">
    <div
      class="flex flex-col items-center justify-center space-y-6 sm:flex-row sm:justify-between sm:space-y-0"
    >
      <!-- Brand -->
      <a
        href="/"
        class="flex items-center space-x-2 text-slate-900 dark:text-white font-semibold group"
      >
        <span
          class="text-2xl leading-none group-hover:-rotate-12 group-hover:scale-110 transition-transform duration-300 ease-in-out"
          >*</span
        >
        <span>Bernie</span>
      </a>

      <!-- Copyright -->
      <p
        class="text-sm text-slate-600 dark:text-slate-400 text-center sm:text-left"
      >
        © {currentYear}
        {translations.copyright}
      </p>

      <!-- Featured Links (replacing social links) -->
      <div class="flex items-center space-x-6">
        {
          featuredLinks.length > 0 ? (
            featuredLinks.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200"
                aria-label={link.title}
              >
                <svg
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  set:html={getIconSvg(link.icon)}
                />
              </a>
            ))
          ) : (
            <>
              <a
                href="https://github.com/Unforgettableeternalproject"
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200"
                aria-label="GitHub"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path
                    fill-rule="evenodd"
                    d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                    clip-rule="evenodd"
                  />
                </svg>
              </a>
              <a
                href="https://x.com/Lightingbird11"
                target="_blank"
                rel="noopener noreferrer"
                class="text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200"
                aria-label="Twitter"
              >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              </a>
              <a
                href="mailto:ptyc4076@gmail.com"
                class="text-slate-500 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-200"
                aria-label="Email"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    strokeWidth="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  />
                </svg>
              </a>
            </>
          )
        }
      </div>
    </div>
  </div>
</footer>
