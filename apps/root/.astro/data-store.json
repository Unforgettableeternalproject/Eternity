[["Map",1,2,9,10,21,22,31,32,59,60,78,79,96,97,151,152,158,159,165,166,171,172,186,187,193,194,203,204],"meta::meta",["Map",3,4,5,6,7,8],"astro-version","5.16.6","content-config-digest","0e5b56dc9518aa62","astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"site\":\"https://unforgettableeternalproject.com\",\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"attribute\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"index.js\",\"redirects\":false,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":\"0.0.0.0\",\"port\":4320,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":{\"type\":\"shiki\",\"excludeLangs\":[\"math\"]},\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark\",\"themes\":{},\"wrap\":false,\"transformers\":[]},\"remarkPlugins\":[],\"rehypePlugins\":[],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"i18n\":{\"defaultLocale\":\"zh-tw\",\"locales\":[\"zh-tw\",\"en\"],\"routing\":{\"prefixDefaultLocale\":false,\"redirectToDefaultLocale\":true,\"fallbackType\":\"redirect\"}},\"security\":{\"checkOrigin\":true,\"allowedDomains\":[]},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false,\"failOnPrerenderConflict\":false,\"svgo\":false},\"legacy\":{\"collections\":false},\"session\":{\"driver\":\"cloudflare-kv-binding\",\"options\":{\"binding\":\"SESSION\"}}}","homepage-zh",["Map",11,12],"index",{"id":11,"data":13,"filePath":19,"digest":20},{"title":14,"name":15,"subtitle":16,"introHeading":17,"introContent":18},"歡迎來到","Eternity","這是我們故事的開端，你可以稱呼我為 Bernie","創作者、開發者、勇者","歡迎來到我的個人主頁，在這裡我會放各式創作、專案集，以及通往我各個正在經營的平台的連結。\n\n如你所見，這是我所搭建的只屬於我的空間，之所以為何稱作Eternity，也許聽上去有些稚氣，不過對我而言，這個名詞有著特別的意義，象徵著我的故事、我的努力，我的U.E.P。\n\n就單純只是這樣，如果想要跟我聯繫，或者提供我一些改進建議，你可以在這裡找到聯繫我的方法。","src/content/homepage-zh/index.json","9170c541cd8827c3","homepage-en",["Map",11,23],{"id":11,"data":24,"filePath":29,"digest":30},{"title":25,"name":15,"subtitle":26,"introHeading":27,"introContent":28},"Welcome to","This is the beginning of our story, and you may call me Bernie","Creator, Developer, and to bear it all","Welcome to my personal homepage. Here I'll showcase my various creations, project portfolios, and links to the platforms I'm currently using. As you can see, this is a space I've created that's uniquely my own. The reason I call it \"Eternity\" might sound a bit childish, but for me, this term holds special meaning—it symbolizes my story, my efforts, and my U.E.P. That's all. If you'd like to contact me or offer suggestions for improvement, you can find ways to reach me here.","src/content/homepage-en/index.json","163367a58af6f020","about-zh",["Map",11,33],{"id":11,"data":34,"filePath":57,"digest":58},{"title":35,"bio":36,"fullBio":37,"avatar":38,"skills":39,"experience":43,"certifications":48,"social":54},"我的個人簡介","對我而言，有一個尚未完成的故事存在著","\u003Cp>\n  我的本名是\n  \u003Cspan style=\"\n    font-weight:600;\n    background:linear-gradient(90deg,#6ee7ff,#c77dff);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n  \">\n    顏榕嶙\n  \u003C/span>，台灣人。\n\u003C/p>\n\n\u003Cp>\n  我並不想要被任何事物給拘束，而希望追求一個\n  \u003Cspan style=\"color:#7dd3fc; text-shadow:0 0 6px rgba(125,211,252,0.4);\">\n    自由自在的環境\n  \u003C/span>。\n\u003C/p>\n\n\u003Cp>\n  當然，聽起來還是天方夜譚，不過這也是我之所以繼續努力著的原因。\n\u003C/p>\n\n\u003Cp>\n  有一個故事存活在我的心中，而對我而言，想辦法把這個故事給實現\n  \u003Cspan style=\"font-style:italic; opacity:0.8;\">\n    (無論使用甚麼辦法)\n  \u003C/span>\n  就是我一直在追求的\n  \u003Cspan style=\"\n    font-weight:700;\n    background:linear-gradient(\n      90deg,\n      #d5b618,\n      #f5e27a,\n      #d5b618\n    );\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    text-shadow:0 0 12px rgba(213,182,24,0.35);\n  \">\n    最終目標\n  \u003C/span>。\n\u003C/p>\n\n\u003Cp>\n  因此，祝我好運吧。\n\u003C/p>\n","/images/avatars/avatar.png",[40,41,42],"開發","設計","寫作",[44],{"title":45,"company":45,"period":46,"description":47},"測試工作","測試時間","攝氏五十度",[49],{"name":50,"issuer":51,"date":52,"link":53},"測試證照","測試單位","測試日期","測試連結",{"github":55,"email":56},"https://github.com/Unforgettableeternalproject","ptyc4076@gmail.com","src/content/about-zh/index.json","24a5d8e90490e9ff","about-en",["Map",11,61],{"id":11,"data":62,"filePath":76,"digest":77},{"title":63,"bio":64,"fullBio":65,"avatar":38,"skills":66,"experience":70,"certifications":73,"social":75},"My Autobio","To me, there's an unfinished story waiting for me to complete.","\u003Cp>\n  My name is\n  \u003Cspan style=\"\n    font-weight:600;\n    background:linear-gradient(90deg,#6ee7ff,#c77dff);\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n  \">\n    Bernie Yen\n  \u003C/span>, from Taiwan.\n\u003C/p>\n\n\u003Cp>\n  I do not wish to be bound by anything, but instead seek\n  \u003Cspan style=\"color:#7dd3fc; text-shadow:0 0 6px rgba(125,211,252,0.4);\">\n    a truly free environment\n  \u003C/span>.\n\u003C/p>\n\n\u003Cp>\n  Of course, it may sound like a fantasy,\u003Cbr>\n  but that is exactly why I continue to move forward.\n\u003C/p>\n\n\u003Cp>\n  There is a story living within my heart, and to me,\n  finding a way to bring this story into reality\n  \u003Cspan style=\"font-style:italic; opacity:0.8;\">\n    (no matter the means)\n  \u003C/span>\n  is the\n  \u003Cspan style=\"\n    font-weight:700;\n    background:linear-gradient(\n      90deg,\n      #d5b618,\n      #f5e27a,\n      #d5b618\n    );\n    -webkit-background-clip:text;\n    -webkit-text-fill-color:transparent;\n    text-shadow:0 0 12px rgba(213,182,24,0.35);\n  \">\n    final goal\n  \u003C/span>\n  I have always been pursuing.\n\u003C/p>\n\n\u003Cp>\n  So, wish me good luck.\n\u003C/p>\n",[67,68,69],"Development","Design","Writing",[71],{"title":72,"company":72,"period":72,"description":72},"AAA",[74],{"name":72,"issuer":72,"date":72,"link":72},{"github":55,"email":56},"src/content/about-en/index.json","652d4e901e16a642","card-music",["Map",11,80],{"id":11,"data":81,"filePath":94,"digest":95},{"enabled":82,"order":83,"position":84,"tracks":85},true,1,"left",[86,91],{"title":87,"artist":88,"url":89,"cover":90},"Utopia","Bernie","/music/Utopia.mp3","/images/music/tracks/0/cover.png",{"title":92,"artist":88,"url":93},"Stroll","/music/Stroll.mp3","src/content/card-music/index.json","1c73fcec22032cd1","card-quote",["Map",11,98],{"id":11,"data":99,"filePath":149,"digest":150},{"enabled":82,"order":100,"position":84,"quotes_zh":101,"quotes_en":126},3,[102,105,108,111,114,117,120,123],{"text":103,"author":104},"在這個世界上，我們於苦難中纏結","伊馮那·塞赫",{"text":106,"author":107},"你和我是一樣的，艾斯維爾，我們是一張白紙的兩面。","莫夫·奇萊",{"text":109,"author":110},"你必須要理解你所追求的真實。","???",{"text":112,"author":113},"我會在永恆的另一側等待著你。","艾爾菲羅斯·赫利烏斯",{"text":115,"author":116},"你也許選擇了一條不曾有他人走訪的道路，但千萬得謹記那屬於你的責任不可輕易拋於身後。\n","佩斯特·尼傑",{"text":118,"author":119},"一個分裂的世界，四分五裂得沒人有機會拼湊得起，仍去嘗試的話有甚麼意義呢?","賽蒙·羅傑斯",{"text":121,"author":122},"你好啊，我是U.E.P，你叫我小U就可以了!","U.E.P",{"text":124,"author":125},"夢幻；虛幻；玄幻；奇幻；眩亂；虛實交界的世界，你又如何定義是與非呢?","萊斯特·杜恩",[127,130,133,135,138,141,144,146],{"text":128,"author":129},"Together, in this world. We are entangled in misery.","Yvonne Sehor",{"text":131,"author":132},"You are the same as me, Xavier. We are but the two sides of a paper.","Molf Carrie",{"text":134,"author":110},"You must realize the reality you're pursuing. ",{"text":136,"author":137},"I will be waiting for you at the other end of eternity.","Alphrous Harius",{"text":139,"author":140},"You might have chosen a path where no before man had, but you must not leave your responsibility in oblivion.","Paster Nigel",{"text":142,"author":143},"A shattered world, so fracture that nobody is capable to repair. Why matter doing so?","Simon Rogers",{"text":145,"author":122},"Hello! My name is U.E.P, and you can call me U.",{"text":147,"author":148},"A dreamlike world, riddled with illusion—where fantasy dazzles and truth loses its shape. In such a place…by whose will is right separated from wrong?","Lester Dunn","src/content/card-quote/index.json","9fabfb63d7c9502a","card-visitor-counter",["Map",11,153],{"id":11,"data":154,"filePath":156,"digest":157},{"enabled":82,"order":155,"position":84},2,"src/content/card-visitor-counter/index.json","4d0fe92526256d10","card-quick-stats",["Map",11,160],{"id":11,"data":161,"filePath":163,"digest":164},{"enabled":82,"order":83,"position":162},"right","src/content/card-quick-stats/index.json","66a04287d1fd3fff","card-table-of-contents",["Map",11,167],{"id":11,"data":168,"filePath":169,"digest":170},{"enabled":82,"order":155,"position":162},"src/content/card-table-of-contents/index.json","63ad02f4884415e4","projects",["Map",173,174],"測試",{"id":173,"data":175,"filePath":184,"digest":185},{"description_zh":173,"title_en":176,"description_en":177,"tags":178,"featured":82,"order":180,"status":181,"image":182,"links":183},"Test","test",[179],"tset",0,"active","/images/projects/測試/image.png",{},"src/content/projects/測試.yaml","18e7ef47091e77e5","card-latest-update",["Map",11,188],{"id":11,"data":189,"filePath":191,"digest":192},{"enabled":82,"order":190,"position":84},4,"src/content/card-latest-update/index.json","47a5e699324aa7f9","updates",["Map",195,196],"測試動態",{"id":195,"data":197,"filePath":201,"digest":202},{"description_zh":195,"title_en":198,"description_en":198,"date":199,"category":200,"featured":82},"Test Update",["Date","2026-01-20T00:00:00.000Z"],"website","s