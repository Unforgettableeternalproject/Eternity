{
  "$ref": "#/definitions/card-music",
  "definitions": {
    "card-music": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "order": {
          "type": "number",
          "default": 1
        },
        "position": {
          "type": "string",
          "enum": ["left", "right"],
          "default": "left"
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "artist": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "cover": {
                "type": "string"
              }
            },
            "required": ["title", "artist"],
            "additionalProperties": false
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
