---
/**
 * PrismLayout — Prism design system layout
 * Clean replacement for BaseLayout: no gradient bg, no cursor glow, no sidebars
 * Just TopBar + Content + Footer with Prism tokens
 */
import '../styles/prism-tokens.css';
import { ViewTransitions } from 'astro:transitions';
import PTopBar from '../components/prism/PTopBar';
import PFooter from '../components/prism/PFooter';
import { getCurrentLocale } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = "Eternity - Bernie's Personal Website",
  ogImage = '/og-image.png',
  ogType = 'website',
} = Astro.props;

const locale = getCurrentLocale(Astro.url);
const currentPath = Astro.url.pathname;

// Canonical + alternate URLs
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const alternateLocale = locale === 'zh-tw' ? 'en' : 'zh-tw';
const alternatePath = Astro.url.pathname.startsWith('/en')
  ? Astro.url.pathname.replace('/en', '') || '/'
  : `/en${Astro.url.pathname}`;
const alternateURL = new URL(alternatePath, Astro.site);
---

<!doctype html>
<html lang={locale === 'zh-tw' ? 'zh-TW' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <ViewTransitions />

    <!-- Canonical + Alternate -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang={alternateLocale} href={alternateURL} />
    <link rel="alternate" hreflang={locale} href={canonicalURL} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL('/', Astro.site)}
    />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content="Bernie's Eternity" />
    <meta
      property="og:locale"
      content={locale === 'zh-tw' ? 'zh_TW' : 'en_US'}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/Logo.ico" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <!-- Theme: prevent FOUC -->
    <script is:inline>
      const getTheme = () => {
        if (
          typeof localStorage !== 'undefined' &&
          localStorage.getItem('theme')
        ) {
          return localStorage.getItem('theme');
        }
        return 'dark';
      };
      document.documentElement.classList[
        getTheme() === 'dark' ? 'add' : 'remove'
      ]('dark');
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList[
          getTheme() === 'dark' ? 'add' : 'remove'
        ]('dark');
      });
    </script>
  </head>

  <body class="prism-layout" style={{ margin: 0, minHeight: '100vh' }}>
    <PTopBar client:load currentPath={currentPath} locale={locale} />

    <main style={{ maxWidth: 960, margin: '0 auto', padding: '0 32px' }}>
      <slot />
    </main>

    <PFooter client:load locale={locale} />
  </body>
</html>
