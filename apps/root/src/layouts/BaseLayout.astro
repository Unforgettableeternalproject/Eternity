---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import NavigationWithSearch from '../components/NavigationWithSearch.astro';
import QuartzFooter from '../components/QuartzFooter.astro';
import ConsoleEasterEgg from '../components/ConsoleEasterEgg';
import UEPCharacter from '../components/UEPCharacter';
import ScrollToTop from '../components/ScrollToTop';
import ToastContainer from '../components/Toast';
import GlobalRipple from '../components/GlobalRipple';
import CookieConsent from '../components/CookieConsent';
import ImageViewerModal from '../components/ImageViewerModal';
import WidgetDataProvider from '../components/WidgetDataProvider.astro';
import QuartzWidgetSystem from '../components/QuartzWidgetSystem';
import StickyTOC from '../components/StickyTOC';
import '../components/QuartzWidgetSystem.css';
import '../components/StickyTOC.css';
import { getCurrentLocale } from '../i18n/utils';
// getCollection removed — footer no longer needs it here

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = "Eternity - Bernie's Personal Website",
  ogImage = '/og-image.png',
  ogType = 'website',
} = Astro.props;

const locale = getCurrentLocale(Astro.url);

// Footer 連結現在由 QuartzFooter 自行管理

// Get canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Get alternate language URL
const alternateLocale = locale === 'zh-tw' ? 'en' : 'zh-tw';
const alternatePath = Astro.url.pathname.startsWith('/en')
  ? Astro.url.pathname.replace('/en', '')
  : `/en${Astro.url.pathname}`;
const alternateURL = new URL(alternatePath, Astro.site);
---

<!doctype html>
<html lang={locale} class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <ViewTransitions />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Alternate Language -->
    <link rel="alternate" hreflang={alternateLocale} href={alternateURL} />
    <link rel="alternate" hreflang={locale} href={canonicalURL} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL('/', Astro.site)}
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content="Bernie's Eternity" />
    <meta
      property="og:locale"
      content={locale === 'zh-tw' ? 'zh_TW' : 'en_US'}
    />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Google Fonts（非阻塞載入，取代 global.css 的 @import） -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Noto+Serif+TC:wght@400;500;700&family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/Logo.ico" />

    <!-- Page Title -->
    <title>{title}</title>

    <!-- 防止深色模式閃爍 (FOUC) -->
    <script is:inline>
      // 在頁面載入前立即執行
      const getThemePreference = () => {
        if (
          typeof localStorage !== 'undefined' &&
          localStorage.getItem('theme')
        ) {
          return localStorage.getItem('theme');
        }
        // 預設使用深色模式
        return 'dark';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

      // View Transitions 時也要應用主題
      document.addEventListener('astro:after-swap', () => {
        const isDark = getThemePreference() === 'dark';
        document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
      });
    </script>

    <!-- 音樂狀態清理（延遲到閒置時，before-swap 監聽器除外） -->
    <script is:inline>
      // before-swap 監聽器必須立即註冊（清理重複音頻元素）
      document.addEventListener('astro:before-swap', function () {
        var audios = document.querySelectorAll('audio#global-music-player');
        if (audios.length > 1) {
          for (var i = 1; i < audios.length; i++) {
            audios[i].pause();
            audios[i].remove();
          }
        }
      });
      // localStorage 清理延遲到閒置時
      (typeof requestIdleCallback === 'function'
        ? requestIdleCallback
        : setTimeout)(function () {
        if (typeof localStorage !== 'undefined') {
          localStorage.removeItem('music-is-playing');
          localStorage.removeItem('music-volume');
          localStorage.removeItem('music-state');
        }
      });
    </script>
  </head>
  <body class="min-h-screen relative">
    <!-- Interactive gradient background -->
    <div class="gradient-bg">
      <!-- Hexagonal Dot Pattern -->
      <div class="absolute inset-0 dot-pattern opacity-40"></div>

      <!-- Radial Gradient Overlay -->
      <div
        class="absolute inset-0 bg-gradient-radial from-transparent via-white/60 to-white dark:from-transparent dark:via-slate-900/60 dark:to-slate-900"
      >
      </div>

      <!-- Large Blur Effect for Depth -->
      <div
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[600px] w-[600px] rounded-full bg-primary-500/30 dark:bg-primary-500/20 blur-[120px]"
      >
      </div>

      <!-- Secondary blur for accent -->
      <div
        class="absolute right-0 top-0 h-[400px] w-[400px] rounded-full bg-secondary-500/20 dark:bg-secondary-500/10 blur-[100px]"
      >
      </div>

      <!-- Animated gradient orbs -->
      <div class="gradient-orb gradient-orb-1"></div>
      <div class="gradient-orb gradient-orb-2"></div>
      <div class="gradient-orb gradient-orb-3"></div>
    </div>

    <!-- Mouse cursor glow effect -->
    <div id="cursor-glow" class="cursor-glow" style="opacity: 0;"></div>

    <!-- Global click ripple effect（persist 跨頁存活，不重新 mount） -->
    <GlobalRipple
      client:only="react"
      transition:persist
      color="rgba(99, 102, 241, 0.15)"
      navColor="rgba(236, 72, 153, 0.2)"
      duration={800}
      size={80}
    />

    <!-- Fixed Navigation — Quartz solid bg -->
    <header
      class="fixed top-0 left-0 right-0 z-50"
      style="background: var(--q-paper); border-bottom: 1px solid var(--q-line);"
    >
      <NavigationWithSearch currentPath={Astro.url.pathname} />
    </header>

    <!-- Spacer for fixed header -->
    <div class="h-[72px]"></div>

    <!-- Widget 資料注入（SSR → window.__widgetData） -->
    <WidgetDataProvider />

    <!-- Quartz Widget System（persist 跨頁存活，不重新 mount） -->
    <QuartzWidgetSystem client:only="react" transition:persist />

    <!-- Sticky TOC（右側 margin，僅大螢幕+有標題時顯示，可見才載入） -->
    <StickyTOC client:visible />

    <!-- 手機版不顯示 widget，桌面版由 QuartzWidgetSystem 處理 -->

    <!-- Main Content Area -->
    <main class="transition-all duration-300">
      <slot />
    </main>

    <!-- Quartz Footer -->
    <QuartzFooter currentLocale={locale} />

    <!-- Console Easter Egg — persist 跨頁存活 -->
    <ConsoleEasterEgg
      client:idle
      transition:persist
      consoleUrl={locale === 'zh-tw' ? '/zh-tw/console' : '/en/console'}
      label={locale === 'zh-tw' ? '終端機' : 'Console'}
      debugMode={false}
    />

    <!-- U.E.P 角色互動系統 — persist 跨頁存活 -->
    <UEPCharacter
      client:idle
      transition:persist
      uepDocsUrl="https://uep.unforgettableeternalproject.com"
      debugMode={false}
    />

    <!-- 返回頂部按鈕（persist 跨頁存活，idle 延遲載入） -->
    <ScrollToTop
      client:idle
      transition:persist
      position="right"
      showAfter={300}
    />

    <!-- Toast 通知系統（persist 跨頁存活，idle 延遲載入） -->
    <ToastContainer client:idle transition:persist position="top-right" />

    <!-- 圖片查看器模態窗（persist 跨頁存活，idle 延遲載入） -->
    <ImageViewerModal client:idle transition:persist />

    <!-- Cookie 同意彈窗（persist 跨頁存活，idle 延遲載入） -->
    <CookieConsent client:idle transition:persist />

    <!-- q-prose 圖片點擊 → ImageViewerModal -->
    <script is:inline>
      function initProseImageClick() {
        document.querySelectorAll('.q-prose img').forEach(function (img) {
          if (img.dataset.zoomBound) return;
          img.dataset.zoomBound = '1';
          img.style.cursor = 'zoom-in';
          img.addEventListener('click', function () {
            window.dispatchEvent(
              new CustomEvent('openImageModal', {
                detail: { src: img.src, alt: img.alt || '' },
              })
            );
          });
        });
      }
      // 初始載入 + View Transitions 後重新綁定
      document.addEventListener('DOMContentLoaded', initProseImageClick);
      document.addEventListener('astro:page-load', initProseImageClick);
    </script>

    <!-- Mouse tracking script（延遲到閒置時初始化，避免阻塞主線程） -->
    <script is:inline>
      (typeof requestIdleCallback === 'function'
        ? requestIdleCallback
        : setTimeout)(function () {
        const cursorGlow = document.getElementById('cursor-glow');

        // 嘗試從 sessionStorage 讀取上次的滑鼠位置
        let mouseX =
          parseFloat(sessionStorage.getItem('mouseX')) || window.innerWidth / 2;
        let mouseY =
          parseFloat(sessionStorage.getItem('mouseY')) ||
          window.innerHeight / 2;
        let currentX = mouseX;
        let currentY = mouseY;

        // 初始化滑鼠位置
        if (cursorGlow) {
          cursorGlow.style.left = currentX + 'px';
          cursorGlow.style.top = currentY + 'px';
          cursorGlow.style.opacity = '0';
        }

        // Smooth mouse tracking
        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;

          // 儲存當前位置
          sessionStorage.setItem('mouseX', mouseX.toString());
          sessionStorage.setItem('mouseY', mouseY.toString());
        });

        // Animate cursor glow with smooth easing
        function animate() {
          const dx = mouseX - currentX;
          const dy = mouseY - currentY;

          currentX += dx * 0.1;
          currentY += dy * 0.1;

          if (cursorGlow) {
            cursorGlow.style.left = currentX + 'px';
            cursorGlow.style.top = currentY + 'px';
          }

          requestAnimationFrame(animate);
        }

        // Show cursor glow on mouse enter
        document.addEventListener('mouseenter', () => {
          if (cursorGlow) cursorGlow.style.opacity = '1';
        });

        // Hide cursor glow on mouse leave
        document.addEventListener('mouseleave', () => {
          if (cursorGlow) cursorGlow.style.opacity = '0';
        });

        animate();
      });
    </script>
  </body>
</html>
