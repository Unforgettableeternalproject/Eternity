---
import '../styles/global.css';
import NavigationWithSearch from '../components/NavigationWithSearch.astro';
import Footer from '@uep/ui/Footer';
import AdminEntry from '../components/AdminEntry.astro';
import ConsoleEasterEgg from '../components/ConsoleEasterEgg';
import ScrollToTop from '../components/ScrollToTop';
import ToastContainer from '../components/Toast';
import { getCurrentLocale, getTranslations } from '../i18n/utils';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const { 
  title, 
  description = "Eternity - Bernie's Personal Website",
  ogImage = '/og-image.png',
  ogType = 'website'
} = Astro.props;

const locale = getCurrentLocale(Astro.url);
const t = getTranslations(locale);

// 載入精選連結給 Footer
const allLinks = await getCollection('links');
const featuredLinks = allLinks
  .filter(l => l.data.featured)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
  .map(link => ({
    title: locale === 'zh-tw' ? link.id : link.data.title_en,
    url: link.data.url,
    icon: link.data.icon,
  }));

// Get canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Get alternate language URL
const alternateLocale = locale === 'zh-tw' ? 'en' : 'zh-tw';
const alternatePath = Astro.url.pathname.startsWith('/en') 
  ? Astro.url.pathname.replace('/en', '')
  : `/en${Astro.url.pathname}`;
const alternateURL = new URL(alternatePath, Astro.site);
---

<!doctype html>
<html lang={locale} class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Alternate Language -->
    <link rel="alternate" hreflang={alternateLocale} href={alternateURL} />
    <link rel="alternate" hreflang={locale} href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content="Bernie's Eternity" />
    <meta property="og:locale" content={locale === 'zh-tw' ? 'zh_TW' : 'en_US'} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/Logo.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    
    <!-- Page Title -->
    <title>{title}</title>
    
    <!-- 防止深色模式閃爍 (FOUC) -->
    <script is:inline>
      // 在頁面載入前立即執行
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList[isDark ? 'add' : 'remove']('dark');
    </script>
  </head>
  <body class="min-h-screen bg-white dark:bg-slate-900 relative">
    <!-- Interactive gradient background -->
    <div class="gradient-bg">
      <div class="gradient-orb gradient-orb-1"></div>
      <div class="gradient-orb gradient-orb-2"></div>
      <div class="gradient-orb gradient-orb-3"></div>
    </div>
    
    <!-- Mouse cursor glow effect -->
    <div id="cursor-glow" class="cursor-glow" style="opacity: 0;"></div>
    
    <!-- Sticky Navigation -->
    <header class="sticky top-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800">
      <NavigationWithSearch currentPath={Astro.url.pathname} />
    </header>
    
    <!-- Main Content Area -->
    <main>
      <slot />
    </main>
    
    <!-- Footer -->
    <Footer 
      currentLocale={locale}
      translations={t.footer}
      featuredLinks={featuredLinks}
    />
    
    <!-- 隱藏的管理員入口 -->
    <AdminEntry />
    
    <!-- Console Easter Egg (React Island) -->
    <ConsoleEasterEgg 
      client:idle
      consoleUrl={locale === 'zh-tw' ? '/zh-tw/console' : '/en/console'}
      label={locale === 'zh-tw' ? '終端機' : 'Console'}
      debugMode={false}
    />
    
    <!-- 返回頂部按鈕 (React Island) -->
    <ScrollToTop client:load position="right" showAfter={300} />
    
    <!-- Toast 通知系統 (React Island) -->
    <ToastContainer client:only="react" position="top-right" />
    
    <!-- Mouse tracking script -->
    <script is:inline>
      (function() {
        const cursorGlow = document.getElementById('cursor-glow');
        let mouseX = 0;
        let mouseY = 0;
        let currentX = 0;
        let currentY = 0;
        
        // Smooth mouse tracking
        document.addEventListener('mousemove', (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        });
        
        // Animate cursor glow with smooth easing
        function animate() {
          const dx = mouseX - currentX;
          const dy = mouseY - currentY;
          
          currentX += dx * 0.1;
          currentY += dy * 0.1;
          
          if (cursorGlow) {
            cursorGlow.style.left = currentX + 'px';
            cursorGlow.style.top = currentY + 'px';
          }
          
          requestAnimationFrame(animate);
        }
        
        // Show cursor glow on mouse enter
        document.addEventListener('mouseenter', () => {
          if (cursorGlow) cursorGlow.style.opacity = '1';
        });
        
        // Hide cursor glow on mouse leave
        document.addEventListener('mouseleave', () => {
          if (cursorGlow) cursorGlow.style.opacity = '0';
        });
        
        animate();
      })();
    </script>
  </body>
</html>
