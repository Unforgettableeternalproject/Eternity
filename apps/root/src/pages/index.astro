                          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                        />
                      </svg>
                      <span>
                        {locale === 'zh-tw'
                          ? '\u9ede\u64ca\u7ffb\u8f49'
                          : 'Click to flip'}
                      </span>
                    </div>
                  </div>

                  <div slot="back" class="h-full flex flex-col p-5">
                    <div 
                      class="flex-1 min-h-0 overflow-y-auto scrollbar-hide"
                      data-auto-scroll-content
                    >
                      <div class="text-sm leading-relaxed text-white/90 prose prose-sm prose-invert max-w-none [&_h1]:text-lg [&_h1]:font-bold [&_h2]:text-base [&_h2]:font-semibold [&_h3]:text-sm [&_h3]:font-medium [&_h4]:text-sm [&_h5]:text-xs [&_h6]:text-xs [&_p]:text-sm [&_li]:text-sm">
                        {(() => {
                          console.log('=== Rendering update:', update.id);
                          const contentModule = updateContentMap.get(update.id);
                          console.log('Content module found:', !!contentModule);
                          console.log('Has Content component:', !!contentModule?.Content);
                          
                          if (contentModule && contentModule.Content) {
                            const { Content } = contentModule;
                            console.log('Rendering Content component for:', update.id);
                            return <Content />;
                          }
                          
                          // Fallback 到 description
                          console.log('Fallback to description for:', update.id);
                          return (
                            <p class="text-white/80">
                              {locale === 'zh-tw'
                                ? update.data.description_zh
                                : update.data.description_en}
