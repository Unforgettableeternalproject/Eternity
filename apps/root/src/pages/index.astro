        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* 隱藏滾動條但保持可滾動功能 */
  .scrollbar-hide {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
  
  .scrollbar-hide::-webkit-scrollbar {
    display: none;  /* Chrome, Safari and Opera */
  }

  .dot-pattern {
    background-image:
      radial-gradient(circle, rgb(148 163 184 / 0.3) 1px, transparent 1px),
      radial-gradient(circle, rgb(148 163 184 / 0.3) 1px, transparent 1px);
    background-size: 24px 41.57px;
    background-position:
      0 0,
      12px 20.78px;
  }

  :global(.dark) .dot-pattern {
    background-image:
      radial-gradient(circle, rgb(255 255 255 / 0.15) 1px, transparent 1px),
      radial-gradient(circle, rgb(255 255 255 / 0.15) 1px, transparent 1px);
  }

  @keyframes gradient {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .animate-gradient {
    background-size: 200% auto;
    animation: gradient 3s ease infinite;
  }
</style>

<script>
  // Lightweight intersection reveal for sections/cards; respects reduced motion via CSS
  function initRevealAnimation() {
    const prefersReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    if (prefersReduced) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const el = entry.target;
          if (entry.isIntersecting) {
            el.classList.add('reveal-visible');
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
    );

    document.querySelectorAll('.reveal-item').forEach((el) => {
      observer.observe(el);
    });
  }

  // 初始載入和頁面切換時都要執行
  document.addEventListener('DOMContentLoaded', initRevealAnimation);
  document.addEventListener('astro:page-load', initRevealAnimation);

  // 自動滾動功能
  function initAutoScroll() {
    const cards = document.querySelectorAll('[data-flip-card]');
    
    cards.forEach((card) => {
      const scrollContainer = card.querySelector('[data-auto-scroll-content]');
      if (!scrollContainer) return;

      let scrollInterval: number | null = null;
      let isScrolling = false;

      // 監聽卡片翻轉事件
      card.addEventListener('cardFlipped', () => {
        // 重置到頂部
        scrollContainer.scrollTop = 0;
        
        // 清除之前的滾動
        if (scrollInterval) {
          clearInterval(scrollInterval);
          scrollInterval = null;
        }

        // 等待卡片翻轉動畫完成後開始滾動
        setTimeout(() => {
          const maxScroll = scrollContainer.scrollHeight - scrollContainer.clientHeight;
          
          // 如果內容不需要滾動，就不要開始
          if (maxScroll <= 0) return;

          isScrolling = true;
          const scrollSpeed = 30; // 每秒滾動像素數
          const scrollStep = scrollSpeed / 60; // 每幀滾動的距離（60fps）

          scrollInterval = window.setInterval(() => {
            if (!isScrolling) return;

            scrollContainer.scrollTop += scrollStep;

            // 滾動到底部時停止
            if (scrollContainer.scrollTop >= maxScroll) {
              if (scrollInterval) {
                clearInterval(scrollInterval);
                scrollInterval = null;
              }
              isScrolling = false;
            }
          }, 1000 / 60) as unknown as number; // 60fps
        }, 600); // 等待翻轉動畫（0.6s）
      });

      // 滑鼠懸停或觸摸時暫停滾動
      scrollContainer.addEventListener('mouseenter', () => {
        if (scrollInterval) {
          clearInterval(scrollInterval);
          scrollInterval = null;
          isScrolling = false;
        }
      });

      // 手動滾動時也暫停自動滾動
      scrollContainer.addEventListener('wheel', () => {
        if (scrollInterval) {
          clearInterval(scrollInterval);
          scrollInterval = null;
          isScrolling = false;
        }
      }, { passive: true });

      scrollContainer.addEventListener('touchstart', () => {
        if (scrollInterval) {
          clearInterval(scrollInterval);
          scrollInterval = null;
          isScrolling = false;
        }
      }, { passive: true });
    });
  }

  document.addEventListener('DOMContentLoaded', initAutoScroll);
  document.addEventListener('astro:page-load', initAutoScroll);
</script>
