---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCurrentLocale, getTranslations } from '../i18n/utils';
import { getProjects, getUpdates, getSingleton, assetUrl } from '../lib/api';
import { normalizeColors } from '../lib/color-normalize';
import { APP_VERSION } from '../lib/version';

export const prerender = false;

const locale = getCurrentLocale(Astro.url);
const t = getTranslations(locale);
const basePath = locale === 'zh-tw' ? '/zh-tw' : '/en';

// Homepage CMS data
const homepageSingleton = await getSingleton(
  locale === 'zh-tw' ? 'homepage-zh' : 'homepage-en'
);
const homepageData = homepageSingleton
  ? { data: homepageSingleton.content as Record<string, any> }
  : null;

// 頁面文字 singleton（可從 admin 後台編輯的靜態文案）
const ptKey = locale === 'zh-tw' ? 'page-home-zh' : 'page-home-en';
const ptRaw = await getSingleton(ptKey);
const pt = (ptRaw?.content ?? {}) as Record<string, string>;

// Projects from D1
const allProjectsRaw = await getProjects();
const allProjects = allProjectsRaw.map((p) => ({
  id: p.id,
  data: {
    title_zh: p.titleZh,
    title_en: p.titleEn,
    description_zh: p.descZh,
    description_en: p.descEn,
    tags: p.tags,
    featured: p.featured,
    order: p.sortOrder,
    status: p.status,
    image: p.image,
    links: p.links,
    startDate: p.startDate ? new Date(p.startDate) : null,
    endDate: p.endDate ? new Date(p.endDate) : null,
  },
}));
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
  .slice(0, 2);
const otherProjects = allProjects
  .filter((p) => !p.data.featured)
  .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
  .slice(0, 4);

// Updates from D1
const allUpdatesRaw = await getUpdates(5);
const latestUpdates = allUpdatesRaw.map((u) => ({
  id: u.id,
  data: {
    title_zh: u.titleZh,
    title_en: u.titleEn,
    description_zh: u.descZh,
    description_en: u.descEn,
    date: new Date(u.date),
    category: u.category,
  },
}));

// Skills count for stats
const skillDomains = 5;
---

<BaseLayout title={t.home.title} description={t.home.description}>
  <!-- ─────────── HERO ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-16 py-16 md:py-24 lg:py-28 max-w-screen-2xl mx-auto"
  >
    <span class="q-section-label">
      {pt.heroLabel || '—— vol. 00 · personal site · 2026'}
    </span>

    <div
      class="mt-6 grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-10 lg:gap-14 items-center"
    >
      <!-- LEFT — title + subtitle + CTA -->
      <div>
        <h1
          class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[112px] font-bold tracking-tighter leading-[0.96]"
          style="color: var(--q-ink);"
          set:html={normalizeColors(
            pt.heroTitle ||
              (locale === 'zh-tw'
                ? '一個還<span style="color: var(--q-ink-soft);">在</span>寫的<br /><span style="color: var(--q-navy);">故事</span>。'
                : 'A story <span style="color: var(--q-ink-soft);">still being</span><br /><span style="color: var(--q-navy);">written</span>.')
          )}
        />

        <p
          class="mt-7 text-lg leading-relaxed max-w-lg"
          style="color: var(--q-ink-soft);"
          set:html={normalizeColors(
            pt.heroSubtitle ||
              (locale === 'zh-tw'
                ? '我是 <strong style="color: var(--q-ink); font-weight: 600;">顏榕嶙</strong> — 台灣的全端工程師與創作者。我用程式、音樂、文字、像素，慢慢把心中那個故事寫成現實。'
                : 'I\'m <strong style="color: var(--q-ink); font-weight: 600;">Bernie Yen</strong> — a full-stack developer &amp; creator from Taiwan. I use code, music, words, and pixels to slowly bring the story in my heart to life.')
          )}
        />

        <div class="mt-5 flex gap-5 items-end flex-wrap">
          <a
            href={`${basePath}/projects`}
            class="text-sm font-semibold no-underline transition-opacity hover:opacity-70"
            style="color: var(--q-ink); border-bottom: 1.5px solid var(--q-ink); padding-bottom: 4px;"
          >
            {pt.heroCta1 || (locale === 'zh-tw' ? '看作品' : 'View work')} →
          </a>
          <a
            href="https://uep.unforgettableeternalproject.com"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium no-underline transition-opacity hover:opacity-70"
            style="color: var(--q-ink-soft); border-bottom: 1px solid var(--q-line); padding-bottom: 4px;"
          >
            {
              pt.heroCta2 ||
                (locale === 'zh-tw'
                  ? '去看看U.E.P的邊際世界'
                  : 'Check out the Imaginary World of U.E.P')
            } ↗
          </a>
        </div>
      </div>

      <!-- RIGHT — Quartz fact sheet（可搖晃互動） -->
      <aside
        data-draggable-card
        style="border: 1px solid var(--q-line); background: var(--q-paper);"
      >
        <!-- Header bar -->
        <div
          class="px-4 py-2.5 flex justify-between items-center"
          style="background: var(--q-ink); color: var(--q-paper);"
        >
          <span
            class="q-mono"
            style="color: var(--q-paper); opacity: 0.7; font-size: 10px;"
          >
            {locale === 'zh-tw' ? '登錄表 · Sheet A' : 'Fact Sheet · A'}
          </span>
          <span class="q-live-dot" style="width: 7px; height: 7px;"></span>
        </div>

        <!-- Rows -->
        <div class="px-5 py-4">
          {
            [
              [
                'NAME',
                locale === 'zh-tw'
                  ? '顏榕嶙 · Bernie Yen'
                  : 'Bernie Yen · 顏榕嶙',
              ],
              [
                'ROLE',
                locale === 'zh-tw'
                  ? '全端工程師 / 創作者'
                  : 'Full-stack Dev / Creator',
              ],
              ['SINCE', '2018'],
              ['STATUS', null],
              ['REACH', 'ptyc4076@gmail.com'],
            ].map(([key, val], i, arr) => (
              <div
                class="grid items-baseline py-2.5"
                style={`
                grid-template-columns: 72px 1fr;
                gap: 14px;
                ${i < arr.length - 1 ? 'border-bottom: 1px dashed var(--q-line);' : ''}
              `}
              >
                <span class="q-mono">{key}</span>
                {val ? (
                  <span class="text-sm font-mono" style="color: var(--q-ink);">
                    {val}
                  </span>
                ) : (
                  <span
                    class="text-sm font-mono flex items-center gap-2"
                    style="color: var(--q-navy);"
                  >
                    <span class="q-live-dot" style="width: 6px; height: 6px;" />
                    Polishing {APP_VERSION}
                  </span>
                )}
              </div>
            ))
          }
        </div>

        <!-- Bottom signature -->
        <div style="height: 1px; background: var(--q-line);"></div>
        <div
          class="px-5 py-3 flex justify-between items-center"
          style="background: var(--q-paper-soft);"
        >
          <span class="q-mono">signed</span>
          <span class="text-xl font-bold italic" style="color: var(--q-navy);"
            >B.Y.</span
          >
        </div>
      </aside>
    </div>
  </section>

  <!-- ─────────── STATS BAR ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-16 py-7"
    style="border-top: 1px solid var(--q-line); border-bottom: 1px solid var(--q-line); background: var(--q-paper-soft);"
  >
    <div
      class="max-w-screen-xl mx-auto grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-5 gap-6 lg:gap-9 items-center"
    >
      <div>
        <div
          class="font-mono text-3xl font-medium tracking-tight"
          style="color: var(--q-ink);"
        >
          {String(allProjects.length).padStart(2, '0')}
        </div>
        <span class="q-mono mt-1 inline-block"
          >{locale === 'zh-tw' ? 'projects' : 'projects'}</span
        >
      </div>
      <div>
        <div
          class="font-mono text-3xl font-medium tracking-tight"
          style="color: var(--q-ink);"
        >
          2018
        </div>
        <span class="q-mono mt-1 inline-block"
          >{
            locale === 'zh-tw' ? 'since · 第一行程式' : 'since · first line'
          }</span
        >
      </div>
      <div>
        <div
          class="font-mono text-3xl font-medium tracking-tight"
          style="color: var(--q-ink);"
        >
          {String(skillDomains).padStart(2, '0')}
        </div>
        <span class="q-mono mt-1 inline-block">creative domains</span>
      </div>
      <div>
        <div
          class="font-mono text-3xl font-medium tracking-tight"
          style="color: var(--q-navy);"
        >
          {APP_VERSION}
        </div>
        <span class="q-mono mt-1 inline-block">currently shipping</span>
      </div>
      <div class="hidden lg:flex items-center gap-2">
        <span class="q-live-dot"></span>
        <span class="q-mono" style="color: var(--q-coral);">online</span>
      </div>
    </div>
  </section>

  <!-- ─────────── PROJECTS ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-16 py-20 md:py-28 max-w-screen-xl mx-auto reveal"
  >
    <!-- Section header -->
    <div
      class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 mb-9"
      style="border-bottom: 1px solid var(--q-line);"
    >
      <div>
        <span class="q-section-label"
          >{pt.projectsLabel || '—— 01 / selected work'}</span
        >
        <h2
          class="mt-2 text-3xl md:text-4xl font-bold tracking-tight"
          style="color: var(--q-ink); line-height: 1;"
        >
          {
            pt.projectsTitle ||
              (locale === 'zh-tw' ? '精選作品' : 'Selected Work')
          }
        </h2>
      </div>
      <div class="flex items-center gap-4">
        <span class="q-mono">{allProjects.length} entries</span>
        <a
          href={`${basePath}/projects`}
          class="text-sm font-medium no-underline transition-opacity hover:opacity-70"
          style="color: var(--q-ink); border-bottom: 1px solid var(--q-ink-soft); padding-bottom: 2px;"
        >
          {pt.projectsCta || (locale === 'zh-tw' ? '查看全部' : 'View all')} →
        </a>
      </div>
    </div>

    <!-- Featured projects — 2 col -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-9 mb-14">
      {
        featuredProjects.map((project) => (
          <a
            href={`${basePath}/projects/${project.id}`}
            class="block no-underline group reveal-item"
          >
            {/* Plate */}
            <div class="q-plate" style="aspect-ratio: 16/9; overflow: hidden;">
              {project.data.image ? (
                <img
                  src={assetUrl(project.data.image)}
                  alt={
                    locale === 'zh-tw'
                      ? project.data.title_zh || project.id
                      : project.data.title_en
                  }
                  loading="lazy"
                />
              ) : (
                <div style="position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;">
                  <svg
                    width="36"
                    height="36"
                    viewBox="0 0 48 48"
                    fill="none"
                    style="opacity: 0.2;"
                  >
                    <rect
                      x="4"
                      y="8"
                      width="40"
                      height="32"
                      stroke="var(--q-ink)"
                      stroke-width="2"
                      fill="none"
                    />
                    <path
                      d="M4 32 L16 22 L24 28 L34 18 L44 26"
                      stroke="var(--q-ink)"
                      stroke-width="2"
                      fill="none"
                      stroke-linejoin="round"
                    />
                    <circle cx="14" cy="18" r="3" fill="var(--q-ink)" />
                  </svg>
                  <span
                    class="q-mono"
                    style="font-size: 10px; opacity: 0.35; max-width: 70%; text-align: center; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;"
                  >
                    {locale === 'zh-tw'
                      ? project.data.title_zh || project.id
                      : project.data.title_en}
                  </span>
                </div>
              )}
            </div>

            {/* Meta */}
            <div class="mt-4 flex justify-between items-baseline">
              <span class="q-mono" style="color: var(--q-navy);">
                {String(project.data.order || 1).padStart(2, '0')} ·{' '}
                {project.data.status}
              </span>
              <span class="q-mono">
                {project.data.startDate
                  ? project.data.startDate.getFullYear()
                  : '—'}
              </span>
            </div>

            <h3
              class="mt-2 text-xl md:text-2xl font-bold tracking-tight group-hover:opacity-75 transition-opacity"
              style="color: var(--q-ink);"
            >
              {locale === 'zh-tw'
                ? project.data.title_zh || project.id
                : project.data.title_en}
              <span
                class="ml-2 text-xs q-mono"
                style="color: var(--q-navy); vertical-align: middle;"
              >
                ✦
              </span>
            </h3>

            <p
              class="mt-2 text-sm leading-relaxed"
              style="color: var(--q-ink-soft); max-width: 480px;"
            >
              {locale === 'zh-tw'
                ? project.data.description_zh
                : project.data.description_en}
            </p>

            <div class="mt-3 flex gap-1.5 flex-wrap">
              {project.data.tags.slice(0, 4).map((tag: string) => (
                <span class="q-pill">{tag}</span>
              ))}
              {project.data.tags.length > 4 && (
                <span class="q-pill">+{project.data.tags.length - 4}</span>
              )}
            </div>
          </a>
        ))
      }
    </div>

    <!-- Other projects — catalog list -->
    <div>
      {
        otherProjects.map((project, i) => (
          <a
            href={`${basePath}/projects/${project.id}`}
            class="grid gap-5 items-baseline py-3.5 no-underline transition-opacity hover:opacity-75 reveal-item"
            style={`
            grid-template-columns: 40px 1fr 80px 24px;
            border-top: 1px solid var(--q-line);
            ${i === otherProjects.length - 1 ? 'border-bottom: 1px solid var(--q-line);' : ''}
            color: inherit;
          `}
          >
            <span class="q-mono" style="color: var(--q-navy);">
              {String(project.data.order || i + 3).padStart(2, '0')}
            </span>
            <div>
              <h4
                class="text-lg md:text-xl font-semibold tracking-tight"
                style="color: var(--q-ink); margin: 0;"
              >
                {locale === 'zh-tw'
                  ? project.data.title_zh || project.id
                  : project.data.title_en}
                <span
                  class="ml-3 text-sm font-normal italic"
                  style="color: var(--q-ink-mute);"
                >
                  —{' '}
                  {locale === 'zh-tw'
                    ? project.data.description_zh?.slice(0, 30)
                    : project.data.description_en?.slice(0, 40)}
                </span>
              </h4>
            </div>
            <span class="q-mono">
              {project.data.startDate
                ? project.data.startDate.getFullYear()
                : '—'}
            </span>
            <span class="text-right text-lg" style="color: var(--q-ink);">
              →
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- ─────────── ABOUT + UPDATES ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-16 py-16 md:py-24 max-w-screen-xl mx-auto reveal"
  >
    <div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-16 lg:gap-20">
      <!-- ABOUT -->
      <div class="reveal-item">
        <span class="q-section-label">{pt.aboutLabel || '—— 02 / about'}</span>
        <h3
          class="mt-3 text-3xl md:text-4xl font-bold tracking-tight"
          style="color: var(--q-ink);"
        >
          {pt.aboutTitle || (locale === 'zh-tw' ? '關於我' : 'About Me')}
        </h3>
        <div class="mt-7 space-y-4">
          {
            /* 優先層級：pt.aboutContent > homepageData.introContent > 硬編碼 fallback */
          }
          {
            pt.aboutContent ? (
              <p class="text-base leading-[1.85]" style="color: var(--q-ink);">
                {pt.aboutContent}
              </p>
            ) : homepageData?.data.introContent ? (
              <p class="text-base leading-[1.85]" style="color: var(--q-ink);">
                {homepageData.data.introContent}
              </p>
            ) : (
              <>
                <p
                  class="text-base leading-[1.85]"
                  style="color: var(--q-ink);"
                >
                  {locale === 'zh-tw'
                    ? '我並不想要被任何事物給拘束，而希望追求一個自由自在的環境。'
                    : "I don't want to be constrained by anything — I seek a free and open environment."}
                </p>
                <p
                  class="text-base leading-[1.85]"
                  style="color: var(--q-ink);"
                >
                  {locale === 'zh-tw'
                    ? '當然，聽起來還是天方夜譚，不過這也是我之所以繼續努力著的原因。'
                    : "Of course, it still sounds like a fantasy, but that's exactly why I keep pushing forward."}
                </p>
                <p
                  class="text-base leading-[1.85]"
                  style="color: var(--q-ink);"
                >
                  {locale === 'zh-tw'
                    ? '有一個故事存活在我的心中，而對我而言，想辦法把這個故事給實現就是我一直在追求的最終目標。'
                    : 'A story lives in my heart, and finding a way to bring it to life is the ultimate goal I pursue.'}
                </p>
              </>
            )
          }
        </div>
        <a
          href={`${basePath}/about`}
          class="inline-block mt-5 text-sm font-medium no-underline transition-opacity hover:opacity-70"
          style="color: var(--q-ink); border-bottom: 1.5px solid var(--q-navy); padding-bottom: 3px;"
        >
          {pt.aboutCta || (locale === 'zh-tw' ? '完整自介' : 'Full bio')} →
        </a>
      </div>

      <!-- UPDATES -->
      <div class="reveal-item">
        <span class="q-section-label">{pt.updatesLabel || '—— 03 / log'}</span>
        <h3
          class="mt-3 text-3xl md:text-4xl font-bold tracking-tight"
          style="color: var(--q-ink);"
        >
          {pt.updatesTitle || (locale === 'zh-tw' ? '近期動態' : 'Recent Log')}
        </h3>

        <div class="mt-7">
          {
            latestUpdates.map((update, i) => (
              <a
                href={`${basePath}/updates/${update.id}`}
                class="grid items-baseline py-3.5 no-underline transition-opacity hover:opacity-70"
                style={`
                grid-template-columns: 80px 1fr;
                gap: 16px;
                border-top: 1px solid var(--q-line);
                ${i === latestUpdates.length - 1 ? 'border-bottom: 1px solid var(--q-line);' : ''}
                color: inherit;
              `}
              >
                <span class="q-mono">
                  {update.data.date.toLocaleDateString(
                    locale === 'zh-tw' ? 'zh-TW' : 'en-US',
                    { year: '2-digit', month: '2-digit', day: '2-digit' }
                  )}
                </span>
                <span
                  class="text-sm font-medium leading-snug"
                  style="color: var(--q-ink);"
                >
                  {locale === 'zh-tw'
                    ? update.data.title_zh || update.id
                    : update.data.title_en || update.id}
                </span>
              </a>
            ))
          }
        </div>

        <a
          href={`${basePath}/updates`}
          class="inline-block mt-5 text-sm font-medium no-underline transition-opacity hover:opacity-70"
          style="color: var(--q-ink); border-bottom: 1.5px solid var(--q-navy); padding-bottom: 3px;"
        >
          {pt.updatesCta || (locale === 'zh-tw' ? '所有動態' : 'All updates')} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Scrollbar hide for any overflow containers */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  // Lightweight intersection reveal — respects reduced motion via CSS
  function initRevealAnimation() {
    const prefersReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    if (prefersReduced) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
    );

    document.querySelectorAll('.reveal-item').forEach((el) => {
      observer.observe(el);
    });
  }

  // ── 可拖曳卡片互動（通用，手機版停用避免誤觸導致畫面縮小） ──
  function makeDraggableCard(el: HTMLElement) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(max-width: 767px)').matches) return;

    let isDragging = false;
    let startX = 0,
      startY = 0;
    let currentX = 0,
      currentY = 0;
    let velocityX = 0,
      velocityY = 0;
    let lastX = 0,
      lastY = 0;
    let shakeFrame = 0;
    let inertiaRaf = 0;
    const MAX_ROTATE = 6;
    const INERTIA_FRICTION = 0.86; // 慣性摩擦係數（每幀保留 86% 速度）
    const SNAP_BACK_MS = 600;

    // 初始化樣式
    el.style.cursor = 'grab';
    el.style.userSelect = 'none';
    el.style.willChange = 'transform';
    el.style.position = 'relative';

    // 粒子容器
    let pContainer: HTMLDivElement | null = null;
    function pc() {
      if (!pContainer) {
        pContainer = document.createElement('div');
        pContainer.style.cssText =
          'position:absolute;inset:0;pointer-events:none;overflow:visible;z-index:10;';
        el.appendChild(pContainer);
      }
      return pContainer;
    }

    function emitParticles(vx: number, vy: number) {
      const c = pc();
      const rect = el.getBoundingClientRect();
      const count = Math.min(10, Math.floor(Math.sqrt(vx * vx + vy * vy)) + 2);
      for (let i = 0; i < count; i++) {
        const p = document.createElement('span');
        const edge = Math.random();
        const sx =
          edge < 0.5 ? (vx > 0 ? rect.width : 0) : Math.random() * rect.width;
        const sy =
          edge >= 0.5
            ? vy > 0
              ? rect.height
              : 0
            : Math.random() * rect.height;
        const angle = Math.atan2(vy, vx) + (Math.random() - 0.5) * 2;
        const dist = 25 + Math.random() * 50;
        const size = 2 + Math.random() * 3;
        p.style.cssText = `position:absolute;left:${sx}px;top:${sy}px;width:${size}px;height:${size}px;background:var(--q-navy);opacity:0.5;pointer-events:none;`;
        c.appendChild(p);
        p.animate(
          [
            { transform: 'translate(0,0) scale(1)', opacity: 0.55 },
            {
              transform: `translate(${Math.cos(angle) * dist}px,${Math.sin(angle) * dist}px) scale(0)`,
              opacity: 0,
            },
          ],
          {
            duration: 400 + Math.random() * 350,
            easing: 'ease-out',
            fill: 'forwards',
          }
        ).onfinish = () => p.remove();
      }
    }

    // 晃動偵測：追蹤水平方向變化
    let lastDirX = 0; // 上一次水平移動方向 (-1/0/1)
    let dirChangeCount = 0; // 短時間內方向變化次數
    let dirChangeTimer = 0; // 方向變化衰減計時器
    let dragParticleCD = 0; // 拖曳粒子冷卻

    function setTransform(x: number, y: number, dragging: boolean) {
      // 旋轉方向跟著滑鼠移動方向，不是卡片位置
      const tiltTarget = Math.max(
        -MAX_ROTATE,
        Math.min(MAX_ROTATE, velocityX * 1.2)
      );
      const noise =
        dragging && shakeFrame++ % 3 === 0 ? (Math.random() - 0.5) * 1.2 : 0;
      const scale = dragging ? 1.018 : 1;
      el.style.transform = `translate(${x + noise}px, ${y}px) rotate(${tiltTarget}deg) scale(${scale})`;
      el.style.transition = dragging
        ? 'none'
        : `transform ${SNAP_BACK_MS}ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease`;
    }

    function grab(cx: number, cy: number) {
      cancelAnimationFrame(inertiaRaf);
      isDragging = true;
      startX = cx - currentX;
      startY = cy - currentY;
      lastX = cx;
      lastY = cy;
      velocityX = 0;
      velocityY = 0;
      shakeFrame = 0;
      lastDirX = 0;
      dirChangeCount = 0;
      dragParticleCD = 0;
      el.style.cursor = 'grabbing';
      el.style.boxShadow =
        '0 10px 30px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.06)';
    }

    // 晃動時的小粒子（比放開時更輕、更散）
    function emitShakeParticles() {
      const c = pc();
      const rect = el.getBoundingClientRect();
      const count = 2 + Math.floor(Math.random() * 3);
      for (let i = 0; i < count; i++) {
        const p = document.createElement('span');
        const sx = Math.random() * rect.width;
        const sy = Math.random() * rect.height;
        const angle = Math.random() * Math.PI * 2;
        const dist = 15 + Math.random() * 30;
        const size = 1.5 + Math.random() * 2;
        p.style.cssText = `position:absolute;left:${sx}px;top:${sy}px;width:${size}px;height:${size}px;background:var(--q-navy);opacity:0.35;pointer-events:none;`;
        c.appendChild(p);
        p.animate(
          [
            { transform: 'translate(0,0)', opacity: 0.4 },
            {
              transform: `translate(${Math.cos(angle) * dist}px,${Math.sin(angle) * dist}px)`,
              opacity: 0,
            },
          ],
          {
            duration: 300 + Math.random() * 200,
            easing: 'ease-out',
            fill: 'forwards',
          }
        ).onfinish = () => p.remove();
      }
    }

    function drag(cx: number, cy: number) {
      if (!isDragging) return;
      const rawVx = cx - lastX;
      const rawVy = cy - lastY;
      velocityX = velocityX * 0.4 + rawVx * 0.6;
      velocityY = velocityY * 0.4 + rawVy * 0.6;
      lastX = cx;
      lastY = cy;
      currentX = cx - startX;
      currentY = cy - startY;

      // 偵測左右晃動：方向快速反轉
      const dirX = rawVx > 0.5 ? 1 : rawVx < -0.5 ? -1 : 0;
      if (dirX !== 0 && dirX !== lastDirX && lastDirX !== 0) {
        dirChangeCount++;
        clearTimeout(dirChangeTimer);
        dirChangeTimer = window.setTimeout(() => {
          dirChangeCount = Math.max(0, dirChangeCount - 2);
        }, 300);
      }
      if (dirX !== 0) lastDirX = dirX;

      // 晃動夠快時噴粒子（有冷卻避免過多）
      if (dirChangeCount >= 2 && dragParticleCD <= 0) {
        emitShakeParticles();
        dragParticleCD = 4; // 每 4 次 move 才能再噴
      }
      if (dragParticleCD > 0) dragParticleCD--;

      setTransform(currentX, currentY, true);
    }

    function release() {
      if (!isDragging) return;
      isDragging = false;
      el.style.cursor = 'grab';
      el.style.boxShadow = 'none';

      const speed = Math.sqrt(velocityX ** 2 + velocityY ** 2);
      if (speed > 1.5) emitParticles(velocityX, velocityY);

      // 慣性滑行 → 彈回原位
      let vx = velocityX * 1.4; // 水平慣性倍率
      let vy = velocityY * 0.8;

      function inertiaStep() {
        vx *= INERTIA_FRICTION;
        vy *= INERTIA_FRICTION;
        currentX += vx;
        currentY += vy;
        setTransform(currentX, currentY, true);

        if (Math.abs(vx) > 0.3 || Math.abs(vy) > 0.3) {
          inertiaRaf = requestAnimationFrame(inertiaStep);
        } else {
          // 慣性結束，彈回原位
          currentX = 0;
          currentY = 0;
          setTransform(0, 0, false);
        }
      }
      inertiaRaf = requestAnimationFrame(inertiaStep);
    }

    el.addEventListener('mousedown', (e) => {
      grab(e.clientX, e.clientY);
      e.preventDefault();
    });
    window.addEventListener('mousemove', (e) => drag(e.clientX, e.clientY));
    window.addEventListener('mouseup', release);
    el.addEventListener('dblclick', () => {
      cancelAnimationFrame(inertiaRaf);
      currentX = 0;
      currentY = 0;
      setTransform(0, 0, false);
    });
    el.addEventListener(
      'touchstart',
      (e) => grab(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );
    el.addEventListener(
      'touchmove',
      (e) => drag(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );
    el.addEventListener('touchend', release);
  }

  function initDraggableCards() {
    document
      .querySelectorAll<HTMLElement>('[data-draggable-card]')
      .forEach(makeDraggableCard);
  }

  // astro:page-load 已涵蓋 DOMContentLoaded 情境
  document.addEventListener('astro:page-load', () => {
    initRevealAnimation();
    initDraggableCards();
  });
</script>
