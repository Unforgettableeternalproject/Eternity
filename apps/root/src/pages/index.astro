                            (locale === 'zh-tw' ? '\u7db2\u7ad9' : 'Website')}
                          {update.data.category === 'project' &&
                            (locale === 'zh-tw' ? '\u5c08\u6848' : 'Project')}
                          {update.data.category === 'announcement' &&
                            (locale === 'zh-tw'
                              ? '\u516c\u544a'
