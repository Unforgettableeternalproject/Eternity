---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCurrentLocale } from '../i18n/utils';
import { getSingleton } from '../lib/api';
import { normalizeColors } from '../lib/color-normalize';

export const prerender = false;

const locale = getCurrentLocale(Astro.url);

/* ── Fetch from D1 ── */
const singletonKey = locale === 'zh-tw' ? 'about-zh' : 'about-en';
const raw = await getSingleton(singletonKey);

/* ── 頁面 hero 文字（從 page-about singleton 讀取） ── */
const ptKey = locale === 'zh-tw' ? 'page-about-zh' : 'page-about-en';
const ptRaw = await getSingleton(ptKey);
const pt = (ptRaw?.content ?? {}) as Record<string, string>;
const data = (raw?.content ?? {}) as {
  title?: string;
  bio?: string;
  heroTitle?: string;
  heroIntro?: string;
  fullBio?: string;
  avatar?: string;
  facts?: [string, string][];
  skills?: {
    id: string;
    name: string;
    en: string;
    brief: string;
    description: string;
    selfAssessment: string;
  }[];
  experience?: {
    title: string;
    company: string;
    period: string;
    location: string;
    description: string;
    stack: string[];
    current: boolean;
  }[];
  social?: { github?: string; email?: string };
  cta?: { heading?: string; text?: string };
};

const skills = data.skills ?? [];
const experience = data.experience ?? [];
const social = data.social ?? {};
const cta = data.cta ?? {};

/* ── Currently 動態面板 ── */
const currentlyRaw = await getSingleton('currently');
const currently = (currentlyRaw?.content ?? {}) as {
  working?: string;
  learning?: string;
  listening?: string;
  playing?: string;
  reading?: string;
  status?: string;
  updatedAt?: string;
};

// 組裝顯示項目（只顯示有值的）
const currentlyItems: { label: string; icon: string; value: string }[] = [];
if (currently.working)
  currentlyItems.push({
    label: 'WORKING ON',
    icon: '⚙',
    value: currently.working,
  });
if (currently.learning)
  currentlyItems.push({
    label: 'LEARNING',
    icon: '◈',
    value: currently.learning,
  });
if (currently.listening)
  currentlyItems.push({
    label: 'LISTENING',
    icon: '♪',
    value: currently.listening,
  });
if (currently.playing)
  currentlyItems.push({
    label: 'PLAYING',
    icon: '▶',
    value: currently.playing,
  });
if (currently.reading)
  currentlyItems.push({
    label: 'READING',
    icon: '▤',
    value: currently.reading,
  });
if (currently.status)
  currentlyItems.push({ label: 'STATUS', icon: '●', value: currently.status });

// Fallback：如果 singleton 還沒建立
if (currentlyItems.length === 0) {
  currentlyItems.push(
    { label: 'WORKING ON', icon: '⚙', value: 'Eternity v1.0' },
    { label: 'LEARNING', icon: '◈', value: 'Cloudflare Workers' },
    { label: 'STATUS', icon: '●', value: 'Polishing' }
  );
}
---

<BaseLayout
  title={locale === 'zh-tw' ? '關於我 — 顏榕嶙' : 'About — Bernie Yen'}
  description={data.bio || ''}
>
  <!-- ─────────── HERO ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pt-16 sm:pt-20 lg:pt-[100px] pb-12 lg:pb-[60px] max-w-screen-xl mx-auto"
  >
    <span class="q-section-label">
      {
        pt.heroLabel ||
          (locale === 'zh-tw'
            ? '—— 01 / about · 個人簡介'
            : '—— 01 / about · personal profile')
      }
    </span>

    <h1
      class="mt-6 text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[96px] font-bold leading-[0.97] tracking-tighter max-w-[1100px]"
      style="color: var(--q-ink);"
      set:html={normalizeColors(
        pt.heroTitle ||
          (locale === 'zh-tw'
            ? '有一個<br /><span style="color: var(--q-navy); font-weight: 600;">尚未完成</span>的<br />故事存在著。'
            : 'A story <br /><span style="color: var(--q-navy); font-weight: 600;">not yet finished</span><br />exists.')
      )}
    />

    <div
      class="mt-10 lg:mt-14 grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-14 items-start"
    >
      <p
        class="m-0 max-w-[580px] text-lg leading-[1.75]"
        style="color: var(--q-ink-soft);"
      >
        {pt.heroIntro || data.heroIntro || ''}
      </p>

      <!-- Currently 動態面板（可拖曳互動） -->
      <aside
        data-draggable-card
        style="border: 1px solid var(--q-line); background: var(--q-paper);"
      >
        <div
          class="px-4 py-2.5 flex justify-between items-center"
          style="background: var(--q-ink); color: var(--q-paper);"
        >
          <span
            class="q-mono"
            style="color: var(--q-paper); opacity: 0.7; font-size: 10px;"
          >
            {locale === 'zh-tw' ? '目前狀態 · Currently' : 'Currently · Live'}
          </span>
          <span class="q-live-dot" style="width: 7px; height: 7px;"></span>
        </div>
        <div class="px-5 py-4">
          {
            currentlyItems.map((item, i) => (
              <div
                class="grid items-baseline py-2.5"
                style={`
                grid-template-columns: 96px 1fr;
                gap: 12px;
                ${i > 0 ? 'border-top: 1px dashed var(--q-line);' : ''}
              `}
              >
                <span
                  class="q-mono"
                  style="font-size: 10px; display: flex; align-items: center; gap: 5px;"
                >
                  <span style="font-size: 11px; opacity: 0.7;">
                    {item.icon}
                  </span>
                  {item.label}
                </span>
                <span
                  class="text-sm"
                  style="color: var(--q-ink); font-family: 'Plus Jakarta Sans', 'Noto Sans TC', sans-serif;"
                >
                  {item.value}
                </span>
              </div>
            ))
          }
        </div>
        {
          currently.updatedAt && (
            <div
              class="px-5 py-2 flex justify-end"
              style="border-top: 1px solid var(--q-line); font-size: 10px;"
            >
              <span class="q-mono" style="opacity: 0.5;">
                updated {currently.updatedAt}
              </span>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  <!-- ─────────── FULL BIO ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pt-10 pb-10 lg:pt-[40px] lg:pb-[60px] max-w-screen-xl mx-auto reveal"
  >
    <div
      class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 mb-9"
      style="border-bottom: 1px solid var(--q-line);"
    >
      <div>
        <span class="q-section-label">—— 01 / full bio</span>
        <h2
          class="mt-2 text-3xl md:text-4xl font-bold tracking-tight leading-none"
          style="color: var(--q-ink);"
        >
          {locale === 'zh-tw' ? '關於我' : 'About Me'}
        </h2>
      </div>
    </div>

    {
      data.fullBio ? (
        <div
          class="q-bio-prose reveal-item max-w-[720px]"
          set:html={normalizeColors(data.fullBio || '')}
        />
      ) : (
        <p class="text-sm italic" style="color: var(--q-ink-mute);">
          {locale === 'zh-tw' ? '尚未撰寫。' : 'Not written yet.'}
        </p>
      )
    }
  </section>

  <!-- ─────────── SKILLS ─────────── -->
  {
    skills.length > 0 && (
      <section class="px-4 sm:px-6 lg:px-10 xl:px-[72px] py-12 lg:py-[60px] max-w-screen-xl mx-auto reveal">
        <div
          class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 mb-9"
          style="border-bottom: 1px solid var(--q-line);"
        >
          <div>
            <span class="q-section-label">—— 02 / practice in detail</span>
            <h2
              class="mt-2 text-3xl md:text-4xl font-bold tracking-tight leading-none"
              style="color: var(--q-ink);"
            >
              {locale === 'zh-tw' ? '技能與領域' : 'Skills & Domains'}
            </h2>
          </div>
          <span class="q-mono">{skills.length} domains</span>
        </div>

        <div>
          {skills.map((s, i) => (
            <article
              class="grid grid-cols-1 lg:grid-cols-[140px_1fr_1fr] gap-6 lg:gap-12 py-7 lg:py-9 reveal-item"
              style={`
              border-top: 1px solid var(--q-line);
              ${i === skills.length - 1 ? 'border-bottom: 1px solid var(--q-line);' : ''}
            `}
            >
              <div>
                <div
                  class="text-5xl lg:text-[68px] font-mono leading-[0.85] tracking-tighter"
                  style="color: var(--q-ink-fade); font-weight: 400;"
                >
                  {s.id}
                </div>
                <h4
                  class="mt-4 text-xl lg:text-[22px] font-bold tracking-tight"
                  style="color: var(--q-ink); margin-bottom: 4px;"
                >
                  {s.name}
                </h4>
                <div
                  class="text-sm italic font-medium"
                  style="color: var(--q-navy);"
                >
                  {s.en}
                </div>
                <div class="mt-3">
                  <span class="q-mono">{s.brief}</span>
                </div>
              </div>

              <div>
                <span class="q-mono" style="color: var(--q-navy);">
                  description
                </span>
                <p
                  class="mt-2.5 text-sm leading-[1.8]"
                  style="color: var(--q-ink); margin: 10px 0 0;"
                >
                  {s.description}
                </p>
              </div>

              <div>
                <span class="q-mono" style="color: var(--q-navy);">
                  self-assessment
                </span>
                <p
                  class="mt-2.5 text-sm leading-[1.8] italic"
                  style="color: var(--q-ink-soft); margin: 10px 0 0;"
                >
                  {s.selfAssessment}
                </p>
              </div>
            </article>
          ))}
        </div>
      </section>
    )
  }

  <!-- ─────────── EXPERIENCE ─────────── -->
  {
    experience.length > 0 && (
      <section class="px-4 sm:px-6 lg:px-10 xl:px-[72px] py-12 lg:py-[60px] max-w-screen-xl mx-auto reveal">
        <div
          class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 mb-9"
          style="border-bottom: 1px solid var(--q-line);"
        >
          <div>
            <span class="q-section-label">—— 03 / experience</span>
            <h2
              class="mt-2 text-3xl md:text-4xl font-bold tracking-tight leading-none"
              style="color: var(--q-ink);"
            >
              {locale === 'zh-tw' ? '經歷' : 'Experience'}
            </h2>
          </div>
        </div>

        <div>
          {experience.map((e, i) => (
            <div
              class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-5 md:gap-10 py-7 md:py-8 reveal-item"
              style={`border-top: 1px solid var(--q-line);`}
            >
              <div>
                <span
                  class="q-mono"
                  style={`color: ${i === 0 ? 'var(--q-navy)' : 'var(--q-ink-soft)'};`}
                >
                  {e.period}
                </span>
                <div class="mt-1.5 text-sm" style="color: var(--q-ink-soft);">
                  {e.location}
                </div>
                {e.current && (
                  <div class="mt-3 flex items-center gap-2">
                    <span class="q-live-dot" style="width: 8px; height: 8px;" />
                    <span class="q-mono" style="color: var(--q-coral);">
                      current
                    </span>
                  </div>
                )}
              </div>

              <div>
                <h4
                  class="text-xl md:text-2xl font-bold tracking-tight"
                  style="color: var(--q-ink); margin: 0;"
                >
                  {e.title}
                  <span
                    class="ml-3 text-lg font-medium italic"
                    style="color: var(--q-navy);"
                  >
                    @ {e.company}
                  </span>
                </h4>
                <p
                  class="mt-3 mb-4 text-[15px] leading-[1.7]"
                  style="color: var(--q-ink-soft);"
                >
                  {e.description}
                </p>
                {e.stack && (
                  <div class="flex gap-1.5 flex-wrap">
                    {e.stack.map((tag) => (
                      <span class="q-pill">{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- ─────────── CTA ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pt-10 pb-20 lg:pb-[120px] max-w-screen-xl mx-auto"
  >
    <div
      class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-14 items-end pt-14"
      style="border-top: 1px solid var(--q-line);"
    >
      <div>
        <span class="q-section-label"> —— 04 / reach out </span>
        <h3
          class="mt-3.5 text-4xl lg:text-[56px] font-bold tracking-tight leading-none"
          style="color: var(--q-ink);"
        >
          {cta.heading || (locale === 'zh-tw' ? '想聊聊？' : "Let's talk?")}
        </h3>
        <p
          class="mt-3.5 text-base leading-[1.7] max-w-[480px]"
          style="color: var(--q-ink-soft);"
        >
          {cta.text || ''}
        </p>
      </div>

      <div class="flex flex-col">
        <a
          href={`mailto:${social.email || 'ptyc4076@gmail.com'}`}
          class="flex justify-between items-center px-5 py-4 text-[15px] font-semibold no-underline"
          style="background: var(--q-ink); color: var(--q-paper);"
        >
          <span>{locale === 'zh-tw' ? '寄信' : 'Email'} →</span>
          <span
            class="font-mono text-xs opacity-70"
            style="font-family: 'JetBrains Mono', monospace;"
            >{social.email || 'ptyc4076@gmail.com'}</span
          >
        </a>
        {
          social.github && (
            <a
              href={social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex justify-between items-center px-5 py-4 text-[15px] font-medium no-underline"
              style="background: var(--q-paper); color: var(--q-ink); border: 1px solid var(--q-line); border-top: none;"
            >
              <span>GitHub →</span>
              <span
                class="font-mono text-xs opacity-70"
                style="font-family: 'JetBrains Mono', monospace;"
              >
                {social.github.replace('https://github.com/', '@')}
              </span>
            </a>
          )
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .q-bio-prose :global(p) {
    margin: 0 0 20px;
    font-size: 18px;
    line-height: 1.9;
    color: var(--q-ink);
  }
</style>

<script>
  function initRevealAnimation() {
    const prefersReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    if (prefersReduced) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
    );

    document
      .querySelectorAll('.reveal-item')
      .forEach((el) => observer.observe(el));
  }

  // ── 可拖曳卡片互動（與首頁共用邏輯） ──
  function makeDraggableCard(el: HTMLElement) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let isDragging = false;
    let startX = 0,
      startY = 0,
      currentX = 0,
      currentY = 0;
    let velocityX = 0,
      velocityY = 0,
      lastX = 0,
      lastY = 0;
    let shakeFrame = 0,
      inertiaRaf = 0;
    const MAX_ROTATE = 6,
      INERTIA_FRICTION = 0.86,
      SNAP_BACK_MS = 600;
    el.style.cursor = 'grab';
    el.style.userSelect = 'none';
    el.style.willChange = 'transform';
    el.style.position = 'relative';

    let pC: HTMLDivElement | null = null;
    function pc() {
      if (!pC) {
        pC = document.createElement('div');
        pC.style.cssText =
          'position:absolute;inset:0;pointer-events:none;overflow:visible;z-index:10;';
        el.appendChild(pC);
      }
      return pC;
    }
    function emitParticles(vx: number, vy: number) {
      const c = pc(),
        rect = el.getBoundingClientRect();
      const count = Math.min(10, Math.floor(Math.sqrt(vx * vx + vy * vy)) + 2);
      for (let i = 0; i < count; i++) {
        const p = document.createElement('span');
        const edge = Math.random(),
          sx =
            edge < 0.5 ? (vx > 0 ? rect.width : 0) : Math.random() * rect.width;
        const sy =
          edge >= 0.5
            ? vy > 0
              ? rect.height
              : 0
            : Math.random() * rect.height;
        const angle = Math.atan2(vy, vx) + (Math.random() - 0.5) * 2,
          dist = 25 + Math.random() * 50,
          size = 2 + Math.random() * 3;
        p.style.cssText = `position:absolute;left:${sx}px;top:${sy}px;width:${size}px;height:${size}px;background:var(--q-navy);opacity:0.5;pointer-events:none;`;
        c.appendChild(p);
        p.animate(
          [
            { transform: 'translate(0,0) scale(1)', opacity: 0.55 },
            {
              transform: `translate(${Math.cos(angle) * dist}px,${Math.sin(angle) * dist}px) scale(0)`,
              opacity: 0,
            },
          ],
          {
            duration: 400 + Math.random() * 350,
            easing: 'ease-out',
            fill: 'forwards',
          }
        ).onfinish = () => p.remove();
      }
    }
    let lastDirX = 0,
      dirChangeCount = 0,
      dirChangeTimer = 0,
      dragParticleCD = 0;
    function emitShakeParticles() {
      const c = pc(),
        rect = el.getBoundingClientRect();
      const count = 2 + Math.floor(Math.random() * 3);
      for (let i = 0; i < count; i++) {
        const p = document.createElement('span');
        const sx = Math.random() * rect.width,
          sy = Math.random() * rect.height;
        const angle = Math.random() * Math.PI * 2,
          dist = 15 + Math.random() * 30,
          size = 1.5 + Math.random() * 2;
        p.style.cssText = `position:absolute;left:${sx}px;top:${sy}px;width:${size}px;height:${size}px;background:var(--q-navy);opacity:0.35;pointer-events:none;`;
        c.appendChild(p);
        p.animate(
          [
            { transform: 'translate(0,0)', opacity: 0.4 },
            {
              transform: `translate(${Math.cos(angle) * dist}px,${Math.sin(angle) * dist}px)`,
              opacity: 0,
            },
          ],
          {
            duration: 300 + Math.random() * 200,
            easing: 'ease-out',
            fill: 'forwards',
          }
        ).onfinish = () => p.remove();
      }
    }
    function setT(x: number, y: number, d: boolean) {
      const r = Math.max(-MAX_ROTATE, Math.min(MAX_ROTATE, velocityX * 1.2));
      const n = d && shakeFrame++ % 3 === 0 ? (Math.random() - 0.5) * 1.2 : 0;
      el.style.transform = `translate(${x + n}px,${y}px) rotate(${r}deg) scale(${d ? 1.018 : 1})`;
      el.style.transition = d
        ? 'none'
        : `transform ${SNAP_BACK_MS}ms cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.3s ease`;
    }
    function grab(cx: number, cy: number) {
      cancelAnimationFrame(inertiaRaf);
      isDragging = true;
      startX = cx - currentX;
      startY = cy - currentY;
      lastX = cx;
      lastY = cy;
      velocityX = 0;
      velocityY = 0;
      shakeFrame = 0;
      lastDirX = 0;
      dirChangeCount = 0;
      dragParticleCD = 0;
      el.style.cursor = 'grabbing';
      el.style.boxShadow =
        '0 10px 30px rgba(0,0,0,0.12),0 2px 8px rgba(0,0,0,0.06)';
    }
    function drag(cx: number, cy: number) {
      if (!isDragging) return;
      const rawVx = cx - lastX;
      velocityX = velocityX * 0.4 + rawVx * 0.6;
      velocityY = velocityY * 0.4 + (cy - lastY) * 0.6;
      lastX = cx;
      lastY = cy;
      currentX = cx - startX;
      currentY = cy - startY;
      const dirX = rawVx > 0.5 ? 1 : rawVx < -0.5 ? -1 : 0;
      if (dirX !== 0 && dirX !== lastDirX && lastDirX !== 0) {
        dirChangeCount++;
        clearTimeout(dirChangeTimer);
        dirChangeTimer = window.setTimeout(() => {
          dirChangeCount = Math.max(0, dirChangeCount - 2);
        }, 300);
      }
      if (dirX !== 0) lastDirX = dirX;
      if (dirChangeCount >= 2 && dragParticleCD <= 0) {
        emitShakeParticles();
        dragParticleCD = 4;
      }
      if (dragParticleCD > 0) dragParticleCD--;
      setT(currentX, currentY, true);
    }
    function release() {
      if (!isDragging) return;
      isDragging = false;
      el.style.cursor = 'grab';
      el.style.boxShadow = 'none';
      if (Math.sqrt(velocityX ** 2 + velocityY ** 2) > 1.5)
        emitParticles(velocityX, velocityY);
      let vx = velocityX * 1.4,
        vy = velocityY * 0.8;
      function step() {
        vx *= INERTIA_FRICTION;
        vy *= INERTIA_FRICTION;
        currentX += vx;
        currentY += vy;
        setT(currentX, currentY, true);
        if (Math.abs(vx) > 0.3 || Math.abs(vy) > 0.3) {
          inertiaRaf = requestAnimationFrame(step);
        } else {
          currentX = 0;
          currentY = 0;
          setT(0, 0, false);
        }
      }
      inertiaRaf = requestAnimationFrame(step);
    }
    el.addEventListener('mousedown', (e) => {
      grab(e.clientX, e.clientY);
      e.preventDefault();
    });
    window.addEventListener('mousemove', (e) => drag(e.clientX, e.clientY));
    window.addEventListener('mouseup', release);
    el.addEventListener('dblclick', () => {
      cancelAnimationFrame(inertiaRaf);
      currentX = 0;
      currentY = 0;
      setT(0, 0, false);
    });
    el.addEventListener(
      'touchstart',
      (e) => grab(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );
    el.addEventListener(
      'touchmove',
      (e) => drag(e.touches[0].clientX, e.touches[0].clientY),
      { passive: true }
    );
    el.addEventListener('touchend', release);
  }

  document.addEventListener('DOMContentLoaded', () => {
    initRevealAnimation();
    document
      .querySelectorAll<HTMLElement>('[data-draggable-card]')
      .forEach(makeDraggableCard);
  });
  document.addEventListener('astro:page-load', () => {
    initRevealAnimation();
    document
      .querySelectorAll<HTMLElement>('[data-draggable-card]')
      .forEach(makeDraggableCard);
  });
</script>
