---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCurrentLocale, getTranslations } from '../i18n/utils';

const locale = getCurrentLocale(Astro.url);
const t = getTranslations(locale);
const basePath = locale === 'zh-tw' ? '/zh-tw' : '/en';

/* ── Bio paragraphs ── */
const bioLong = locale === 'zh-tw'
  ? [
      '我的本名是顏榕嶙，台灣人。',
      '我並不想要被任何事物給拘束，而希望追求一個自由自在的環境。',
      '當然，聽起來還是天方夜譚，不過這也是我之所以繼續努力著的原因。',
      '有一個故事存活在我的心中，而對我而言，想辦法把這個故事給實現（無論使用甚麼辦法）就是我一直在追求的最終目標。',
      '因此，祝我好運吧。',
    ]
  : [
      'My name is Bernie Yen, from Taiwan.',
      "I don't want to be constrained by anything — I seek a free and open environment.",
      "Of course, it still sounds like a fantasy, but that's exactly why I keep pushing forward.",
      'A story lives in my heart, and bringing it to life — by whatever means necessary — is the ultimate goal I pursue.',
      'So wish me luck.',
    ];

const highlightPrimary = locale === 'zh-tw' ? '最終目標' : 'ultimate goal';
const highlightSecondary = locale === 'zh-tw' ? '自由自在的環境' : 'free and open environment';

/* ── Fact column ── */
const facts = [
  ['NAME', locale === 'zh-tw' ? '顏榕嶙 · Bernie Yen' : 'Bernie Yen · 顏榕嶙'],
  ['ROLE', locale === 'zh-tw' ? '全端工程師 / 創作者' : 'Full-stack Dev / Creator'],
  ['LOC',  'Taiwan · 高雄'],
  ['SINCE','2018'],
  ['EMAIL','ptyc4076@gmail.com'],
  ['GIT',  '@Unforgettableeternalproject'],
];

/* ── Skills ── */
const skills = [
  {
    id: '01',
    name: locale === 'zh-tw' ? '軟體設計／開發' : 'Software Development',
    en: 'Software',
    brief: 'Python · JavaScript · C# · Full-stack',
    description: locale === 'zh-tw'
      ? '這算是我的本業，從國中開始就在往程式設計的方向前進了，如今我已經做了很多個挺好看的專案，而我也不吝於將它們給展示於此。寫程式對我來說也是一種創作過程，主要是把想法給實現出來變成真正的作品、產品，以達到某個特定的目標。'
      : "This is my main craft. I've been heading toward software development since middle school, and by now I've built several projects that I'm happy to showcase here.",
    self: locale === 'zh-tw'
      ? '我無法說我已經對於這一塊爐火純青，但我也是對自己的能力挺有自信的，以這個網頁為例，我的確有辦法將自己所想的給實作出來。我熟悉的語言主要是 Python、JavaScript 以及一點 C#，如有建議請不吝指教！'
      : "I can't say I've mastered this field, but I'm fairly confident in my abilities. This very website is proof that I can implement what I envision.",
  },
  {
    id: '02',
    name: locale === 'zh-tw' ? '音樂創作' : 'Music Composition',
    en: 'Composition',
    brief: locale === 'zh-tw' ? '區域、角色、劇情主題曲 · 數十首' : 'Region, character & story themes',
    description: locale === 'zh-tw'
      ? '音樂對我來說就是一種傳遞故事的手段，從我國中起就對於作曲挺有興趣的，主要是有辦法把我心中的旋律給展現出來就有種成功解釋我的故事的感覺。實際上，我沒有學過樂器，對音樂理論的理解只限於高中音樂課，但誰知道呢？我認為這樣自己摸索也相當不錯。'
      : "Music is a way for me to convey stories. I've been interested in composing since middle school — expressing the melodies in my head feels like successfully explaining my stories.",
    self: locale === 'zh-tw'
      ? '俗話說練習是成功的根本，從最早以前到現在我堆積出的作品也已經有幾十首，因此我可以說即使不到專業等級，作為區域、角色和劇情的主題曲我個人認為是相當足夠的，當然可以的話我也希望能夠繼續精進自己。'
      : "Practice makes perfect — I've accumulated dozens of compositions by now. While not professional-level, they serve well as theme songs for regions, characters, and plot arcs.",
  },
  {
    id: '03',
    name: locale === 'zh-tw' ? '寫作' : 'Writing',
    en: 'Writing',
    brief: locale === 'zh-tw' ? '小說、設定文件、世界觀建構' : 'Novels, lore docs, worldbuilding',
    description: locale === 'zh-tw'
      ? '我時常在閒暇時期寫作，主要是我有一個完整的大綱在敘述整個故事，對我而言這些故事已經在我腦中存在很久了，因此我想要試著把這些故事用文字的方式給表達出來，基本上是寫小說。我一直在努力磨練我的文筆，為了呈現一個最完整、最詳細的敘述模式。'
      : "I write frequently in my spare time. I have a complete outline narrating the entire story — these stories have existed in my mind for a long time. I'm always working to polish my writing skills.",
    self: locale === 'zh-tw'
      ? '每次前進了一些道路之後驀然回首，總會感覺自己的過往並沒有太多的光采，並想要重新點繪，反而就一直在起點附近徘徊。我認為我對創作文章的熟練度一直在 0~100 之間徘徊，一個所謂的平衡總是飄忽不定。'
      : "Every time I look back after some progress, I feel the past lacks brilliance and want to repaint it, lingering near the starting point. My writing proficiency constantly fluctuates.",
  },
  {
    id: '04',
    name: locale === 'zh-tw' ? '像素繪圖' : 'Pixel Art',
    en: 'Pixel Art',
    brief: locale === 'zh-tw' ? '場景、人物、icon' : 'Scenes, characters, icons',
    description: locale === 'zh-tw'
      ? '我畫畫一直以來都不好，當然我也希望自己能夠學會繪圖，這樣很多腦中的人物和場景都可以被實際創作出來。慶幸的是，雖然我畫不了直線，而且構圖與上色都不太好，像素畫還算是在我可以掌握的範圍。'
      : "Drawing has never been my strong suit, but pixel art is within my reach. Through it, I can bring the characters and scenes in my mind to life.",
    self: locale === 'zh-tw'
      ? '美術是我的弱項，因此我不會說我畫得很好，但我並不會為我過去的作品感到羞愧，正是有那些零散的創作，我的故事才得以進展到如今這個地步，所以說，我會想辦法讓我的技藝更加精湛。'
      : "Art is my weakness, but I'm not ashamed of my past works — those scattered creations are what pushed my story forward to where it is today.",
  },
  {
    id: '05',
    name: locale === 'zh-tw' ? '剪輯 ＆ 混音' : 'Editing & Mixing',
    en: 'Edit & Mix',
    brief: 'Premiere · After Effects · Audition',
    description: locale === 'zh-tw'
      ? '由於我有經營 YouTube 頻道，因此有自學過一些基本的剪輯，主要以 Premiere 和 After Effect 為主，也經常用 Audition 去對我的雛型曲作一些快速混響和修整，雖然都是簡單的操作，但也足夠用了。'
      : "Since I run a YouTube channel, I've self-taught basic editing with Premiere and After Effects, and often use Audition for quick reverb and adjustments on my draft compositions.",
    self: locale === 'zh-tw'
      ? '當然比起剪輯專業或者大眾傳播等等要簡陋很多，我主要都是以作歌曲影片為主，但經過一段時間的學習我認為現在至少可以做出一些不錯的動畫跟解說影片。'
      : "Much simpler compared to professional editing, but after some learning I can at least produce decent animations and explanation videos.",
  },
];

/* ── Experience ── */
const experience = [
  {
    title: locale === 'zh-tw' ? '全端工程師' : 'Full-stack Engineer',
    company: locale === 'zh-tw' ? '佶昕智能' : 'JiXin AI',
    period: '2026/01 — 2026/07',
    location: 'Taiwan',
    description: locale === 'zh-tw'
      ? '作為工程師在這間公司工作了一段期間，主要負責官方平台的前／後端技術設計以及開發。'
      : "Worked as an engineer responsible for the full-stack design and development of the company's official platform.",
    stack: ['React', 'Node.js', 'PostgreSQL', 'Docker'],
    current: false,
  },
  {
    title: 'Lead Organizer',
    company: 'GDG on Campus · NKNU',
    period: '2024 — 2025',
    location: locale === 'zh-tw' ? '高雄師範大學' : 'NKNU, Kaohsiung',
    description: locale === 'zh-tw'
      ? '在校園內推動 GDG 社群，負責活動企劃、技術講座、教學內容設計與社群官網開發。'
      : 'Led the campus GDG community — event planning, tech talks, educational content, and community website development.',
    stack: ['Astro', 'TypeScript', 'Community'],
    current: false,
  },
];
---

<BaseLayout
  title={locale === 'zh-tw' ? '關於我 — 顏榕嶙' : 'About — Bernie Yen'}
  description={locale === 'zh-tw'
    ? '對我而言，有一個尚未完成的故事存在著。'
    : 'A story still being written — about me.'}
>

  <!-- ─────────── HERO ─────────── -->
  <section class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pt-20 sm:pt-24 lg:pt-[120px] pb-14 lg:pb-20 max-w-screen-xl mx-auto">
    <span class="q-section-label">
      —— 03 / about · {locale === 'zh-tw' ? '個人簡介' : 'personal profile'}
    </span>

    <h1
      class="mt-6 text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[112px] font-bold leading-[0.96] tracking-tighter max-w-[1100px]"
      style="color: var(--q-ink);"
    >
      {locale === 'zh-tw' ? (
        <>
          有一個<br />
          <span style="color: var(--q-navy); font-weight: 600;">尚未完成</span>的<br />
          故事存在著。
        </>
      ) : (
        <>
          A story <br />
          <span style="color: var(--q-navy); font-weight: 600;">not yet finished</span><br />
          exists.
        </>
      )}
    </h1>

    <div class="mt-10 lg:mt-14 grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-14 items-start">
      <p class="m-0 max-w-[580px] text-lg leading-[1.75]" style="color: var(--q-ink-soft);">
        {locale === 'zh-tw'
          ? '我的本名是顏榕嶙，台灣人。這頁是我給自己留下的一份備忘錄 — 也讓走過的人，對「顏榕嶙是誰」有更完整的印象。'
          : "My name is Bernie Yen, from Taiwan. This page is a memo I left for myself — and for anyone passing through, a fuller picture of who I am."}
      </p>

      <!-- Fact column -->
      <dl class="m-0">
        {facts.map(([k, v], i) => (
          <div
            class="grid items-baseline py-2.5"
            style={`
              grid-template-columns: 72px 1fr;
              gap: 16px;
              border-top: ${i === 0 ? '1px solid var(--q-line)' : '1px dashed var(--q-line)'};
              ${i === facts.length - 1 ? 'border-bottom: 1px solid var(--q-line);' : ''}
            `}
          >
            <span class="q-mono">{k}</span>
            <span class="text-sm font-mono" style="color: var(--q-ink); font-family: 'JetBrains Mono', monospace;">
              {v}
            </span>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ─────────── FULL BIO ─────────── -->
  <section class="px-4 sm:px-6 lg:px-10 xl:px-[72px] py-10 lg:py-[40px_72px_60px] max-w-[820px] mx-auto reveal">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 mb-9" style="border-bottom: 1px solid var(--q-line);">
      <div>
        <span class="q-section-label">—— 01 / full bio</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight leading-none" style="color: var(--q-ink);">
          {locale === 'zh-tw' ? '關於我' : 'About Me'}
        </h2>
      </div>
    </div>

    {bioLong.map((p) => {
      if (p.includes(highlightPrimary)) {
        const [before, after] = p.split(highlightPrimary);
        return (
          <p class="m-0 mb-5 text-lg leading-[1.9] reveal-item" style="color: var(--q-ink);">
            {before}<span style="font-style: italic; color: var(--q-navy); font-weight: 600; border-bottom: 1.5px solid var(--q-navy); padding-bottom: 1px;">{highlightPrimary}</span>{after}
          </p>
        );
      }
      if (p.includes(highlightSecondary)) {
        const [before, after] = p.split(highlightSecondary);
        return (
          <p class="m-0 mb-5 text-lg leading-[1.9] reveal-item" style="color: var(--q-ink);">
            {before}<span style="font-style: italic; color: var(--q-navy); font-weight: 500;">{highlightSecondary}</span>{after}
          </p>
        );
      }
      return (
        <p class="m-0 mb-5 text-lg leading-[1.9] reveal-item" style="color: var(--q-ink);">
          {p}
        </p>
      );
    })}
  </section>

  <!-- ─────────── SKILLS ─────────── -->
  <section class="px-4 sm:px-6 lg:px-10 xl:px-[72px] py-12 lg:py-[60px] max-w-screen-xl mx-auto reveal">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 mb-9" style="border-bottom: 1px solid var(--q-line);">
      <div>
        <span class="q-section-label">—— 02 / practice in detail</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight leading-none" style="color: var(--q-ink);">
          {locale === 'zh-tw' ? '技能與領域' : 'Skills & Domains'}
        </h2>
      </div>
      <span class="q-mono">{skills.length} domains</span>
    </div>

    <div>
      {skills.map((s, i) => (
        <article
          class="grid grid-cols-1 lg:grid-cols-[140px_1fr_1fr] gap-6 lg:gap-12 py-7 lg:py-9 reveal-item"
          style={`
            border-top: 1px solid var(--q-line);
            ${i === skills.length - 1 ? 'border-bottom: 1px solid var(--q-line);' : ''}
          `}
        >
          <!-- ID + Name -->
          <div>
            <div
              class="text-5xl lg:text-[68px] font-mono leading-[0.85] tracking-tighter"
              style="color: var(--q-ink-fade); font-weight: 400;"
            >{s.id}</div>
            <h4 class="mt-4 text-xl lg:text-[22px] font-bold tracking-tight" style="color: var(--q-ink); margin-bottom: 4px;">
              {s.name}
            </h4>
            <div class="text-sm italic font-medium" style="color: var(--q-navy);">{s.en}</div>
            <div class="mt-3">
              <span class="q-mono">{s.brief}</span>
            </div>
          </div>

          <!-- Description -->
          <div>
            <span class="q-mono" style="color: var(--q-navy);">description</span>
            <p class="mt-2.5 text-sm leading-[1.8]" style="color: var(--q-ink); margin: 10px 0 0;">
              {s.description}
            </p>
          </div>

          <!-- Self-assessment -->
          <div>
            <span class="q-mono" style="color: var(--q-navy);">self-assessment</span>
            <p class="mt-2.5 text-sm leading-[1.8] italic" style="color: var(--q-ink-soft); margin: 10px 0 0;">
              {s.self}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ─────────── EXPERIENCE ─────────── -->
  <section class="px-4 sm:px-6 lg:px-10 xl:px-[72px] py-12 lg:py-[60px] max-w-screen-xl mx-auto reveal">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 mb-9" style="border-bottom: 1px solid var(--q-line);">
      <div>
        <span class="q-section-label">—— 03 / experience</span>
        <h2 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight leading-none" style="color: var(--q-ink);">
          {locale === 'zh-tw' ? '經歷' : 'Experience'}
        </h2>
      </div>
    </div>

    <div>
      {experience.map((e, i) => (
        <div
          class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-5 md:gap-10 py-7 md:py-8 reveal-item"
          style={`border-top: 1px solid var(--q-line);`}
        >
          <!-- Period + Location -->
          <div>
            <span class="q-mono" style={`color: ${i === 0 ? 'var(--q-navy)' : 'var(--q-ink-soft)'};`}>
              {e.period}
            </span>
            <div class="mt-1.5 text-sm" style="color: var(--q-ink-soft);">{e.location}</div>
            {e.current && (
              <div class="mt-3 flex items-center gap-2">
                <span class="q-live-dot" style="width: 8px; height: 8px;"></span>
                <span class="q-mono" style="color: var(--q-coral);">current</span>
              </div>
            )}
          </div>

          <!-- Content -->
          <div>
            <h4 class="text-xl md:text-2xl font-bold tracking-tight" style="color: var(--q-ink); margin: 0;">
              {e.title}
              <span class="ml-3 text-lg font-medium italic" style="color: var(--q-navy);">@ {e.company}</span>
            </h4>
            <p class="mt-3 mb-4 text-[15px] leading-[1.7]" style="color: var(--q-ink-soft);">
              {e.description}
            </p>
            <div class="flex gap-1.5 flex-wrap">
              {e.stack.map((tag) => (
                <span class="q-pill">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ─────────── CTA ─────────── -->
  <section class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pt-10 pb-20 lg:pb-[120px] max-w-screen-xl mx-auto">
    <div
      class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-14 items-end pt-14"
      style="border-top: 1px solid var(--q-line);"
    >
      <div>
        <span class="q-section-label">
          —— 04 / reach out
        </span>
        <h3
          class="mt-3.5 text-4xl lg:text-[56px] font-bold tracking-tight leading-none"
          style="color: var(--q-ink);"
        >
          {locale === 'zh-tw' ? '想聊聊？' : "Let's talk?"}
        </h3>
        <p class="mt-3.5 text-base leading-[1.7] max-w-[480px]" style="color: var(--q-ink-soft);">
          {locale === 'zh-tw'
            ? '不論程式、音樂、文字、像素 — 只要跟「故事」沾上邊，我都想聽。'
            : "Code, music, words, pixels — if it has anything to do with 'story', I want to hear it."}
        </p>
      </div>

      <div class="flex flex-col">
        <a
          href={`mailto:ptyc4076@gmail.com`}
          class="flex justify-between items-center px-5 py-4 text-[15px] font-semibold no-underline"
          style="background: var(--q-ink); color: var(--q-paper);"
        >
          <span>{locale === 'zh-tw' ? '寄信' : 'Email'} →</span>
          <span class="font-mono text-xs opacity-70" style="font-family: 'JetBrains Mono', monospace;">ptyc4076@gmail.com</span>
        </a>
        <a
          href="https://github.com/Unforgettableeternalproject"
          target="_blank"
          rel="noopener noreferrer"
          class="flex justify-between items-center px-5 py-4 text-[15px] font-medium no-underline"
          style="background: var(--q-paper); color: var(--q-ink); border: 1px solid var(--q-line); border-top: none;"
        >
          <span>GitHub →</span>
          <span class="font-mono text-xs opacity-70" style="font-family: 'JetBrains Mono', monospace;">@Unforgettableeternalproject</span>
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  function initRevealAnimation() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('reveal-visible');
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
    );

    document.querySelectorAll('.reveal-item').forEach((el) => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', initRevealAnimation);
  document.addEventListener('astro:page-load', initRevealAnimation);
</script>
