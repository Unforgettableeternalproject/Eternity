---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCurrentLocale, getTranslations } from '../i18n/utils';
import { getEntry } from 'astro:content';
import AboutBioTypewriter from '../components/AboutBioTypewriter';
import SkillsGrid from '../components/SkillsGrid';

const locale = getCurrentLocale(Astro.url);
const t = getTranslations(locale);

// 根據語言載入對應的關於內容
const aboutKey = locale === 'zh-tw' ? 'about-zh' : 'about-en';
const aboutData = await getEntry(aboutKey, 'index');

// 準備 fullBio 內容（支援 HTML）
const bioContent = aboutData?.data.fullBio || aboutData?.data.bio || '';
const hasBioContent = Boolean(bioContent && bioContent.trim());

// 處理技能資料：將舊格式（字串陣列）轉換為新格式（物件陣列）
const skills =
  aboutData?.data.skills?.map((skill) =>
    typeof skill === 'string' ? { name: skill } : skill
  ) || [];
---

<BaseLayout title={t.about.title} description={t.about.description}>
  <div class="relative py-24">
    <!-- 幾何裝飾 -->
    <div class="container-custom relative z-10">
      <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="text-center space-y-6 mb-16 animate-fade-in-up">
          <h1 class="text-5xl font-bold text-slate-900 dark:text-white">
            {aboutData?.data.title || t.about.heading}
          </h1>
          <p class="text-xl text-slate-600 dark:text-slate-300">
            {aboutData?.data.bio || t.about.subtitle}
          </p>

          {/* 聯絡我按鈕 */}
          {
            aboutData?.data.social?.email && (
              <div class="flex justify-center gap-4 pt-2">
                <a
                  href={`/${locale}/contact`}
                  class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-primary-500 to-secondary-500 text-white rounded-lg hover:from-primary-600 hover:to-secondary-600 transition-all duration-200 hover:shadow-lg hover:scale-105"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    />
                  </svg>
                  {locale === 'zh-tw' ? '聯絡我' : 'Contact Me'}
                </a>
                {aboutData?.data.social?.github && (
                  <a
                    href={aboutData.data.social.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-6 py-3 bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 rounded-lg hover:bg-slate-800 dark:hover:bg-slate-200 transition-all duration-200 hover:shadow-lg"
                  >
                    <svg
                      class="w-5 h-5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                        clip-rule="evenodd"
                      />
                    </svg>
                    GitHub
                  </a>
                )}
              </div>
            )
          }
        </div>

        {
          aboutData ? (
            <>
              {/* Profile Section */}
              <div class="flex flex-col md:flex-row gap-12 items-center mb-16 animation-delay-200 animate-fade-in-up">
                {/* Profile Image */}
                {aboutData.data.avatar && (
                  <div class="w-full md:w-1/3">
                    <img
                      src={aboutData.data.avatar}
                      alt={aboutData.data.title}
                      width={400}
                      height={400}
                      class="aspect-square rounded-2xl object-cover border border-slate-200/50 dark:border-slate-700/50"
                    />
                  </div>
                )}

                {/* Bio Content */}
                <div class="w-full md:w-2/3">
                  {hasBioContent ? (
                    <AboutBioTypewriter
                      client:load
                      content={bioContent}
                      speed={20}
                      delay={300}
                    />
                  ) : (
                    <p class="text-lg leading-relaxed text-slate-600 dark:text-slate-400">
                      {locale === 'zh-tw'
                        ? '尚未添加完整自我介紹'
                        : 'No bio added yet'}
                    </p>
                  )}
                </div>
              </div>

              {/* Skills Section */}
              {skills && skills.length > 0 && (
                <div class="mb-16 animation-delay-400 animate-fade-in-up">
                  <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-8">
                    {t.about.skills}
                  </h2>
                  <SkillsGrid client:load skills={skills} locale={locale} />
                </div>
              )}

              {/* Experience Section */}
              <div class="mb-16 animation-delay-500 animate-fade-in-up">
                <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-8">
                  {t.about.experience}
                </h2>
                {(aboutData.data as any).experience &&
                (aboutData.data as any).experience.length > 0 ? (
                  <div class="space-y-6">
                    {(aboutData.data as any).experience.map((exp: any) => (
                      <div class="p-6 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl hover:shadow-lg transition-shadow duration-200">
                        <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-3">
                          <h3 class="text-xl font-bold text-slate-900 dark:text-white">
                            {exp.title}
                          </h3>
                          <span class="text-sm font-medium text-primary-600 dark:text-primary-400 mt-1 md:mt-0">
                            {exp.period}
                          </span>
                        </div>
                        <p class="text-lg font-medium text-slate-700 dark:text-slate-300 mb-3">
                          {exp.company}
                        </p>
                        {exp.description && (
                          <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
                            {exp.description}
                          </p>
                        )}
                      </div>
                    ))}
                  </div>
                ) : (
                  <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                    {locale === 'zh-tw'
                      ? '尚未添加工作經歷'
                      : 'No experience added yet'}
                  </div>
                )}
              </div>

              {/* Certifications Section */}
              <div class="mb-16 animation-delay-600 animate-fade-in-up">
                <h2 class="text-3xl font-bold text-slate-900 dark:text-white mb-8">
                  {t.about.certifications}
                </h2>
                {(aboutData.data as any).certifications &&
                (aboutData.data as any).certifications.length > 0 ? (
                  <div class="grid md:grid-cols-2 gap-4">
                    {(aboutData.data as any).certifications.map((cert: any) => (
                      <div class="p-5 bg-gradient-to-br from-primary-50 to-secondary-50 dark:from-primary-950/30 dark:to-secondary-950/30 border border-primary-200 dark:border-primary-800 rounded-xl hover:shadow-md transition-all duration-200">
                        <div class="flex items-start justify-between mb-2">
                          <h3 class="text-lg font-bold text-slate-900 dark:text-white pr-2">
                            {cert.name}
                          </h3>
                          {cert.link && (
                            <a
                              href={cert.link}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="flex-shrink-0 text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300"
                              aria-label={
                                locale === 'zh-tw'
                                  ? '查看證書'
                                  : 'View Certificate'
                              }
                            >
                              <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                                />
                              </svg>
                            </a>
                          )}
                        </div>
                        <p class="text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
                          {cert.issuer}
                        </p>
                        {cert.date && (
                          <p class="text-sm text-slate-600 dark:text-slate-400">
                            {cert.date}
                          </p>
                        )}
                      </div>
                    ))}
                  </div>
                ) : (
                  <div class="text-center py-8 text-slate-500 dark:text-slate-400">
                    {locale === 'zh-tw'
                      ? '尚未添加證照與認證'
                      : 'No certifications added yet'}
                  </div>
                )}
              </div>
            </>
          ) : (
            <div class="text-center py-20 animate-fade-in-up">
              {/* Empty State */}
              <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                <svg
                  class="w-12 h-12 text-slate-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                  />
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-2">
                {t.about.notSet}
              </h3>
              <p class="text-slate-600 dark:text-slate-300 mb-6">
                {locale === 'zh-tw'
                  ? '請前往後台新增您的個人資料'
                  : 'Please add your profile in the admin panel'}
              </p>
              <a href="/keystatic" class="btn btn-primary">
                {t.about.goToAdmin}
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>
