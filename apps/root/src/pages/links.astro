---
import BaseLayout from '../layouts/BaseLayout.astro';

const links = [
  {
    title: 'GitHub',
    url: 'https://github.com/unforgettableeternalproject',
    description: 'My open source projects and contributions',
  },
  {
    title: 'UEP Documentation',
    url: 'https://uep.unforgettableeternalproject.com',
    description: 'Technical documentation and creative writings',
  },
];
---

<BaseLayout title="Links - UEP Online" description="Find all my important links here">
  <div class="links-page">
    <h1>Important Links</h1>
    <p class="intro-text">
      Here are some useful links to my projects and profiles across the web.
    </p>

    <div class="link-grid">
      {
        links.map((link) => (
          <a href={link.url} class="link-card" target="_blank" rel="noopener noreferrer">
            <h2>{link.title} →</h2>
            <p>{link.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .links-page {
    max-width: 900px;
    margin: 0 auto;
  }
  h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--black);
  }
  .intro-text {
    font-size: 1.125rem;
    color: var(--gray-dark);
    margin-bottom: 2rem;
  }
  .link-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }
  .link-card {
    display: block;
    padding: 1.5rem;
    background: var(--gray-light);
    border: 1px solid var(--gray);
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--black);
    transition: all 0.2s;
  }
  .link-card:hover {
    border-color: var(--accent);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.15);
    transform: translateY(-2px);
  }
  .link-card h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--accent);
  }
  .link-card p {
    color: var(--gray-dark);
    line-height: 1.5;
  }
</style>
