---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCurrentLocale } from '../i18n/utils';
import { getLinks, getSingleton } from '../lib/api';
import { normalizeColors } from '../lib/color-normalize';

export const prerender = false;

const locale = getCurrentLocale(Astro.url);
const basePath = locale === 'zh-tw' ? '/zh-tw' : '/en';

/* ── 頁面文字從 D1 讀取 ── */
const ptKey = locale === 'zh-tw' ? 'page-links-zh' : 'page-links-en';
const ptRaw = await getSingleton(ptKey);
const pt = (ptRaw?.content ?? {}) as Record<string, string>;

const allLinksRaw = await getLinks();
const sorted = allLinksRaw
  .map((l) => ({
    id: l.id,
    data: {
      title_zh: l.titleZh,
      title_en: l.titleEn,
      description_zh: l.descZh,
      description_en: l.descEn,
      url: l.url,
      category: l.category,
      status: l.status,
      icon: l.icon,
      featured: l.featured,
      order: l.sortOrder,
    },
  }))
  .sort((a, b) => {
    // featured 排最前
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    // normal 排在 unmaintained/deprecated 前面
    const statusRank = { normal: 0, unmaintained: 1, deprecated: 2 };
    const sa = statusRank[a.data.status as keyof typeof statusRank] ?? 0;
    const sb = statusRank[b.data.status as keyof typeof statusRank] ?? 0;
    if (sa !== sb) return sa - sb;
    return (a.data.order || 999) - (b.data.order || 999);
  });

/* Group by category */
const categoryOrder = ['social', 'work', 'creative', 'other'];
const groups: { name: string; en: string; items: typeof sorted }[] = [];

const categoryMeta: Record<string, { name: string; en: string }> = {
  social: {
    name: locale === 'zh-tw' ? '社群' : 'Social',
    en: 'social & contact',
  },
  work: { name: locale === 'zh-tw' ? '工作' : 'Work', en: 'work & code' },
  creative: {
    name: locale === 'zh-tw' ? '創作' : 'Creative',
    en: 'music · video · art',
  },
  other: { name: locale === 'zh-tw' ? '其他' : 'Other', en: 'miscellaneous' },
};

for (const cat of categoryOrder) {
  const items = sorted.filter((l) => (l.data.category || 'other') === cat);
  if (items.length > 0) {
    const meta = categoryMeta[cat] || { name: cat, en: cat };
    groups.push({ name: meta.name, en: meta.en, items });
  }
}
---

<BaseLayout
  title={locale === 'zh-tw' ? '連結 — 顏榕嶙' : 'Links — Bernie Yen'}
  description={locale === 'zh-tw' ? '你能在哪裡找到我。' : 'Where to find me.'}
>
  <!-- ─────────── HERO ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pt-16 sm:pt-20 lg:pt-[100px] pb-12 lg:pb-[60px] max-w-screen-xl mx-auto"
  >
    <span class="q-section-label">
      {
        pt.heroLabel ||
          (locale === 'zh-tw'
            ? '—— 04 / links · 對外連結'
            : '—— 04 / links · external links')
      }
    </span>

    <h1
      class="mt-6 text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[96px] font-bold leading-[0.97] tracking-tighter max-w-[1100px]"
      style="color: var(--q-ink);"
      set:html={normalizeColors(
        pt.heroTitle ||
          (locale === 'zh-tw'
            ? '你能在<br /><span style="color: var(--q-navy); font-weight: 600;">哪裡</span>找到我。'
            : 'Where to<br /><span style="color: var(--q-navy); font-weight: 600;">find</span> me.')
      )}
    />

    <div
      class="mt-10 lg:mt-12 grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-14 items-end"
    >
      <p
        class="m-0 max-w-[540px] text-[17px] leading-[1.7]"
        style="color: var(--q-ink-soft);"
      >
        {
          pt.heroSubtitle ||
            (locale === 'zh-tw'
              ? '所有對外連結都收在這頁 — 程式、創作、世界觀、夥伴與聯絡方式。一個 hub，少一點四散。'
              : 'All external links are collected here — code, creative, worldbuilding, allies and contact. One hub, less scattering.')
        }
      </p>
      <div>
        <span class="q-mono">jump to</span>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {
            groups.map((g, i) => (
              <a
                href={`#group-${i}`}
                class="q-pill no-underline hover:opacity-75 transition-opacity"
              >
                <span style="color: var(--q-navy);">
                  {String(i + 1).padStart(2, '0')}
                </span>
                {g.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────── GROUPS ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] py-10 lg:py-[40px] max-w-screen-xl mx-auto"
  >
    {
      groups.map((g, gi) => (
        <div
          id={`group-${gi}`}
          class="mb-12 lg:mb-16 reveal"
          style="scroll-margin-top: 100px;"
        >
          {/* Group header */}
          <div
            class="grid grid-cols-1 md:grid-cols-[180px_1fr_auto] gap-4 md:gap-9 items-baseline mb-5 pb-3.5"
            style="border-bottom: 1px solid var(--q-line);"
          >
            <div
              class="font-mono text-2xl md:text-[32px] tracking-tight leading-none"
              style="color: var(--q-navy); font-weight: 400;"
            >
              {String(gi + 1).padStart(2, '0')}
            </div>
            <div>
              <span class="q-mono">{g.en}</span>
              <h2
                class="mt-1.5 text-2xl md:text-4xl font-bold tracking-tight leading-[1.05]"
                style="color: var(--q-ink);"
              >
                {g.name}
              </h2>
            </div>
            <span class="q-mono">
              {g.items.length} {g.items.length === 1 ? 'entry' : 'entries'}
            </span>
          </div>

          {/* Cards */}
          <div class="grid grid-cols-1 md:grid-cols-[180px_1fr] gap-0 md:gap-9">
            <div class="hidden md:block" />
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {g.items.map((it) => {
                const linkTitle =
                  locale === 'zh-tw'
                    ? it.data.title_zh || it.id
                    : it.data.title_en;
                const linkDesc =
                  locale === 'zh-tw'
                    ? it.data.description_zh
                    : it.data.description_en;
                const initial = linkTitle?.[0] || '?';
                const st = it.data.status || 'normal';
                const isDeprecated = st === 'deprecated';
                const isUnmaintained = st === 'unmaintained';
                const isInactive = isDeprecated || isUnmaintained;

                // 狀態標籤文字
                const statusLabel = isDeprecated
                  ? locale === 'zh-tw'
                    ? '已棄用'
                    : 'DEPRECATED'
                  : isUnmaintained
                    ? locale === 'zh-tw'
                      ? '未維護'
                      : 'UNMAINTAINED'
                    : null;

                return (
                  <a
                    href={it.data.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block no-underline flex flex-col gap-1.5 p-5 lg:p-[22px] relative reveal-item group"
                    style={`background: var(--q-paper); color: inherit; transition: border-color 0.15s, opacity 0.15s; ${
                      isDeprecated
                        ? 'border: 1px dashed var(--q-line); opacity: 0.5;'
                        : isUnmaintained
                          ? 'border: 1px solid var(--q-line); opacity: 0.65;'
                          : 'border: 1px solid var(--q-line);'
                    }`}
                  >
                    {/* 狀態標籤 */}
                    {statusLabel && (
                      <span
                        class="absolute top-0 right-0 font-mono text-[9px] tracking-[0.12em] uppercase px-2 py-1"
                        style={`color: ${isDeprecated ? 'var(--q-coral)' : 'var(--q-ink-mute)'}; background: var(--q-paper-soft); border-left: 1px ${isDeprecated ? 'dashed' : 'solid'} var(--q-line); border-bottom: 1px ${isDeprecated ? 'dashed' : 'solid'} var(--q-line);`}
                      >
                        {statusLabel}
                      </span>
                    )}

                    <div class="flex items-center gap-3">
                      <div
                        class="w-[34px] h-[34px] grid place-items-center text-base font-bold shrink-0"
                        style={`border: 1px solid var(--q-line); background: var(--q-paper-soft); border-radius: 8px; color: ${isInactive ? 'var(--q-ink-mute)' : 'var(--q-ink)'};`}
                      >
                        {initial}
                      </div>
                      <div class="min-w-0">
                        <div
                          class="text-[15px] font-bold tracking-tight group-hover:opacity-75 transition-opacity"
                          style={`color: ${isInactive ? 'var(--q-ink-soft)' : 'var(--q-ink)'};`}
                        >
                          {linkTitle}
                          {it.data.featured && (
                            <span
                              class="ml-1.5 text-xs q-mono"
                              style="color: var(--q-navy); vertical-align: middle;"
                            >
                              ✦
                            </span>
                          )}
                        </div>
                        <span class="q-mono truncate block">
                          {it.data.url
                            ?.replace('https://', '')
                            .replace('mailto:', '')}
                        </span>
                      </div>
                    </div>

                    {linkDesc && (
                      <p
                        class="mt-2 text-[13.5px] leading-[1.65] flex-1"
                        style="color: var(--q-ink-soft);"
                      >
                        {linkDesc}
                      </p>
                    )}

                    <div
                      class="mt-2.5 pt-3 flex justify-between items-center"
                      style="border-top: 1px dashed var(--q-line);"
                    >
                      <span
                        class="font-mono text-[11px] truncate"
                        style="color: var(--q-ink-soft);"
                      >
                        {it.data.url?.replace('https://', '').slice(0, 30)}
                      </span>
                      <span class="text-sm" style="color: var(--q-navy);">
                        ↗
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <!-- ─────────── CTA ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pb-20 lg:pb-[120px] max-w-screen-xl mx-auto"
  >
    <div
      class="grid grid-cols-1 md:grid-cols-[auto_1fr_auto] gap-6 md:gap-9 items-center pt-12"
      style="border-top: 1px solid var(--q-line);"
    >
      <div
        class="hidden md:block font-mono text-6xl lg:text-[78px] leading-[0.85] tracking-tighter"
        style="color: var(--q-navy); font-weight: 400;"
      >
        ?
      </div>
      <div>
        <span class="q-section-label">—— also</span>
        <h3
          class="mt-2 text-xl md:text-2xl font-bold tracking-tight"
          style="color: var(--q-ink);"
        >
          {
            pt.bottomTitle ||
              (locale === 'zh-tw'
                ? '有些東西還沒放上來'
                : 'Some things are not listed yet')
          }
        </h3>
        <p
          class="mt-1.5 text-sm leading-[1.65] max-w-[580px]"
          style="color: var(--q-ink-soft);"
        >
          {
            pt.bottomSubtitle ||
              (locale === 'zh-tw'
                ? 'Bandcamp / itch.io / 某些 deprecated 的舊作 — 都還在整理。如果你在找特定東西，直接寫信問會更快。'
                : 'Bandcamp, itch.io, and some deprecated old works are still being organized. If you are looking for something specific, email me directly.')
          }
        </p>
      </div>
      <a
        href={`${basePath}/contact`}
        class="text-sm font-medium no-underline transition-opacity hover:opacity-70"
        style="color: var(--q-ink); border-bottom: 1.5px solid var(--q-navy); padding-bottom: 3px;"
      >
        {locale === 'zh-tw' ? '寫信問' : 'Ask via email'} →
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  function initRevealAnimation() {
    const prefersReduced = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    if (prefersReduced) return;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const e of entries)
          if (e.isIntersecting) e.target.classList.add('reveal-visible');
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
    );
    document
      .querySelectorAll('.reveal-item')
      .forEach((el) => observer.observe(el));
  }
  document.addEventListener('DOMContentLoaded', initRevealAnimation);
  document.addEventListener('astro:page-load', initRevealAnimation);
</script>
