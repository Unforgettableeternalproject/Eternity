---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCurrentLocale } from '../../i18n/utils';
import { getProject, getProjects, assetUrl } from '../../lib/api';
import { normalizeColors } from '../../lib/color-normalize';

export const prerender = false;

const locale = getCurrentLocale(Astro.url);
const basePath = locale === 'zh-tw' ? '/zh-tw' : '/en';

const slug = Astro.params.slug!;
const projectRaw = await getProject(slug);
if (!projectRaw) return Astro.redirect(`${basePath}/projects`);

/* Map API shape to template-friendly shape */
const toLocal = (p: typeof projectRaw) => ({
  id: p.id,
  data: {
    title_zh: p.titleZh,
    title_en: p.titleEn,
    description_zh: p.descZh,
    description_en: p.descEn,
    tags: p.tags,
    featured: p.featured,
    order: p.sortOrder,
    status: p.status,
    image: p.image,
    links: p.links,
    startDate: p.startDate ? new Date(p.startDate) : null,
    endDate: p.endDate ? new Date(p.endDate) : null,
    content_zh: p.contentZh,
    content_en: p.contentEn,
  },
});

const project = toLocal(projectRaw);

const allRaw = await getProjects();
const sorted = allRaw
  .map(toLocal)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
const idx = sorted.findIndex((p) => p.id === project.id);
const prev = idx > 0 ? sorted[idx - 1] : null;
const next = idx < sorted.length - 1 ? sorted[idx + 1] : null;
const related = sorted.filter((p) => p.id !== project.id).slice(0, 3);

const title =
  locale === 'zh-tw'
    ? project.data.title_zh || project.id
    : project.data.title_en;
const desc =
  locale === 'zh-tw'
    ? project.data.description_zh
    : project.data.description_en;
const year = project.data.startDate
  ? project.data.startDate.getFullYear() + '—'
  : '—';
const orderStr = String(project.data.order || idx + 1).padStart(2, '0');
const contentText =
  locale === 'zh-tw' ? project.data.content_zh : project.data.content_en;
---

<BaseLayout
  title={`${title} — ${locale === 'zh-tw' ? '顏榕嶙' : 'Bernie Yen'}`}
  description={desc || ''}
>
  <!-- ─────────── BREADCRUMB ─────────── -->
  <div
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] py-3.5 flex items-center gap-2.5"
    style="border-bottom: 1px solid var(--q-line); background: var(--q-paper-soft);"
  >
    <a
      href={`${basePath}/projects`}
      class="q-mono no-underline"
      style="color: var(--q-ink-mute);">~/projects</a
    >
    <span style="color: var(--q-ink-mute);">/</span>
    <span class="q-mono" style="color: var(--q-ink);">{project.id}</span>
  </div>

  <!-- ─────────── HERO ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pt-14 lg:pt-20 pb-10 lg:pb-[50px] max-w-screen-xl mx-auto"
  >
    <div class="flex items-center gap-3 flex-wrap mb-6 lg:mb-7">
      {
        project.data.featured && (
          <span class="q-pill q-pill--accent">✦ featured</span>
        )
      }
      <span class="q-pill">{project.data.status}</span>
      <span class="q-mono">{year}</span>
    </div>

    <h1
      class="text-4xl sm:text-5xl lg:text-[60px] font-bold leading-[1.08] tracking-tight mb-4"
      style="color: var(--q-ink);"
    >
      {title}
    </h1>

    {
      desc && (
        <div
          class="text-xl lg:text-2xl italic mb-8 lg:mb-9"
          style="color: var(--q-ink-soft); font-weight: 400;"
        >
          — {desc}
        </div>
      )
    }

    <div
      class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-14 items-start"
    >
      <p
        class="m-0 text-lg leading-[1.75] max-w-[580px]"
        style="color: var(--q-ink);"
      >
        {desc}
      </p>
      <div class="flex flex-col gap-0">
        {
          project.data.links?.website && (
            <a
              href={project.data.links.website}
              target="_blank"
              rel="noopener noreferrer"
              class="flex justify-between items-baseline px-4 py-3.5 text-sm font-semibold no-underline"
              style="background: var(--q-ink); color: var(--q-paper);"
            >
              <span>↗ Live</span>
              <span
                class="font-mono text-[11px] opacity-70"
                style="font-family: 'JetBrains Mono', monospace;"
              >
                {project.data.links.website.replace('https://', '')}
              </span>
            </a>
          )
        }
        {
          project.data.links?.github && (
            <a
              href={project.data.links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex justify-between items-baseline px-4 py-3.5 text-sm font-semibold no-underline"
              style={`background: transparent; color: var(--q-ink); border: 1px solid var(--q-line); ${project.data.links?.website ? 'border-top: none;' : ''}`}
            >
              <span>⌥ GitHub</span>
              <span
                class="font-mono text-[11px] opacity-70"
                style="font-family: 'JetBrains Mono', monospace;"
              >
                {project.data.links.github.replace('https://', '')}
              </span>
            </a>
          )
        }
        {
          project.data.links?.demo && (
            <a
              href={project.data.links.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="flex justify-between items-baseline px-4 py-3.5 text-sm font-semibold no-underline"
              style="background: transparent; color: var(--q-ink); border: 1px solid var(--q-line); border-top: none;"
            >
              <span>▶ Demo</span>
              <span
                class="font-mono text-[11px] opacity-70"
                style="font-family: 'JetBrains Mono', monospace;"
              >
                {project.data.links.demo.replace('https://', '')}
              </span>
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- cover 只顯示在列表頁（projects.astro），詳細頁不顯示 -->

  <!-- ─────────── META BAR ─────────── -->
  <section
    style="border-top: 1px solid var(--q-line); border-bottom: 1px solid var(--q-line); background: var(--q-paper-soft);"
  >
    <div
      class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-10 xl:px-[72px] py-6 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6"
    >
      {
        [
          [
            'STATUS',
            project.data.status,
            project.data.status === 'active' ? 'var(--q-navy)' : 'var(--q-ink)',
          ],
          [
            'STARTED',
            project.data.startDate
              ? `${project.data.startDate.getFullYear()} / ${String(project.data.startDate.getMonth() + 1).padStart(2, '0')}`
              : '—',
            'var(--q-ink)',
          ],
          ['ORDER', orderStr, 'var(--q-ink)'],
          ['TAGS', `${project.data.tags.length} tags`, 'var(--q-ink)'],
          [
            'FEATURED',
            project.data.featured ? 'Yes' : 'No',
            project.data.featured ? 'var(--q-navy)' : 'var(--q-ink)',
          ],
        ].map(([k, v, color], i) => (
          <div
            style={
              i > 0
                ? `border-left: 1px solid var(--q-line); padding-left: 20px;`
                : ''
            }
            class={i > 0 ? 'hidden sm:block' : ''}
          >
            <span class="q-mono">{k}</span>
            <div
              class="mt-1.5 text-[15px] font-semibold tracking-tight"
              style={`color: ${color};`}
            >
              {v}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ─────────── CONTENT + SIDEBAR ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] py-16 lg:py-24 max-w-screen-xl mx-auto"
  >
    <div class="grid grid-cols-1 lg:grid-cols-[1.7fr_1fr] gap-12 lg:gap-20">
      <!-- Main -->
      <article>
        <div
          class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 mb-9"
          style="border-bottom: 1px solid var(--q-line);"
        >
          <div>
            <span class="q-section-label">—— 01 / overview</span>
            <h2
              class="mt-2 text-3xl md:text-4xl font-bold tracking-tight leading-none"
              style="color: var(--q-ink);"
            >
              {locale === 'zh-tw' ? '專案總覽' : 'Overview'}
            </h2>
          </div>
        </div>

        {
          contentText ? (
            <div class="q-prose" set:html={normalizeColors(contentText)} />
          ) : desc ? (
            <p class="text-[17.5px] leading-[1.9]" style="color: var(--q-ink);">
              {desc}
            </p>
          ) : (
            <p class="text-sm italic" style="color: var(--q-ink-mute);">
              {locale === 'zh-tw'
                ? '尚未撰寫詳細內容。'
                : 'No detailed content yet.'}
            </p>
          )
        }
      </article>

      <!-- Sidebar -->
      <aside class="lg:sticky lg:top-28 self-start flex flex-col gap-10">
        <div>
          <span class="q-section-label">—— tech stack</span>
          <h4
            class="mt-2.5 text-xl font-bold tracking-tight"
            style="color: var(--q-ink);"
          >
            {locale === 'zh-tw' ? '使用技術' : 'Tech Stack'}
          </h4>
          <div class="mt-3.5 flex flex-wrap gap-1.5">
            {
              project.data.tags.map((tag: string) => (
                <span class="q-pill">{tag}</span>
              ))
            }
          </div>
        </div>

        <div>
          <span class="q-section-label">—— quick info</span>
          <h4
            class="mt-2.5 text-xl font-bold tracking-tight"
            style="color: var(--q-ink);"
          >
            {locale === 'zh-tw' ? '速覽' : 'Quick Info'}
          </h4>
          <div class="mt-3.5">
            {
              [
                ['ID', orderStr],
                ['YEAR', year],
                ['STATUS', project.data.status],
                [
                  'SCOPE',
                  locale === 'zh-tw' ? '個人 · solo' : 'Personal · solo',
                ],
              ].map(([k, v], i) => (
                <div
                  class="grid items-baseline py-3"
                  style={`grid-template-columns: auto 1fr; gap: 16px; ${i > 0 ? 'border-top: 1px solid var(--q-line);' : ''}`}
                >
                  <span class="q-mono">{k}</span>
                  <span
                    class="text-[13px] text-right"
                    style="color: var(--q-ink); font-family: 'JetBrains Mono', monospace;"
                  >
                    {v}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ─────────── RELATED ─────────── -->
  {
    related.length > 0 && (
      <section class="px-4 sm:px-6 lg:px-10 xl:px-[72px] py-10 lg:py-[40px] max-w-screen-xl mx-auto">
        <div
          class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 mb-9"
          style="border-bottom: 1px solid var(--q-line);"
        >
          <div>
            <span class="q-section-label">—— related</span>
            <h2
              class="mt-2 text-3xl md:text-4xl font-bold tracking-tight leading-none"
              style="color: var(--q-ink);"
            >
              {locale === 'zh-tw' ? '相關作品' : 'Related Projects'}
            </h2>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
          {related.map((rp) => {
            const rpTitle =
              locale === 'zh-tw' ? rp.data.title_zh || rp.id : rp.data.title_en;
            return (
              <a
                href={`${basePath}/projects/${rp.id}`}
                class="block no-underline group"
              >
                <div
                  class="q-plate"
                  style="aspect-ratio: 16/10; overflow: hidden;"
                >
                  {rp.data.image ? (
                    <img
                      src={assetUrl(rp.data.image)}
                      alt={rpTitle}
                      loading="lazy"
                    />
                  ) : (
                    <div style="position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;">
                      <svg
                        width="36"
                        height="36"
                        viewBox="0 0 48 48"
                        fill="none"
                        style="opacity: 0.2;"
                      >
                        <rect
                          x="4"
                          y="8"
                          width="40"
                          height="32"
                          stroke="var(--q-ink)"
                          stroke-width="2"
                          fill="none"
                        />
                        <path
                          d="M4 32 L16 22 L24 28 L34 18 L44 26"
                          stroke="var(--q-ink)"
                          stroke-width="2"
                          fill="none"
                          stroke-linejoin="round"
                        />
                        <circle cx="14" cy="18" r="3" fill="var(--q-ink)" />
                      </svg>
                      <span
                        class="q-mono"
                        style="font-size: 10px; opacity: 0.35; max-width: 70%; text-align: center; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;"
                      >
                        {rpTitle}
                      </span>
                    </div>
                  )}
                </div>
                <div class="mt-3.5">
                  <span class="q-mono">
                    {rp.data.status} ·{' '}
                    {rp.data.startDate ? rp.data.startDate.getFullYear() : '—'}
                  </span>
                  <h4
                    class="mt-1.5 text-lg font-bold tracking-tight group-hover:opacity-75 transition-opacity"
                    style="color: var(--q-ink);"
                  >
                    {rpTitle}
                  </h4>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )
  }

  <!-- ─────────── PREV / NEXT ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pb-20 lg:pb-[120px] max-w-screen-xl mx-auto"
  >
    <div
      class="grid grid-cols-1 sm:grid-cols-2 gap-10 lg:gap-20 pt-8"
      style="border-top: 1px solid var(--q-line);"
    >
      {
        prev ? (
          <a
            href={`${basePath}/projects/${prev.id}`}
            class="no-underline"
            style="color: inherit;"
          >
            <span class="q-mono">← previous</span>
            <div
              class="mt-2.5 text-xl lg:text-[26px] font-bold tracking-tight"
              style="color: var(--q-ink);"
            >
              {locale === 'zh-tw'
                ? prev.data.title_zh || prev.id
                : prev.data.title_en}
            </div>
          </a>
        ) : (
          <div />
        )
      }

      {
        next ? (
          <a
            href={`${basePath}/projects/${next.id}`}
            class="no-underline sm:text-right"
            style="color: inherit;"
          >
            <span class="q-mono">next →</span>
            <div
              class="mt-2.5 text-xl lg:text-[26px] font-bold tracking-tight"
              style="color: var(--q-ink);"
            >
              {locale === 'zh-tw'
                ? next.data.title_zh || next.id
                : next.data.title_en}
            </div>
          </a>
        ) : (
          <div />
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .q-prose {
    max-width: 760px;
  }
  .q-prose :global(p) {
    margin: 0 0 20px;
    font-size: 17px;
    line-height: 1.85;
    color: var(--q-ink);
  }
  .q-prose :global(h2),
  .q-prose :global(h3) {
    margin: 44px 0 14px;
    font-family: var(--q-font-body);
    font-size: 26px;
    font-weight: 700;
    color: var(--q-ink);
    letter-spacing: -0.015em;
  }
  .q-prose :global(ul) {
    margin: 14px 0 18px;
    padding: 0;
    list-style: none;
  }
  .q-prose :global(li) {
    position: relative;
    padding-left: 20px;
    margin: 0 0 10px;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--q-ink);
  }
  .q-prose :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 11px;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--q-navy);
  }
  .q-prose :global(li li)::before {
    width: 4px;
    height: 4px;
    background: transparent;
    border: 1.5px solid var(--q-navy);
  }
  .q-prose :global(li > ul) {
    margin-top: 6px;
    margin-bottom: 4px;
  }
  .q-prose :global(blockquote) {
    margin: 40px 0;
    padding: 8px 0 8px 32px;
    border-left: 2px solid var(--q-navy);
    font-size: 21px;
    line-height: 1.6;
    color: var(--q-ink);
    font-style: italic;
    font-weight: 500;
  }
  .q-prose :global(a) {
    color: var(--q-navy);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
