---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.flatMap((project) => {
    return [
      {
        params: { slug: project.id },
        props: { project, locale: 'zh-tw' },
      },
      {
        params: { slug: project.id },
        props: { project, locale: 'en' },
      },
    ];
  });
}

const { project, locale } = Astro.props;

const contentModules = await Astro.glob(
  '../../content/projects/**/content_*.mdoc'
);
const contentFileSuffix = `/content/projects/${project.id}/${locale === 'zh-tw' ? 'content_zh.mdoc' : 'content_en.mdoc'}`;
const contentEntry = contentModules.find((mod) =>
  mod.file.replace(/\\/g, '/').endsWith(contentFileSuffix)
);
const ProjectContent = contentEntry?.Content;

const formatDate = (date?: Date) => {
  if (!date) return '';
  return date.toLocaleDateString(locale === 'zh-tw' ? 'zh-TW' : 'en-US', {
    year: 'numeric',
    month: 'long',
  });
};
---

<BaseLayout
  title={locale === 'zh-tw'
    ? project.data.title_zh || project.data.title_en
    : project.data.title_en}
  description={locale === 'zh-tw'
    ? project.data.description_zh
    : project.data.description_en}
>
  <div class="container-custom py-20">
    <article class="max-w-4xl mx-auto">
      <!-- Back Button -->
      <a
        href={locale === 'zh-tw' ? '/zh-tw/projects' : '/en/projects'}
        class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 mb-8"
      >
        <svg
          class="w-5 h-5 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        {locale === 'zh-tw' ? '返回專案列表' : 'Back to Projects'}
      </a>

      <!-- Header -->
      <header class="mb-12">
        <div class="flex items-center gap-3 mb-4">
          <span
            class="px-3 py-1 text-sm rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300"
          >
            {
              project.data.status === 'active'
                ? locale === 'zh-tw'
                  ? '進行中'
                  : 'Active'
                : project.data.status === 'completed'
                  ? locale === 'zh-tw'
                    ? '已完成'
                    : 'Completed'
                  : locale === 'zh-tw'
                    ? '已封存'
                    : 'Archived'
            }
          </span>
          {
            project.data.startDate && (
              <span class="text-slate-500 dark:text-slate-400">
                {formatDate(project.data.startDate)}
                {project.data.endDate &&
                  ` - ${formatDate(project.data.endDate)}`}
              </span>
            )
          }
        </div>

        <h1
          class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-6"
        >
          {locale === 'zh-tw' ? project.data.title_zh : project.data.title_en}
        </h1>

        <p class="text-xl text-slate-600 dark:text-slate-300 mb-8">
          {
            locale === 'zh-tw'
              ? project.data.description_zh
              : project.data.description_en
          }
        </p>

        {
          project.data.image && (
            <div class="mb-8 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700">
              <Image
                src={project.data.image}
                alt={
                  locale === 'zh-tw'
                    ? project.data.title_zh || project.id
                    : project.data.title_en || project.id
                }
                width={800}
                height={450}
                class="w-full h-auto"
                loading="lazy"
                decoding="async"
              />
            </div>
          )
        }

        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mb-8">
          {
            project.data.tags.map((tag) => (
              <span class="px-3 py-1 text-sm rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                {tag}
              </span>
            ))
          }
        </div>

        <!-- Links -->
        {
          project.data.links && (
            <div class="flex flex-wrap gap-4">
              {project.data.links.website && (
                <a
                  href={project.data.links.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary"
                >
                  {locale === 'zh-tw' ? '訪問網站' : 'Visit Website'}
                </a>
              )}
              {project.data.links.demo && (
                <a
                  href={project.data.links.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-secondary"
                >
                  {locale === 'zh-tw' ? '查看 Demo' : 'View Demo'}
                </a>
              )}
              {project.data.links.github && (
                <a
                  href={project.data.links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-secondary"
                >
                  <svg
                    class="w-5 h-5 mr-2"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                  GitHub
                </a>
              )}
            </div>
          )
        }
      </header>

      <!-- Content -->
      <div class="prose prose-lg dark:prose-invert max-w-none">
        {
          ProjectContent ? (
            <ProjectContent />
          ) : (
            <div class="text-center py-12 text-slate-500 dark:text-slate-400">
              <p>No detailed content available for this project.</p>
            </div>
          )
        }
      </div>
    </article>
  </div>
</BaseLayout>
