---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;

// Load MDOC content as Markdoc Content component
let ProjectContent;
let hasContent = false;

try {
  const contentModules = await Astro.glob(
    '../../../content/projects/**/content_zh.mdoc'
  );
  const contentEntry = contentModules[0];

  if (contentEntry?.Content) {
    ProjectContent = contentEntry.Content;
    hasContent = true;
  }
} catch (error) {
  console.error('Error loading project content:', error);
}

const formatDate = (date?: Date) => {
  if (!date) return '';
  return date.toLocaleDateString('zh-TW', {
    year: 'numeric',
    month: 'long',
  });
};
---

<BaseLayout
  title={project.data.title_zh || project.id}
  description={project.data.description_zh}
>
  <div class="container-custom py-20 relative z-10 min-h-[calc(100vh-12rem)]">
    <article class="max-w-4xl mx-auto">
      <!-- Back Button -->
      <a
        href="/zh-tw/projects"
        class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 mb-8 animate-fade-in-up"
      >
        <svg
          class="w-5 h-5 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"></path>
        </svg>
        返回專案列表
      </a>

      <!-- Header -->
      <header class="mb-12 animate-fade-in-up" style="animation-delay: 100ms">
        <div class="flex items-start justify-between gap-6 mb-6">
          <div class="flex-1">
            <div class="flex items-center gap-3 mb-4">
              <span
                class={`px-3 py-1 text-sm rounded-full ${
                  project.data.status === 'active'
                    ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300'
                    : project.data.status === 'paused'
                      ? 'bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-300'
                      : project.data.status === 'completed'
                        ? 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300'
                        : 'bg-slate-100 dark:bg-slate-900/30 text-slate-700 dark:text-slate-300'
                }`}
              >
                {
                  project.data.status === 'active'
                    ? '進行中'
                    : project.data.status === 'paused'
                      ? '暫時停滯'
                      : project.data.status === 'completed'
                        ? '已完成'
                        : '已封存'
                }
              </span>
              {
                project.data.startDate && (
                  <span class="text-slate-500 dark:text-slate-400">
                    {formatDate(project.data.startDate)}
                    {project.data.endDate &&
                      ` - ${formatDate(project.data.endDate)}`}
                  </span>
                )
              }
            </div>

            <h1
              class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4"
              style="text-transform: none;"
            >
              {project.data.title_zh || project.id}
            </h1>

            <p class="text-xl text-slate-600 dark:text-slate-300 mb-6">
              {project.data.description_zh}
            </p>
          </div>

          {
            project.data.image && (
              <Image
                src={project.data.image}
                alt={project.id}
                width={128}
                height={128}
                class="w-32 h-32 rounded-xl object-cover shadow-lg flex-shrink-0"
                loading="lazy"
                decoding="async"
              />
            )
          }
        </div>

        <!-- Tags -->
        <div class="flex flex-wrap gap-2 mb-8">
          {
            project.data.tags.map((tag) => (
              <span class="px-3 py-1 text-sm rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                {tag}
              </span>
            ))
          }
        </div>

        <!-- Links -->
        {
          project.data.links && (
            <div class="flex flex-wrap gap-4">
              {project.data.links.website && (
                <a
                  href={project.data.links.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary"
                >
                  訪問網站
                </a>
              )}
              {project.data.links.demo && (
                <a
                  href={project.data.links.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-secondary"
                >
                  查看 Demo
                </a>
              )}
              {project.data.links.github && (
                <a
                  href={project.data.links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-secondary"
                >
                  <svg
                    class="w-5 h-5 mr-2"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                  </svg>
                  GitHub
                </a>
              )}
            </div>
          )
        }
      </header>

      <div
        class="prose prose-lg dark:prose-invert max-w-none animate-fade-in"
        style="animation-delay: 200ms; animation-duration: 800ms"
      >
        {
          hasContent ? (
            <ProjectContent />
          ) : (
            <div class="text-center py-12 text-slate-500 dark:text-slate-400">
              <p>此專案暫無詳細內容</p>
            </div>
          )
        }
      </div>
    </article>
  </div>
</BaseLayout>
