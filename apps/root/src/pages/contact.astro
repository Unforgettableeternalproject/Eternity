---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCurrentLocale, getTranslations } from '../i18n/utils';

const locale = getCurrentLocale(Astro.url);
const t = getTranslations(locale);

// 社群平台列表
const socialLinks = [
  {
    name: 'GitHub',
    url: 'https://github.com/Unforgettableeternalproject',
    icon: 'github',
    color: 'hover:text-slate-900 dark:hover:text-white',
    handle: '@Unforgettableeternalproject',
  },
  {
    name: 'Facebook',
    url: 'https://www.facebook.com/u.e.p.bernie/',
    icon: 'facebook',
    color: 'hover:text-blue-600',
    handle: 'u.e.p.bernie',
  },
  {
    name: 'Line',
    url: 'https://line.me/ti/p/BnUGRFFka9',
    icon: 'line',
    color: 'hover:text-green-500',
    handle: 'BnUGRFFka9',
  },
  {
    name: 'Discord',
    url: 'https://discord.gg/ARyrkB9F7Z',
    icon: 'discord',
    color: 'hover:text-indigo-500',
    handle: 'u_e_p_bernie',
  },
  {
    name: 'Email',
    url: 'mailto:ptyc4076@gmail.com',
    icon: 'email',
    color: 'hover:text-red-500',
    handle: 'ptyc4076@gmail.com',
  },
];
---

<BaseLayout title={t.contact.title} description={t.contact.description}>
  <div class="min-h-screen py-16 relative overflow-hidden">
    <!-- 裝飾背景 -->
    <div class="absolute inset-0 z-0 pointer-events-none">
      <div
        class="absolute top-20 left-10 w-72 h-72 bg-primary-500/10 rounded-full blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-20 right-10 w-96 h-96 bg-secondary-500/10 rounded-full blur-3xl"
      >
      </div>
      <!-- 幾何輪廓 -->
      <div
        class="absolute top-32 right-[15%] w-48 h-48 rounded-full geo-outline geo-hue bg-gradient-to-br from-primary-400/70 to-secondary-500/70"
      >
      </div>
      <div
        class="absolute bottom-32 left-[12%] w-56 h-56 rotate-45 geo-outline geo-hue bg-gradient-to-br from-secondary-400/70 to-primary-500/70"
      >
      </div>
      <div
        class="absolute top-[50%] left-[8%] w-32 h-32 geo-outline geo-hue bg-gradient-to-br from-primary-400/60 to-secondary-500/60"
      >
      </div>
    </div>

    <div class="container-custom max-w-6xl mx-auto relative z-10 px-4 sm:px-6">
      <!-- Header -->
      <div class="text-center mb-12 md:mb-16 animate-fade-in-up">
        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-bold text-slate-900 dark:text-white mb-4"
        >
          {t.contact.title}
        </h1>
        <p
          class="text-base sm:text-lg text-slate-600 dark:text-slate-400 max-w-2xl mx-auto px-4"
        >
          {t.contact.subtitle}
        </p>
      </div>

      <!-- 左右分佈 -->
      <div class="grid md:grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8">
        <!-- 左側:社群平台 -->
        <div class="space-y-4 md:space-y-6">
          <div
            class="bg-white dark:bg-slate-800/50 backdrop-blur rounded-2xl border border-slate-200 dark:border-slate-700 p-6 md:p-8 shadow-lg animate-fade-in-up"
            style="animation-delay: 100ms"
          >
            <h2
              class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-4 md:mb-6 flex items-center"
            >
              <svg
                class="w-5 h-5 sm:w-6 sm:h-6 mr-2 text-primary-600 dark:text-primary-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              {t.contact.social.heading}
            </h2>

            <div class="space-y-2">
              {
                socialLinks.map((link) => (
                  <a
                    href={link.url}
                    target={link.icon === 'email' ? '_self' : '_blank'}
                    rel={
                      link.icon === 'email' ? undefined : 'noopener noreferrer'
                    }
                    class={`flex items-center px-3 py-2 rounded-lg transition-all duration-200 ${link.color} hover:bg-slate-100 dark:hover:bg-slate-800 group`}
                  >
                    <div class="flex-shrink-0 w-8 h-8 flex items-center justify-center">
                      {link.icon === 'github' && (
                        <svg
                          class="w-5 h-5 text-slate-600 dark:text-slate-400"
                          fill="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                            clip-rule="evenodd"
                          />
                        </svg>
                      )}
                      {link.icon === 'facebook' && (
                        <svg
                          class="w-5 h-5 text-slate-600 dark:text-slate-400"
                          fill="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                        </svg>
                      )}
                      {link.icon === 'line' && (
                        <svg
                          class="w-5 h-5 text-slate-600 dark:text-slate-400"
                          fill="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
                        </svg>
                      )}
                      {link.icon === 'discord' && (
                        <svg
                          class="w-5 h-5 text-slate-600 dark:text-slate-400"
                          fill="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path d="M20.317 4.492c-1.53-.69-3.17-1.2-4.885-1.49a.075.075 0 0 0-.079.036c-.21.369-.444.85-.608 1.23a18.566 18.566 0 0 0-5.487 0 12.36 12.36 0 0 0-.617-1.23A.077.077 0 0 0 8.562 3c-1.714.29-3.354.8-4.885 1.491a.07.07 0 0 0-.032.027C.533 9.093-.32 13.555.099 17.961a.08.08 0 0 0 .031.055 20.03 20.03 0 0 0 5.993 2.98.078.078 0 0 0 .084-.026 13.83 13.83 0 0 0 1.226-1.963.074.074 0 0 0-.041-.104 13.201 13.201 0 0 1-1.872-.878.075.075 0 0 1-.008-.125c.126-.093.252-.19.372-.287a.075.075 0 0 1 .078-.01c3.927 1.764 8.18 1.764 12.061 0a.075.075 0 0 1 .079.009c.12.098.245.195.372.288a.075.075 0 0 1-.006.125c-.598.344-1.22.635-1.873.877a.075.075 0 0 0-.041.105c.36.687.772 1.341 1.225 1.962a.077.077 0 0 0 .084.028 19.963 19.963 0 0 0 6.002-2.981.076.076 0 0 0 .032-.054c.5-5.094-.838-9.52-3.549-13.442a.06.06 0 0 0-.031-.028zM8.02 15.278c-1.182 0-2.157-1.069-2.157-2.38 0-1.312.956-2.38 2.157-2.38 1.21 0 2.176 1.077 2.157 2.38 0 1.312-.956 2.38-2.157 2.38zm7.975 0c-1.183 0-2.157-1.069-2.157-2.38 0-1.312.955-2.38 2.157-2.38 1.21 0 2.176 1.077 2.157 2.38 0 1.312-.946 2.38-2.157 2.38z" />
                        </svg>
                      )}
                      {link.icon === 'email' && (
                        <svg
                          class="w-5 h-5 text-slate-600 dark:text-slate-400"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                          />
                        </svg>
                      )}
                    </div>
                    <div class="ml-3 flex-1 min-w-0">
                      <p class="text-sm font-medium text-slate-900 dark:text-white truncate">
                        {link.name}
                      </p>
                      <p class="text-xs text-slate-500 dark:text-slate-500 truncate">
                        {link.handle}
                      </p>
                    </div>
                    <svg
                      class="w-4 h-4 text-slate-400 opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5 transition-all"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <!-- 右側:聯絡表單 -->
        <div class="space-y-4 md:space-y-6">
          <div
            class="bg-white dark:bg-slate-800/50 backdrop-blur rounded-2xl border border-slate-200 dark:border-slate-700 p-6 md:p-8 shadow-lg animate-fade-in-up"
            style="animation-delay: 100ms"
          >
            <h2
              class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-4 md:mb-6 flex items-center"
            >
              <svg
                class="w-5 h-5 sm:w-6 sm:h-6 mr-2 text-primary-600 dark:text-primary-400"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"
                ></path>
              </svg>
              {t.contact.form.heading}
            </h2>

            <form id="contact-form" class="space-y-4 md:space-y-5">
              <div class="grid sm:grid-cols-2 gap-4 md:gap-5">
                <div>
                  <label
                    for="name"
                    class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"
                  >
                    {t.contact.form.name.label}
                    <span class="text-red-500">{t.contact.form.required}</span>
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    class="w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white transition-colors"
                    placeholder={t.contact.form.name.placeholder}
                  />
                </div>

                <div>
                  <label
                    for="email"
                    class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"
                  >
                    {t.contact.form.email.label}
                    <span class="text-red-500">{t.contact.form.required}</span>
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    class="w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white transition-colors"
                    placeholder={t.contact.form.email.placeholder}
                  />
                </div>
              </div>

              <div>
                <label
                  for="subject"
                  class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"
                >
                  {t.contact.form.subject.label}
                  <span class="text-red-500">{t.contact.form.required}</span>
                </label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  required
                  class="w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white transition-colors"
                  placeholder={t.contact.form.subject.placeholder}
                />
              </div>

              <div>
                <label
                  for="message"
                  class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-2"
                >
                  {t.contact.form.message.label}
                  <span class="text-red-500">{t.contact.form.required}</span>
                </label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="6"
                  class="w-full px-4 py-3 border border-slate-300 dark:border-slate-600 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 bg-slate-50 dark:bg-slate-900 text-slate-900 dark:text-white resize-none transition-colors"
                  placeholder={t.contact.form.message.placeholder}></textarea>
              </div>

              <button
                type="submit"
                class="w-full px-6 py-4 bg-gradient-to-r from-primary-600 to-primary-700 hover:from-primary-700 hover:to-primary-800 text-white font-semibold rounded-xl transition-all duration-200 flex items-center justify-center space-x-2 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                </svg>
                <span>{t.contact.form.submit}</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { toastManager } from '../components/Toast';

  const form = document.getElementById('contact-form') as HTMLFormElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = {
      name: formData.get('name'),
      email: formData.get('email'),
      subject: formData.get('subject'),
      message: formData.get('message'),
    };

    try {
      const response = await fetch('/api/contact.json', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(data),
      });

      const result = await response.json();

      if (response.ok) {
        toastManager.success('訊息已成功發送！我會儘快回覆您。', 5000);
        form.reset();
      } else {
        toastManager.error(result.error || '發送失敗，請稍後再試。', 5000);
      }
    } catch {
      toastManager.error('網路錯誤，請檢查您的連線。', 5000);
    }
  });
</script>
