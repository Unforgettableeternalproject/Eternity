---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCurrentLocale, getTranslations } from '../i18n/utils';
import { getSingleton } from '../lib/api';

export const prerender = false;

const locale = getCurrentLocale(Astro.url);
const t = getTranslations(locale);
const basePath = locale === 'zh-tw' ? '/zh-tw' : '/en';

/* ── Fetch from D1 ── */
const singletonKey = locale === 'zh-tw' ? 'contact-zh' : 'contact-en';
const raw = await getSingleton(singletonKey);

/* ── 頁面 hero 文字（從 page-contact singleton 讀取） ── */
const ptKey = locale === 'zh-tw' ? 'page-contact-zh' : 'page-contact-en';
const ptRaw = await getSingleton(ptKey);
const pt = (ptRaw?.content ?? {}) as Record<string, string>;
const data = (raw?.content ?? {}) as {
  heroTitle?: string;
  heroIntro?: string;
  subjects?: string[];
  directLinks?: { key: string; value: string; url: string }[];
  expectation?: string;
  faqs?: { q: string; a: string }[];
  devCta?: { heading?: string; text?: string };
};

const subjects = data.subjects ?? [];
const directLinks = data.directLinks ?? [];
const faqs = data.faqs ?? [];
const devCta = data.devCta ?? {};
---

<BaseLayout
  title={locale === 'zh-tw' ? '聯繫 — 顏榕嶙' : 'Contact — Bernie Yen'}
  description={locale === 'zh-tw' ? '來說你的故事。' : 'Tell me your story.'}
>
  <!-- ─────────── HERO ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pt-16 sm:pt-20 lg:pt-[100px] pb-12 lg:pb-[60px] max-w-screen-xl mx-auto"
  >
    <span class="q-section-label">
      {
        pt.heroLabel ||
          (locale === 'zh-tw'
            ? '—— 06 / contact · 寫信給我'
            : '—— 06 / contact · reach out')
      }
    </span>

    <h1
      class="mt-6 text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[96px] font-bold leading-[0.97] tracking-tighter max-w-[1100px]"
      style="color: var(--q-ink);"
      set:html={pt.heroTitle ||
        (locale === 'zh-tw'
          ? '來說<span style="color: var(--q-navy); font-weight: 600;">你的</span>故事。'
          : 'Tell me <span style="color: var(--q-navy); font-weight: 600;">your</span> story.')}
    />

    <div
      class="mt-10 lg:mt-12 grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-14 items-end"
    >
      <p
        class="m-0 max-w-[560px] text-[17.5px] leading-[1.7]"
        style="color: var(--q-ink-soft);"
      >
        {
          locale === 'zh-tw' ? (
            <>
              {pt.heroIntro ||
                data.heroIntro ||
                '合作邀約、聲音作品、文字、世界觀討論、或單純打聲招呼 — 都歡迎。我會盡量在 48 小時內回。'}
            </>
          ) : (
            <>
              {pt.heroIntro ||
                data.heroIntro ||
                "Collaborations, music, writing, worldbuilding discussions, or just saying hi — all welcome. I'll try to reply within 48 hours."}
            </>
          )
        }
      </p>
      <div class="flex items-center gap-2">
        <span class="q-live-dot" style="width: 8px; height: 8px;"></span>
        <span class="q-mono" style="color: var(--q-coral);">
          currently available
        </span>
      </div>
    </div>
  </section>

  <!-- ─────────── FORM + SIDEBAR ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] py-10 lg:py-[40px] max-w-screen-xl mx-auto"
  >
    <div class="grid grid-cols-1 lg:grid-cols-[1.5fr_1fr] gap-12 lg:gap-14">
      <!-- FORM -->
      <div>
        <div
          class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-5 mb-9"
          style="border-bottom: 1px solid var(--q-line);"
        >
          <div>
            <span class="q-section-label">—— 01 / message form</span>
            <h2
              class="mt-2 text-3xl md:text-4xl font-bold tracking-tight leading-none"
              style="color: var(--q-ink);"
            >
              {locale === 'zh-tw' ? '傳一封信' : 'Send a message'}
            </h2>
          </div>
        </div>

        <form id="contact-form" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <span class="q-mono">name *</span>
              <input
                type="text"
                name="name"
                required
                class="q-input mt-2"
                placeholder={locale === 'zh-tw' ? '你的名字' : 'Your name'}
              />
            </div>
            <div>
              <span class="q-mono">email *</span>
              <input
                type="email"
                name="email"
                required
                class="q-input mt-2"
                placeholder="you@somewhere.com"
              />
            </div>
          </div>

          <div>
            <span class="q-mono">subject</span>
            <div class="flex gap-1.5 flex-wrap mt-2.5 mb-3" id="subject-pills">
              {
                subjects.map((s, i) => (
                  <button
                    type="button"
                    class={`q-subject-pill ${i === 0 ? 'active' : ''}`}
                    data-subject={s.split(' · ')[0]}
                  >
                    {s}
                  </button>
                ))
              }
            </div>
            <input
              type="text"
              name="subject"
              class="q-input"
              placeholder={locale === 'zh-tw'
                ? '一句話說明你想聊什麼'
                : 'One line about what you want to discuss'}
            />
          </div>

          <div>
            <span class="q-mono">message *</span>
            <textarea
              name="message"
              required
              class="q-input mt-2"
              style="min-height: 180px; resize: vertical; line-height: 1.65;"
              placeholder={locale === 'zh-tw'
                ? '細節寫多一點對我很有幫助 — 你做什麼、想合作什麼、時程怎麼樣...'
                : 'More detail helps — what you do, what collaboration you have in mind, timeline...'}
            ></textarea>
            <div class="mt-2 flex justify-between">
              <span class="q-mono">markdown supported</span>
              <span class="q-mono" id="char-count">0 / 2000</span>
            </div>
          </div>

          <div
            class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2"
          >
            <span class="q-mono"
              >powered by resend · ≤ 48hr {
                locale === 'zh-tw' ? '回覆' : 'reply'
              }</span
            >
            <button
              type="submit"
              class="px-8 py-3.5 text-[15px] font-semibold inline-flex items-center gap-2.5 cursor-pointer"
              style="background: var(--q-ink); color: var(--q-paper); border: none;"
            >
              {locale === 'zh-tw' ? '送出' : 'Send'} →
            </button>
          </div>
        </form>
      </div>

      <!-- SIDEBAR -->
      <div class="flex flex-col gap-8">
        <!-- Direct -->
        {
          directLinks.length > 0 && (
            <div>
              <span class="q-section-label">—— 02 / direct</span>
              <h3
                class="mt-2.5 text-xl md:text-2xl font-bold tracking-tight"
                style="color: var(--q-ink);"
              >
                {locale === 'zh-tw' ? '或者直接寄' : 'Or reach out directly'}
              </h3>
              <div class="mt-3.5">
                {directLinks.map((link, i, arr) => (
                  <a
                    href={link.url}
                    target={link.key === 'EMAIL' ? '_self' : '_blank'}
                    rel={
                      link.key === 'EMAIL' ? undefined : 'noopener noreferrer'
                    }
                    class="grid items-baseline py-4 no-underline transition-opacity hover:opacity-70"
                    style={`
                    grid-template-columns: auto 1fr auto;
                    gap: 16px;
                    border-top: 1px solid var(--q-line);
                    ${i === arr.length - 1 ? 'border-bottom: 1px solid var(--q-line);' : ''}
                    color: inherit;
                  `}
                  >
                    <span class="q-mono" style="color: var(--q-navy);">
                      {link.key}
                    </span>
                    <span
                      class="text-sm font-mono truncate"
                      style="color: var(--q-ink); font-family: 'JetBrains Mono', monospace;"
                    >
                      {link.value}
                    </span>
                    <span style="color: var(--q-navy); font-size: 16px;">
                      ↗
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
        }

        <!-- Expectation -->
        <div>
          <span class="q-section-label">—— 03 / expectation</span>
          <h3
            class="mt-2.5 text-xl md:text-2xl font-bold tracking-tight"
            style="color: var(--q-ink);"
          >
            {locale === 'zh-tw' ? '能預期的回應' : 'What to expect'}
          </h3>
          <p
            class="mt-3 text-sm leading-[1.75]"
            style="color: var(--q-ink-soft);"
          >
            {data.expectation || ''}
          </p>
        </div>

        <!-- FAQ -->
        {
          faqs.length > 0 && (
            <div>
              <span class="q-section-label">—— 04 / faq</span>
              <h3
                class="mt-2.5 text-xl md:text-2xl font-bold tracking-tight"
                style="color: var(--q-ink);"
              >
                {locale === 'zh-tw' ? '常見問題' : 'FAQ'}
              </h3>
              <div class="mt-3.5">
                {faqs.map((faq, i, arr) => (
                  <details
                    class="py-3"
                    style={`
                    border-top: ${i === 0 ? '1px solid var(--q-line)' : '1px dashed var(--q-line)'};
                    ${i === arr.length - 1 ? 'border-bottom: 1px solid var(--q-line);' : ''}
                  `}
                  >
                    <summary
                      class="cursor-pointer flex justify-between items-center text-sm font-semibold tracking-tight list-none"
                      style="color: var(--q-ink);"
                    >
                      {faq.q}
                      <span class="q-mono" style="color: var(--q-ink-mute);">
                        ＋
                      </span>
                    </summary>
                    <p
                      class="mt-2 text-[13.5px] leading-[1.65]"
                      style="color: var(--q-ink-soft);"
                    >
                      {faq.a}
                    </p>
                  </details>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- ─────────── DEV CTA ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pb-20 lg:pb-[120px] max-w-screen-xl mx-auto"
  >
    <div
      class="grid grid-cols-1 md:grid-cols-[auto_1fr_auto] gap-6 md:gap-9 items-center pt-12"
      style="border-top: 1px solid var(--q-line);"
    >
      <div
        class="hidden md:block font-mono text-5xl lg:text-[56px] leading-[0.9] tracking-tighter"
        style="color: var(--q-navy); font-weight: 400;"
      >
        &lt;/&gt;
      </div>
      <div>
        <span class="q-section-label">—— 05 / for devs</span>
        <h3
          class="mt-2 text-lg md:text-[22px] font-bold tracking-tight"
          style="color: var(--q-ink);"
        >
          {
            devCta.heading ||
              (locale === 'zh-tw'
                ? '遇到 bug 或想提建議？'
                : 'Found a bug or have a suggestion?')
          }
        </h3>
        <p class="mt-1 text-sm leading-[1.6]" style="color: var(--q-ink-soft);">
          {devCta.text || ''}
        </p>
      </div>
      <a
        href="https://github.com/Unforgettableeternalproject/Eternity/issues/new"
        target="_blank"
        rel="noopener noreferrer"
        class="px-5 py-3 text-sm font-semibold no-underline whitespace-nowrap"
        style="background: var(--q-ink); color: var(--q-paper);"
      >
        {locale === 'zh-tw' ? '開 issue' : 'Open issue'} →
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .q-input {
    width: 100%;
    padding: 14px 16px;
    background: var(--q-paper);
    border: 1px solid var(--q-line);
    border-radius: 0;
    font-size: 15px;
    color: var(--q-ink);
    font-family: 'Plus Jakarta Sans', 'Noto Sans TC', sans-serif;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s;
  }
  .q-input:focus {
    border-color: var(--q-navy);
  }
  .q-input::placeholder {
    color: var(--q-ink-mute);
  }

  .q-subject-pill {
    padding: 6px 14px;
    border-radius: 999px;
    background: transparent;
    color: var(--q-ink);
    border: 1px solid var(--q-line);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12.5px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
  }
  .q-subject-pill:hover {
    border-color: var(--q-line-hard);
  }
  .q-subject-pill.active {
    background: var(--q-ink);
    color: var(--q-paper);
    border-color: var(--q-ink);
  }

  details summary::-webkit-details-marker {
    display: none;
  }
  details[open] summary span {
    transform: rotate(45deg);
    display: inline-block;
  }
</style>

<script>
  import { toastManager } from '../components/Toast';

  function initContactForm() {
    /* Subject pills */
    const pills =
      document.querySelectorAll<HTMLButtonElement>('.q-subject-pill');
    const subjectInput = document.querySelector<HTMLInputElement>(
      'input[name="subject"]'
    );
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        if (subjectInput) subjectInput.value = pill.dataset.subject || '';
      });
    });

    /* Char count */
    const textarea = document.querySelector<HTMLTextAreaElement>(
      'textarea[name="message"]'
    );
    const counter = document.getElementById('char-count');
    textarea?.addEventListener('input', () => {
      if (counter) counter.textContent = `${textarea.value.length} / 2000`;
    });

    /* Form submit */
    const form = document.getElementById('contact-form') as HTMLFormElement;
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const data = {
        name: fd.get('name'),
        email: fd.get('email'),
        subject: fd.get('subject'),
        message: fd.get('message'),
      };

      try {
        const res = await fetch('/api/contact.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();
        if (res.ok) {
          toastManager.success('訊息已成功發送！我會儘快回覆您。', 5000);
          form.reset();
          if (counter) counter.textContent = '0 / 2000';
          pills.forEach((p, i) => {
            p.classList.toggle('active', i === 0);
          });
        } else {
          toastManager.error(result.error || '發送失敗，請稍後再試。', 5000);
        }
      } catch {
        toastManager.error('網路錯誤，請檢查您的連線。', 5000);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initContactForm);
  document.addEventListener('astro:page-load', initContactForm);
</script>
