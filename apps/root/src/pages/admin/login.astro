---
export const prerender = false;

import {
  isTestModeOverrideValue,
  TEST_MODE_COOKIE_NAME,
} from '../../lib/apiBase';

const JWT_COOKIE = 'root-admin-jwt';
const ACTIVE_COOKIE = 'root-admin-active';
// Test Mode 下登入一律打正式 worker：test worker 與正式共用 JWT_SECRET，
// 但 test D1 的 admin_users 刻意保持空——帳密只能由正式 worker 驗證，
// 簽出的 JWT 在 test worker 上同樣有效（與 staging 行為一致）。
const isTestModeLogin = isTestModeOverrideValue(
  Astro.cookies.get(TEST_MODE_COOKIE_NAME)?.value
);
const apiBase =
  import.meta.env.PUBLIC_PROD_CONTENT_API_URL ||
  (import.meta.env.DEV && !isTestModeLogin
    ? 'http://localhost:8788'
    : 'https://eternity-content-api.ptyc4076.workers.dev');

function safeRedirect(url: string | null | undefined): string {
  if (!url || !url.startsWith('/admin')) return '/admin';
  return url;
}

// 已有合法 JWT → 直接跳轉
const existingJwt = Astro.cookies.get(JWT_COOKIE);
if (existingJwt?.value) {
  return Astro.redirect('/admin');
}

let error = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const username = formData.get('username')?.toString() || '';
    const password = formData.get('password')?.toString() || '';
    const redirectTo = safeRedirect(formData.get('redirect')?.toString());

    const res = await fetch(`${apiBase}/api/auth/login`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, password }),
    });
    const json = (await res.json()) as {
      ok: boolean;
      data?: { token: string };
      error?: string;
    };

    if (json.ok && json.data?.token) {
      Astro.cookies.set(JWT_COOKIE, json.data.token, {
        path: '/',
        httpOnly: true,
        secure: import.meta.env.PROD,
        maxAge: 60 * 60 * 24,
        sameSite: 'lax',
      });
      Astro.cookies.set(ACTIVE_COOKIE, '1', {
        path: '/',
        httpOnly: false,
        secure: import.meta.env.PROD,
        maxAge: 60 * 60 * 24,
        sameSite: 'lax',
      });
      return Astro.redirect(redirectTo);
    } else {
      error = json.error || '驗證失敗 — 帳號或密碼不正確';
    }
  } catch {
    error = '無法連線至認證服務';
  }
}

const redirectTo = safeRedirect(Astro.url.searchParams.get('redirect'));

// middleware 被踢回來時的原因
const reason = Astro.url.searchParams.get('reason');
if (!error && reason === 'no-secret') {
  error = 'JWT_SECRET 未設定 — 請檢查 Cloudflare Pages 環境變數';
} else if (!error && reason === 'jwt-invalid') {
  error =
    'Session 驗證失敗 — JWT 簽章不符或已過期（Worker 與 Pages 的 JWT_SECRET 可能不一致）';
}
---

<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin · Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Noto+Sans+TC:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="q-login-wrap">
      <div class="q-login-card">
        <div class="q-login-header">
          <span class="q-login-wordmark">顏榕嶙</span>
          <span class="q-login-mono">· admin</span>
        </div>

        <div class="q-login-rule"></div>

        <h1 class="q-login-title">登入</h1>
        <p class="q-login-sub">restricted · authorization required</p>

        <form method="POST" class="q-login-form">
          <input type="hidden" name="redirect" value={redirectTo} />

          <div class="q-login-field">
            <label class="q-login-label" for="username">identifier</label>
            <input
              id="username"
              type="text"
              name="username"
              autocomplete="username"
              class="q-login-input"
              placeholder="帳號"
              required
            />
          </div>

          <div class="q-login-field">
            <label class="q-login-label" for="password">passphrase</label>
            <input
              id="password"
              type="password"
              name="password"
              autocomplete="current-password"
              class="q-login-input"
              placeholder="密碼"
              required
            />
          </div>

          {error && <div class="q-login-error">{error}</div>}

          <button type="submit" class="q-login-btn"
            >commit & authenticate</button
          >
        </form>

        <a href="/" class="q-login-back">← 回到主站</a>
      </div>
    </div>
  </body>
</html>

<style is:global>
  .q-login-wrap {
    min-height: calc(100vh - var(--test-banner-h, 0px));
    display: grid;
    place-items: center;
    background: #f8f7f3;
    font-family: var(--q-font-body);
    padding: 40px 20px;
  }

  .q-login-card {
    width: 100%;
    max-width: 400px;
    padding: 48px 40px 36px;
    border: 1px solid rgba(15, 21, 48, 0.1);
    background: #fff;
  }

  .q-login-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 12px;
  }

  .q-login-wordmark {
    font-size: 16px;
    font-weight: 700;
    color: #0f1530;
    letter-spacing: -0.01em;
  }

  .q-login-mono {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #7b8398;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .q-login-rule {
    height: 1px;
    background: rgba(15, 21, 48, 0.1);
    margin-bottom: 28px;
  }

  .q-login-title {
    font-size: 32px;
    font-weight: 700;
    color: #0f1530;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
  }

  .q-login-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #7b8398;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 32px;
  }

  .q-login-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .q-login-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .q-login-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #7b8398;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .q-login-input {
    width: 100%;
    padding: 10px 12px;
    background: #f8f7f3;
    border: 1px solid rgba(15, 21, 48, 0.1);
    color: #0f1530;
    font-family: var(--q-font-body);
    font-size: 14px;
    font-weight: 500;
    outline: none;
    border-radius: 0;
    box-sizing: border-box;
    transition: border-color 0.15s;
  }
  .q-login-input::placeholder {
    color: #c7ccd7;
  }
  .q-login-input:focus {
    border-color: #27396c;
  }

  .q-login-error {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    color: #d6442e;
    letter-spacing: 0.06em;
    padding: 8px 12px;
    border: 1px solid rgba(214, 68, 46, 0.3);
    background: rgba(214, 68, 46, 0.04);
  }

  .q-login-btn {
    width: 100%;
    padding: 11px 16px;
    margin-top: 4px;
    background: #0f1530;
    border: 1px solid #0f1530;
    color: #f8f7f3;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }
  .q-login-btn:hover {
    background: #27396c;
    border-color: #27396c;
  }

  .q-login-back {
    display: block;
    text-align: center;
    margin-top: 24px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    color: #7b8398;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: color 0.15s;
  }
  .q-login-back:hover {
    color: #27396c;
  }

  @media (max-width: 480px) {
    .q-login-card {
      padding: 32px 24px 28px;
    }
    .q-login-title {
      font-size: 26px;
    }
  }
</style>
