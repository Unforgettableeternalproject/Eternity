---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import RootEditor from '../../components/editor/RootEditor';
import AdminTestModeControl from '../../components/admin/AdminTestModeControl';
import { getApiBase } from '../../lib/apiBase';
import {
  getProjects,
  getUpdates,
  getLinks,
  getSingleton,
  getCards,
} from '../../lib/api';

// 取得 JWT token 供 React 元件做寫入 API 呼叫
const JWT_COOKIE = 'root-admin-jwt';
const jwtCookie = Astro.cookies.get(JWT_COOKIE);
const token = jwtCookie?.value || '';
const apiBase = getApiBase();

// 並行取得所有資料（含 about 雙語及 currently singleton）
const [
  projects,
  updates,
  links,
  homepageZh,
  aboutZh,
  aboutEn,
  contactZh,
  contactEn,
  currentlySingleton,
  // 頁面文字 singletons
  pageHomeZh,
  pageHomeEn,
  pageProjectsZh,
  pageProjectsEn,
  pageUpdatesZh,
  pageUpdatesEn,
  pageLinksZh,
  pageLinksEn,
  pageAboutZh,
  pageAboutEn,
  pageContactZh,
  pageContactEn,
  cards,
] = await Promise.all([
  getProjects(),
  getUpdates(),
  getLinks(),
  getSingleton('homepage-zh'),
  getSingleton('about-zh'),
  getSingleton('about-en'),
  getSingleton('contact-zh'),
  getSingleton('contact-en'),
  getSingleton('currently'),
  // 頁面文字
  getSingleton('page-home-zh'),
  getSingleton('page-home-en'),
  getSingleton('page-projects-zh'),
  getSingleton('page-projects-en'),
  getSingleton('page-updates-zh'),
  getSingleton('page-updates-en'),
  getSingleton('page-links-zh'),
  getSingleton('page-links-en'),
  getSingleton('page-about-zh'),
  getSingleton('page-about-en'),
  getSingleton('page-contact-zh'),
  getSingleton('page-contact-en'),
  getCards(),
]);
---

<AdminLayout title="Admin · Editor">
  <div class="adm-test-mode-floating">
    <AdminTestModeControl client:load />
  </div>
  <RootEditor
    client:only="react"
    projects={projects || []}
    updates={updates || []}
    links={links || []}
    homepage={homepageZh?.content || null}
    about={aboutZh?.content || null}
    aboutEn={aboutEn?.content || null}
    contact={contactZh?.content || null}
    contactEn={contactEn?.content || null}
    currently={currentlySingleton?.content || null}
    cards={cards || []}
    pageHomeZh={pageHomeZh?.content || null}
    pageHomeEn={pageHomeEn?.content || null}
    pageProjectsZh={pageProjectsZh?.content || null}
    pageProjectsEn={pageProjectsEn?.content || null}
    pageUpdatesZh={pageUpdatesZh?.content || null}
    pageUpdatesEn={pageUpdatesEn?.content || null}
    pageLinksZh={pageLinksZh?.content || null}
    pageLinksEn={pageLinksEn?.content || null}
    pageAboutZh={pageAboutZh?.content || null}
    pageAboutEn={pageAboutEn?.content || null}
    pageContactZh={pageContactZh?.content || null}
    pageContactEn={pageContactEn?.content || null}
    apiBase={apiBase}
    token={token}
    visitorApiUrl={import.meta.env.PUBLIC_VISITOR_API_URL || ''}
  />
</AdminLayout>

<style>
  /* Test mode 控制卡浮動定位（Issue #41）
     避開頂端 32px TEST MODE banner；醒目但不擋 RootEditor 主要操作區 */
  .adm-test-mode-floating {
    position: fixed;
    top: 44px;
    right: 16px;
    z-index: 100;
    width: 380px;
    max-width: calc(100vw - 32px);
    pointer-events: auto;
  }
  body.has-test-banner .adm-test-mode-floating {
    top: 44px;
  }
  /* 窄螢幕時退回 inline 感（貼齊右上不擋畫面） */
  @media (max-width: 640px) {
    .adm-test-mode-floating {
      top: 40px;
      right: 8px;
      left: 8px;
      width: auto;
    }
  }
</style>
