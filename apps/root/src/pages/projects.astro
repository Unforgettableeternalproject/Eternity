---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCurrentLocale, getTranslations } from '../i18n/utils';

const locale = getCurrentLocale(Astro.url);
const t = getTranslations(locale);

// Project data with i18n
const projects = [
  {
    title: t.projects.items.uep.title,
    description: t.projects.items.uep.description,
    image: null,
    tags: [t.projects.tags.creativeWriting, t.projects.tags.worldBuilding, t.projects.tags.fiction],
    link: 'https://uep.unforgettableeternalproject.com',
  },
  {
    title: t.projects.items.eternity.title,
    description: t.projects.items.eternity.description,
    image: null,
    tags: [t.projects.tags.astro, t.projects.tags.typescript, t.projects.tags.tailwindcss],
    link: null,
  },
  {
    title: t.projects.items.portfolio.title,
    description: t.projects.items.portfolio.description,
    image: null,
    tags: [t.projects.tags.art, t.projects.tags.design, t.projects.tags.illustration],
    link: null,
  },
];
---

<BaseLayout 
  title={t.projects.title}
  description={t.projects.description}
>
  <div class="relative py-24">
    <!-- Background gradients -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
      <div class="absolute right-0 top-10 h-96 w-96 rounded-full bg-secondary-500/10 blur-3xl"></div>
      <div class="absolute -left-20 top-60 h-80 w-80 rounded-full bg-primary-500/10 blur-3xl"></div>
      <div class="absolute right-1/3 bottom-40 h-72 w-72 rounded-full bg-secondary-500/5 blur-3xl"></div>
    </div>
    
    <div class="container-custom relative z-10">
      <!-- Header -->
      <div class="text-center space-y-4 mb-16 animate-fade-in-up">
        <h1 class="text-5xl font-bold text-slate-900 dark:text-white">
          {t.projects.heading}
        </h1>
        <p class="text-xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
          {t.projects.subtitle}
        </p>
      </div>

      <!-- Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        {projects.map((project, index) => (
          <div 
            class="card card-hover p-6 space-y-4 animate-fade-in-up"
            style={`animation-delay: ${index * 100}ms`}
          >
            <!-- Project Image Placeholder -->
            <div class="aspect-video rounded-lg bg-gradient-to-br from-primary-500/20 to-secondary-500/20 dark:from-primary-500/10 dark:to-secondary-500/10 backdrop-blur-sm border border-slate-200/50 dark:border-slate-700/50 flex items-center justify-center">
              <svg class="w-16 h-16 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>

            <!-- Project Info -->
            <div class="space-y-3">
              <h3 class="text-2xl font-bold text-slate-900 dark:text-white">
                {project.title}
              </h3>
              <p class="text-slate-600 dark:text-slate-300">
                {project.description}
              </p>

              <!-- Tags -->
              <div class="flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="px-3 py-1 text-xs font-medium bg-primary-50 dark:bg-primary-950 text-primary-700 dark:text-primary-400 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Link -->
              {project.link && (
                <a 
                  href={project.link} 
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 font-medium group"
                >
                  {t.projects.viewProject}
                  <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                  </svg>
                </a>
              )}
              {!project.link && (
                <span class="inline-flex items-center gap-2 text-slate-400 dark:text-slate-500 font-medium">
                  {locale === 'zh-tw' ? '即將推出' : 'Coming Soon'}
                </span>
              )}
            </div>
          </div>
        ))}
      </div>

      <!-- CTA Section -->
      <div class="text-center mt-16 space-y-6 animate-fade-in-up animation-delay-400">
        <h2 class="text-3xl font-bold text-slate-900 dark:text-white">
          {t.projects.cta.heading}
        </h2>
        <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto">
          {t.projects.cta.description}
        </p>
        <div class="flex flex-wrap gap-4 justify-center pt-4">
          <a 
            href="https://github.com/Unforgettableeternalproject" 
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary"
          >
            {t.projects.cta.github}
          </a>
          <a 
            href="https://uep.unforgettableeternalproject.com" 
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            {t.projects.cta.explore}
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
