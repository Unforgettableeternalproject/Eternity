---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCurrentLocale, getTranslations } from '../i18n/utils';
import { getProjects, assetUrl } from '../lib/api';

export const prerender = false;

const locale = getCurrentLocale(Astro.url);
const t = getTranslations(locale);
const basePath = locale === 'zh-tw' ? '/zh-tw' : '/en';
const apiBase = import.meta.env.PUBLIC_CONTENT_API_URL || 'http://localhost:8788';

const allProjectsRaw = await getProjects();
const projects = allProjectsRaw
  .map(p => ({
    id: p.id,
    data: {
      title_zh: p.titleZh, title_en: p.titleEn,
      description_zh: p.descZh, description_en: p.descEn,
      tags: p.tags, featured: p.featured, order: p.sortOrder,
      status: p.status, image: p.image, links: p.links,
      startDate: p.startDate ? new Date(p.startDate) : null,
    },
  }))
  .sort((a, b) => {
    const oA = a.data.order ?? 999, oB = b.data.order ?? 999;
    if (oA !== oB) return oA - oB;
    return (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0);
  });

const allTags = Array.from(new Set(projects.flatMap((p) => p.data.tags))).sort();
const featuredCount = projects.filter((p) => p.data.featured).length;
---

<BaseLayout
  title={locale === 'zh-tw' ? '作品 — 顏榕嶙' : 'Projects — Bernie Yen'}
  description={locale === 'zh-tw' ? '我做過的所有東西。' : "Everything I've built."}
>

  <!-- ─────────── HERO ─────────── -->
  <section class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pt-16 sm:pt-20 lg:pt-[100px] pb-12 lg:pb-[60px] max-w-screen-xl mx-auto">
    <span class="q-section-label">
      —— 02 / projects · {locale === 'zh-tw' ? '作品目錄' : 'project catalog'}
    </span>

    <h1
      class="mt-6 text-5xl sm:text-6xl md:text-7xl lg:text-8xl xl:text-[96px] font-bold leading-[0.98] tracking-tighter max-w-[1100px]"
      style="color: var(--q-ink);"
    >
      {locale === 'zh-tw' ? (
        <>
          我做過的<br />
          <span style="color: var(--q-navy); font-weight: 600;">所有東西</span>。
        </>
      ) : (
        <>
          Everything<br />
          I've <span style="color: var(--q-navy); font-weight: 600;">built</span>.
        </>
      )}
    </h1>

    <div class="mt-10 lg:mt-14 grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-10 lg:gap-12 items-end">
      <p class="m-0 max-w-[560px] text-[17px] leading-[1.7]" style="color: var(--q-ink-soft);">
        {locale === 'zh-tw'
          ? '程式、世界觀、遊戲、工具 — 全部攤開列在這份目錄裡。點任何一個進去看詳細紀錄。'
          : 'Code, worldbuilding, games, tools — all laid out in this catalog. Click any entry for full details.'}
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-5 lg:gap-6">
        <div>
          <div class="font-mono text-4xl font-medium tracking-tight" style="color: var(--q-ink);">{String(projects.length).padStart(2, '0')}</div>
          <span class="q-mono mt-1 inline-block">total</span>
        </div>
        <div>
          <div class="font-mono text-4xl font-medium tracking-tight" style="color: var(--q-ink);">2018</div>
          <span class="q-mono mt-1 inline-block">since</span>
        </div>
        <div>
          <div class="font-mono text-4xl font-medium tracking-tight" style="color: var(--q-ink);">{String(featuredCount).padStart(2, '0')}</div>
          <span class="q-mono mt-1 inline-block">picks</span>
        </div>
        <div>
          <div class="font-mono text-4xl font-medium tracking-tight" style="color: var(--q-navy);">+</div>
          <span class="q-mono mt-1 inline-block">in progress</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─────────── FILTER BAR ─────────── -->
  <section
    class="px-4 sm:px-6 lg:px-10 xl:px-[72px] py-4"
    style="background: var(--q-paper-soft); border-top: 1px solid var(--q-line); border-bottom: 1px solid var(--q-line); position: sticky; top: 72px; z-index: 4;"
  >
    <div class="max-w-screen-xl mx-auto flex flex-wrap justify-between items-center gap-4">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="q-mono">filter</span>
        {['all', ...allTags.slice(0, 8)].map((tag, i) => (
          <button
            class={`q-filter-pill ${i === 0 ? 'active' : ''}`}
            data-tag={tag}
          >
            {tag}
          </button>
        ))}
      </div>
      <div class="flex items-center gap-4">
        <span class="q-mono">{projects.length} entries</span>
      </div>
    </div>
  </section>

  <!-- ─────────── PROJECT GRID ─────────── -->
  <section class="px-4 sm:px-6 lg:px-10 xl:px-[72px] py-12 lg:py-14 max-w-screen-xl mx-auto">

    <!-- Empty state -->
    <div id="q-empty" class="hidden text-center py-20">
      <div class="text-6xl mb-4" style="color: var(--q-ink-fade);">∅</div>
      <p class="q-mono">{locale === 'zh-tw' ? '沒有符合的結果' : 'no matching results'}</p>
    </div>

    <!-- Grid -->
    <div id="q-project-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10 reveal">
      {projects.map((p) => {
        const title = locale === 'zh-tw' ? (p.data.title_zh || p.id) : p.data.title_en;
        const desc = locale === 'zh-tw' ? p.data.description_zh : p.data.description_en;
        const year = p.data.startDate ? p.data.startDate.getFullYear() : '—';

        return (
          <a
            href={`${basePath}/projects/${p.id}`}
            class="block no-underline group project-card reveal-item"
            data-tags={JSON.stringify(p.data.tags)}
          >
            <!-- Plate -->
            <div class="q-plate" style="aspect-ratio: 4/3; overflow: hidden;">
              {p.data.image ? (
                <img
                  src={assetUrl(p.data.image)}
                  alt={title}
                  style="width: 100%; height: 100%; object-fit: cover; display: block;"
                  loading="lazy"
                />
              ) : (
                <div style="position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; height: 100%;">
                  <span class="q-mono">{title}</span>
                </div>
              )}
            </div>

            <!-- Meta -->
            <div class="mt-4 flex justify-between items-baseline">
              <span class="q-mono" style="color: var(--q-navy);">
                {String(p.data.order || 1).padStart(2, '0')} · {p.data.status}
              </span>
              <span class="q-mono">{year}</span>
            </div>

            <h3
              class="mt-2 text-lg md:text-[22px] font-bold tracking-tight group-hover:opacity-75 transition-opacity"
              style="color: var(--q-ink);"
            >
              {title}
              {p.data.featured && <span class="ml-2 q-pill q-pill--accent">★</span>}
            </h3>

            <p class="mt-1.5 text-sm leading-[1.65]" style="color: var(--q-ink-soft); max-width: 420px;">
              {desc?.slice(0, 80)}{(desc?.length ?? 0) > 80 ? '…' : ''}
            </p>

            <div class="mt-3 flex gap-1.5 flex-wrap">
              {p.data.tags.slice(0, 3).map((tag: string) => (
                <span class="q-pill">{tag}</span>
              ))}
              {p.data.tags.length > 3 && <span class="q-pill">+{p.data.tags.length - 3}</span>}
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- ─────────── IN PROGRESS ─────────── -->
  <section class="px-4 sm:px-6 lg:px-10 xl:px-[72px] pb-20 lg:pb-[120px] max-w-screen-xl mx-auto">
    <div
      class="grid grid-cols-1 md:grid-cols-[auto_1fr_auto] gap-6 md:gap-9 items-center pt-12"
      style="border-top: 1px solid var(--q-line);"
    >
      <div
        class="hidden md:block font-mono text-7xl lg:text-[88px] leading-[0.85] tracking-tighter"
        style="color: var(--q-navy); font-weight: 400;"
      >+</div>
      <div>
        <span class="q-section-label">—— next · {locale === 'zh-tw' ? '進行中' : 'in progress'}</span>
        <h3 class="mt-2 text-2xl md:text-[28px] font-bold tracking-tight" style="color: var(--q-ink);">
          {locale === 'zh-tw' ? '還有些東西躺在抽屜裡' : 'More things sitting in the drawer'}
        </h3>
        <p class="mt-1.5 text-sm leading-[1.65] max-w-[600px]" style="color: var(--q-ink-soft);">
          {locale === 'zh-tw'
            ? '桌面型 AI、世界觀腳本、新一輪 OST、像素場景集 — 都還在寫。'
            : 'Desktop AI, worldbuilding scripts, new OST batch, pixel scene packs — all in progress.'}
        </p>
      </div>
      <a
        href={`${basePath}/updates`}
        class="text-sm font-medium no-underline transition-opacity hover:opacity-70"
        style="color: var(--q-ink); border-bottom: 1.5px solid var(--q-navy); padding-bottom: 3px;"
      >
        {locale === 'zh-tw' ? '看動態' : 'View updates'} →
      </a>
    </div>
  </section>

</BaseLayout>

<style>
  .q-filter-pill {
    padding: 6px 14px;
    border-radius: 999px;
    background: transparent;
    color: var(--q-ink);
    border: 1px solid var(--q-line);
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.1em;
    cursor: pointer;
    text-transform: uppercase;
    transition: all 0.15s;
  }

  .q-filter-pill:hover {
    border-color: var(--q-line-hard);
  }

  .q-filter-pill.active {
    background: var(--q-ink);
    color: var(--q-paper);
    border-color: var(--q-ink);
  }

  .project-card {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .project-card[data-hidden="true"] {
    display: none;
  }
</style>

<script>
  function initProjectFilters() {
    const pills = document.querySelectorAll<HTMLButtonElement>('.q-filter-pill');
    const cards = document.querySelectorAll<HTMLElement>('.project-card');
    const grid = document.getElementById('q-project-grid');
    const empty = document.getElementById('q-empty');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const tag = pill.dataset.tag || 'all';

        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');

        let visible = 0;
        cards.forEach((card) => {
          const tags: string[] = JSON.parse(card.dataset.tags || '[]');
          const match = tag === 'all' || tags.includes(tag);
          card.setAttribute('data-hidden', match ? 'false' : 'true');
          if (match) visible++;
        });

        if (empty && grid) {
          if (visible === 0) {
            empty.classList.remove('hidden');
            grid.classList.add('hidden');
          } else {
            empty.classList.add('hidden');
            grid.classList.remove('hidden');
          }
        }
      });
    });
  }

  function initRevealAnimation() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced) return;
    const observer = new IntersectionObserver(
      (entries) => { for (const e of entries) if (e.isIntersecting) e.target.classList.add('reveal-visible'); },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
    );
    document.querySelectorAll('.reveal-item').forEach((el) => observer.observe(el));
  }

  document.addEventListener('DOMContentLoaded', () => { initProjectFilters(); initRevealAnimation(); });
  document.addEventListener('astro:page-load', () => { initProjectFilters(); initRevealAnimation(); });
</script>
