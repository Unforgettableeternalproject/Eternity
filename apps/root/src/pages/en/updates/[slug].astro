---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';

export async function getStaticPaths() {
  const updates = await getCollection('updates');
  
  return updates.map((update) => ({
    params: { slug: update.id },
    props: { update },
  }));
}

const { update } = Astro.props;
const locale = 'en';

// Load markdoc content from subdirectory
let Content = null;
let markdocContent = '';
try {
  const contentPath = join(process.cwd(), 'src', 'content', 'updates', update.id, 'content_en.mdoc');
  markdocContent = await readFile(contentPath, 'utf-8');
} catch (e) {
  // No content file, that's okay
  console.log(`No content_en.mdoc found for ${update.id}`);
}

const formatDate = (date: Date) => {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
};

const getCategoryLabel = (category: string) => {
  const labels = {
    website: 'Website',
    project: 'Project',
    announcement: 'Announcement',
    other: 'Other',
  };
  return labels[category as keyof typeof labels] || category;
};

const getCategoryColor = (category: string) => {
  const colors = {
    website: 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300',
    project: 'bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-300',
    announcement: 'bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300',
    other: 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300',
  };
  return colors[category as keyof typeof colors] || colors.other;
};
---

<BaseLayout 
  title={`${update.data.title_en || update.id} - Updates`}
  description={update.data.description_en}
>
  <div class="container-custom py-20 min-h-[calc(100vh-12rem)]">
    <article class="max-w-4xl mx-auto">
      <!-- Back Button -->
      <a 
        href="/en/updates"
        class="inline-flex items-center text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 mb-8 transition-colors"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        Back to Updates
      </a>

      <!-- Header -->
      <header class="mb-12 space-y-6">
        <div class="flex items-center gap-3">
          <span class={`px-3 py-1 text-sm rounded-full font-medium ${getCategoryColor(update.data.category)}`}>
            {getCategoryLabel(update.data.category)}
          </span>
          <time class="text-slate-500 dark:text-slate-400">
            {formatDate(update.data.date)}
          </time>
        </div>

        <h1 class="text-4xl md:text-5xl font-bold text-slate-900 dark:text-white">
          {update.data.title_en || update.id}
        </h1>

        <p class="text-xl text-slate-600 dark:text-slate-300">
          {update.data.description_en}
        </p>
      </header>

      <!-- Divider -->
      <div class="h-px bg-gradient-to-r from-transparent via-slate-300 dark:via-slate-700 to-transparent mb-12"></div>

      <!-- Content -->
      <div class="prose prose-lg dark:prose-invert max-w-none min-h-[calc(100vh-12rem)]">
        {markdocContent ? (
          <div set:html={markdocContent} />
        ) : (
          <div class="text-center py-12 text-slate-500 dark:text-slate-400">
            <p>No detailed content available for this update</p>
          </div>
        )}
      </div>
    </article>
  </div>
</BaseLayout>
