---
import { getCurrentLocale, getTranslations } from '../i18n/utils';
import { getCard } from '../lib/api';
import MusicPlayer from './MusicPlayer';

const locale = getCurrentLocale(Astro.url);
const t = getTranslations(locale);

// 從 D1 獲取音樂卡片資料
const musicCardRaw = await getCard('card-music');
const musicCard = musicCardRaw?.content as {
  enabled?: boolean;
  tracks?: { title: string; artist: string; url: string; cover?: string }[];
} | null;

// Music 資料（優先使用 D1，fallback 到硬編碼，並過濾掉沒有 url 的曲目）
const tracks = (
  musicCard?.tracks || [
    {
      title: locale === 'zh-tw' ? '示例曲目 1' : 'Sample Track 1',
      artist: 'Artist',
      url: '/music/track1.mp3',
    },
    {
      title: locale === 'zh-tw' ? '示例曲目 2' : 'Sample Track 2',
      artist: 'Artist',
      url: '/music/track2.mp3',
    },
  ]
).filter(
  (
    track
  ): track is { title: string; artist: string; url: string; cover?: string } =>
    !!track.url
);
---

{
  musicCard?.enabled && (
    <div id="global-music-player-container" transition:persist="music-player">
      <MusicPlayer
        client:only="react"
        tracks={tracks}
        locale={locale}
        translations={t.musicPlayer}
      />
    </div>
  )
}

<script>
  // 從 URL 獲取當前語言和翻譯
  function getCurrentLanguageData() {
    const pathname = window.location.pathname;
    const isZhTw = pathname.startsWith('/zh-tw');
    const locale = isZhTw ? 'zh-tw' : 'en';

    // 根據語言返回對應的翻譯
    const translations = isZhTw
      ? {
          title: '音樂播放器',
          paused: '⏸️ 音樂已暫停',
          playing: '▶️ 繼續播放',
        }
      : {
          title: 'Music Player',
          paused: '⏸️ Music Paused',
          playing: '▶️ Now Playing',
        };

    return { locale, translations };
  }

  // 通知語言變化
  function notifyLanguageChange() {
    const { locale, translations } = getCurrentLanguageData();

    const event = new CustomEvent('music-player-language-change', {
      detail: { locale, translations },
    });
    window.dispatchEvent(event);
  }

  // 監聽頁面切換完成事件
  document.addEventListener('astro:after-swap', notifyLanguageChange);

  // 初次載入時也執行
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', notifyLanguageChange);
  } else {
    notifyLanguageChange();
  }
</script>
