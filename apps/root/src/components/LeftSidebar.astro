---
import { getCurrentLocale } from '../i18n/utils';
import { getCollection, getEntry } from 'astro:content';
import MusicPlayer from './MusicPlayer';
import SidebarCard from './SidebarCard';
import { envConfig } from '../config/env';

const locale = getCurrentLocale(Astro.url);

// 獲取訪客計數器 API URL
const VISITOR_API_URL =
  import.meta.env.PUBLIC_VISITOR_API_URL ||
  'https://eternity-visitor-counter.ptyc4076.workers.dev';

// 獲取最近的更新
const allUpdates = await getCollection('updates');
const latestUpdate = allUpdates.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)[0];

// 從 Keystatic 獲取卡片資料（singleton）
const quoteCard = await getEntry('card-quote', 'index');
const musicCard = await getEntry('card-music', 'index');
const visitorCounterCard = await getEntry('card-visitor-counter', 'index');
const latestUpdateCard = await getEntry('card-latest-update', 'index');

// Quote 資料（從陣列中隨機選擇）
const quotes = quoteCard?.data
  ? locale === 'zh-tw'
    ? quoteCard.data.quotes_zh
    : quoteCard.data.quotes_en
  : null;

const randomQuote =
  quotes && quotes.length > 0
    ? quotes[Math.floor(Math.random() * quotes.length)]
    : {
        text:
          locale === 'zh-tw'
            ? '代碼如詩，細節成就完美'
            : 'Code is poetry, details make perfection',
        author: '',
      };

// Music 資料（優先使用 Keystatic，fallback 到硬編碼，並過濾掉沒有 url 的曲目）
const tracks = (
  musicCard?.data?.tracks || [
    {
      title: locale === 'zh-tw' ? '示例曲目 1' : 'Sample Track 1',
      artist: 'Artist',
      url: '/music/track1.mp3',
    },
    {
      title: locale === 'zh-tw' ? '示例曲目 2' : 'Sample Track 2',
      artist: 'Artist',
      url: '/music/track2.mp3',
    },
  ]
).filter(
  (
    track
  ): track is { title: string; artist: string; url: string; cover?: string } =>
    !!track.url
);

// 定義卡片 ID 列表
const cardIds = ['music-player', 'visitor-counter'];
if (latestUpdate) cardIds.push('latest-update');
cardIds.push('quote');
---

<aside class="fixed left-4 top-32 w-64 z-30" id="left-sidebar">
  <div class="flex flex-col" id="left-sidebar-container">
    {
      musicCard?.data.enabled && (
        <SidebarCard client:load id="music-player">
          <MusicPlayer
            client:load
            tracks={tracks}
            locale={locale}
            transition:persist="music-player"
          />
        </SidebarCard>
      )
    }

    {
      visitorCounterCard?.data.enabled && (
        <SidebarCard
          client:load
          id="visitor-counter"
          transition:persist="visitor-counter"
        >
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <svg
                class="w-5 h-5 text-secondary-400"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
              </svg>
              <span class="text-sm font-medium text-slate-700 dark:text-slate-200">
                {locale === 'zh-tw' ? '訪客' : 'Visitors'}
              </span>
            </div>
            <div class="text-2xl font-bold bg-gradient-to-r from-primary-400 to-secondary-400 bg-clip-text text-transparent">
              <span id="visitor-count">---</span>
            </div>
          </div>
          <div class="mt-2 flex items-center justify-between">
            <span class="text-xs text-slate-600 dark:text-slate-400">
              {locale === 'zh-tw' ? '感謝您的來訪' : 'Thanks for visiting'}
            </span>
            {envConfig.showDevTools && (
              <button
                id="reset-visitor-count"
                class="text-[10px] px-2 py-1 bg-red-500/20 text-red-400 rounded hover:bg-red-500/30 transition-colors"
                title="Reset counter (dev only)"
              >
                Reset
              </button>
            )}
          </div>
        </SidebarCard>
      )
    }

    {
      latestUpdate && latestUpdateCard?.data.enabled && (
        <SidebarCard client:load id="latest-update">
          <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100 mb-3 flex items-center gap-2">
            <svg
              class="w-4 h-4 text-primary-400"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
            </svg>
            {locale === 'zh-tw' ? '最新動態' : 'Latest Update'}
          </h3>
          <div class="bg-gradient-to-br from-primary-500/10 to-secondary-500/10 rounded-lg p-3 border border-primary-400/20">
            <div class="text-sm text-slate-700 dark:text-slate-200 mb-1 font-medium truncate">
              {locale === 'zh-tw'
                ? latestUpdate.id
                : latestUpdate.data.title_en}
            </div>
            <div class="text-xs text-slate-600 dark:text-slate-400">
              {latestUpdate.data.date.toLocaleDateString(
                locale === 'zh-tw' ? 'zh-TW' : 'en-US',
                {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                }
              )}
            </div>
          </div>
        </SidebarCard>
      )
    }

    {
      quoteCard?.data.enabled && (
        <SidebarCard client:load id="quote">
          <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100 mb-3 flex items-center gap-2">
            <svg
              class="w-4 h-4 text-primary-400"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z" />
            </svg>
            {locale === 'zh-tw' ? '本日名言' : 'Quote of the Day'}
          </h3>
          <div class="flex flex-col gap-2">
            <p class="text-sm italic text-slate-700 dark:text-slate-200 leading-relaxed">
              "{randomQuote.text}"
            </p>
            {randomQuote.author && (
              <p class="text-xs text-slate-600 dark:text-slate-500 text-right">
                — {randomQuote.author}
              </p>
            )}
          </div>
        </SidebarCard>
      )
    }
  </div>
</aside>

<script>
  // 簡易拖曳排序功能
  let draggedElement: HTMLElement | null = null;

  function initDragAndDrop() {
    const container = document.getElementById('left-sidebar-container');
    if (!container) return;

    const cards = container.querySelectorAll('[data-card-id]');

    cards.forEach((card) => {
      const cardEl = card as HTMLElement;
      const handle = cardEl.querySelector('.drag-handle') as HTMLElement;

      if (!handle) return;

      handle.addEventListener('mousedown', () => {
        cardEl.setAttribute('draggable', 'true');
      });

      cardEl.addEventListener('dragstart', (e) => {
        draggedElement = cardEl;
        cardEl.style.opacity = '0.5';
        cardEl.style.transform = 'scale(0.95)';

        // 為其他卡片添加輕微縮小效果
        cards.forEach((otherCard) => {
          if (otherCard !== cardEl) {
            (otherCard as HTMLElement).style.transform = 'scale(0.98)';
            (otherCard as HTMLElement).style.opacity = '0.7';
          }
        });
      });

      cardEl.addEventListener('dragend', () => {
        cardEl.style.opacity = '1';
        cardEl.style.transform = 'scale(1)';
        cardEl.setAttribute('draggable', 'false');

        // 恢復其他卡片
        cards.forEach((otherCard) => {
          (otherCard as HTMLElement).style.transform = 'scale(1)';
          (otherCard as HTMLElement).style.opacity = '1';
        });

        draggedElement = null;
      });

      cardEl.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (!draggedElement || draggedElement === cardEl) return;

        const bounding = cardEl.getBoundingClientRect();
        const offset = e.clientY - bounding.top;

        if (offset > bounding.height / 2) {
          cardEl.after(draggedElement);
        } else {
          cardEl.before(draggedElement);
        }
      });
    });
  }

  // 初始化
  document.addEventListener('astro:page-load', initDragAndDrop);
  initDragAndDrop();
</script>

<script define:vars={{ VISITOR_API_URL }}>
  // Cloudflare Workers 訪客計數器
  let hasInitialized = false; // 追蹤是否已初始化

  async function updateVisitorCount() {
    // 如果已經初始化且元素有內容，跳過
    const countElement = document.getElementById('visitor-count');
    if (!countElement) return;

    if (hasInitialized && countElement.textContent !== '---') {
      return; // 已有數據，不重複查詢
    }

    // 檢查是否為主頁 (根路徑或語言根路徑)
    const currentPath = window.location.pathname;
    const isHomePage =
      currentPath === '/' ||
      currentPath === '/zh-tw' ||
      currentPath === '/zh-tw/' ||
      currentPath === '/en' ||
      currentPath === '/en/';

    try {
      // 獲取當前訪客數
      const countResponse = await fetch(`${VISITOR_API_URL}/api/visitor/count`);
      const countData = await countResponse.json();
      let totalVisitors = countData.totalVisitors || 0;

      // 只在主頁且本次會話未追蹤時追蹤訪客
      if (isHomePage) {
        const hasTracked = sessionStorage.getItem('visitor-tracked');

        if (!hasTracked) {
          const trackResponse = await fetch(
            `${VISITOR_API_URL}/api/visitor/track`,
            {
              method: 'POST',
            }
          );
          const trackData = await trackResponse.json();
          totalVisitors = trackData.totalVisitors;
          sessionStorage.setItem('visitor-tracked', 'true');
        }
      }

      // 動畫顯示計數
      let current = 0;
      const target = totalVisitors;
      const duration = 1000;
      const increment = target / (duration / 16);

      const animate = () => {
        current += increment;
        if (current < target) {
          countElement.textContent = Math.floor(current).toString();
          requestAnimationFrame(animate);
        } else {
          countElement.textContent = target.toString();
        }
      };

      animate();
      hasInitialized = true; // 標記已初始化
    } catch (error) {
      console.error('訪客計數器錯誤:', error);
      countElement.textContent = '---';
    }

    // 開發/測試環境顯示重置按鈕（已移除功能，因為數據在 Workers 端）
    const resetButton = document.getElementById('reset-visitor-count');
    if (resetButton) {
      resetButton.style.display = 'none'; // 隱藏重置按鈕
    }
  }

  document.addEventListener('DOMContentLoaded', updateVisitorCount);
  document.addEventListener('astro:page-load', updateVisitorCount);
</script>
