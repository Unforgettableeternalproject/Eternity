---
import { envConfig } from '../config/env';

// 只在開發和測試環境顯示管理員入口，正式環境不顯示
const showAdmin = envConfig.showDevTools;
---

{
  showAdmin && (
    <div
      id="admin-entry"
      class="fixed top-5 right-8 z-50 cursor-move select-none"
    >
      <button
        id="admin-btn"
        class="px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-110 flex items-center gap-2"
        aria-label="Admin Access"
        type="button"
      >
        <span class="text-xl">🔐</span>
        <span>Admin</span>
      </button>
    </div>
  )
}

<script>
  const adminBtn = document.getElementById('admin-btn');
  const adminEntry = document.getElementById('admin-entry');

  // Admin 按鈕點擊事件
  if (adminBtn) {
    adminBtn.addEventListener('click', (e) => {
      // 防止拖曳時觸發點擊
      if ((adminEntry as any)?._isDragging) return;

      const password = prompt('輸入管理員密碼 / Enter admin password:');

      if (password === '426067') {
        window.location.href = '/keystatic';
      } else if (password !== null) {
        alert('密碼錯誤！ / Incorrect password!');
      }
    });
  }

  // 拖曳功能
  if (adminEntry) {
    let isDragging = false;
    let currentX = 0;
    let currentY = 0;
    let initialX = 0;
    let initialY = 0;
    let xOffset = 0;
    let yOffset = 0;

    adminEntry.addEventListener('mousedown', dragStart);
    document.addEventListener('mousemove', drag);
    document.addEventListener('mouseup', dragEnd);

    function dragStart(e: MouseEvent) {
      initialX = e.clientX - xOffset;
      initialY = e.clientY - yOffset;

      if (e.target === adminEntry || adminEntry.contains(e.target as Node)) {
        isDragging = true;
        (adminEntry as any)._isDragging = false; // 重置拖曳標記
      }
    }

    function drag(e: MouseEvent) {
      if (isDragging) {
        e.preventDefault();

        currentX = e.clientX - initialX;
        currentY = e.clientY - initialY;

        xOffset = currentX;
        yOffset = currentY;

        // 標記為正在拖曳（用於防止觸發點擊）
        if (Math.abs(currentX) > 5 || Math.abs(currentY) > 5) {
          (adminEntry as any)._isDragging = true;
        }

        setTranslate(currentX, currentY, adminEntry);
      }
    }

    function dragEnd() {
      if (isDragging) {
        // 延遲重置拖曳標記，避免立即觸發點擊
        setTimeout(() => {
          (adminEntry as any)._isDragging = false;
        }, 100);
      }
      initialX = currentX;
      initialY = currentY;
      isDragging = false;
    }

    function setTranslate(xPos: number, yPos: number, el: HTMLElement) {
      el.style.transform = `translate(${xPos}px, ${yPos}px)`;
    }
  }
</script>

<style>
  #admin-entry {
    animation: fadeIn 0.3s ease-in;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #admin-btn {
    backdrop-filter: blur(10px);
  }

  #admin-btn:hover {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }
</style>
