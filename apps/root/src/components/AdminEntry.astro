---
// 只在開發環境顯示管理員入口
const isDev = import.meta.env.DEV;
---

{isDev && (
  <div id="admin-entry" class="fixed bottom-8 right-8 z-50">
    <button
      id="admin-btn"
      class="px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white font-semibold rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-110 flex items-center gap-2"
      aria-label="Admin Access"
      type="button"
    >
      <span class="text-xl">🔐</span>
      <span>Admin</span>
    </button>
  </div>
)}

<script>
  const adminBtn = document.getElementById('admin-btn');
  
  if (adminBtn) {
    adminBtn.addEventListener('click', () => {
      const password = prompt('輸入管理員密碼 / Enter admin password:');
      
      if (password === '426067') {
        window.location.href = '/keystatic';
      } else if (password !== null) {
        alert('密碼錯誤！ / Incorrect password!');
      }
    });
  }
</script>

<style>
  #admin-entry {
    animation: fadeIn 0.3s ease-in;
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  #admin-btn {
    backdrop-filter: blur(10px);
  }
  
  #admin-btn:hover {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }
</style>
