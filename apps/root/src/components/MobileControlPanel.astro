---
/**
 * Mobile Control Panel - iPhone 控制中心風格的底部面板
 * 顯示所有側邊欄卡片（左右合併）
 */
import { getCurrentLocale } from '../i18n/utils';
import { getCollection, getEntry } from 'astro:content';
import GlobalMusicPlayer from './GlobalMusicPlayer.astro';

const locale = getCurrentLocale(Astro.url);

// 獲取訪客計數器 API URL
const VISITOR_API_URL =
  import.meta.env.PUBLIC_VISITOR_API_URL ||
  'https://eternity-visitor-counter.ptyc4076.workers.dev';

// 獲取最近的更新
const allUpdates = await getCollection('updates');
const latestUpdate = allUpdates.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
)[0];

// 獲取所有項目和統計數據
const allProjects = await getCollection('projects');

const stats = [
  {
    label: locale === 'zh-tw' ? '專案' : 'Projects',
    value: allProjects.length,
    icon: 'M4 6h16M4 12h16M4 18h16',
    color: 'from-blue-500 to-cyan-500',
  },
  {
    label: locale === 'zh-tw' ? '更新' : 'Updates',
    value: allUpdates.length,
    icon: 'M13 10V3L4 14h7v7l9-11h-7z',
    color: 'from-purple-500 to-pink-500',
  },
  {
    label: locale === 'zh-tw' ? '活躍專案' : 'Active',
    value: allProjects.filter((p) => p.data.status === 'active').length,
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
    color: 'from-green-500 to-emerald-500',
  },
  {
    label: locale === 'zh-tw' ? '已完成' : 'Completed',
    value: allProjects.filter((p) => p.data.status === 'completed').length,
    icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
    color: 'from-indigo-500 to-purple-500',
  },
];

// 從 Keystatic 獲取卡片資料
const quoteCard = await getEntry('card-quote', 'index');
const musicCard = await getEntry('card-music', 'index');
const visitorCounterCard = await getEntry('card-visitor-counter', 'index');
const latestUpdateCard = await getEntry('card-latest-update', 'index');
const quickStatsCard = await getEntry('card-quick-stats', 'index');

// Quote 資料
const quotes = quoteCard?.data
  ? locale === 'zh-tw'
    ? quoteCard.data.quotes_zh
    : quoteCard.data.quotes_en
  : null;

const randomQuote =
  quotes && quotes.length > 0
    ? quotes[Math.floor(Math.random() * quotes.length)]
    : {
        text:
          locale === 'zh-tw'
            ? '代碼如詩，細節成就完美'
            : 'Code is poetry, details make perfection',
        author: '',
      };

// Music 資料
const tracks = (
  musicCard?.data?.tracks || [
    {
      title: locale === 'zh-tw' ? '示例曲目 1' : 'Sample Track 1',
      artist: 'Artist',
      url: '/music/track1.mp3',
    },
    {
      title: locale === 'zh-tw' ? '示例曲目 2' : 'Sample Track 2',
      artist: 'Artist',
      url: '/music/track2.mp3',
    },
  ]
).filter(
  (
    track
  ): track is { title: string; artist: string; url: string; cover?: string } =>
    !!track.url
);
---

<!-- 手機版底部控制面板（僅在 < md 顯示） -->
<div
  class="md:hidden fixed bottom-0 left-0 right-0 z-50"
  id="mobile-control-panel-wrapper"
>
  <!-- 底部指示器（滑動手柄） -->
  <div
    id="mobile-panel-handle"
    class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-white/90 to-white/70 dark:from-slate-900/90 dark:to-slate-900/70 backdrop-blur-xl rounded-t-3xl shadow-2xl cursor-pointer transition-all duration-300"
  >
    <div class="flex flex-col items-center py-3">
      <div class="w-12 h-1.5 bg-slate-300 dark:bg-slate-600 rounded-full mb-2">
      </div>
      <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">
        {locale === 'zh-tw' ? '點擊查看更多' : 'Tap for more'}
      </div>
    </div>
  </div>

  <!-- 面板內容 -->
  <div
    id="mobile-panel-content"
    class="absolute bottom-0 left-0 right-0 bg-gradient-to-br from-white/95 to-slate-50/95 dark:from-slate-900/95 dark:to-slate-800/95 backdrop-blur-xl rounded-t-3xl shadow-2xl transform translate-y-full transition-transform duration-500 ease-out"
    style="max-height: 85vh;"
  >
    <!-- 關閉手柄 -->
    <div
      class="sticky top-0 bg-gradient-to-b from-white/90 to-transparent dark:from-slate-900/90 z-10 pt-4 pb-2"
    >
      <div
        class="flex flex-col items-center cursor-pointer"
        id="mobile-panel-close-handle"
      >
        <div
          class="w-12 h-1.5 bg-slate-400 dark:bg-slate-500 rounded-full mb-2"
        >
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-400 font-medium">
          {locale === 'zh-tw' ? '點擊關閉' : 'Tap to close'}
        </div>
      </div>
    </div>

    <!-- 卡片內容區域 -->
    <div
      class="overflow-y-auto px-4 pb-8"
      style="max-height: calc(85vh - 60px);"
    >
      <div class="grid grid-cols-1 gap-4">
        <!-- 訪客計數器 -->
        {
          visitorCounterCard?.data.enabled && (
            <div class="bg-white/60 dark:bg-slate-800/60 backdrop-blur-sm rounded-2xl p-4 shadow-lg">
              <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100 mb-3 flex items-center gap-2">
                <svg
                  class="w-4 h-4 text-secondary-400"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                </svg>
                {locale === 'zh-tw' ? '訪客計數' : 'Visitor Count'}
              </h3>
              <div class="flex items-baseline gap-2">
                <span
                  id="mobile-visitor-count"
                  class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-secondary-400 to-secondary-600"
                >
                  ---
                </span>
                <span class="text-sm text-slate-500 dark:text-slate-400">
                  {locale === 'zh-tw' ? '次訪問' : 'visits'}
                </span>
              </div>
            </div>
          )
        }

        <!-- 快速統計 -->
        {
          quickStatsCard?.data.enabled && (
            <div class="bg-white/60 dark:bg-slate-800/60 backdrop-blur-sm rounded-2xl p-4 shadow-lg">
              <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100 mb-4 flex items-center gap-2">
                <svg
                  class="w-4 h-4 text-primary-400"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" />
                </svg>
                {locale === 'zh-tw' ? '快速統計' : 'Quick Stats'}
              </h3>
              <div class="grid grid-cols-2 gap-3">
                {stats.map((stat) => (
                  <div
                    class:list={[
                      'group relative overflow-hidden rounded-lg bg-gradient-to-br p-3 hover:scale-105 transition-transform duration-200',
                      stat.color,
                    ]}
                  >
                    <div class="absolute inset-0 bg-black/10" />
                    <div class="relative">
                      <svg
                        class="w-5 h-5 text-white/90 mb-2"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d={stat.icon}
                        />
                      </svg>
                      <div class="text-2xl font-bold text-white">
                        {stat.value}
                      </div>
                      <div class="text-xs text-white/90 font-medium">
                        {stat.label}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )
        }

        <!-- 最新更新 -->
        {
          latestUpdateCard?.data.enabled && latestUpdate && (
            <div class="bg-white/60 dark:bg-slate-800/60 backdrop-blur-sm rounded-2xl p-4 shadow-lg">
              <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100 mb-3 flex items-center gap-2">
                <svg
                  class="w-4 h-4 text-accent-400"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
                </svg>
                {locale === 'zh-tw' ? '最新更新' : 'Latest Update'}
              </h3>
              <a
                href={`/${locale}/updates/${latestUpdate.id}`}
                class="block hover:opacity-80 transition-opacity"
              >
                <div class="text-sm font-semibold text-slate-800 dark:text-slate-100 mb-1">
                  {locale === 'zh-tw'
                    ? latestUpdate.data.title_zh || latestUpdate.id
                    : latestUpdate.data.title_en || latestUpdate.id}
                </div>
                <div class="text-xs text-slate-500 dark:text-slate-400">
                  {latestUpdate.data.date.toLocaleDateString(
                    locale === 'zh-tw' ? 'zh-TW' : 'en-US'
                  )}
                </div>
              </a>
            </div>
          )
        }

        <!-- 隨機格言 -->
        {
          quoteCard?.data.enabled && (
            <div class="bg-white/60 dark:bg-slate-800/60 backdrop-blur-sm rounded-2xl p-4 shadow-lg">
              <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100 mb-3 flex items-center gap-2">
                <svg
                  class="w-4 h-4 text-primary-400"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"
                  />
                </svg>
                {locale === 'zh-tw' ? '本日名言' : 'Quote of the Day'}
              </h3>
              <div class="text-sm italic text-slate-700 dark:text-slate-300 mb-2">
                "{randomQuote.text}"
              </div>
              {randomQuote.author && (
                <div class="text-xs text-slate-500 dark:text-slate-400 text-right">
                  — {randomQuote.author}
                </div>
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>

<script define:vars={{ VISITOR_API_URL }}>
  // 訪客計數器（手機版）
  let hasInitialized = false;

  async function updateMobileVisitorCount() {
    const countElement = document.getElementById('mobile-visitor-count');
    if (!countElement) return;

    if (hasInitialized && countElement.textContent !== '---') {
      return;
    }

    const currentPath = window.location.pathname;
    const isHomePage =
      currentPath === '/' ||
      currentPath === '/zh-tw' ||
      currentPath === '/zh-tw/' ||
      currentPath === '/en' ||
      currentPath === '/en/';

    try {
      const countResponse = await fetch(`${VISITOR_API_URL}/api/visitor/count`);
      const countData = await countResponse.json();
      let totalVisitors = countData.totalVisitors || 0;

      if (isHomePage) {
        const hasTracked = sessionStorage.getItem('visitor-tracked');

        if (!hasTracked) {
          const trackResponse = await fetch(
            `${VISITOR_API_URL}/api/visitor/track`,
            {
              method: 'POST',
            }
          );
          const trackData = await trackResponse.json();
          totalVisitors = trackData.totalVisitors;
          sessionStorage.setItem('visitor-tracked', 'true');
        }
      }

      // 動畫顯示計數
      let current = 0;
      const target = totalVisitors;
      const duration = 1000;
      const increment = target / (duration / 16);

      const animate = () => {
        current += increment;
        if (current < target) {
          countElement.textContent = Math.floor(current).toString();
          requestAnimationFrame(animate);
        } else {
          countElement.textContent = target.toString();
        }
      };

      animate();
      hasInitialized = true;
    } catch (error) {
      console.error('訪客計數器錯誤:', error);
      countElement.textContent = '---';
    }
  }

  document.addEventListener('DOMContentLoaded', updateMobileVisitorCount);
  document.addEventListener('astro:page-load', updateMobileVisitorCount);
</script>

<script>
  // 手機版控制面板滑動控制
  function initMobileControlPanel() {
    const panelContent = document.getElementById('mobile-panel-content');
    const handle = document.getElementById('mobile-panel-handle');
    const closeHandle = document.getElementById('mobile-panel-close-handle');

    if (!panelContent || !handle || !closeHandle) return;

    let startY = 0;
    let currentY = 0;
    let isDragging = false;
    let isOpen = false;

    // 打開面板
    function openPanel() {
      if (!panelContent) return;
      panelContent.style.transform = 'translateY(0)';
      handle && (handle.style.opacity = '0');
      handle && (handle.style.pointerEvents = 'none');
      isOpen = true;
    }

    // 關閉面板
    function closePanel() {
      if (!panelContent) return;
      panelContent.style.transform = 'translateY(100%)';
      handle && (handle.style.opacity = '1');
      handle && (handle.style.pointerEvents = 'auto');
      isOpen = false;
    }

    // 點擊手柄打開
    handle.addEventListener('click', openPanel);

    // 點擊關閉手柄關閉
    closeHandle.addEventListener('click', closePanel);

    // 觸摸滑動打開
    handle.addEventListener('touchstart', (e) => {
      startY = e.touches[0].clientY;
      isDragging = true;
    });

    handle.addEventListener('touchmove', (e) => {
      if (!isDragging) return;
      currentY = e.touches[0].clientY;
      const diff = startY - currentY;

      if (diff > 50) {
        openPanel();
        isDragging = false;
      }
    });

    handle.addEventListener('touchend', () => {
      isDragging = false;
    });

    // 觸摸滑動關閉
    closeHandle.addEventListener('touchstart', (e) => {
      startY = e.touches[0].clientY;
      isDragging = true;
    });

    closeHandle.addEventListener('touchmove', (e) => {
      if (!isDragging || !isOpen) return;
      currentY = e.touches[0].clientY;
      const diff = currentY - startY;

      if (diff > 50) {
        closePanel();
        isDragging = false;
      }
    });

    closeHandle.addEventListener('touchend', () => {
      isDragging = false;
    });

    // ESC 鍵關閉
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) {
        closePanel();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initMobileControlPanel);
  document.addEventListener('astro:page-load', initMobileControlPanel);
</script>
