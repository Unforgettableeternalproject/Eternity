---
/**
 * Navigation Component with Global Search
 * Wraps the UI Navigation with search functionality
 */
import ThemeToggle from '@uep/ui/ThemeToggle';
import GlobalSearch from './GlobalSearch';
import { getCurrentLocale, getTranslations } from '../i18n/utils';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const locale = getCurrentLocale(Astro.url);
const t = getTranslations(locale);

// Calculate alternate language path
function getAlternatePath(path: string, currentLocale: 'zh-tw' | 'en'): string {
  const targetLocale = currentLocale === 'zh-tw' ? 'en' : 'zh-tw';

  // Remove current locale prefix
  let cleanPath = path;
  if (path.startsWith('/en/')) {
    cleanPath = path.substring(3);
  } else if (path.startsWith('/en')) {
    cleanPath = path.substring(3) || '/';
  } else if (path.startsWith('/zh-tw/')) {
    cleanPath = path.substring(6);
  } else if (path.startsWith('/zh-tw')) {
    cleanPath = path.substring(6) || '/';
  }

  // Ensure cleanPath starts with '/'
  if (!cleanPath.startsWith('/')) {
    cleanPath = '/' + cleanPath;
  }

  // Add target locale prefix
  return `/${targetLocale}${cleanPath}`;
}

const alternatePath = getAlternatePath(currentPath, locale);
---

<!-- Quartz TopBar -->
<nav class="px-4 sm:px-6 lg:px-10 xl:px-16 py-5">
  <div class="flex items-center justify-between gap-6 max-w-screen-2xl mx-auto">
    <!-- Wordmark -->
    <a
      href={locale === 'zh-tw' ? '/zh-tw/' : '/en/'}
      class="flex items-baseline gap-2.5 no-underline"
    >
      <span
        class="text-lg font-bold tracking-tight"
        style="color: var(--q-ink);"
      >
        顏榕嶙
      </span>
      <span class="q-mono hidden sm:inline" style="font-size: 11px;"
        >· BERNIE</span
      >
    </a>

    <!-- Desktop Nav — text-only with underline active -->
    <nav class="hidden md:flex items-center justify-center gap-7 flex-1">
      {
        [
          {
            key: 'home',
            path: locale === 'zh-tw' ? '/zh-tw/' : '/en/',
            label: t.nav.home,
            num: '01',
          },
          {
            key: 'projects',
            path: locale === 'zh-tw' ? '/zh-tw/projects' : '/en/projects',
            label: t.nav.projects,
            num: '02',
          },
          {
            key: 'about',
            path: locale === 'zh-tw' ? '/zh-tw/about' : '/en/about',
            label: t.nav.about,
            num: '03',
          },
          {
            key: 'updates',
            path: locale === 'zh-tw' ? '/zh-tw/updates' : '/en/updates',
            label: t.nav.updates,
            num: '04',
          },
          {
            key: 'links',
            path: locale === 'zh-tw' ? '/zh-tw/links' : '/en/links',
            label: t.nav.links,
            num: '05',
          },
          {
            key: 'contact',
            path: locale === 'zh-tw' ? '/zh-tw/contact' : '/en/contact',
            label: t.nav.contact,
            num: '06',
          },
        ].map((item) => {
          const isActive =
            item.key === 'home'
              ? currentPath === '/' ||
                currentPath === '/zh-tw/' ||
                currentPath === '/en/'
              : currentPath.includes(`/${item.key}`);
          return (
            <a
              href={item.path}
              class="relative flex items-baseline gap-1.5 no-underline pb-0.5 transition-colors duration-200"
              style={
                isActive
                  ? `color: var(--q-ink); font-weight: 600;`
                  : `color: var(--q-ink-soft);`
              }
            >
              <span
                class="font-mono text-[10px] tracking-widest uppercase"
                style={
                  isActive
                    ? `color: var(--q-navy);`
                    : `color: var(--q-ink-fade);`
                }
              >
                {item.num}
              </span>
              <span class="text-sm" style="font-weight: inherit;">
                {item.label}
              </span>
              {isActive && (
                <span
                  class="absolute left-0 right-0 -bottom-[21px] h-px"
                  style="background: var(--q-ink);"
                />
              )}
            </a>
          );
        })
      }
    </nav>

    <!-- Right utilities -->
    <div class="hidden md:flex items-center gap-3">
      <!-- Inline search trigger styled as Quartz ⌘K box -->
      <div class="w-48 lg:w-56">
        <GlobalSearch client:load locale={locale} currentPath={currentPath} />
      </div>

      <span class="w-px h-3.5" style="background: var(--q-line);"></span>

      <!-- Language Switch -->
      <a
        href={alternatePath}
        data-lang-switch
        class="q-mono no-underline transition-opacity hover:opacity-70"
        style="font-size: 11px; color: var(--q-ink-mute);"
      >
        {locale === 'zh-tw' ? 'EN' : 'ZH'}
      </a>

      <!-- Theme Toggle -->
      <ThemeToggle />

      <!-- Admin -->
      <span class="w-px h-3.5" style="background: var(--q-line);"></span>
      <a
        href="/admin"
        class="q-mono no-underline transition-opacity hover:opacity-70"
        style="font-size: 10px; color: var(--q-ink-fade); letter-spacing: 0.14em;"
        title="Admin"
      >
        ●
      </a>
    </div>

    <!-- Mobile -->
    <div class="md:hidden flex items-center gap-2 flex-1">
      <div class="flex-1 flex justify-center mx-2">
        <div class="w-full max-w-xs">
          <GlobalSearch client:load locale={locale} currentPath={currentPath} />
        </div>
      </div>

      <div class="flex items-center gap-1.5">
        <a
          href={alternatePath}
          data-lang-switch
          class="inline-flex items-center justify-center w-8 h-8 text-xs font-medium transition-opacity hover:opacity-70"
          style="color: var(--q-ink-mute); border: 1px solid var(--q-line);"
          aria-label={locale === 'zh-tw'
            ? 'Switch to English'
            : '切換至繁體中文'}
        >
          {locale === 'zh-tw' ? 'EN' : 'ZH'}
        </a>

        <ThemeToggle data-mobile="true" />

        <button
          id="mobile-menu-button"
          class="p-1.5 transition-opacity hover:opacity-70"
          style="color: var(--q-ink-soft);"
          aria-label="Toggle mobile menu"
          aria-expanded="false"
          type="button"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              class="menu-open"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
            <path
              class="menu-close hidden"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden hidden overflow-hidden transition-all duration-300 ease-in-out"
  >
    <div
      class="flex flex-col space-y-0 pt-4 pb-2 mt-4"
      style="border-top: 1px solid var(--q-line);"
    >
      {
        [
          {
            key: 'home',
            path: locale === 'zh-tw' ? '/zh-tw/' : '/en/',
            label: t.nav.home,
          },
          {
            key: 'projects',
            path: locale === 'zh-tw' ? '/zh-tw/projects' : '/en/projects',
            label: t.nav.projects,
          },
          {
            key: 'about',
            path: locale === 'zh-tw' ? '/zh-tw/about' : '/en/about',
            label: t.nav.about,
          },
          {
            key: 'updates',
            path: locale === 'zh-tw' ? '/zh-tw/updates' : '/en/updates',
            label: t.nav.updates,
          },
          {
            key: 'links',
            path: locale === 'zh-tw' ? '/zh-tw/links' : '/en/links',
            label: t.nav.links,
          },
          {
            key: 'contact',
            path: locale === 'zh-tw' ? '/zh-tw/contact' : '/en/contact',
            label: t.nav.contact,
          },
        ].map((item) => {
          const isActive =
            item.key === 'home'
              ? currentPath === '/' ||
                currentPath === '/zh-tw/' ||
                currentPath === '/en/'
              : currentPath.includes(`/${item.key}`);
          return (
            <a
              href={item.path}
              class="text-sm font-medium transition-colors duration-200 px-3 py-2.5 no-underline"
              style={
                isActive
                  ? `color: var(--q-ink); font-weight: 600; border-left: 2px solid var(--q-ink);`
                  : `color: var(--q-ink-soft); border-left: 2px solid transparent;`
              }
            >
              {item.label}
            </a>
          );
        })
      }
    </div>
  </div>
</nav>

<script>
  // Mobile menu toggle
  function initMobileMenu() {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuOpen = document.querySelector('.menu-open');
    const menuClose = document.querySelector('.menu-close');

    if (!mobileMenuButton || !mobileMenu) {
      console.warn('Mobile menu elements not found:', {
        mobileMenuButton,
        mobileMenu,
      });
      return;
    }

    // 移除舊的事件監聽器（如果有）
    const newButton = mobileMenuButton.cloneNode(true);
    mobileMenuButton.parentNode?.replaceChild(newButton, mobileMenuButton);

    // 在新按鈕上添加事件監聽器
    newButton.addEventListener('click', (e) => {
      console.log('Mobile menu button clicked');
      const isHidden = mobileMenu.classList.toggle('hidden');

      const newMenuOpen = document.querySelector('.menu-open');
      const newMenuClose = document.querySelector('.menu-close');

      newMenuOpen?.classList.toggle('hidden');
      newMenuClose?.classList.toggle('hidden');

      // 更新 aria-expanded（!isHidden 因為 toggle 返回的是切換後的狀態）
      if (newButton instanceof HTMLElement) {
        newButton.setAttribute('aria-expanded', (!isHidden).toString());
      }
    });

    console.log('Mobile menu initialized');
  }

  document.addEventListener('DOMContentLoaded', initMobileMenu);
  document.addEventListener('astro:page-load', initMobileMenu);
</script>

<script>
  // 語言切換：文字 scramble ↔ decode 轉場動畫
  // 出場：文字 scramble → 導航
  // 入場：文字從亂碼逐步 decode 回正確內容

  const SCRAMBLE_CHARS =
    'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%&<>[]{}|/~+-=*^';
  const OUT_ROUNDS = 3; // 出場 scramble 輪數
  const OUT_INTERVAL = 45; // 出場每輪間隔 ms
  const IN_ROUNDS = 6; // 入場 decode 輪數
  const IN_INTERVAL = 35; // 入場每輪間隔 ms

  function getVisibleTextElements() {
    const selectors =
      'h1,h2,h3,h4,h5,h6,p,a,span,li,td,th,label,button,figcaption,blockquote,dt,dd';
    const elements = document.querySelectorAll(selectors);
    const visible = [];
    const viewH = window.innerHeight;

    for (const el of elements) {
      if (
        el.closest(
          'script,style,noscript,svg,.toast-container,[data-lang-switch]'
        )
      )
        continue;
      if (el.offsetParent === null && getComputedStyle(el).position !== 'fixed')
        continue;

      const rect = el.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > viewH || rect.width === 0) continue;

      const directText = Array.from(el.childNodes)
        .filter((n) => n.nodeType === Node.TEXT_NODE)
        .map((n) => n.textContent || '')
        .join('');
      if (directText.trim().length === 0) continue;

      visible.push(el);
    }
    return visible;
  }

  function scrambleChar(ch) {
    if (/\s/.test(ch)) return ch;
    return SCRAMBLE_CHARS[Math.floor(Math.random() * SCRAMBLE_CHARS.length)];
  }

  function scrambleTextNodes(el) {
    for (const node of el.childNodes) {
      if (node.nodeType === Node.TEXT_NODE && node.textContent.trim()) {
        node.textContent = node.textContent
          .split('')
          .map((ch) => scrambleChar(ch))
          .join('');
      }
    }
  }

  // ── 出場：scramble → 導航 ──
  function runScrambleOut(href) {
    const elements = getVisibleTextElements();
    if (elements.length === 0) {
      sessionStorage.setItem('lang-switch', '1');
      window.location.href = href;
      return;
    }

    let round = 0;
    const timer = setInterval(() => {
      round++;
      elements.forEach((el) => scrambleTextNodes(el));

      if (round >= OUT_ROUNDS) {
        clearInterval(timer);
        sessionStorage.setItem('lang-switch', '1');
        window.location.href = href;
      }
    }, OUT_INTERVAL);
  }

  // ── 入場：亂碼 → 逐步 decode 回正確內容 ──
  function runDecodeIn() {
    const flag = sessionStorage.getItem('lang-switch');
    if (!flag) return;
    sessionStorage.removeItem('lang-switch');

    const prefersReducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;
    if (prefersReducedMotion) return;

    const elements = getVisibleTextElements();
    if (elements.length === 0) return;

    // 儲存每個 text node 的正確內容
    const nodeMap = [];
    elements.forEach((el) => {
      for (const node of el.childNodes) {
        if (node.nodeType === Node.TEXT_NODE && node.textContent.trim()) {
          nodeMap.push({
            node,
            original: node.textContent,
            chars: node.textContent.split(''),
          });
        }
      }
    });

    // 先全部 scramble
    nodeMap.forEach(({ node, original }) => {
      node.textContent = original
        .split('')
        .map((ch) => scrambleChar(ch))
        .join('');
    });

    // 逐步 decode：每輪多一些字元恢復正確
    let round = 0;
    const timer = setInterval(() => {
      round++;
      const revealRatio = round / IN_ROUNDS;

      nodeMap.forEach(({ node, chars }) => {
        node.textContent = chars
          .map((ch, i) => {
            if (/\s/.test(ch)) return ch;
            // 用字元位置 hash 決定該字元在第幾輪「解鎖」
            const unlockAt = ((i * 7 + ch.charCodeAt(0) * 3) % IN_ROUNDS) + 1;
            return round >= unlockAt ? ch : scrambleChar(ch);
          })
          .join('');
      });

      if (round >= IN_ROUNDS) {
        clearInterval(timer);
        // 確保完全還原
        nodeMap.forEach(({ node, original }) => {
          node.textContent = original;
        });
      }
    }, IN_INTERVAL);
  }

  function initLangSwitch() {
    // 綁定出場
    document.querySelectorAll('[data-lang-switch]').forEach((link) => {
      if (link.dataset.langBound) return;
      link.dataset.langBound = '1';

      link.addEventListener('click', (e) => {
        e.preventDefault();
        const href = link.getAttribute('href');
        if (!href) return;

        const prefersReducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;
        if (prefersReducedMotion) {
          window.location.href = href;
          return;
        }

        runScrambleOut(href);
      });
    });

    // 檢查入場
    runDecodeIn();
  }

  document.addEventListener('DOMContentLoaded', initLangSwitch);
  document.addEventListener('astro:page-load', initLangSwitch);
</script>
