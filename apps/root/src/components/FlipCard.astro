---
import './FlipCard.css';

interface Props {
  type?: 'project' | 'update';
  className?: string;
}

const { type = 'project', className = '' } = Astro.props;
---

<div 
  class={`flip-card ${className} ${type === 'update' ? 'flip-card--update' : 'flip-card--project'}`}
  data-flip-card
>
  <div class="flip-card__inner">
    <div class="flip-card__front">
      <slot name="front" />
    </div>
    <div class="flip-card__back">
      <slot name="back" />
    </div>
  </div>
</div>

<script>
  // 為所有 FlipCard 添加點擊事件
  document.addEventListener('DOMContentLoaded', () => {
    const cards = document.querySelectorAll('[data-flip-card]');
    
    cards.forEach(card => {
      card.addEventListener('click', (e) => {
        // 如果點擊的是連結，不要翻轉
        if ((e.target as HTMLElement).closest('a')) {
          return;
        }
        
        const inner = card.querySelector('.flip-card__inner');
        if (inner) {
          const wasFlipped = inner.classList.contains('flipped');
          inner.classList.toggle('flipped');
          
          // 觸發自訂事件，讓背面內容知道卡片已翻轉
          if (!wasFlipped) {
            const event = new CustomEvent('cardFlipped', { bubbles: true });
            card.dispatchEvent(event);
          }
        }
      });
      
      // 鍵盤支持
      card.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
          e.preventDefault();
          const inner = card.querySelector('.flip-card__inner');
          if (inner) {
            const wasFlipped = inner.classList.contains('flipped');
            inner.classList.toggle('flipped');
            
            if (!wasFlipped) {
              const event = new CustomEvent('cardFlipped', { bubbles: true });
              card.dispatchEvent(event);
            }
          }
        }
      });
      
      // 添加 tabindex 使其可聚焦
      (card as HTMLElement).setAttribute('tabindex', '0');
      (card as HTMLElement).setAttribute('role', 'button');
      (card as HTMLElement).setAttribute('aria-label', 'Click to flip and see details');
    });
  });
</script>
