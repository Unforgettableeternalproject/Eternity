---
import UepToastContainer from '../components/ui/UepToast';
import UepDialogContainer from '../components/ui/UepDialog';
import GlobalWelcomeHost from '../components/ui/GlobalWelcomeHost';
import TestModeBanner from '../components/ui/TestModeBanner';
import UepDevTools from '../devtools/UepDevTools';
import { ScanlineHudPortal } from '../devtools/ScanlineHud';

interface Props {
  title: string;
  description?: string;
  zone?: string;
  /** 首頁大廳動畫：在 head 注入遮罩，防止內容閃現 */
  lobbyBlock?: boolean;
}

const {
  title,
  description = 'U.E.P · Imaginary Space — 不朽永恆計畫 (UEP) 邊際世界觀測誌',
  zone,
  lobbyBlock = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-TW" data-lobby={lobbyBlock ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/x-icon" href="/Logo.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="U.E.P's Imaginary Space" />
    <meta property="og:locale" content="zh_TW" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD 結構化資料 -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: "U.E.P's Imaginary Space",
        alternateName: [
          '邊際世界觀測誌',
          '不朽永恆計畫',
          'Unforgettable Eternal Project',
          'UEP',
        ],
        url: 'https://uep.unforgettableeternalproject.com',
        inLanguage: 'zh-TW',
      })}
    />

    <!-- Preconnect：Content API（首頁 SSR 有 runtime fetch，提前建立連線） -->
    <link
      rel="preconnect"
      href="https://eternity-content-api.ptyc4076.workers.dev"
      crossorigin
    />

    <!-- LCP 圖片預載（僅首頁，瀏覽器提前發現 React 元件內的圖片） -->
    {
      lobbyBlock && (
        <link
          rel="preload"
          as="image"
          href="/uep/Big-UEP.webp"
          type="image/webp"
        />
      )
    }

    <!-- Fonts：非阻塞載入，避免 render-blocking 300ms 延遲 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 先 preload 字體 CSS，讓瀏覽器提早發現 -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+TC:wght@400;600&display=swap"
    />
    <!-- 以 print media 非同步載入，onload 切換為 all 完成套用 -->
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+TC:wght@400;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <!-- 停用 JavaScript 時的退路 -->
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+TC:wght@400;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- 閒置感知系統 -->
    <script>
      import { initIdleAwareness } from '../scripts/idle-awareness';
      initIdleAwareness();
    </script>

    <!-- 站台行為設定（/admin/settings 站台分頁的四項參數）＋內容保護 -->
    <script>
      import { initUepSettings } from '../lib/uepSettings';
      import { initContentProtection } from '../scripts/content-protection';
      // 有 sessionStorage 快取時同步就緒；首訪第一頁 fetch 未回前，
      // 消費點（含下面的內容保護）退回程式碼常數
      void initUepSettings();
      initContentProtection();
    </script>

    <!-- 訪客追蹤：文件站分站計數，透過 visitor-counter Worker 記錄 site=uep -->
    <script>
      import { scheduleUepVisitorTrack } from '../scripts/visitor-track';
      scheduleUepVisitorTrack();
    </script>

    <!-- Theme init (no flash) + lobby block -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('uep-theme') || 'light';
        document.documentElement.setAttribute('data-theme', t);
        /* 剛從 /login 完成 auth 回來：WelcomeCeremony 全屏遮罩自己就是唯一畫面，
           跳過 lobbyBlock 避免雙層遮罩造成 Welcome 淡出時空白閃現。
           同時在 body 上加 class，讓需要 skip 入場動畫的元件（主頁 lobby 等）
           可以檢查這個 class 決定是否播——歡迎儀式作為「特別例外」取代
           頁面自身的長入場，避免 Welcome 淡出後還看到頁面在跑動畫 */
        var welcomePending = false;
        try {
          welcomePending =
            sessionStorage.getItem('uep.welcome.pending.v1') !== null;
        } catch (e) {
          /* sessionStorage 不可用時走預設分支 */
        }
        if (welcomePending) {
          /* body 尚未存在（script 在 head 執行），先掛到 html 上；DOMContentLoaded
             後再搬到 body。兩個地方都掛，元件檢查任一即可 */
          document.documentElement.classList.add('uep-welcome-pending');
          document.addEventListener('DOMContentLoaded', function () {
            document.body.classList.add('uep-welcome-pending');
          });
        }
        if (
          document.documentElement.hasAttribute('data-lobby') &&
          !welcomePending
        ) {
          var bg = t === 'dark' ? '#14151a' : '#fafaf7';
          /* 與 .lobby-overlay 同一層光暈（HomePage.css 的 --lobby-glow）。
             搬過來有兩個作用：
             1. 視覺連續——原本是「純色 → JS 到了才突然出現光暈與動畫」，
                現在遮罩一出現就是大廳的靜態首幀，React 接手時無縫。
             2. FCP：Lighthouse 只認文字或圖片的繪製，**純色背景不算**，
                所以在 JS 抵達前它眼中的畫面完全是空的——行動版量到的
                FCP 14.3s 就是這麼來的（TBT 卻是 0ms，瓶頸從來不是執行）。
                CSS 漸層屬於 background-image，會觸發 FCP。
             遮罩的遮蔽能力完全不變，儀式該擋的東西一樣擋著。 */
          var glow =
            t === 'dark' ? 'rgba(213,182,24,0.22)' : 'rgba(213,182,24,0.1)';
          var s = document.createElement('style');
          s.id = 'lobby-block-style';
          /* 遮罩的職責只到「大廳動畫接手」為止——lobby overlay 一出現就
             自己負責遮蔽，所以這裡不必撐滿 4.2s 的儀式全長。
             保底存在的理由是它唯一的移除者是 HomePage 的 React effect：
             JS 整個載入失敗的話，畫面會永遠是一片純色，沒有內容也沒有
             任何錯誤提示。純 CSS 動畫不依賴 JS，只在異常時才會走到。
             2.5s 遠大於正常的掛載時間；真的走到保底時使用者會先看到內容、
             稍後才被動畫蓋上，順序略怪但遠勝於長時間白屏。 */
          s.textContent =
            'body::before{content:"";position:fixed;inset:0;z-index:9999;' +
            'background:radial-gradient(ellipse 50% 40% at 50% 50%,' +
            glow +
            ',transparent 70%),' +
            bg +
            ';pointer-events:none;animation:uep-lobby-block-failsafe 600ms ease-out 2.5s forwards}' +
            '@keyframes uep-lobby-block-failsafe{to{opacity:0;visibility:hidden}}';
          document.head.appendChild(s);
        }
      })();
    </script>
  </head>
  <body data-zone={zone}>
    <TestModeBanner client:load />
    <slot />
    <UepToastContainer client:idle />
    <UepDialogContainer client:idle />
    <GlobalWelcomeHost client:idle />
    <UepDevTools client:idle />
    <ScanlineHudPortal client:idle />
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';

  html {
    font-family: var(--font-sans);
    background: var(--bg);
    color: var(--ink);
    line-height: 1.6;
    min-height: 100vh;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  body {
    position: relative;
    overflow-x: hidden;
    min-height: 100vh;
  }

  a {
    color: inherit;
  }

  img,
  svg {
    display: block;
  }

  /* Ensure Chinese text uses serif */
  :lang(zh),
  :lang(zh-TW) {
    font-family: var(--font-serif-tc);
  }
</style>
