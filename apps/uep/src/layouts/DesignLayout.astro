---
interface Props {
  title: string;
  description?: string;
  zone?: string;
}

const {
  title,
  description = 'U.E.P · Imaginary Space — 邊際世界 · 觀測誌',
  zone,
} = Astro.props;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/x-icon" href="/Logo.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+TC:wght@400;600&display=swap"
      rel="stylesheet"
    />

    <!-- Theme init (no flash) -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('uep-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
  </head>
  <body data-zone={zone}>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';

  html {
    font-family: var(--font-sans);
    background: var(--bg);
    color: var(--ink);
    line-height: 1.6;
    min-height: 100vh;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    position: relative;
    overflow-x: hidden;
    min-height: 100vh;
  }

  a {
    color: inherit;
  }

  img,
  svg {
    display: block;
  }

  /* Ensure Chinese text uses serif */
  :lang(zh),
  :lang(zh-TW) {
    font-family: var(--font-serif-tc);
  }
</style>
