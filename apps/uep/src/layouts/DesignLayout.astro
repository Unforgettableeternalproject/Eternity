---
import UepToastContainer from '../components/ui/UepToast';
import UepDialogContainer from '../components/ui/UepDialog';

interface Props {
  title: string;
  description?: string;
  zone?: string;
  /** 首頁大廳動畫：在 head 注入遮罩，防止內容閃現 */
  lobbyBlock?: boolean;
}

const {
  title,
  description = 'U.E.P · Imaginary Space — 不朽永恆計畫 (UEP) 邊際世界觀測誌',
  zone,
  lobbyBlock = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-TW" data-lobby={lobbyBlock ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/x-icon" href="/Logo.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="U.E.P's Imaginary Space" />
    <meta property="og:locale" content="zh_TW" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD 結構化資料 -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: "U.E.P's Imaginary Space",
        alternateName: [
          '邊際世界觀測誌',
          '不朽永恆計畫',
          'Unforgettable Eternal Project',
          'UEP',
        ],
        url: 'https://uep.unforgettableeternalproject.com',
        inLanguage: 'zh-TW',
      })}
    />

    <!-- Preconnect：Content API（首頁 SSR 有 runtime fetch，提前建立連線） -->
    <link
      rel="preconnect"
      href="https://eternity-content-api.ptyc4076.workers.dev"
      crossorigin
    />

    <!-- LCP 圖片預載（僅首頁，瀏覽器提前發現 React 元件內的圖片） -->
    {
      lobbyBlock && (
        <link
          rel="preload"
          as="image"
          href="/uep/Big-UEP.webp"
          type="image/webp"
        />
      )
    }

    <!-- Fonts：非阻塞載入，避免 render-blocking 300ms 延遲 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- 先 preload 字體 CSS，讓瀏覽器提早發現 -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+TC:wght@400;600&display=swap"
    />
    <!-- 以 print media 非同步載入，onload 切換為 all 完成套用 -->
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+TC:wght@400;600&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <!-- 停用 JavaScript 時的退路 -->
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Noto+Serif+TC:wght@400;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <!-- 閒置感知系統 -->
    <script>
      import { initIdleAwareness } from '../scripts/idle-awareness';
      initIdleAwareness();
    </script>

    <!-- Theme init (no flash) + lobby block -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('uep-theme') || 'dark';
        document.documentElement.setAttribute('data-theme', t);
        if (document.documentElement.hasAttribute('data-lobby')) {
          var bg = t === 'dark' ? '#14151a' : '#fafaf7';
          var s = document.createElement('style');
          s.id = 'lobby-block-style';
          s.textContent =
            'body::before{content:"";position:fixed;inset:0;z-index:9999;background:' +
            bg +
            ';pointer-events:none}';
          document.head.appendChild(s);
        }
      })();
    </script>
  </head>
  <body data-zone={zone}>
    <slot />
    <UepToastContainer client:idle />
    <UepDialogContainer client:idle />
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';

  html {
    font-family: var(--font-sans);
    background: var(--bg);
    color: var(--ink);
    line-height: 1.6;
    min-height: 100vh;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  body {
    position: relative;
    overflow-x: hidden;
    min-height: 100vh;
  }

  a {
    color: inherit;
  }

  img,
  svg {
    display: block;
  }

  /* Ensure Chinese text uses serif */
  :lang(zh),
  :lang(zh-TW) {
    font-family: var(--font-serif-tc);
  }
</style>
