---
import Navbar from '../components/Navbar.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "U.E.P's Imaginary Space — 不朽永恆計畫 (UEP) 邊際世界觀測誌",
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/x-icon" href="/Logo.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="U.E.P's Imaginary Space" />
    <meta property="og:locale" content="zh_TW" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD 結構化資料 -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: "U.E.P's Imaginary Space",
        alternateName: [
          '邊際世界觀測誌',
          '不朽永恆計畫',
          'Unforgettable Eternal Project',
          'UEP',
        ],
        url: 'https://uep.unforgettableeternalproject.com',
        inLanguage: 'zh-TW',
      })}
    />
  </head>
  <body>
    <!-- 背景裝飾層 -->
    <div class="bg-gradient"></div>
    <div class="bg-grid"></div>

    <div class="layout">
      <Navbar currentPath={currentPath} />
      <main>
        <slot />
      </main>
      <footer>
        <div class="footer-content">
          <div class="footer-logo">
            <span class="footer-icon">✨</span>
            <span>U.E.P's Imaginary Space</span>
          </div>
          <p class="footer-text">
            &copy; 2025 Bernie. Documentation for Unforgettable Eternal Project.
          </p>
          <div class="footer-links">
            <a
              href="https://github.com/Unforgettableeternalproject"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
            </a>
            <span class="separator">•</span>
            <a
              href="https://unforgettableeternalproject.com"
              target="_blank"
              rel="noopener noreferrer"
            >
              Main Site
            </a>
          </div>
        </div>
      </footer>
    </div>

    <!-- 鼠標跟隨光效 -->
    <div class="cursor-glow" id="cursorGlow"></div>
    <script>
      // 鼠標跟隨光效
      const cursorGlow = document.getElementById('cursorGlow');
      let mouseX = 0,
        mouseY = 0;
      let glowX = 0,
        glowY = 0;

      document.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      function animateGlow() {
        glowX += (mouseX - glowX) * 0.1;
        glowY += (mouseY - glowY) * 0.1;

        if (cursorGlow) {
          cursorGlow.style.left = glowX + 'px';
          cursorGlow.style.top = glowY + 'px';
        }

        requestAnimationFrame(animateGlow);
      }

      animateGlow();
    </script>
  </body>
  <style>
    :root {
      --gold: #d5b618;
      --gold-light: #e8c547;
      --gold-dark: #c9a615;
      --purple: #a855f7;
      --purple-light: #c084fc;
      --purple-dark: #7e22ce;
      --cyan: #06b6d4;
      --void-black: #0a0a0f;
      --void-gray: #1a1a2e;
      --text-primary: #f8f8ff;
      --text-secondary: #c0c0d8;
      --glass-bg: rgba(255, 255, 255, 0.05);
      --glass-border: rgba(255, 255, 255, 0.1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-family:
        system-ui,
        -apple-system,
        'Segoe UI',
        'Microsoft JhengHei',
        sans-serif;
      background: var(--void-black);
      color: var(--text-primary);
      line-height: 1.6;
      min-height: 100vh;
      scroll-behavior: smooth;
      overflow-x: hidden;
    }

    body {
      position: relative;
      overflow-x: hidden;
    }

    /* 背景漸層 */
    .bg-gradient {
      position: fixed;
      inset: 0;
      background:
        radial-gradient(
          circle at 20% 30%,
          rgba(168, 85, 247, 0.15) 0%,
          transparent 50%
        ),
        radial-gradient(
          circle at 80% 70%,
          rgba(213, 182, 24, 0.15) 0%,
          transparent 50%
        ),
        radial-gradient(
          circle at 50% 50%,
          rgba(6, 182, 212, 0.1) 0%,
          transparent 60%
        );
      pointer-events: none;
      z-index: -2;
      animation: gradientShift 20s ease infinite;
    }

    @keyframes gradientShift {
      0%,
      100% {
        opacity: 1;
        transform: scale(1);
      }
      50% {
        opacity: 0.8;
        transform: scale(1.1);
      }
    }

    /* 背景網格 */
    .bg-grid {
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(213, 182, 24, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(213, 182, 24, 0.03) 1px, transparent 1px);
      background-size: 50px 50px;
      pointer-events: none;
      z-index: -1;
      opacity: 0.5;
      animation: gridMove 30s linear infinite;
    }

    @keyframes gridMove {
      0% {
        transform: translate(0, 0);
      }
      100% {
        transform: translate(50px, 50px);
      }
    }

    /* 鼠標光效 */
    .cursor-glow {
      position: fixed;
      width: 600px;
      height: 600px;
      border-radius: 50%;
      background: radial-gradient(
        circle,
        rgba(213, 182, 24, 0.08) 0%,
        transparent 70%
      );
      pointer-events: none;
      z-index: 9999;
      transform: translate(-50%, -50%);
      transition: opacity 0.3s ease;
      mix-blend-mode: screen;
    }

    @media (hover: none) {
      .cursor-glow {
        display: none;
      }
    }

    .layout {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    main {
      flex: 1;
      max-width: 1400px;
      width: 100%;
      margin: 0 auto;
      animation: fadeIn 0.6s ease-out;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    footer {
      background: rgba(10, 10, 15, 0.8);
      backdrop-filter: blur(20px);
      border-top: 1px solid rgba(213, 182, 24, 0.2);
      margin-top: 4rem;
      box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.4);
      position: relative;
      overflow: hidden;
    }

    footer::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent 0%,
        var(--gold) 25%,
        var(--purple) 50%,
        var(--cyan) 75%,
        transparent 100%
      );
      animation: shimmer 3s ease-in-out infinite;
    }

    @keyframes shimmer {
      0%,
      100% {
        opacity: 0.3;
      }
      50% {
        opacity: 1;
      }
    }

    .footer-content {
      max-width: 1400px;
      margin: 0 auto;
      padding: 3rem 2rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .footer-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-size: 1.2rem;
      font-weight: 600;
      color: var(--gold);
      margin-bottom: 0.5rem;
    }

    .footer-icon {
      animation: twinkle 3s ease-in-out infinite;
    }

    .footer-text {
      color: rgba(255, 255, 255, 0.6);
      font-size: 0.95rem;
    }

    .footer-links {
      display: flex;
      gap: 1rem;
      justify-content: center;
      align-items: center;
      margin-top: 0.5rem;
    }

    .footer-links a {
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      font-size: 0.9rem;
      transition: all 0.3s ease;
      position: relative;
    }

    .footer-links a::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 0;
      height: 1px;
      background: var(--gold);
      transition: width 0.3s ease;
    }

    .footer-links a:hover {
      color: var(--gold);
    }

    .footer-links a:hover::after {
      width: 100%;
    }

    .separator {
      color: rgba(255, 255, 255, 0.3);
    }

    @media (max-width: 768px) {
      .footer-content {
        padding: 2rem 1rem;
      }

      .footer-logo {
        font-size: 1rem;
      }

      .footer-text {
        font-size: 0.85rem;
      }

      .footer-links {
        flex-direction: column;
        gap: 0.5rem;
      }

      .separator {
        display: none;
      }
    }
  </style>
</html>
