---
// 進度條組件
---

<div class="construction-progress">
  <div class="progress-label-wrapper">
    <span class="progress-icon">⚡</span>
    <p class="progress-text">構建進度</p>
    <span class="progress-icon">⚡</span>
  </div>

  <div class="progress-bar">
    <div class="progress-fill" id="progressFill"></div>
  </div>

  <p class="progress-percentage" id="progressPercentage">初始化中...</p>
  <p class="progress-hint">概念原質正在重組</p>
</div>

<style>
  .construction-progress {
    padding: 2.5rem;
    background: var(--glass-bg);
    backdrop-filter: blur(15px);
    border: 1px solid var(--glass-border);
    border-radius: 1.25rem;
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .progress-label-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .progress-icon {
    font-size: 1.5rem;
    animation: flicker 2s ease-in-out infinite;
  }

  @keyframes flicker {
    0%,
    100% {
      opacity: 1;
      filter: drop-shadow(0 0 5px var(--gold));
    }
    50% {
      opacity: 0.6;
      filter: drop-shadow(0 0 10px var(--gold));
    }
  }

  .progress-text {
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--gold-light);
    text-shadow: 0 0 10px rgba(213, 182, 24, 0.3);
  }

  .progress-bar {
    position: relative;
    width: 100%;
    height: 2.5rem;
    background: rgba(26, 26, 46, 0.6);
    border-radius: 1.25rem;
    overflow: hidden;
    border: 2px solid var(--glass-border);
    box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  .progress-fill {
    height: 100%;
    width: 0;
    background: linear-gradient(
      90deg,
      var(--purple) 0%,
      var(--gold) 50%,
      var(--cyan) 100%
    );
    background-size: 200% 100%;
    border-radius: 1.25rem;
    transition: width 2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    animation: progressFlow 3s linear infinite;
  }

  @keyframes progressFlow {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 200% 50%;
    }
  }

  .progress-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.3) 50%,
      transparent 100%
    );
    animation: shimmerProgress 1.5s ease-in-out infinite;
  }

  @keyframes shimmerProgress {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .progress-percentage {
    margin-top: 1rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--gold-light);
    text-shadow: 0 0 15px rgba(213, 182, 24, 0.5);
  }

  .progress-hint {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--purple-light);
    font-style: italic;
    opacity: 0.8;
    animation: fadeInOut 3s ease-in-out infinite;
  }

  @keyframes fadeInOut {
    0%,
    100% {
      opacity: 0.5;
    }
    50% {
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    .construction-progress {
      padding: 1.5rem;
    }

    .progress-bar {
      height: 2rem;
    }
  }
</style>

<script>
  function animateProgress() {
    const progressFill = document.getElementById('progressFill');
    const progressPercentage = document.getElementById('progressPercentage');

    if (!progressFill || !progressPercentage) return;

    const targetProgress = Math.floor(Math.random() * 20) + 30;

    setTimeout(() => {
      progressFill.style.width = `${targetProgress}%`;
      progressPercentage.textContent = `${targetProgress}%`;
    }, 500);
  }

  document.addEventListener('DOMContentLoaded', animateProgress);
</script>
