---
const { title, subtitle } = Astro.props;
---

<div class="hero">
  <div class="title-wrapper">
    <h1 class="glitch-text" data-text={title}>
      {
        title
          .split('')
          .map((char: string, i: number) => (
            <span style={`animation-delay: ${i * 0.1}s`}>{char}</span>
          ))
      }
    </h1>
  </div>

  <div class="construction-badge">
    <span class="portal-icon rotating">✦</span>
    <span class="text">邊際世界構建中</span>
    <span class="portal-icon rotating-reverse">✦</span>
  </div>

  {subtitle && <p class="subtitle floating-text">{subtitle}</p>}

  <div class="quote-wrapper">
    <span class="quote-mark">"</span>
    <p class="quote">萬物由最原初的質所成</p>
    <p class="quote">在有限的時間中無限的擴展著</p>
    <span class="quote-mark closing">"</span>
  </div>
</div>

<style>
  .hero {
    text-align: center;
    padding: 4rem 0 3rem;
    margin-bottom: 3rem;
    position: relative;
    z-index: 2;
  }

  .title-wrapper {
    margin-bottom: 2rem;
    perspective: 1000px;
  }

  .glitch-text {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    background: linear-gradient(
      135deg,
      var(--gold) 0%,
      var(--purple-light) 50%,
      var(--cyan) 100%
    );
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 6s ease infinite;
    letter-spacing: 0.05em;
    display: inline-block;
  }

  .glitch-text span {
    display: inline-block;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes gradientShift {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .construction-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    background: linear-gradient(135deg, var(--purple-dark), var(--purple));
    border: 2px solid var(--purple-light);
    border-radius: 2rem;
    box-shadow:
      0 0 20px rgba(168, 85, 247, 0.4),
      0 0 40px rgba(168, 85, 247, 0.2);
    animation: pulse 2s ease-in-out infinite;
    position: relative;
    overflow: hidden;
    margin: 2rem 0;
  }

  .construction-badge::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      45deg,
      transparent 30%,
      rgba(255, 255, 255, 0.1) 50%,
      transparent 70%
    );
    animation: shimmer 3s linear infinite;
  }

  @keyframes shimmer {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow:
        0 0 20px rgba(168, 85, 247, 0.4),
        0 0 40px rgba(168, 85, 247, 0.2);
    }
    50% {
      transform: scale(1.05);
      box-shadow:
        0 0 30px rgba(168, 85, 247, 0.6),
        0 0 60px rgba(168, 85, 247, 0.3);
    }
  }

  .portal-icon {
    font-size: 1.5rem;
    filter: drop-shadow(0 0 10px var(--purple-light));
  }

  .rotating {
    animation: rotate 4s linear infinite;
  }

  .rotating-reverse {
    animation: rotate 4s linear infinite reverse;
  }

  @keyframes rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .construction-badge .text {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }

  .subtitle {
    font-size: 1.3rem;
    color: var(--text-secondary);
    margin-top: 1.5rem;
    font-weight: 300;
  }

  .floating-text {
    animation: floatSlow 4s ease-in-out infinite;
  }

  @keyframes floatSlow {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.9;
    }
    50% {
      transform: translateY(-5px);
      opacity: 1;
    }
  }

  .quote-wrapper {
    position: relative;
    margin-top: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .quote-mark {
    font-size: 4rem;
    color: var(--gold);
    opacity: 0.3;
    font-family: Georgia, serif;
    line-height: 0;
  }

  .quote-mark.closing {
    display: inline-block;
    transform: rotate(180deg);
  }

  .quote {
    font-size: 1.1rem;
    color: var(--gold-light);
    font-style: italic;
    margin: 0.5rem 0;
    opacity: 0.85;
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2rem 0 1.5rem;
    }

    .glitch-text {
      font-size: 2rem;
    }

    .construction-badge {
      padding: 0.75rem 1.5rem;
    }
  }
</style>
