---
/**
 * Enhanced Content Renderer - 四層式渲染架構
 *
 * Layer 1: 原始層 - 讀取原始 Markdown
 * Layer 2: 設計層 - GitBook → Astro 語法轉換
 * Layer 3: 覆蓋層 - 使用者配置的段落增強
 * Layer 4: 元件層 - 最終 HTML 渲染
 */

import { processContent } from '../utils/ContentProcessor';
import { loadOverlayConfig } from '../utils/overlay-helpers';

interface Props {
  /** 原始 Markdown 內容 */
  rawContent: string;
  /** 內容文件路徑（相對於 content/） */
  contentPath: string;
  /** 專案根目錄 */
  projectRoot?: string;
  /** 是否啟用覆蓋層（預設：true） */
  enableOverlay?: boolean;
}

const {
  rawContent,
  contentPath,
  projectRoot = import.meta.env.PWD || process.cwd(),
  enableOverlay = true,
} = Astro.props;

// Layer 3: 載入覆蓋層配置
let overlayConfig;
if (enableOverlay) {
  overlayConfig = loadOverlayConfig(contentPath, projectRoot);

  if (overlayConfig) {
    console.log(`[Overlay] 已載入配置: ${contentPath}`);
  }
}

// Layer 1-3: 處理內容（原始 → 設計 → 覆蓋）
const processedContent = processContent(rawContent, overlayConfig);

// 由於 Astro 組件無法動態渲染，我們需要將處理後的內容
// 作為 Markdown 讓 Astro 處理，然後手動插入組件
// 暫時先使用簡單的 HTML 渲染，組件部分需要後續處理
---

<!-- Layer 4: 元件層渲染 -->
<article class="enhanced-content">
  <div class="content-body">
    <!-- 這裡暫時使用原始渲染，需要改進以支持組件 -->
    <Fragment set:html={processedContent} />
  </div>
</article>

<style>
  .enhanced-content {
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .content-body {
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.9);
  }

  /* Markdown 基礎樣式 */
  .content-body :global(h1),
  .content-body :global(h2),
  .content-body :global(h3),
  .content-body :global(h4),
  .content-body :global(h5),
  .content-body :global(h6) {
    color: #d5b618;
    margin: 2rem 0 1rem;
    font-weight: 600;
  }

  .content-body :global(h1) {
    font-size: 2.5rem;
    background: linear-gradient(135deg, #d5b618 0%, #ffd700 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .content-body :global(h2) {
    font-size: 2rem;
    color: #a855f7;
  }

  .content-body :global(h3) {
    font-size: 1.5rem;
    color: #06b6d4;
  }

  .content-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .content-body :global(strong) {
    color: #fbbf24;
    font-weight: 700;
  }

  .content-body :global(em) {
    color: rgba(255, 255, 255, 0.7);
    font-style: italic;
  }

  .content-body :global(a) {
    color: #06b6d4;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .content-body :global(a:hover) {
    color: #67e8f9;
    text-decoration: underline;
  }

  .content-body :global(code) {
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 0.25rem;
    padding: 0.125rem 0.375rem;
    color: #fbbf24;
    font-family: 'Courier New', monospace;
    font-size: 0.875em;
  }

  .content-body :global(pre) {
    background: rgba(168, 85, 247, 0.15);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .content-body :global(pre code) {
    background: none;
    border: none;
    padding: 0;
  }

  .content-body :global(blockquote) {
    border-left: 4px solid #d5b618;
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: rgba(255, 255, 255, 0.8);
    font-style: italic;
  }

  .content-body :global(ul),
  .content-body :global(ol) {
    margin: 1rem 0;
    padding-left: 2rem;
  }

  .content-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .content-body :global(img) {
    max-width: 100%;
    border-radius: 0.75rem;
    margin: 2rem 0;
  }

  .content-body :global(hr) {
    border: none;
    height: 2px;
    background: linear-gradient(90deg, transparent, #d5b618, transparent);
    margin: 3rem 0;
  }

  /* 響應式 */
  @media (max-width: 768px) {
    .enhanced-content {
      padding: 1.5rem 1rem;
    }

    .content-body :global(h1) {
      font-size: 2rem;
    }

    .content-body :global(h2) {
      font-size: 1.5rem;
    }

    .content-body :global(h3) {
      font-size: 1.25rem;
    }
  }
</style>
