---
/**
 * Spoiler - 劇透/敏感內容遮罩組件
 * 
 * 用途：
 * - 隱藏劇透內容，需要點擊才能顯示
 * - 處理敏感或需要警告的內容
 * - 替代原本的 ◼︎ 符號
 * 
 * 變體：
 * - blur: 模糊效果，點擊或懸停顯示（預設）
 * - click: 完全隱藏，點擊後顯示
 * - censored: 黑條遮蓋，點擊後顯示
 */

interface Props {
  variant?: 'blur' | 'click' | 'censored';
  warning?: string;
  inline?: boolean;
}

const { 
  variant = 'blur', 
  warning = '此內容包含劇透',
  inline = false 
} = Astro.props;

const componentId = `spoiler-${Math.random().toString(36).substring(2, 11)}`;
---

<span 
  class={`spoiler spoiler--${variant} ${inline ? 'spoiler--inline' : ''}`}
  data-spoiler-id={componentId}
  data-revealed="false"
  title={warning}
>
  <span class="spoiler__content">
    <slot />
  </span>
  {variant === 'click' && (
    <span class="spoiler__overlay">
      <button class="spoiler__reveal-btn" aria-label="顯示內容">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        <span>點擊顯示</span>
      </button>
    </span>
  )}
  {variant === 'censored' && (
    <span class="spoiler__overlay spoiler__overlay--censored">
      <button class="spoiler__reveal-btn spoiler__reveal-btn--censored" aria-label="顯示內容">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
          <path d="M18.63 8A17.89 17.89 0 0 1 18 8"/>
          <path d="M6.26 6.26A5.86 5.86 0 0 0 6 8c0 7-3 9-3 9h14"/>
          <path d="M18 8a6 6 0 0 0-9.33-5"/>
          <line x1="1" y1="1" x2="23" y2="23"/>
        </svg>
        <span>警告：劇透內容</span>
      </button>
    </span>
  )}
</span>

<style>
  .spoiler {
    --spoiler-bg: rgba(0, 0, 0, 0.9);
    --spoiler-border: rgba(212, 175, 55, 0.3);
    --spoiler-text: rgba(255, 255, 255, 0.9);
    --spoiler-accent: #d4af37;
    
    position: relative;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .spoiler--inline {
    display: inline;
  }

  .spoiler__content {
    display: inline-block;
    transition: all 0.3s ease;
  }

  /* ===== Blur 變體 (預設) ===== */
  .spoiler--blur .spoiler__content {
    filter: blur(8px);
    user-select: none;
    cursor: pointer;
    transition: filter 0.3s ease;
  }

  .spoiler--blur:hover .spoiler__content,
  .spoiler--blur[data-revealed="true"] .spoiler__content {
    filter: blur(0);
    user-select: text;
  }

  /* ===== Click 變體 ===== */
  .spoiler--click .spoiler__content {
    opacity: 0;
    filter: blur(10px);
    user-select: none;
  }

  .spoiler--click[data-revealed="true"] .spoiler__content {
    opacity: 1;
    filter: blur(0);
    user-select: text;
  }

  .spoiler__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--spoiler-bg);
    border: 1px solid var(--spoiler-border);
    border-radius: 0.375rem;
    pointer-events: all;
    transition: opacity 0.3s ease;
  }

  .spoiler[data-revealed="true"] .spoiler__overlay {
    opacity: 0;
    pointer-events: none;
  }

  .spoiler__reveal-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid var(--spoiler-accent);
    border-radius: 0.375rem;
    color: var(--spoiler-accent);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .spoiler__reveal-btn:hover {
    background: rgba(212, 175, 55, 0.2);
    transform: scale(1.05);
  }

  .spoiler__reveal-btn svg {
    width: 1rem;
    height: 1rem;
  }

  /* ===== Censored 變體 ===== */
  .spoiler--censored .spoiler__content {
    opacity: 0;
    user-select: none;
  }

  .spoiler--censored[data-revealed="true"] .spoiler__content {
    opacity: 1;
    user-select: text;
  }

  .spoiler__overlay--censored {
    background: repeating-linear-gradient(
      0deg,
      #000 0px,
      #000 4px,
      transparent 4px,
      transparent 8px
    );
    backdrop-filter: blur(5px);
  }

  .spoiler__reveal-btn--censored {
    background: rgba(220, 38, 38, 0.1);
    border-color: rgba(220, 38, 38, 0.6);
    color: rgba(239, 68, 68, 0.9);
  }

  .spoiler__reveal-btn--censored:hover {
    background: rgba(220, 38, 38, 0.2);
    border-color: rgba(239, 68, 68, 0.8);
  }

  /* ===== Inline 模式調整 ===== */
  .spoiler--inline.spoiler--blur .spoiler__content {
    display: inline;
  }

  .spoiler--inline.spoiler--click,
  .spoiler--inline.spoiler--censored {
    padding: 0.125rem 0.5rem;
    background: var(--spoiler-bg);
    border: 1px solid var(--spoiler-border);
    border-radius: 0.25rem;
    vertical-align: baseline;
  }

  .spoiler--inline .spoiler__overlay {
    position: relative;
    inset: auto;
    display: inline-flex;
    background: transparent;
    border: none;
  }

  .spoiler--inline .spoiler__reveal-btn {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
  }

  .spoiler--inline .spoiler__reveal-btn svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .spoiler--inline[data-revealed="true"] .spoiler__overlay {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const spoilers = document.querySelectorAll('.spoiler');

    spoilers.forEach((spoiler) => {
      const variant = spoiler.className.match(/spoiler--(\w+)/)?.[1];
      
      // Blur 變體：點擊切換永久顯示
      if (variant === 'blur') {
        spoiler.addEventListener('click', () => {
          const isRevealed = spoiler.getAttribute('data-revealed') === 'true';
          spoiler.setAttribute('data-revealed', (!isRevealed).toString());
        });
      }
      
      // Click 和 Censored 變體：點擊按鈕顯示
      if (variant === 'click' || variant === 'censored') {
        const btn = spoiler.querySelector('.spoiler__reveal-btn');
        btn?.addEventListener('click', (e) => {
          e.stopPropagation();
          spoiler.setAttribute('data-revealed', 'true');
        });
      }
    });
  });
</script>
