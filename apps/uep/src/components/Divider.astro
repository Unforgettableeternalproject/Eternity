---
/**
 * Divider 元件 - 替換 ❇︎ 符號分隔線
 * 用於內容分段
 */

interface Props {
  style?: 'star' | 'gradient' | 'simple' | 'dots';
  spacing?: 'normal' | 'large' | 'small';
}

const { style = 'star', spacing = 'normal' } = Astro.props;
---

<div class={`divider divider-${style} spacing-${spacing}`}>
  {style === 'star' && (
    <div class="star-pattern">
      {'❇︎'.repeat(28)}
    </div>
  )}
  {style === 'dots' && (
    <div class="dots-pattern">
      <span></span>
      <span></span>
      <span></span>
    </div>
  )}
</div>

<style>
  .divider {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* 間距設定 */
  .spacing-small {
    margin: 1.5rem 0;
  }

  .spacing-normal {
    margin: 3rem 0;
  }

  .spacing-large {
    margin: 4.5rem 0;
  }

  /* 星星樣式 */
  .divider-star .star-pattern {
    color: rgba(213, 182, 24, 0.3);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    overflow: hidden;
    text-align: center;
    word-break: break-all;
    line-height: 1;
  }

  /* 漸變線樣式 */
  .divider-gradient::before {
    content: '';
    display: block;
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg, 
      transparent 0%, 
      rgba(213, 182, 24, 0.5) 25%,
      rgba(168, 85, 247, 0.5) 50%,
      rgba(213, 182, 24, 0.5) 75%,
      transparent 100%
    );
  }

  /* 簡單線樣式 */
  .divider-simple::before {
    content: '';
    display: block;
    width: 100%;
    height: 1px;
    background: rgba(213, 182, 24, 0.2);
  }

  /* 點點樣式 */
  .divider-dots .dots-pattern {
    display: flex;
    gap: 0.75rem;
    align-items: center;
  }

  .divider-dots .dots-pattern span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(213, 182, 24, 0.5);
    animation: pulse 2s ease-in-out infinite;
  }

  .divider-dots .dots-pattern span:nth-child(2) {
    animation-delay: 0.3s;
  }

  .divider-dots .dots-pattern span:nth-child(3) {
    animation-delay: 0.6s;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.3);
    }
  }

  @media (max-width: 640px) {
    .divider-star .star-pattern {
      font-size: 0.6rem;
    }
  }
</style>
