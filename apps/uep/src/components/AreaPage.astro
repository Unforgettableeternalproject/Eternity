{/* 遞迴渲染節點的函數（Astro 片段） */}
{tree.map(() => null)}
<script is:inline define:vars={{ tree, getIconForLevel }}>
  // 遞迴渲染節點函數
  function renderNode(node, level = 0) {
    const hasChildren = node.children && node.children.length > 0;
    const slug = Array.isArray(node.slug) ? node.slug.join('/') : node.slug;
    const indent = 1.5 + level * 1.5;
    const icon = ['📚', '📖', '📝', '📋'][Math.min(level, 3)];
    
    let html = `<div class="tree-node" data-level="${level}">`;
    
    // 導航項目容器
    html += `<div class="node-row">`;
    html += `<a href="/${slug}" class="nav-item" data-level="${level}" style="padding-left: ${indent}rem;">`;
    html += `<span class="nav-icon">${icon}</span>`;
    html += `<div class="nav-content">`;
    html += `<span class="nav-title">${node.title}</span>`;
    html += `<span class="nav-path">/${slug}</span>`;
    html += `</div>`;
    html += `</a>`;
    
    // 如果有子項，顯示展開/收合箭頭
    if (hasChildren) {
      html += `<button class="expand-toggle" data-target="${node.id}" aria-expanded="true" aria-label="展開/收合">`;
      html += `<span class="expand-chevron">▼</span>`;
      html += `</button>`;
    }
    
    html += `</div>`; // node-row
    
    // 子項容器
    if (hasChildren) {
      html += `<div class="children-container" id="${node.id}">`;
      node.children.forEach(child => {
        html += renderNode(child, level + 1);
      });
      html += `</div>`;
    }
    
    html += `</div>`; // tree-node
    
    return html;
  }
  
  // 將渲染結果插入 DOM
  if (typeof window !== 'undefined') {
    document.addEventListener('DOMContentLoaded', () => {
      const container = document.querySelector('.navigation-tree');
      if (container && tree) {
        container.innerHTML = tree.map(node => renderNode(node, 0)).join('');
      }
    });
  }
</script>

