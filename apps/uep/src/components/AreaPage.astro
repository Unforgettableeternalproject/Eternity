---
interface PageItem {
  slug: string | string[];
  title: string;
  level?: number;
}

interface Props {
  icon: string;
  title: string;
  description: string;
  themeColor: string;
  workingImage: string;
  pages?: PageItem[];
}

const { icon, title, description, themeColor, workingImage, pages = [] } = Astro.props;

// 將頁面組織成樹狀結構（支援任意層級）
interface TreeNode {
  slug: string | string[];
  title: string;
  level: number;
  children: TreeNode[];
  id: string;
}

function buildTree(pages: PageItem[]): TreeNode[] {
  const roots: TreeNode[] = [];
  const stack: TreeNode[] = [];
  
  pages.forEach((page, index) => {
    const slug = Array.isArray(page.slug) ? page.slug : [page.slug];
    const level = page.level ?? 0; // 預設為 0
    const node: TreeNode = {
      ...page,
      slug,
      level,
      children: [],
      id: `node-${index}`
    };

    // 根據層級建立樹狀結構
    while (stack.length > 0 && (stack[stack.length - 1]?.level ?? 0) >= node.level) {
      stack.pop();
    }

    if (stack.length === 0 || node.level === 0) {
      roots.push(node);
    } else {
      const parent = stack[stack.length - 1];
      if (parent) {
        parent.children.push(node);
      }
    }

    stack.push(node);
  });

  return roots;
}

const tree = buildTree(pages);

function getIconForLevel(level: number): string {
  const icons = ['📚', '📖', '📝', '📋'];
  return icons[Math.min(level, icons.length - 1)];
}

// 遞迴渲染節點（支援所有層級的展開/收合）
function renderTreeNode(node: TreeNode): any {
  const hasChildren = node.children && node.children.length > 0;
  const slug = Array.isArray(node.slug) ? node.slug.join('/') : node.slug;
  const indent = 1.5 + node.level * 1.5;
  
  return { node, hasChildren, slug, indent };
}
---

<div class="area-page">
  <a href="/" class="back-link">
    <span class="back-arrow">←</span>
    <span>返回世界的軸心</span>
  </a>

  <div class="area-header">
    <div class="area-icon-wrapper">
      <div class="icon-glow"></div>
      <div class="area-icon">{icon}</div>
    </div>
    <h1 class="area-title">{title}</h1>
    <p class="area-desc" set:html={description} />
  </div>

  {pages.length > 0 ? (
    <div class="pages-section">
      <div class="section-header">
        <h2 class="section-title">📖 區域導航</h2>
        <p class="section-subtitle">點擊箭頭展開/收合</p>
      </div>

      <div class="navigation-tree">
        {tree.map((node) => {
          const { hasChildren, slug, indent } = renderTreeNode(node);
          
          return (
            <div class="tree-node" data-level={node.level}>
              <div class="node-row">
                <a
                  href={`/${slug}`}
                  class="nav-item"
                  data-level={node.level}
                  style={`padding-left: ${indent}rem;`}
                >
                  <span class="nav-icon">{getIconForLevel(node.level)}</span>
                  <span class="nav-title">{node.title}</span>
                  <span class="nav-arrow">›</span>
                </a>
                {hasChildren && (
                  <button
                    class="expand-toggle"
                    data-target={node.id}
                    aria-expanded="true"
                    aria-label={`展開/收合 ${node.title}`}
                  >
                    <span class="expand-chevron">▼</span>
                  </button>
                )}
              </div>
              {hasChildren && (
                <div class="children-container" id={node.id}>
                  {node.children.map((child) => {
                    const childSlug = Array.isArray(child.slug) ? child.slug.join('/') : child.slug;
                    const childIndent = 1.5 + child.level * 1.5;
                    const childHasChildren = child.children && child.children.length > 0;
                    
                    return (
                      <div class="tree-node" data-level={child.level}>
                        <div class="node-row">
                          <a
                            href={`/${childSlug}`}
                            class="nav-item"
                            data-level={child.level}
                            style={`padding-left: ${childIndent}rem;`}
                          >
                            <span class="nav-icon">{getIconForLevel(child.level)}</span>
                            <span class="nav-title">{child.title}</span>
                            <span class="nav-arrow">›</span>
                          </a>
                          {childHasChildren && (
                            <button
                              class="expand-toggle"
                              data-target={child.id}
                              aria-expanded="true"
                              aria-label={`展開/收合 ${child.title}`}
                            >
                              <span class="expand-chevron">▼</span>
                            </button>
                          )}
                        </div>
                        {childHasChildren && (
                          <div class="children-container" id={child.id}>
                            {child.children.map((grandchild) => {
                              const grandchildSlug = Array.isArray(grandchild.slug) ? grandchild.slug.join('/') : grandchild.slug;
                              const grandchildIndent = 1.5 + grandchild.level * 1.5;
                              
                              return (
                                <a
                                  href={`/${grandchildSlug}`}
                                  class="nav-item"
                                  data-level={grandchild.level}
                                  style={`padding-left: ${grandchildIndent}rem;`}
                                >
                                  <span class="nav-icon">{getIconForLevel(grandchild.level)}</span>
                                  <span class="nav-title">{grandchild.title}</span>
                                  <span class="nav-arrow">›</span>
                                </a>
                              );
                            })}
                          </div>
                        )}
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  ) : (
    <div class="construction-box">
      <div class="construction-particles">
        <div class="construction-particle"></div>
        <div class="construction-particle"></div>
        <div class="construction-particle"></div>
      </div>
      
      <div class="construction-content">
        <div class="working-image-wrapper">
          <img src={workingImage} alt="UEP Working" class="working-image" />
        </div>
        
        <div class="construction-text">
          <h2 class="construction-title">內容建設中</h2>
          <p class="construction-desc">U.E.P 正在整理這個區域的內容，請稍候！</p>
          
          <div class="loading-bar">
            <div class="loading-progress"></div>
          </div>
          
          <p class="construction-hint">敬請期待 ✨</p>
        </div>
      </div>
    </div>
  )}
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButtons = document.querySelectorAll('.expand-toggle');
    
    toggleButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        const targetId = button.getAttribute('data-target');
        const container = document.getElementById(targetId!);
        const chevron = button.querySelector('.expand-chevron');
        const isExpanded = button.getAttribute('aria-expanded') === 'true';
        
        if (container && chevron) {
          if (isExpanded) {
            // 收合
            container.style.maxHeight = '0';
            container.style.opacity = '0';
            chevron.textContent = '▶';
            button.setAttribute('aria-expanded', 'false');
          } else {
            // 展開
            container.style.maxHeight = container.scrollHeight + 'px';
            container.style.opacity = '1';
            chevron.textContent = '▼';
            button.setAttribute('aria-expanded', 'true');
          }
        }
      });
    });
  });
</script>

