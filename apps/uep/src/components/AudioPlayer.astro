---
/**
 * AudioPlayer - 簡易音頻播放器組件
 *
 * 功能：
 * - 播放/暫停控制
 * - 音量調整
 * - 進度條顯示
 * - 互斥播放（同時只能有一個播放器在播放）
 *
 * 變體：
 * - minimal: 極簡風格，只有核心控制
 * - card: 卡片式，包含標題和描述
 * - inline: 行內式，融入文字流
 */

interface Props {
  src: string;
  title?: string;
  description?: string;
  variant?: 'minimal' | 'card' | 'inline';
}

const { src, title, description, variant = 'card' } = Astro.props;
const playerId = `audio-player-${Math.random().toString(36).substring(2, 11)}`;
---

<div class={`audio-player audio-player--${variant}`} data-player-id={playerId}>
  {
    variant === 'card' && (title || description) && (
      <div class="audio-player__header">
        {title && <h3 class="audio-player__title">{title}</h3>}
        {description && <p class="audio-player__description">{description}</p>}
      </div>
    )
  }

  <div class="audio-player__controls">
    {
      variant === 'inline' && title && (
        <span class="audio-player__inline-title">🎵 {title}</span>
      )
    }

    <button class="audio-player__play-btn" aria-label="播放/暫停">
      <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z"></path>
      </svg>
      <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6 4h4v16H6V4zm8 0h4v16h-4V4z"></path>
      </svg>
    </button>

    <div class="audio-player__progress">
      <div class="audio-player__time audio-player__time--current">0:00</div>
      <input
        type="range"
        class="audio-player__progress-bar"
        min="0"
        max="100"
        value="0"
        aria-label="播放進度"
      />
      <div class="audio-player__time audio-player__time--duration">0:00</div>
    </div>

    <div class="audio-player__volume">
      <button class="audio-player__volume-btn" aria-label="靜音/取消靜音">
        <svg class="icon-volume" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"
          ></path>
        </svg>
        <svg class="icon-mute" viewBox="0 0 24 24" fill="currentColor">
          <path
            d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
          ></path>
        </svg>
      </button>
      <input
        type="range"
        class="audio-player__volume-slider"
        min="0"
        max="100"
        value="70"
        aria-label="音量"
      />
    </div>
  </div>

  <audio class="audio-player__element" preload="metadata">
    <source src={src} type="audio/wav" />
    您的瀏覽器不支援音頻播放。
  </audio>
</div>

<style>
  .audio-player {
    --player-bg: rgba(17, 24, 39, 0.6);
    --player-border: rgba(212, 175, 55, 0.2);
    --player-accent: #d4af37;
    --player-text: rgba(255, 255, 255, 0.9);
    --player-text-dim: rgba(255, 255, 255, 0.6);
    --player-hover: rgba(212, 175, 55, 0.1);
  }

  /* ===== Card Variant (預設) ===== */
  .audio-player--card {
    background: var(--player-bg);
    border: 1px solid var(--player-border);
    border-radius: 1rem;
    padding: 1.5rem;
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
  }

  .audio-player--card:hover {
    border-color: var(--player-accent);
    box-shadow: 0 8px 32px rgba(212, 175, 55, 0.15);
  }

  .audio-player__header {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(212, 175, 55, 0.1);
  }

  .audio-player__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--player-accent);
    margin: 0 0 0.5rem 0;
  }

  .audio-player__description {
    font-size: 0.875rem;
    color: var(--player-text-dim);
    margin: 0;
    line-height: 1.5;
  }

  /* ===== Minimal Variant ===== */
  .audio-player--minimal {
    background: var(--player-bg);
    border: 1px solid var(--player-border);
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    backdrop-filter: blur(10px);
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }

  .audio-player--minimal .audio-player__controls {
    gap: 0.5rem;
  }

  .audio-player--minimal .audio-player__progress {
    min-width: 200px;
  }

  /* ===== Inline Variant ===== */
  .audio-player--inline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--player-hover);
    border: 1px solid var(--player-border);
    border-radius: 0.375rem;
    padding: 0.5rem 0.75rem;
    vertical-align: middle;
  }

  .audio-player--inline .audio-player__controls {
    gap: 0.5rem;
    flex-wrap: nowrap;
  }

  .audio-player--inline .audio-player__progress {
    min-width: 150px;
  }

  .audio-player__inline-title {
    font-size: 0.875rem;
    color: var(--player-text);
    white-space: nowrap;
  }

  /* ===== Controls ===== */
  .audio-player__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .audio-player__play-btn,
  .audio-player__volume-btn {
    background: none;
    border: none;
    color: var(--player-accent);
    cursor: pointer;
    padding: 0.5rem;
    border-radius: 0.375rem;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .audio-player__play-btn {
    width: 2.5rem;
    height: 2.5rem;
  }

  .audio-player__volume-btn {
    width: 2rem;
    height: 2rem;
  }

  .audio-player__play-btn:hover,
  .audio-player__volume-btn:hover {
    background: var(--player-hover);
    transform: scale(1.1);
  }

  .audio-player__play-btn svg,
  .audio-player__volume-btn svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  /* Icon 切換邏輯 */
  .audio-player__play-btn .icon-pause,
  .audio-player[data-playing='true'] .icon-play,
  .audio-player__volume-btn .icon-mute,
  .audio-player[data-muted='true'] .icon-volume {
    display: none;
  }

  .audio-player[data-playing='true'] .icon-pause,
  .audio-player[data-muted='true'] .icon-mute {
    display: block;
  }

  /* ===== Progress Bar ===== */
  .audio-player__progress {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .audio-player__time {
    font-size: 0.75rem;
    color: var(--player-text-dim);
    font-variant-numeric: tabular-nums;
    min-width: 2.5rem;
    text-align: center;
  }

  .audio-player__progress-bar {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.1);
    outline: none;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .audio-player__progress-bar::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--player-accent);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .audio-player__progress-bar::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--player-accent);
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
  }

  .audio-player__progress-bar:hover::-webkit-slider-thumb,
  .audio-player__progress-bar:hover::-moz-range-thumb {
    transform: scale(1.2);
  }

  /* ===== Volume ===== */
  .audio-player__volume {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .audio-player__volume-slider {
    width: 80px;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.1);
    outline: none;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .audio-player__volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--player-accent);
    cursor: pointer;
  }

  .audio-player__volume-slider::-moz-range-thumb {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--player-accent);
    cursor: pointer;
    border: none;
  }

  /* ===== Audio Element ===== */
  .audio-player__element {
    display: none;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .audio-player--card {
      padding: 1rem;
    }

    .audio-player__volume {
      display: none;
    }

    .audio-player--minimal,
    .audio-player--inline {
      flex-wrap: wrap;
    }
  }
</style>

<script>
  // 互斥播放邏輯
  class AudioPlayerManager {
    private static currentPlaying: HTMLAudioElement | null = null;

    static play(audio: HTMLAudioElement, playerId: string) {
      // 暫停其他正在播放的音頻
      if (this.currentPlaying && this.currentPlaying !== audio) {
        this.currentPlaying.pause();
        // 觸發事件通知其他播放器更新狀態
        document.dispatchEvent(
          new CustomEvent('audio-pause-all', {
            detail: { excludeId: playerId },
          })
        );
      }
      this.currentPlaying = audio;
    }

    static pause() {
      this.currentPlaying = null;
    }
  }

  // 初始化所有播放器
  document.addEventListener('DOMContentLoaded', () => {
    const players = document.querySelectorAll('.audio-player');

    players.forEach((player) => {
      const playerId = player.getAttribute('data-player-id') || '';
      const audio = player.querySelector(
        '.audio-player__element'
      ) as HTMLAudioElement;
      const playBtn = player.querySelector(
        '.audio-player__play-btn'
      ) as HTMLButtonElement;
      const progressBar = player.querySelector(
        '.audio-player__progress-bar'
      ) as HTMLInputElement;
      const currentTimeEl = player.querySelector(
        '.audio-player__time--current'
      ) as HTMLElement;
      const durationEl = player.querySelector(
        '.audio-player__time--duration'
      ) as HTMLElement;
      const volumeBtn = player.querySelector(
        '.audio-player__volume-btn'
      ) as HTMLButtonElement;
      const volumeSlider = player.querySelector(
        '.audio-player__volume-slider'
      ) as HTMLInputElement;

      if (!audio) return;

      // 格式化時間
      const formatTime = (seconds: number): string => {
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs.toString().padStart(2, '0')}`;
      };

      // 更新播放狀態 UI
      const updatePlayingState = (playing: boolean) => {
        player.setAttribute('data-playing', playing.toString());
      };

      // 播放/暫停
      playBtn?.addEventListener('click', () => {
        if (audio.paused) {
          AudioPlayerManager.play(audio, playerId);
          audio.play();
          updatePlayingState(true);
        } else {
          audio.pause();
          AudioPlayerManager.pause();
          updatePlayingState(false);
        }
      });

      // 進度條更新
      audio.addEventListener('timeupdate', () => {
        if (audio.duration) {
          const progress = (audio.currentTime / audio.duration) * 100;
          progressBar.value = progress.toString();
          currentTimeEl.textContent = formatTime(audio.currentTime);
        }
      });

      // 載入後顯示總時長
      audio.addEventListener('loadedmetadata', () => {
        durationEl.textContent = formatTime(audio.duration);
      });

      // 進度條拖動
      progressBar?.addEventListener('input', () => {
        if (audio.duration) {
          const time = (parseFloat(progressBar.value) / 100) * audio.duration;
          audio.currentTime = time;
        }
      });

      // 音頻結束
      audio.addEventListener('ended', () => {
        updatePlayingState(false);
        AudioPlayerManager.pause();
      });

      // 靜音切換
      volumeBtn?.addEventListener('click', () => {
        audio.muted = !audio.muted;
        player.setAttribute('data-muted', audio.muted.toString());
      });

      // 音量調整
      volumeSlider?.addEventListener('input', () => {
        audio.volume = parseFloat(volumeSlider.value) / 100;
        if (audio.volume > 0 && audio.muted) {
          audio.muted = false;
          player.setAttribute('data-muted', 'false');
        }
      });

      // 設定初始音量
      if (volumeSlider) {
        audio.volume = parseFloat(volumeSlider.value) / 100;
      }

      // 監聽全局暫停事件
      document.addEventListener('audio-pause-all', (e) => {
        const detail = (e as { detail?: { excludeId?: string } }).detail;
        if (detail?.excludeId !== playerId) {
          if (!audio.paused) {
            audio.pause();
          }
          updatePlayingState(false);
        }
      });

      // 監聽音頻的暫停事件，確保 UI 同步
      audio.addEventListener('pause', () => {
        updatePlayingState(false);
      });

      audio.addEventListener('play', () => {
        updatePlayingState(true);
      });
    });
  });
</script>
