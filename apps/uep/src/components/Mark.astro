---
/**
 * Mark 元件 - 替換 <mark style="color:..."> 標記
 * 支援多種顏色的文字標記
 */

interface Props {
  color?:
    | 'yellow'
    | 'red'
    | 'blue'
    | 'green'
    | 'purple'
    | 'orange'
    | 'pink'
    | 'cyan';
  inline?: boolean;
}

const { color = 'yellow', inline = true } = Astro.props;
---

{
  inline ? (
    <span class={`mark mark-${color}`}>
      <slot />
    </span>
  ) : (
    <div class={`mark mark-${color} mark-block`}>
      <slot />
    </div>
  )
}

<style>
  .mark {
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .mark-block {
    display: block;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    margin: 0.5rem 0;
  }

  /* 黃色 */
  .mark-yellow {
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.15);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  /* 紅色 */
  .mark-red {
    color: #f87171;
    background: rgba(248, 113, 113, 0.15);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  /* 藍色 */
  .mark-blue {
    color: #60a5fa;
    background: rgba(96, 165, 250, 0.15);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  /* 綠色 */
  .mark-green {
    color: #4ade80;
    background: rgba(74, 222, 128, 0.15);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  /* 紫色 */
  .mark-purple {
    color: #a855f7;
    background: rgba(168, 85, 247, 0.15);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  /* 橙色 */
  .mark-orange {
    color: #fb923c;
    background: rgba(251, 146, 60, 0.15);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  /* 粉色 */
  .mark-pink {
    color: #ec4899;
    background: rgba(236, 72, 153, 0.15);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  /* 青色 */
  .mark-cyan {
    color: #06b6d4;
    background: rgba(6, 182, 212, 0.15);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }

  .mark:hover {
    filter: brightness(1.2);
  }
</style>
