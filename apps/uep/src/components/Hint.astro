---
/**
 * Hint 元件 - 替換 GitBook 的 {% hint %} 語法
 * 支援多種提示類型：info, warning, danger, success
 */

interface Props {
  type?: 'info' | 'warning' | 'danger' | 'success';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const icons = {
  info: '💡',
  warning: '⚠️',
  danger: '🚨',
  success: '✅',
};

const titles = {
  info: title || '提示',
  warning: title || '警告',
  danger: title || '危險',
  success: title || '成功',
};
---

<div class={`hint hint-${type}`}>
  <div class="hint-icon">{icons[type]}</div>
  <div class="hint-content">
    <div class="hint-title">{titles[type]}</div>
    <div class="hint-body">
      <slot />
    </div>
  </div>
</div>

<style>
  .hint {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 12px;
    margin: 1.5rem 0;
    border-left: 4px solid;
    backdrop-filter: blur(10px);
  }

  .hint-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    line-height: 1;
  }

  .hint-content {
    flex: 1;
  }

  .hint-title {
    font-weight: 600;
    margin-bottom: 0.5rem;
    font-size: 1rem;
  }

  .hint-body {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .hint-body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* Info 樣式 */
  .hint-info {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.5);
  }

  .hint-info .hint-title {
    color: #60a5fa;
  }

  .hint-info .hint-body {
    color: rgba(147, 197, 253, 0.9);
  }

  /* Warning 樣式 */
  .hint-warning {
    background: rgba(251, 191, 36, 0.1);
    border-color: rgba(251, 191, 36, 0.5);
  }

  .hint-warning .hint-title {
    color: #fbbf24;
  }

  .hint-warning .hint-body {
    color: rgba(253, 224, 71, 0.9);
  }

  /* Danger 樣式 */
  .hint-danger {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.5);
  }

  .hint-danger .hint-title {
    color: #f87171;
  }

  .hint-danger .hint-body {
    color: rgba(252, 165, 165, 0.9);
  }

  /* Success 樣式 */
  .hint-success {
    background: rgba(34, 197, 94, 0.1);
    border-color: rgba(34, 197, 94, 0.5);
  }

  .hint-success .hint-title {
    color: #4ade80;
  }

  .hint-success .hint-body {
    color: rgba(134, 239, 172, 0.9);
  }

  @media (max-width: 640px) {
    .hint {
      padding: 1rem;
      gap: 0.75rem;
    }

    .hint-icon {
      font-size: 1.25rem;
    }

    .hint-title {
      font-size: 0.9rem;
    }

    .hint-body {
      font-size: 0.875rem;
    }
  }
</style>
