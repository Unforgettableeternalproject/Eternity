---
/**
 * 內容頁面元件
 * 用於顯示單篇文章/文檔，包含標題、副標題、圖示和內容
 */

import { processIcon } from '../utils/markdown-transforms';

interface Props {
  /** 頁面標題（來自 SUMMARY.md） */
  title: string;
  /** 副標題（來自 frontmatter 的 description） */
  description?: string;
  /** 圖示（來自 frontmatter 的 icon） */
  icon?: string;
  /** 是否隱藏（來自 frontmatter 的 hidden） */
  hidden?: boolean;
  /** 內容類別標籤 */
  category?: string;
  /** 章節編號 */
  chapter?: string;
}

const { 
  title, 
  description, 
  icon, 
  hidden = false,
  category,
  chapter
} = Astro.props;

const processedIcon = icon ? processIcon(icon) : null;
---

<article class="content-page" data-hidden={hidden}>
  <header class="content-header">
    <!-- 圖示與分類 -->
    {(processedIcon || category) && (
      <div class="header-meta">
        {processedIcon && (
          <span class="content-icon">{processedIcon}</span>
        )}
        {category && (
          <span class="content-category">{category}</span>
        )}
        {chapter && (
          <span class="content-chapter">{chapter}</span>
        )}
      </div>
    )}
    
    <!-- 主標題 -->
    <h1 class="content-title">{title}</h1>
    
    <!-- 副標題/描述 -->
    {description && (
      <p class="content-description" set:html={description} />
    )}
    
    <!-- 隱藏內容警告 -->
    {hidden && (
      <div class="hidden-warning">
        <span class="warning-icon">🔒</span>
        <span class="warning-text">此內容目前處於隱藏狀態</span>
      </div>
    )}
  </header>
  
  <!-- 內容插槽 -->
  <div class="content-body">
    <slot />
  </div>
  
  <!-- 頁尾 -->
  <footer class="content-footer">
    <slot name="footer" />
  </footer>
</article>

<style>
  .content-page {
    max-width: 850px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .content-page[data-hidden="true"] {
    position: relative;
  }

  .content-page[data-hidden="true"]::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: repeating-linear-gradient(
      45deg,
      rgba(0, 0, 0, 0.05),
      rgba(0, 0, 0, 0.05) 10px,
      transparent 10px,
      transparent 20px
    );
    pointer-events: none;
    z-index: -1;
  }

  /* 頁首 */
  .content-header {
    margin-bottom: 3rem;
    border-bottom: 2px solid rgba(213, 182, 24, 0.2);
    padding-bottom: 2rem;
  }

  /* Meta 資訊 */
  .header-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .content-icon {
    font-size: 2.5rem;
    line-height: 1;
    filter: drop-shadow(0 2px 8px rgba(213, 182, 24, 0.3));
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .content-category,
  .content-chapter {
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .content-category {
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.2) 0%, rgba(6, 182, 212, 0.2) 100%);
    color: #a855f7;
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .content-chapter {
    background: linear-gradient(135deg, rgba(251, 191, 36, 0.2) 0%, rgba(213, 182, 24, 0.2) 100%);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
  }

  /* 主標題 */
  .content-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0.5rem 0;
    background: linear-gradient(135deg, #d5b618 0%, #ffd700 50%, #d5b618 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: shimmer 3s ease-in-out infinite;
    background-size: 200% auto;
  }

  @keyframes shimmer {
    0%, 100% {
      background-position: 0% center;
    }
    50% {
      background-position: 100% center;
    }
  }

  /* 副標題/描述 */
  .content-description {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.7);
    margin-top: 1rem;
    line-height: 1.6;
    font-style: italic;
  }

  .content-description :global(br) {
    content: '';
    display: block;
    margin-bottom: 0.5rem;
  }

  /* 隱藏警告 */
  .hidden-warning {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.5rem;
    margin-top: 1.5rem;
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.3);
    border-radius: 12px;
  }

  .warning-icon {
    font-size: 1.5rem;
  }

  .warning-text {
    color: #fbbf24;
    font-weight: 600;
    font-size: 0.95rem;
  }

  /* 內容主體 */
  .content-body {
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.8;
    font-size: 1.05rem;
  }

  .content-body :global(p) {
    margin-bottom: 1.5rem;
  }

  .content-body :global(h2) {
    font-size: 2rem;
    color: #a855f7;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    font-weight: 700;
  }

  .content-body :global(h3) {
    font-size: 1.5rem;
    color: #06b6d4;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .content-body :global(h4) {
    font-size: 1.25rem;
    color: #ec4899;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .content-body :global(strong) {
    color: #fbbf24;
    font-weight: 700;
  }

  .content-body :global(em) {
    color: #a855f7;
    font-style: italic;
  }

  .content-body :global(code) {
    background: rgba(168, 85, 247, 0.15);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    font-size: 0.95em;
    color: #fbbf24;
  }

  .content-body :global(blockquote) {
    border-left: 4px solid #d5b618;
    padding-left: 1.5rem;
    margin: 2rem 0;
    color: rgba(255, 255, 255, 0.8);
    font-style: italic;
  }

  .content-body :global(ul),
  .content-body :global(ol) {
    margin: 1.5rem 0;
    padding-left: 2rem;
  }

  .content-body :global(li) {
    margin-bottom: 0.75rem;
  }

  /* 頁尾 */
  .content-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(213, 182, 24, 0.2);
  }

  /* 響應式 */
  @media (max-width: 768px) {
    .content-page {
      padding: 1.5rem 1rem;
    }

    .content-title {
      font-size: 2rem;
    }

    .content-description {
      font-size: 1.1rem;
    }

    .content-icon {
      font-size: 2rem;
    }

    .header-meta {
      flex-wrap: wrap;
    }
  }
</style>
