---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hint from '../components/Hint.astro';
import Spoiler from '../components/Spoiler.astro';
import Divider from '../components/Divider.astro';
import fs from 'node:fs';
import path from 'node:path';
import { transformGitBookContent } from '../utils/markdown-transforms';
import { unified } from 'unified';
import remarkParse from 'remark-parse';
import remarkGfm from 'remark-gfm';
import remarkRehype from 'remark-rehype';
import rehypeStringify from 'rehype-stringify';

// 創建 Markdown 渲染器
const markdownProcessor = unified()
  .use(remarkParse)
  .use(remarkGfm)
  .use(remarkRehype)
  .use(rehypeStringify);

// 讀取測試文章
const contentPath = 'history/passage/unforgettable_story/chpt.-1/arc.00.md';
const fullPath = path.join(process.cwd(), 'content', contentPath);
const rawContent = fs.readFileSync(fullPath, 'utf-8');

// 提取 frontmatter (修正版本)
const frontmatterMatch = rawContent.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n/);
let metadata: Record<string, string> = {};
if (frontmatterMatch) {
  const frontmatter = frontmatterMatch[1];
  frontmatter.split(/\r?\n/).forEach(line => {
    const colonIndex = line.indexOf(':');
    if (colonIndex > 0) {
      const key = line.substring(0, colonIndex).trim();
      const value = line.substring(colonIndex + 1).trim();
      metadata[key] = value;
    }
  });
}

// 移除 frontmatter
const withoutFrontmatter = rawContent.replace(/^---\r?\n[\s\S]*?\r?\n---\r?\n/, '');

// 先將邊界符單獨提取為區塊（替換為特殊標記，前後添加分隔用的空行）
// 注意：❇︎ 實際上是兩個字元 U+2747 (❇) + U+FE0E (變體選擇器)
// 匹配：換行 + 邊界符（10組以上的❇︎）+ 換行
const withBoundaryMarkers = withoutFrontmatter.replace(
  /\r?\n((?:❇\uFE0E){10,})\r?\n/g,
  '\n\n\n\n<<<BOUNDARY>>>\n\n\n\n'
);

// 按 3 個空行（4 個換行符）分割
const rawBlocks = withBoundaryMarkers
  .split(/(?:\r?\n){4,}/)
  .map(b => b.trim())
  .filter(b => b.length > 0);

// 處理邊界符邏輯
interface Block {
  content: string;
  type: 'normal' | 'boundary-wrapped' | 'divider';
}

const blocks: Block[] = [];
let i = 0;

while (i < rawBlocks.length) {
  const current = rawBlocks[i];
  
  // 檢查是否為邊界符標記
  if (current === '<<<BOUNDARY>>>') {
    // 檢查是否為成對包裹（下一個非邊界符區塊後還有邊界符）
    if (i + 2 < rawBlocks.length && rawBlocks[i + 2] === '<<<BOUNDARY>>>') {
      // 成對包裹：將邊界符 + 內容 + 邊界符 視為一個特殊區塊
      blocks.push({
        content: rawBlocks[i + 1],
        type: 'boundary-wrapped'
      });
      i += 3; // 跳過三個區塊
    } else {
      // 單獨邊界符：視為分隔線
      blocks.push({
        content: '',
        type: 'divider'
      });
      i += 1;
    }
  } else {
    // 普通區塊
    blocks.push({
      content: current,
      type: 'normal'
    });
    i += 1;
  }
}

// 應用設計層轉換（GitBook → Astro）
const transformedBlocks = blocks.map(b => ({
  ...b,
  content: b.content ? transformGitBookContent(b.content) : ''
}));

// 渲染 Markdown → HTML
const htmlBlocks = await Promise.all(
  transformedBlocks.map(async (block) => {
    if (!block.content) return { ...block, html: '' };
    const result = await markdownProcessor.process(block.content);
    return {
      ...block,
      html: String(result)
    };
  })
);

// Debug: 詳細檢查前 10 個區塊
console.log('=== Debug Info ===');
console.log(`總區塊數: ${blocks.length}`);
console.log(`Metadata:`, metadata);
console.log('\n===== 前 10 個區塊詳細內容 =====');
htmlBlocks.slice(0, 10).forEach((block, i) => {
  console.log(`\n--- 區塊 ${i} (類型: ${block.type}, 長度: ${block.content.length} 字元) ---`);
  if (block.type === 'divider') {
    console.log('[分隔線]');
  } else if (block.type === 'boundary-wrapped') {
    console.log('[邊界包裹區塊]');
    console.log(block.content.substring(0, 100).replace(/\n/g, '\n  '));
  } else {
    console.log(block.content.substring(0, 100).replace(/\n/g, '\n  '));
  }
  console.log(`--- 區塊 ${i} 結束 ---`);
});
console.log('\n===== Debug 結束 =====\n');
---

<BaseLayout title="覆蓋層測試 - E.0 致永恆">
  <div class="overlay-test-container">
    <div class="test-header">
      <h1>🧪 覆蓋層系統測試</h1>
      {metadata.description && (
        <p class="subtitle">{metadata.description}</p>
      )}
      <p class="test-description">
        此頁面展示四層式渲染架構的效果。<br/>
        配置文件：<code>src/overlays/history/passage/unforgettable_story/chpt.-1/arc.00.json</code>
      </p>
      
      <div class="test-info">
        <h3>應用的增強效果：</h3>
        <ul>
          <li>✨ <strong>Hint</strong>：包裝「在一片空虛當中...」開頭的段落</li>
          <li>🎨 <strong>Divider</strong>：替換 ❇︎ 分隔線</li>
          <li>🔒 <strong>Spoiler</strong>：包裝所有包含 ◼︎ 的段落</li>
          <li>💜 <strong>紫色標記</strong>：標記「你的名字是...」</li>
        </ul>
        <p style="margin-top: 1rem; font-size: 0.875rem; color: rgba(255,255,255,0.5);">
          總區塊數：{blocks.length} | 
          Description: {metadata.description || '無'} | 
          Icon: {metadata.icon || '無'}
        </p>
      </div>
    </div>

    <div class="test-divider"></div>

    <!-- 手動應用覆蓋層規則來渲染 -->
    <article class="enhanced-content">
      <div class="content-body">
        {htmlBlocks.map((block, index) => {
          
          // 類型 1: 分隔線
          if (block.type === 'divider') {
            console.log(`✓ 分隔線於區塊 ${index}`);
            return <Divider style="gradient" spacing="large" />;
          }
          
          // 類型 2: 邊界包裹區塊（特殊樣式）
          if (block.type === 'boundary-wrapped') {
            console.log(`✓ 邊界包裹區塊於區塊 ${index}，內容: ${block.content.substring(0, 50)}...`);
            return (
              <div class="boundary-section">
                <div class="boundary-line top"></div>
                <div class="boundary-content">
                  <div set:html={block.html} />
                </div>
                <div class="boundary-line bottom"></div>
              </div>
            );
          }
          
          // 類型 3: 普通區塊 - 應用覆蓋層規則
          
          // 規則 1: 「在一片空虛當中」開頭的段落用 Hint 包裝
          if (block.content.startsWith('在一片空虛當中')) {
            console.log(`✓ Hint 匹配於區塊 ${index}`);
            return (
              <div class="block-wrapper">
                <Hint type="info">
                  <div set:html={block.html} />
                </Hint>
              </div>
            );
          }
          
          // 規則 2: 包含 ◼︎ 的段落用 Spoiler 包裝
          if (block.content.includes('◼︎')) {
            return (
              <div class="block-wrapper">
                <Spoiler variant="censored">
                  <div set:html={block.html} />
                </Spoiler>
              </div>
            );
          }
          
          // 規則 3: 「你的名字是」用紫色標記
          if (block.content.includes('你的名字是')) {
            console.log(`✓ 紫色標記匹配於區塊 ${index}`);
            const highlighted = block.html.replace(
              /「你的名字是[^」]*」/g,
              '<mark style="background: rgba(168, 85, 247, 0.3); color: #c084fc; padding: 0.25rem 0.5rem; border-radius: 0.25rem; font-weight: 600;">$&</mark>'
            );
            return (
              <div class="block-wrapper">
                <div set:html={highlighted} />
              </div>
            );
          }
          
          // 預設：正常渲染
          return (
            <div class="block-wrapper">
              <div set:html={block.html} />
            </div>
          );
        })}
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .overlay-test-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .test-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .test-header h1 {
    font-size: 2.5rem;
    background: linear-gradient(135deg, #a855f7 0%, #06b6d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    font-size: 1.5rem;
    color: #d4af37;
    margin: 0 0 1.5rem 0;
    font-weight: 500;
  }

  .test-description {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
  }

  .test-description code {
    background: rgba(168, 85, 247, 0.2);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    color: #fbbf24;
    font-size: 0.875rem;
  }

  .test-info {
    margin-top: 2rem;
    padding: 1.5rem;
    background: rgba(17, 24, 39, 0.6);
    border: 1px solid rgba(212, 175, 55, 0.2);
    border-radius: 1rem;
    backdrop-filter: blur(10px);
    text-align: left;
  }

  .test-info h3 {
    color: #d4af37;
    margin: 0 0 1rem 0;
    font-size: 1.25rem;
  }

  .test-info ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .test-info li {
    padding: 0.5rem 0;
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.9375rem;
  }

  .test-info strong {
    color: #fbbf24;
  }

  .test-divider {
    height: 2px;
    background: linear-gradient(90deg, transparent, #a855f7, #06b6d4, transparent);
    margin: 3rem 0;
  }

  /* 段落包裝器 - 區塊間距 */
  .block-wrapper {
    margin-bottom: 3.5rem; /* 區塊間距，模擬原始三空行 */
  }

  /* 區塊內的句子間距 */
  .block-wrapper :global(p) {
    margin-bottom: 0.75rem; /* 句子之間較小間距 */
  }

  .block-wrapper :global(p:last-child) {
    margin-bottom: 0;
  }

  /* 區塊內如果有多個段落，保持間距 */
  .block-wrapper :global(p + p) {
    margin-top: 0.75rem;
  }

  /* 邊界包裹區塊的特殊樣式 */
  .boundary-section {
    margin-bottom: 3.5rem; /* 與一般區塊相同的底部間距 */
    position: relative;
  }

  .boundary-line {
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(212, 175, 55, 0.3) 10%,
      rgba(212, 175, 55, 0.6) 50%,
      rgba(212, 175, 55, 0.3) 90%,
      transparent
    );
    position: relative;
  }

  .boundary-line::before {
    content: '❇︎ ❇︎ ❇︎ ❇︎ ❇︎ ❇︎ ❇︎ ❇︎ ❇︎ ❇︎ ❇︎ ❇︎ ❇︎';
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: linear-gradient(135deg, #1f2937 0%, #111827 100%);
    padding: 0.5rem 1.5rem;
    color: rgba(212, 175, 55, 0.5);
    font-size: 0.875rem;
    letter-spacing: 0.2em;
    border-radius: 0.5rem;
  }

  .boundary-content {
    padding: 3rem 2rem;
    text-align: center;
    background: linear-gradient(
      135deg,
      rgba(212, 175, 55, 0.05) 0%,
      rgba(212, 175, 55, 0.02) 100%
    );
    border-left: 2px solid rgba(212, 175, 55, 0.2);
    border-right: 2px solid rgba(212, 175, 55, 0.2);
  }

  .boundary-content :global(p) {
    font-size: 1.125rem;
    font-weight: 600;
    color: #d4af37;
    margin: 0;
  }

  /* 內容區域樣式覆蓋 */
  .enhanced-content {
    width: 100%;
    max-width: 850px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .content-body {
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.9);
  }

  /* 標題樣式 */
  .content-body :global(h1) {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .content-body :global(h2) {
    font-size: 2rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #d4af37;
  }

  .content-body :global(p) {
    margin: 0;
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .overlay-test-container {
      padding: 2rem 1rem;
    }

    .test-header h1 {
      font-size: 2rem;
    }

    .test-info {
      padding: 1rem;
    }
  }
</style>
