---
import BaseLayout from '../layouts/BaseLayout.astro';
import AreaPage from '../components/AreaPage.astro';
import { loadSummary, extractDirectChildren } from '../utils/summary';
import { join } from 'node:path';

const contentDir = join(process.cwd(), 'content');
const navigation = loadSummary(contentDir);

const storagePages = extractDirectChildren(navigation, 'storage').map(route => ({
  slug: route.slug,
  title: route.title
}));
---

<BaseLayout title="某人的置物空間 - 邊際世界">
  <AreaPage
    icon="📦"
    title="某人的置物空間"
    description="在這裡，你看見了琳瑯滿目的收藏品，彷彿是某人的房間一般。<br>你還記得 U.E.P 說過，他需要一個暫放自己收藏的地方。<br>於是在他的請求下，你允許他在邊際世界的某處開設了一個儲物間。"
    themeColor="#f97316"
    workingImage="/uep/Cat.png"
    pages={storagePages}
  />
</BaseLayout>

  <style>
    .area-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 2rem;
    }

    .area-header {
      text-align: center;
      margin-bottom: 3rem;
    }

    .area-icon {
      font-size: 5rem;
      margin-bottom: 1rem;
    }

    .area-title {
      font-size: 3rem;
      font-weight: 700;
      color: #f97316;
      margin-bottom: 1rem;
    }

    .area-desc {
      font-size: 1.2rem;
      color: rgba(255, 255, 255, 0.7);
      max-width: 600px;
      margin: 0 auto;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--gold);
      text-decoration: none;
      margin-bottom: 2rem;
      padding: 0.5rem 1rem;
      background: rgba(213, 182, 24, 0.1);
      border: 1px solid rgba(213, 182, 24, 0.3);
      border-radius: 8px;
      transition: all 0.2s ease;
    }

    .back-link:hover {
      background: rgba(213, 182, 24, 0.2);
      transform: translateX(-5px);
    }

    .construction {
      text-align: center;
      padding: 3rem;
      background: rgba(249, 115, 22, 0.1);
      border: 2px solid #f97316;
      border-radius: 16px;
    }

    .construction img {
      width: 200px;
      height: auto;
      margin-bottom: 2rem;
    }
  </style>

  <div class="area-page">
    <a href="/" class="back-link">
      ← 返回世界的軸心
    </a>

    <div class="area-header">
      <div class="area-icon">📦</div>
      <h1 class="area-title">某人的置物空間</h1>
      <p class="area-desc">
        事實上，這裡給人的感覺就跟一般的工作室沒什麼兩樣，<br>
        只是不知道是屬於誰的房間。<br>
        整個空間就跟一般常見的工作室沒兩樣，只是似乎沒有可見的盡頭。
      </p>
    </div>

    <div class="construction">
      <img src="/uep/Cat.png" alt="UEP Cat" />
      <h2>內容建設中...</h2>
      <p>U.E.P 正在整理她的東西，請稍候！</p>
    </div>
  </div>
</BaseLayout>