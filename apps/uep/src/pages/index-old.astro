---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="U.E.P的幻想空間 - 邁向邊際世界">
  <div class="construction-page">
    <!-- 背景粒子效果 -->
    <div class="particles-container" id="particles"></div>
    <div class="noise-overlay"></div>
    
    <div class="hero">
      <div class="title-container">
        <div class="glitch-wrapper">
          <h1 class="glitch" data-text="U.E.P的幻想空間">U.E.P的<span class="text-gradient">幻想空間</span></h1>
        </div>
        <div class="construction-badge">
          <span class="portal-icon">✦</span>
          <span class="text">邊際世界構建中</span>
          <span class="portal-icon">✦</span>
        </div>
      </div>
      <p class="subtitle">一個超越維度的知識匯流點正在成形...</p>
      <p class="quote">「萬物由最原初的質所成，在有限的時間中無限的擴展著」</p>
    </div>

    <section class="content">
      <!-- U.E.P 引導區 -->
      <div class="guide-section">
        <div class="uep-avatar">
          <div class="avatar-glow"></div>
          <div class="avatar-ring"></div>
        </div>
        <div class="guide-text">
          <p class="uep-speech">你好啊！我是 U.E.P，歡迎來到邊際世界 ╰(*°▽°*)╯</p>
          <p class="uep-speech">這個空間正在進行最後的調整，很快就能帶你探索無數的故事了！</p>
        </div>
      </div>

      <!-- 邊際世界區域預覽 -->
      <div class="worlds-preview">
        <h2 class="section-title">✧ 邊際世界的奧秘 ✧</h2>
        <div class="world-cards">
          <div class="world-card" data-world="history">
            <div class="card-glow"></div>
            <div class="card-icon">📚</div>
            <h3>歷史典藏庫</h3>
            <p>無數書頁在空中飛舞，回想碎片記錄著各個時空的故事</p>
            <div class="status">準備中...</div>
          </div>
          <div class="world-card" data-world="echo">
            <div class="card-glow"></div>
            <div class="card-icon">🔮</div>
            <h3>回音蒐藏間</h3>
            <p>充滿世界之聲，每個回聲球體都儲存著重要的回憶</p>
            <div class="status">準備中...</div>
          </div>
          <div class="world-card" data-world="phantom">
            <div class="card-glow"></div>
            <div class="card-icon">👥</div>
            <h3>幻影重現室</h3>
            <p>世界的印象，每個人都曾存在於某個時間當中</p>
            <div class="status">準備中...</div>
          </div>
          <div class="world-card" data-world="concept">
            <div class="card-glow"></div>
            <div class="card-icon">⚡</div>
            <h3>概念調整房</h3>
            <p>科幻的伺服器空間，所有世界的概念都在這裡運轉</p>
            <div class="status">準備中...</div>
          </div>
        </div>
      </div>

      <!-- U.E.P 工作圖示 -->
      <div class="uep-images">
        <div class="image-card floating" data-delay="0">
          <div class="image-frame">
            <img src="/uep/Working.png" alt="UEP Working" />
          </div>
          <p class="caption">努力構建中</p>
        </div>
        <div class="image-card floating" data-delay="0.5">
          <div class="image-frame">
            <img src="/uep/Forklift.png" alt="UEP Forklift" />
          </div>
          <p class="caption">搬運概念原質</p>
        </div>
        <div class="image-card floating" data-delay="1">
          <div class="image-frame">
            <img src="/uep/Lead.png" alt="UEP Lead" />
          </div>
          <p class="caption">即將為您引路</p>
        </div>
      </div>

      <!-- 永恆的意義 -->
      <div class="eternity-section">
        <h2 class="section-title">✧ 永恆的意義 ✧</h2>
        <div class="eternity-poem">
          <p>萬物由最原初的質所成</p>
          <p>匯聚成個體，組合成群體</p>
          <p>在有限的時間中無限的擴展著</p>
          <div class="poem-divider"></div>
          <p class="highlight">終點與起點本是個環</p>
          <p class="highlight">創世和毀滅本為同根</p>
          <p class="highlight">輪迴與置換相互平衡</p>
          <div class="poem-divider"></div>
          <p class="fade">而萬物的終焉將歸約於<span class="void">虛無</span></p>
        </div>
      </div>

      <!-- 基軸大廳 - 通往其他世界 -->
      <div class="portals-section">
        <h2 class="section-title">✧ 外部基軸大廳 ✧</h2>
        <p class="portal-desc">通往各種不同世界的通道</p>
        <div class="portal-grid">
          <a
            href="https://unforgettableeternalproject.com"
            class="portal-card"
            target="_blank"
          >
            <div class="portal-light"></div>
            <div class="portal-icon">🌟</div>
            <h3>主要維度</h3>
            <p>返回 UEP 的主要網站</p>
          </a>
          <a
            href="https://github.com/Unforgettableeternalproject"
            class="portal-card"
            target="_blank"
          >
            <div class="portal-light"></div>
            <div class="portal-icon">💫</div>
            <h3>概念倉庫</h3>
            <p>查看所有創作的原始碼</p>
          </a>
        </div>
      </div>

      <!-- 世界構建進度 -->
      <div class="construction-progress">
        <p class="progress-text">✦ 邊際世界構建進度 ✦</p>
        <div class="progress-bar">
          <div class="progress-fill" id="progressFill"></div>
          <div class="progress-particles"></div>
        </div>
        <p class="progress-percentage" id="progressPercentage">初始化中...</p>
        <p class="progress-hint">概念原質正在重組...</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  :root {
    --gold: #d5b618;
    --gold-light: #e8c547;
    --gold-dark: #c9a615;
    --purple: #a855f7;
    --purple-light: #c084fc;
    --purple-dark: #7e22ce;
    --cyan: #06b6d4;
    --void-black: #0a0a0f;
    --void-gray: #1a1a2e;
    --text-primary: #f8f8ff;
    --text-secondary: #c0c0d8;
    --glass-bg: rgba(255, 255, 255, 0.05);
    --glass-border: rgba(255, 255, 255, 0.1);
  }

  .construction-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
    position: relative;
    min-height: 100vh;
  }

  /* 粒子背景 */
  .particles-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .noise-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    animation: noise 8s steps(10) infinite;
  }

  @keyframes noise {
    0%, 100% { transform: translate(0, 0); }
    10% { transform: translate(-5%, -5%); }
    20% { transform: translate(-10%, 5%); }
    30% { transform: translate(5%, -10%); }
    40% { transform: translate(-5%, 15%); }
    50% { transform: translate(-10%, 5%); }
    60% { transform: translate(15%, 0); }
    70% { transform: translate(0, 10%); }
    80% { transform: translate(-15%, 0); }
    90% { transform: translate(10%, 5%); }
  }

  /* Hero 區域 */
  .hero {
    text-align: center;
    padding: 4rem 0 3rem;
    margin-bottom: 4rem;
    position: relative;
    z-index: 2;
  }

  .title-container {
    position: relative;
    display: inline-block;
    margin-bottom: 2rem;
  }

  .glitch-wrapper {
    position: relative;
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 900;
    margin-bottom: 2rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    position: relative;
  }

  .glitch {
    position: relative;
    animation: glitch-skew 5s infinite;
  }

  @keyframes glitch-skew {
    0%, 100% { transform: skew(0deg); }
    20% { transform: skew(0.2deg); }
    40% { transform: skew(-0.2deg); }
  }

  .text-gradient {
    background: linear-gradient(135deg, var(--gold) 0%, var(--purple-light) 50%, var(--cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    background-size: 200% 200%;
    animation: gradientShift 6s ease infinite;
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .construction-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2rem;
    background: linear-gradient(135deg, var(--purple-dark), var(--purple));
    border: 2px solid var(--purple-light);
    border-radius: 2rem;
    box-shadow: 
      0 0 20px rgba(168, 85, 247, 0.4),
      0 0 40px rgba(168, 85, 247, 0.2),
      inset 0 0 20px rgba(255, 255, 255, 0.1);
    animation: pulse 2s ease-in-out infinite;
    position: relative;
    overflow: hidden;
  }

  .construction-badge::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: linear-gradient(
      45deg,
      transparent 30%,
      rgba(255, 255, 255, 0.1) 50%,
      transparent 70%
    );
    animation: shimmer 3s linear infinite;
  }

  @keyframes shimmer {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 
        0 0 20px rgba(168, 85, 247, 0.4),
        0 0 40px rgba(168, 85, 247, 0.2);
    }
    50% {
      transform: scale(1.05);
      box-shadow: 
        0 0 30px rgba(168, 85, 247, 0.6),
        0 0 60px rgba(168, 85, 247, 0.3);
    }
  }

  .portal-icon {
    font-size: 1.5rem;
    animation: rotate 4s linear infinite;
  }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .construction-badge .text {
    font-weight: 700;
    color: var(--text-primary);
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }

  .subtitle {
    font-size: 1.4rem;
    color: var(--text-secondary);
    margin-top: 1.5rem;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  .quote {
    font-size: 1.1rem;
    color: var(--gold-light);
    font-style: italic;
    margin-top: 1rem;
    opacity: 0.9;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    position: relative;
    z-index: 2;
  }

  /* U.E.P 引導區 */
  .guide-section {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 2.5rem;
    background: var(--glass-bg);
    backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    border-radius: 1.5rem;
    box-shadow: 0 8px 32px rgba(168, 85, 247, 0.15);
    position: relative;
    overflow: hidden;
  }

  .guide-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(213, 182, 24, 0.1), transparent);
    animation: scan 4s ease-in-out infinite;
  }

  @keyframes scan {
    0%, 100% { left: -100%; }
    50% { left: 100%; }
  }

  .uep-avatar {
    position: relative;
    width: 120px;
    height: 120px;
    flex-shrink: 0;
  }

  .avatar-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, var(--gold) 0%, transparent 70%);
    animation: glow 2s ease-in-out infinite;
  }

  @keyframes glow {
    0%, 100% {
      opacity: 0.4;
      transform: translate(-50%, -50%) scale(0.9);
    }
    50% {
      opacity: 0.8;
      transform: translate(-50%, -50%) scale(1.1);
    }
  }

  .avatar-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80%;
    height: 80%;
    border: 3px solid var(--gold);
    border-radius: 50%;
    border-top-color: transparent;
    border-right-color: var(--purple);
    animation: spin 3s linear infinite;
  }

  @keyframes spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  .guide-text {
    flex: 1;
  }

  .uep-speech {
    color: var(--gold-light);
    font-size: 1.1rem;
    line-height: 1.8;
    margin-bottom: 0.75rem;
    position: relative;
    padding-left: 1.5rem;
  }

  .uep-speech::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--purple-light);
  }

  /* 區塊標題 */
  .section-title {
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--gold), var(--purple-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 2.5rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* 世界卡片 */
  .worlds-preview {
    padding: 3rem 0;
  }

  .world-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .world-card {
    position: relative;
    padding: 2rem;
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    border: 1px solid var(--glass-border);
    border-radius: 1.25rem;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }

  .world-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, var(--purple) 0%, var(--gold) 100%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .world-card:hover::before {
    opacity: 0.1;
  }

  .card-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.2) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .world-card:hover .card-glow {
    opacity: 1;
    animation: cardGlow 2s ease-in-out infinite;
  }

  @keyframes cardGlow {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(-10%, -10%) scale(1.1);
    }
  }

  .world-card:hover {
    transform: translateY(-8px);
    border-color: var(--purple-light);
    box-shadow: 
      0 12px 40px rgba(168, 85, 247, 0.3),
      0 0 20px rgba(213, 182, 24, 0.2);
  }

  .card-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    filter: drop-shadow(0 0 10px rgba(168, 85, 247, 0.5));
  }

  .world-card h3 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--gold-light);
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }

  .world-card p {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }

  .world-card .status {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(168, 85, 247, 0.2);
    border: 1px solid var(--purple);
    border-radius: 0.5rem;
    color: var(--purple-light);
    font-size: 0.9rem;
    font-weight: 600;
    position: relative;
    z-index: 1;
  }

  /* U.E.P 圖片區 */
  .uep-images {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2.5rem;
    padding: 2rem 0;
  }

  .image-card {
    text-align: center;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .image-card:hover {
    transform: translateY(-10px) scale(1.05);
  }

  .image-card.floating {
    animation: float 3s ease-in-out infinite;
  }

  .image-card[data-delay="0.5"] {
    animation-delay: 0.5s;
  }

  .image-card[data-delay="1"] {
    animation-delay: 1s;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-15px);
    }
  }

  .image-frame {
    position: relative;
    display: inline-block;
    padding: 0.5rem;
    background: var(--glass-bg);
    backdrop-filter: blur(10px);
    border: 2px solid var(--glass-border);
    border-radius: 1rem;
    box-shadow: 0 4px 20px rgba(168, 85, 247, 0.2);
    transition: all 0.3s ease;
  }

  .image-card:hover .image-frame {
    border-color: var(--purple-light);
    box-shadow: 0 8px 30px rgba(168, 85, 247, 0.4);
  }

  .image-card img {
    max-width: 200px;
    width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  .caption {
    margin-top: 1.25rem;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--gold-light);
    text-shadow: 0 0 10px rgba(213, 182, 24, 0.5);
  }

  /* 永恆詩歌區 */
  .eternity-section {
    padding: 3rem 2rem;
    background: var(--glass-bg);
    backdrop-filter: blur(15px);
    border: 1px solid var(--glass-border);
    border-radius: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .eternity-section::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, rgba(213, 182, 24, 0.1) 0%, transparent 70%);
    animation: ethereal 8s ease-in-out infinite;
  }

  @keyframes ethereal {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 0.3;
    }
    50% {
      transform: translate(10%, 10%) rotate(180deg);
      opacity: 0.6;
    }
  }

  .eternity-poem {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .eternity-poem p {
    color: var(--text-secondary);
    font-size: 1.15rem;
    line-height: 2;
    margin-bottom: 0.5rem;
    opacity: 0.9;
  }

  .eternity-poem .highlight {
    color: var(--gold-light);
    font-weight: 600;
    font-size: 1.2rem;
    text-shadow: 0 0 15px rgba(213, 182, 24, 0.4);
  }

  .eternity-poem .fade {
    color: var(--text-secondary);
    opacity: 0.7;
    font-style: italic;
  }

  .eternity-poem .void {
    color: var(--purple-light);
    font-weight: 700;
    text-shadow: 0 0 20px rgba(168, 85, 247, 0.6);
    animation: voidPulse 2s ease-in-out infinite;
  }

  @keyframes voidPulse {
    0%, 100% {
      opacity: 0.8;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.05);
    }
  }

  .poem-divider {
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
    margin: 1.5rem auto;
  }

  /* 傳送門區 */
  .portals-section {
    padding: 3rem 0;
  }

  .portal-desc {
    text-align: center;
    color: var(--text-secondary);
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .portal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .portal-card {
    position: relative;
    display: block;
    padding: 2.5rem;
    background: var(--glass-bg);
    backdrop-filter: blur(15px);
    border: 2px solid var(--glass-border);
    border-radius: 1.5rem;
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
    text-align: center;
  }

  .portal-light {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 0;
    height: 0;
    background: radial-gradient(circle, rgba(213, 182, 24, 0.4) 0%, transparent 70%);
    transition: all 0.5s ease;
  }

  .portal-card:hover .portal-light {
    width: 300%;
    height: 300%;
  }

  .portal-card:hover {
    border-color: var(--gold);
    transform: translateY(-10px) scale(1.02);
    box-shadow: 
      0 20px 60px rgba(213, 182, 24, 0.3),
      0 0 40px rgba(168, 85, 247, 0.2);
  }

  .portal-card .portal-icon {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    display: block;
    filter: drop-shadow(0 0 20px rgba(213, 182, 24, 0.6));
  }

  .portal-card h3 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--gold-light);
    margin-bottom: 0.75rem;
    position: relative;
    z-index: 1;
  }

  .portal-card p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }

  /* 進度條區 */
  .construction-progress {
    padding: 2.5rem;
    background: var(--glass-bg);
    backdrop-filter: blur(15px);
    border: 1px solid var(--glass-border);
    border-radius: 1.25rem;
    text-align: center;
  }

  .progress-text {
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--gold-light);
    margin-bottom: 1.5rem;
    text-shadow: 0 0 10px rgba(213, 182, 24, 0.3);
  }

  .progress-bar {
    position: relative;
    width: 100%;
    height: 2.5rem;
    background: rgba(26, 26, 46, 0.6);
    border-radius: 1.25rem;
    overflow: hidden;
    border: 2px solid var(--glass-border);
    box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.3);
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--purple) 0%, var(--gold) 50%, var(--cyan) 100%);
    background-size: 200% 100%;
    border-radius: 1.25rem;
    transition: width 2s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    animation: progressFlow 3s linear infinite;
  }

  @keyframes progressFlow {
    0% {
      background-position: 0% 50%;
    }
    100% {
      background-position: 200% 50%;
    }
  }

  .progress-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.3) 50%,
      transparent 100%
    );
    animation: shimmerProgress 1.5s ease-in-out infinite;
  }

  @keyframes shimmerProgress {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .progress-particles {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .progress-percentage {
    margin-top: 1rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--gold-light);
    text-shadow: 0 0 15px rgba(213, 182, 24, 0.5);
  }

  .progress-hint {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--purple-light);
    font-style: italic;
    opacity: 0.8;
  }

  /* 響應式設計 */
  @media (max-width: 768px) {
    .hero {
      padding: 2rem 0 1.5rem;
    }

    h1 {
      font-size: 2rem;
    }

    .guide-section {
      flex-direction: column;
      text-align: center;
    }

    .world-cards,
    .uep-images,
    .portal-grid {
      grid-template-columns: 1fr;
    }

    .construction-progress {
      padding: 1.5rem;
    }

    .section-title {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  // 創建粒子效果
  function createParticles() {
    const container = document.getElementById('particles');
    if (!container) return;

    const particleCount = 50;
    const colors = ['#d5b618', '#a855f7', '#06b6d4'];

    for (let i = 0; i < particleCount; i++) {
      const particle = document.createElement('div');
      const size = Math.random() * 4 + 2;
      const color = colors[Math.floor(Math.random() * colors.length)];
      const duration = Math.random() * 20 + 10;
      const delay = Math.random() * 5;

      particle.style.position = 'absolute';
      particle.style.width = `${size}px`;
      particle.style.height = `${size}px`;
      particle.style.background = color;
      particle.style.borderRadius = '50%';
      particle.style.boxShadow = `0 0 ${size * 2}px ${color}`;
      particle.style.left = `${Math.random() * 100}%`;
      particle.style.top = `${Math.random() * 100}%`;
      particle.style.opacity = String(Math.random() * 0.5 + 0.3);
      particle.style.animation = `particleFloat ${duration}s linear ${delay}s infinite`;

      container.appendChild(particle);
    }

    // 添加粒子浮動動畫
    const style = document.createElement('style');
    style.textContent = `
      @keyframes particleFloat {
        0% {
          transform: translateY(0) translateX(0);
        }
        25% {
          transform: translateY(-20vh) translateX(10vw);
        }
        50% {
          transform: translateY(-40vh) translateX(-10vw);
        }
        75% {
          transform: translateY(-60vh) translateX(5vw);
        }
        100% {
          transform: translateY(-100vh) translateX(0);
        }
      }
    `;
    document.head.appendChild(style);
  }

  // 模擬進度條動畫
  function animateProgress() {
    const progressFill = document.getElementById('progressFill');
    const progressPercentage = document.getElementById('progressPercentage');
    
    if (!progressFill || !progressPercentage) return;

    // 模擬隨機進度 (30-50%)
    const targetProgress = Math.floor(Math.random() * 20) + 30;
    
    setTimeout(() => {
      progressFill.style.width = `${targetProgress}%`;
      progressPercentage.textContent = `${targetProgress}%`;
    }, 500);
  }

  // 為圖片卡片添加點擊效果
  function setupImageCards() {
    document.querySelectorAll('.image-card').forEach(card => {
      card.addEventListener('click', () => {
        const htmlCard = card as HTMLElement;
        htmlCard.style.animation = 'none';
        setTimeout(() => {
          htmlCard.style.animation = '';
        }, 10);
      });
    });
  }

  // 為世界卡片添加互動效果
  function setupWorldCards() {
    document.querySelectorAll('.world-card').forEach(card => {
      card.addEventListener('mouseenter', () => {
        const icon = card.querySelector('.card-icon');
        if (icon) {
          (icon as HTMLElement).style.transform = 'scale(1.2) rotate(10deg)';
        }
      });

      card.addEventListener('mouseleave', () => {
        const icon = card.querySelector('.card-icon');
        if (icon) {
          (icon as HTMLElement).style.transform = 'scale(1) rotate(0deg)';
        }
      });
    });
  }

  // 頁面載入時執行
  document.addEventListener('DOMContentLoaded', () => {
    createParticles();
    animateProgress();
    setupImageCards();
    setupWorldCards();
  });
</script>
