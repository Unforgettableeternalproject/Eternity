---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentRenderer from '../components/ContentRenderer.astro';
import { loadSummary, extractRoutes } from '../utils/summary';
import { parseFrontmatter } from '../utils/markdown';
import { parseMarkdownToSections, applyAreaStyle } from '../utils/content-renderer';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { EnhancedContent } from '../utils/content-renderer';

export async function getStaticPaths() {
  const contentDir = join(process.cwd(), 'content');
  
  try {
    const navigation = loadSummary(contentDir);
    const routes = extractRoutes(navigation);
    
    return routes.map(route => ({
      params: { slug: route.slug.join('/') },
      props: {
        filePath: route.filePath,
        title: route.title,
        areaId: route.slug[0] // 第一段路徑是區域 ID (history, echos, etc.)
      }
    }));
  } catch (error) {
    console.error('無法載入 SUMMARY.md:', error);
    return [];
  }
}

const { filePath, title, areaId } = Astro.props;

let enhancedContent: EnhancedContent | null = null;
let error: Error | null = null;
let pageTitle = title;

try {
  const rawContent = readFileSync(filePath, 'utf-8');
  const { content: markdown, frontmatter } = parseFrontmatter(rawContent);
  
  // 如果 frontmatter 有 description，使用它作為標題
  if (frontmatter.description) {
    pageTitle = frontmatter.description;
  }
  
  // 使用新的三層架構渲染系統
  const sections = parseMarkdownToSections(markdown);
  enhancedContent = applyAreaStyle(areaId, { rawSections: sections });
  
} catch (e) {
  error = e instanceof Error ? e : new Error(String(e));
  console.error('無法讀取或渲染檔案:', filePath, e);
}

// 生成區域樣式類名
const areaStyleClass = areaId ? `area-${areaId}` : '';
---

<BaseLayout title={title}>
  <div class="doc-page">
    <aside class="sidebar">
      <div class="sidebar-header">
        <h2>導航</h2>
      </div>
      <nav class="sidebar-nav">
        <p class="construction-notice">導航功能建構中...</p>
      </nav>
    </aside>

    <main class="content">
      {error ? (
        <div class="error-message">
          <h1>❌ 無法載入內容</h1>
          <p>檔案路徑: <code>{filePath}</code></p>
          <p>錯誤: {error.message}</p>
        </div>
      ) : enhancedContent ? (
        <article class="markdown-content">
          <h1 class="page-title">{pageTitle}</h1>
          <ContentRenderer 
            sections={enhancedContent.rawSections} 
            layout={enhancedContent.layout}
            components={enhancedContent.components}
            areaStyle={areaStyleClass}
          />
        </article>
      ) : (
        <div class="loading-message">
          <p>載入中...</p>
        </div>
      )}
    </main>
  </div>
</BaseLayout>

<style>
  .doc-page {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3rem;
    max-width: 1600px;
    margin: 0 auto;
    padding: 2rem;
    min-height: calc(100vh - 4rem);
  }

  .sidebar {
    position: sticky;
    top: 2rem;
    height: fit-content;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    background: linear-gradient(135deg, rgba(26, 26, 46, 0.7), rgba(10, 10, 15, 0.7));
    border: 1px solid rgba(213, 182, 24, 0.2);
    border-radius: 12px;
    padding: 1.5rem;
    backdrop-filter: blur(10px);
  }

  .sidebar-header h2 {
    color: #d5b618;
    font-size: 1.25rem;
    margin: 0 0 1rem 0;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(213, 182, 24, 0.3);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .construction-notice {
    color: #94a3b8;
    font-size: 0.875rem;
    font-style: italic;
    text-align: center;
    padding: 2rem 1rem;
  }

  .content {
    background: linear-gradient(135deg, rgba(26, 26, 46, 0.5), rgba(10, 10, 15, 0.5));
    border: 1px solid rgba(213, 182, 24, 0.15);
    border-radius: 12px;
    padding: 3rem;
    backdrop-filter: blur(10px);
    animation: fadeIn 0.5s ease-out;
  }

  .markdown-content h1 {
    color: #d5b618;
    font-size: 2.5rem;
    margin: 0 0 2rem 0;
    font-weight: 700;
    background: linear-gradient(135deg, #d5b618, #ffd700);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .loading-message {
    text-align: center;
    padding: 3rem;
    color: #94a3b8;
    font-style: italic;
  }

  .error-message {
    padding: 2rem;
    background: rgba(220, 38, 38, 0.1);
    border: 1px solid rgba(220, 38, 38, 0.3);
    border-radius: 8px;
  }

  .error-message h1 {
    color: #fca5a5;
    font-size: 1.5rem;
    margin: 0 0 1rem 0;
  }

  .error-message p {
    color: #cbd5e1;
    margin: 0.5rem 0;
  }

  .error-message code {
    background: rgba(0, 0, 0, 0.3);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-family: monospace;
    color: #fbbf24;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 響應式設計 */
  @media (max-width: 1024px) {
    .doc-page {
      grid-template-columns: 240px 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .doc-page {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .sidebar {
      position: static;
      max-height: none;
    }

    .content {
      padding: 2rem;
    }
  }

  /* 自定義捲軸 */
  .sidebar::-webkit-scrollbar {
    width: 6px;
  }

  .sidebar::-webkit-scrollbar-track {
    background: rgba(10, 10, 15, 0.5);
    border-radius: 3px;
  }

  .sidebar::-webkit-scrollbar-thumb {
    background: rgba(213, 182, 24, 0.3);
    border-radius: 3px;
  }

  .sidebar::-webkit-scrollbar-thumb:hover {
    background: rgba(213, 182, 24, 0.5);
  }
</style>
