---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hint from '../components/Hint.astro';
import Mark from '../components/Mark.astro';
import Tabs from '../components/Tabs.astro';
import Divider from '../components/Divider.astro';
import ContentPage from '../components/ContentPage.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import Spoiler from '../components/Spoiler.astro';

const tabs = [
  {
    id: 'tab-1',
    title: '三區',
    content: `
      <h3>無組織</h3>
      <ul>
        <li>艾斯維爾·科索諾 Xavier Colsono</li>
        <li>凱奇·巴頓 Kach Barten</li>
      </ul>
    `
  },
  {
    id: 'tab-2',
    title: '四區',
    content: `
      <h3>政府相關</h3>
      <ul>
        <li>凱恩 Keine</li>
        <li>卡林·巴克禮 Carin Berkley</li>
      </ul>
    `
  }
];
---

<BaseLayout title="元件展示 - 邊際世界">
  <div class="demo-container">
    <h1>GitBook 元件轉換展示</h1>
    
    <section class="demo-section">
      <h2>1. Hint 提示框元件</h2>
      
      <Hint type="info">
        這裡列舉的內容可能並不完整，會有後續更新補正。
      </Hint>
      
      <Hint type="warning">
        以下的內容可能多少伴隨著故事劇情的劇透，請於欣賞之前務必三思！
      </Hint>
      
      <Hint type="danger">
        危險！此區域包含重大劇透內容。
      </Hint>
      
      <Hint type="success">
        恭喜！您已完成所有任務。
      </Hint>
    </section>

    <Divider style="gradient" />

    <section class="demo-section">
      <h2>2. Mark 標記元件</h2>
      
      <p>
        這是一段包含<Mark color="yellow">黃色標記</Mark>的文字。
      </p>
      <p>
        你可以使用<Mark color="red">紅色</Mark>、
        <Mark color="blue">藍色</Mark>、
        <Mark color="green">綠色</Mark>、
        <Mark color="purple">紫色</Mark>等多種顏色。
      </p>
    </section>

    <Divider style="dots" />

    <section class="demo-section">
      <h2>3. Tabs 分頁元件</h2>
      
      <Tabs tabs={tabs} />
    </section>

    <Divider style="star" />

    <section class="demo-section">
      <h2>4. Divider 分隔線元件</h2>
      
      <p>上方使用星星樣式分隔線</p>
      <Divider style="gradient" spacing="small" />
      <p>這是漸變樣式分隔線</p>
      <Divider style="simple" spacing="small" />
      <p>這是簡單樣式分隔線</p>
      <Divider style="dots" spacing="small" />
      <p>這是點點樣式分隔線</p>
    </section>

    <section class="demo-section">
      <h2>5. 隱藏內容符號</h2>
      
      <p>
        這段文字包含隱藏內容：<span class="hidden-content">◼︎◼︎◼︎◼︎</span>（將滑鼠移到上方可顯示）
      </p>
    </section>

    <Divider style="gradient" />

    <section class="demo-section">
      <h2>6. ContentPage 元件 (完整頁面範例)</h2>
      
      <div class="content-page-demo">
        <h3>範例 1: 故事章節頁面</h3>
        <ContentPage
          title="序　『你所追求的真實...』"
          description="1 - 0"
          icon="sparkle"
          category="未被記載的傳說"
          chapter="Chapter 1"
        >
          <p>這裡什麼都沒有。</p>
          <p>沒有人、沒有光、沒有任何值得注意的事物。</p>
          <Divider style="star" spacing="small" />
          <p><span class="hidden-content">◼︎◼︎◼︎◼︎</span>的腦中一片空白，甚麼都回想不起，就連自己的模樣都已經遺忘了。</p>
        </ContentPage>
      </div>

      <div class="content-page-demo" style="margin-top: 3rem;">
        <h3>範例 2: 音樂收藏頁面</h3>
        <ContentPage
          title="十二分區: 主要區域"
          description="十二分區的大型區域場景歌"
          icon="🎵"
        >
          <Hint type="info">
            這裡列舉的內容可能並不完整，會有後續更新補正。
          </Hint>
          
          <Hint type="warning">
            以下的內容可能多少伴隨著故事劇情的劇透，請於欣賞之前務必三思！<br><br>
            受到刪減的內容會在<Mark color="red">達到特定的條件</Mark>之後被公開。
          </Hint>
          
          <h3>三區概念曲 - 「現代工業」</h3>
          <p>齒輪、煙塵、機器的運轉聲，總有一群人在漆黑的礦道中死命地討生活。</p>
        </ContentPage>
      </div>

      <div class="content-page-demo" style="margin-top: 3rem;">
        <h3>範例 3: 隱藏內容頁面</h3>
        <ContentPage
          title="無名"
          description="也許不是沒有名號，而是早已被世人所遺忘"
          icon="1"
          hidden={true}
        >
          <p>此內容目前尚未解鎖。</p>
        </ContentPage>
      </div>
    </section>

    <Divider style="gradient" />

    <section class="demo-section">
      <h2>7. Frontmatter Metadata 處理</h2>
      
      <div class="metadata-demo">
        <h3>支援的 Metadata 欄位：</h3>
        <ul>
          <li><code>title</code> - 頁面標題（來自 SUMMARY.md）</li>
          <li><code>description</code> - 副標題/描述文字</li>
          <li><code>icon</code> - 頁面圖示（支援 emoji 或文字名稱）</li>
          <li><code>hidden</code> - 是否為隱藏內容</li>
          <li><code>category</code> - 內容分類標籤</li>
          <li><code>chapter</code> - 章節編號</li>
        </ul>

        <h3>Icon 映射範例：</h3>
        <div class="icon-examples">
          <div class="icon-item">
            <span class="icon-display">✨</span>
            <code>sparkle</code>
          </div>
          <div class="icon-item">
            <span class="icon-display">📝</span>
            <code>memo</code>
          </div>
          <div class="icon-item">
            <span class="icon-display">⭐</span>
            <code>star</code>
          </div>
          <div class="icon-item">
            <span class="icon-display">📚</span>
            <code>book</code>
          </div>
          <div class="icon-item">
            <span class="icon-display">💡</span>
            <code>info</code>
          </div>
          <div class="icon-item">
            <span class="icon-display">⚠️</span>
            <code>warning</code>
          </div>
        </div>

        <h3>使用範例（Frontmatter）：</h3>
        <pre><code>---
description: 你可以在這裡聽見些許的水流聲，感覺像是位於大自然中一樣
icon: moon-cloud
hidden: false
---

# 頁面標題（來自 SUMMARY.md）

內容開始...
</code></pre>
      </div>
    </section>

    <section class="demo-section">
      <h2>8. AudioPlayer 音頻播放器</h2>
      <p>三種不同風格的音頻播放器，支援播放/暫停、進度條、音量控制，並且同時只能播放一個音頻（互斥播放）。</p>

      <div class="audio-demo-grid">
        <!-- Card 風格 -->
        <div class="audio-demo-item">
          <h3>Card 風格 - 完整卡片播放器</h3>
          <p>適合獨立展示音樂，包含標題和描述，適合用於概念曲展示。</p>
          <AudioPlayer
            src="/content/.gitbook/assets/Modern Industry.wav"
            title="三區概念曲 - 「現代工業」"
            description="在這座被機械與蒸汽包圍的城市中，人們日復一日地勞作著。這首曲子捕捉了工業革命時期的氛圍，既有機械的冷硬，也有人性的溫暖。"
            variant="card"
          />
        </div>

        <!-- Minimal 風格 -->
        <div class="audio-demo-item">
          <h3>Minimal 風格 - 極簡播放器</h3>
          <p>精簡版本，適合需要節省空間的場景。</p>
          <AudioPlayer
            src="/content/.gitbook/assets/Ephemeral Tranquility.wav"
            title="短暫的寧靜"
            variant="minimal"
          />
        </div>

        <!-- Inline 風格 -->
        <div class="audio-demo-item">
          <h3>Inline 風格 - 行內播放器</h3>
          <p>可以嵌入文字段落中的播放器，適合在敘述中插入音頻。</p>
          <div class="audio-demo-inline-example">
            <p>
              你在遊蕩的時候發現了某些異常，靠近了之後某種聲音從那異常之中傳出。
              不確定是錯覺，還是這聽起來像是 U.E.P 的聲音... 
              <AudioPlayer
                src="/content/.gitbook/assets/uep_distort_message.wav"
                title="扭曲的留言"
                variant="inline"
              />
              她似乎在自言自語些什麼。
            </p>
          </div>
        </div>

        <!-- 互斥播放測試 -->
        <div class="audio-demo-item">
          <h3>互斥播放測試</h3>
          <p>試著播放下方兩個播放器，您會發現同時只能有一個在播放。</p>
          <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem;">
            <AudioPlayer
              src="/content/.gitbook/assets/Spiritual Exile.wav"
              title="靈魂放逐"
              variant="minimal"
            />
            <AudioPlayer
              src="/content/.gitbook/assets/Crystallized World.wav"
              title="結晶化世界"
              variant="minimal"
            />
          </div>
        </div>
      </div>

      <Divider style="gradient" spacing="normal" />

      <div class="metadata-demo">
        <h3>使用方式</h3>
        <pre><code>&lt;AudioPlayer
  src="/path/to/audio.wav"
  title="曲目名稱"
  description="曲目描述或賞析"
  variant="card|minimal|inline"
/&gt;</code></pre>

        <h3>Props 參數</h3>
        <ul>
          <li><code>src</code> - 音頻檔案路徑（必填）</li>
          <li><code>title</code> - 標題（選填）</li>
          <li><code>description</code> - 描述/賞析文字（選填，僅 card 風格顯示）</li>
          <li><code>variant</code> - 播放器風格：'card' | 'minimal' | 'inline'（預設：card）</li>
        </ul>

        <h3>特色功能</h3>
        <ul>
          <li>✅ 播放/暫停控制</li>
          <li>✅ 拖動進度條跳轉</li>
          <li>✅ 音量調整與靜音</li>
          <li>✅ 時間顯示（當前/總長）</li>
          <li>✅ 互斥播放（同時只能播放一個）</li>
          <li>✅ 響應式設計（手機隱藏音量控制）</li>
        </ul>
      </div>
    </section>

    <section class="demo-section">
      <h2>9. Spoiler 劇透/敏感內容遮罩</h2>
      <p>三種不同方式來隱藏劇透或敏感內容，適合處理需要警告的資訊。</p>

      <div class="spoiler-demo-grid">
        <!-- Blur 變體 -->
        <div class="spoiler-demo-item">
          <h3>Blur 變體 - 模糊效果（推薦）</h3>
          <p>懸停時顯示，點擊後永久顯示。適合輕度劇透。</p>
          <div class="demo-example">
            <p>
              故事的最後，<Spoiler variant="blur">U.E.P 選擇了犧牲自己來拯救世界</Spoiler>，
              這個決定改變了一切。
            </p>
          </div>
        </div>

        <!-- Click 變體 -->
        <div class="spoiler-demo-item">
          <h3>Click 變體 - 完全隱藏</h3>
          <p>必須點擊按鈕才能顯示，適合重大劇透。</p>
          <div class="demo-example">
            <p>
              真相是：<Spoiler variant="click">整個世界其實是一個巨大的模擬系統，所有人都活在虛擬實境中</Spoiler>
            </p>
          </div>
        </div>

        <!-- Censored 變體 -->
        <div class="spoiler-demo-item">
          <h3>Censored 變體 - 黑條遮蓋</h3>
          <p>帶有警告標示的遮蓋，適合敏感內容或核心劇透。</p>
          <div class="demo-example">
            <p>
              ◼︎ 區的真實名稱是：<Spoiler variant="censored">虛無大陸（The Void Continent）</Spoiler>
            </p>
          </div>
        </div>

        <!-- 實際應用範例 -->
        <div class="spoiler-demo-item">
          <h3>實際應用：概念曲中的劇透處理</h3>
          <p>在 Echoes 區域展示概念曲時，可以這樣處理劇透內容：</p>
          <div class="demo-example" style="background: rgba(17, 24, 39, 0.6); padding: 1.5rem; border-radius: 0.5rem;">
            <h4 style="color: #d4af37; margin-top: 0;">◼︎區概念曲 - 「<Spoiler variant="blur">虛無輪迴</Spoiler>」</h4>
            <AudioPlayer
              src="/content/.gitbook/assets/Spiritual Exile.wav"
              title="◼︎區概念曲"
              description="這首曲子描述了被遺忘者的孤獨與絕望..."
              variant="card"
            />
            <p style="margin-top: 1rem; color: rgba(255, 255, 255, 0.7);">
              賞析：<Spoiler variant="click">這首曲子實際上是在描述 U.E.P 在虛無大陸中不斷重複的命運循環，每一次循環都會失去一部分記憶，直到最終完全消失...</Spoiler>
            </p>
          </div>
        </div>
      </div>

      <Divider style="gradient" spacing="normal" />

      <div class="metadata-demo">
        <h3>使用方式</h3>
        <pre><code>&lt;Spoiler variant="blur|click|censored" warning="自訂警告文字"&gt;
  劇透內容
&lt;/Spoiler&gt;</code></pre>

        <h3>Props 參數</h3>
        <ul>
          <li><code>variant</code> - 遮罩類型：'blur' | 'click' | 'censored'（預設：blur）</li>
          <li><code>warning</code> - 警告文字（選填，預設：「此內容包含劇透」）</li>
          <li><code>inline</code> - 是否為行內模式（選填，預設：false）</li>
        </ul>

        <h3>三種變體比較</h3>
        <ul>
          <li><strong>blur</strong>: 模糊效果，懸停預覽，點擊永久顯示 - 適合輕度劇透</li>
          <li><strong>click</strong>: 完全隱藏，需點擊顯示 - 適合中度劇透</li>
          <li><strong>censored</strong>: 黑條遮蓋，帶警告標示 - 適合重大劇透或敏感內容</li>
        </ul>

        <h3>建議用法</h3>
        <ul>
          <li>✨ Echoes 概念曲頁面：使用 <code>censored</code> 處理 ◼︎ 相關內容</li>
          <li>📖 故事章節：使用 <code>blur</code> 處理角色名稱等輕度劇透</li>
          <li>🎵 音樂賞析：使用 <code>click</code> 隱藏深度分析與劇情關聯</li>
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .demo-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .demo-container h1 {
    font-size: 2.5rem;
    background: linear-gradient(135deg, #d5b618 0%, #ffd700 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 3rem;
    text-align: center;
  }

  .demo-section {
    margin: 3rem 0;
  }

  .demo-section h2 {
    color: #a855f7;
    margin-bottom: 1.5rem;
    font-size: 1.8rem;
  }

  .demo-section p {
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .hidden-content {
    color: rgba(255, 255, 255, 0.3);
    filter: blur(4px);
    transition: filter 0.3s ease;
    cursor: help;
  }

  .hidden-content:hover {
    filter: blur(0);
  }

  .content-page-demo {
    background: rgba(26, 26, 46, 0.4);
    border: 1px solid rgba(213, 182, 24, 0.2);
    border-radius: 12px;
    padding: 2rem;
    margin-top: 1.5rem;
  }

  .content-page-demo > h3 {
    color: #06b6d4 !important;
    margin-bottom: 1.5rem !important;
    font-size: 1.3rem !important;
  }

  .metadata-demo {
    background: rgba(26, 26, 46, 0.4);
    border: 1px solid rgba(213, 182, 24, 0.2);
    border-radius: 12px;
    padding: 2rem;
  }

  .metadata-demo > h3 {
    color: #a855f7;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .metadata-demo > h3:first-child {
    margin-top: 0;
  }

  .metadata-demo ul {
    list-style: none;
    padding: 0;
  }

  .metadata-demo li {
    padding: 0.75rem;
    margin: 0.5rem 0;
    background: rgba(168, 85, 247, 0.1);
    border-left: 3px solid #a855f7;
    border-radius: 4px;
  }

  .metadata-demo code {
    background: rgba(251, 191, 36, 0.2);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    color: #fbbf24;
    font-family: 'Courier New', monospace;
  }

  .metadata-demo pre {
    background: rgba(0, 0, 0, 0.4);
    padding: 1.5rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-top: 1rem;
  }

  .metadata-demo pre code {
    background: transparent;
    padding: 0;
    color: #06b6d4;
    line-height: 1.6;
  }

  .icon-examples {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem;
    background: rgba(6, 182, 212, 0.1);
    border: 1px solid rgba(6, 182, 212, 0.3);
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .icon-item:hover {
    background: rgba(6, 182, 212, 0.2);
    transform: translateY(-4px);
  }

  .icon-display {
    font-size: 2rem;
  }

  .icon-item code {
    font-size: 0.875rem;
  }

  /* Audio Player Demo Section */
  .audio-demo-grid {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .audio-demo-item {
    padding: 1.5rem;
    background: rgba(17, 24, 39, 0.3);
    border: 1px solid rgba(212, 175, 55, 0.15);
    border-radius: 0.75rem;
  }

  .audio-demo-item h3 {
    font-size: 1.125rem;
    color: #d4af37;
    margin: 0 0 1rem 0;
  }

  .audio-demo-item p {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 1rem 0;
  }

  .audio-demo-inline-example {
    background: rgba(17, 24, 39, 0.4);
    padding: 1rem;
    border-radius: 0.5rem;
    border-left: 3px solid #d4af37;
    margin-top: 1rem;
  }

  .audio-demo-inline-example p {
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.8;
  }

  /* Spoiler Demo Section */
  .spoiler-demo-grid {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .spoiler-demo-item {
    padding: 1.5rem;
    background: rgba(17, 24, 39, 0.3);
    border: 1px solid rgba(212, 175, 55, 0.15);
    border-radius: 0.75rem;
  }

  .spoiler-demo-item h3 {
    font-size: 1.125rem;
    color: #a855f7;
    margin: 0 0 1rem 0;
  }

  .spoiler-demo-item h4 {
    font-size: 1rem;
    margin: 0.5rem 0;
  }

  .spoiler-demo-item p {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 1rem 0;
  }

  .demo-example {
    background: rgba(26, 26, 46, 0.4);
    padding: 1rem;
    border-radius: 0.5rem;
    border-left: 3px solid #a855f7;
    margin-top: 1rem;
  }

  .demo-example p {
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.8;
    margin: 0;
  }

  @media (max-width: 768px) {
