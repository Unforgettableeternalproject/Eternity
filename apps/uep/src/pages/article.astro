---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import OverlayBlock from '../components/OverlayBlock.astro';
import { renderArticleWithOverlay } from '../utils/overlay-renderer';

// 示範頁面：使用固定的文章路徑
// 實際使用時，應該整合到 [...slug].astro 中
const articlePath = 'history/passage/unforgettable_story/chpt.-1/arc.00.md';

let articleData: any = null;
let error: Error | null = null;

try {
  articleData = await renderArticleWithOverlay(articlePath);
} catch (e) {
  error = e instanceof Error ? e : new Error(String(e));
  console.error('載入文章失敗:', articlePath, e);
}
---

<BaseLayout title={articleData?.content.title || '文章'}>
  {error ? (
    <div class="error-container">
      <h1>❌ 無法載入文章</h1>
      <p>文章路徑: <code>{articlePath}</code></p>
      <p>錯誤: {error.message}</p>
    </div>
  ) : articleData ? (
    <article class="article-container">
      <!-- 文章標頭 -->
      <header class="article-header">
        <h1 class="article-title">{articleData.content.title}</h1>
        {articleData.content.description && (
          <p class="article-subtitle">{articleData.content.description}</p>
        )}
        
        {articleData.overlayConfig && (
          <div class="overlay-badge">
            <span class="badge-icon">✨</span>
            <span>已啟用覆蓋層增強</span>
          </div>
        )}
      </header>

      <!-- 文章內容 -->
      <div class="article-body">
        {articleData.blocksWithOverlay && articleData.blocksWithOverlay.map((block: any, index: number) => (
          <OverlayBlock block={block} index={index} />
        ))}
      </div>

      <!-- 文章頁腳 -->
      <footer class="article-footer">
        <div class="footer-info">
          <p>總段落數：{articleData.content?.blocks?.length || 0}</p>
          {articleData.overlayConfig && articleData.overlayConfig.rules && (
            <p>覆蓋層規則：{articleData.overlayConfig.rules.length}</p>
          )}
        </div>
        
        <a href={`/admin/overlay-editor?file=${encodeURIComponent(articlePath)}`} class="edit-link">
          <span>✏️</span>
          <span>編輯覆蓋層</span>
        </a>
      </footer>
    </article>
  ) : (
    <div class="loading-container">
      <p>載入中...</p>
    </div>
  )}
</BaseLayout>

<style>
  .article-container {
    max-width: 850px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .article-header {
    text-align: center;
    margin-bottom: 4rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid rgba(212, 175, 55, 0.2);
  }

  .article-title {
    font-size: 3rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.2;
  }

  .article-subtitle {
    font-size: 1.5rem;
    color: #d4af37;
    margin: 0 0 1.5rem 0;
    font-weight: 500;
  }

  .overlay-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.3);
    border-radius: 2rem;
    color: #d4af37;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .badge-icon {
    font-size: 1.125rem;
  }

  .article-body {
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.9);
  }

  /* 標題樣式 */
  .article-body :global(h1) {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .article-body :global(h2) {
    font-size: 2rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #d4af37;
  }

  .article-body :global(p) {
    margin: 0;
    line-height: 1.8;
  }

  .article-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 2px solid rgba(212, 175, 55, 0.2);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-info {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.875rem;
  }

  .footer-info p {
    margin: 0.25rem 0;
  }

  .edit-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: rgba(168, 85, 247, 0.2);
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 0.5rem;
    color: #a855f7;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s;
  }

  .edit-link:hover {
    background: rgba(168, 85, 247, 0.3);
    transform: translateY(-2px);
  }

  .error-container,
  .loading-container {
    max-width: 850px;
    margin: 0 auto;
    padding: 3rem 2rem;
    text-align: center;
  }

  .error-container h1 {
    color: #ef4444;
    margin-bottom: 1rem;
  }

  .error-container code {
    background: rgba(239, 68, 68, 0.2);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    color: #fca5a5;
  }

  @media (max-width: 768px) {
    .article-container {
      padding: 2rem 1rem;
    }

    .article-title {
      font-size: 2rem;
    }

    .article-subtitle {
      font-size: 1.25rem;
    }

    .article-footer {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
  }
</style>
