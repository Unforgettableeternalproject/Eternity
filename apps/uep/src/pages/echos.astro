---
import BaseLayout from '../layouts/BaseLayout.astro';
import AreaPage from '../components/AreaPage.astro';
import { loadSummary, extractDirectChildren } from '../utils/summary';
import { join } from 'node:path';

const contentDir = join(process.cwd(), 'content');
const navigation = loadSummary(contentDir);

const echosPages = extractDirectChildren(navigation, 'echos').map(route => ({
  slug: route.slug,
  title: route.title
}));
---

<BaseLayout title="回音蒐藏間 - 邊際世界">
  <AreaPage
    icon="🎵"
    title="回音蒐藏間"
    description="你聽見了悠揚的旋律，朦朧的美聲正由遠方傳來。<br>待你順著歌聲來到這裡時，你已經身處於一座氣派的音樂廳中。<br>華美之餘，妳心想，這裡說不定還收藏著更多獨特的聲音。"
    themeColor="#06b6d4"
    workingImage="/uep/Lead.png"
    pages={echosPages}
  />
</BaseLayout>
  <style>
    .area-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 2rem;
    }

    .area-header {
      text-align: center;
      margin-bottom: 3rem;
    }

    .area-icon {
      font-size: 5rem;
      margin-bottom: 1rem;
    }

    .area-title {
      font-size: 3rem;
      font-weight: 700;
      color: var(--cyan);
      margin-bottom: 1rem;
    }

    .area-desc {
      font-size: 1.2rem;
      color: rgba(255, 255, 255, 0.7);
      max-width: 600px;
      margin: 0 auto;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--gold);
      text-decoration: none;
      margin-bottom: 2rem;
      padding: 0.5rem 1rem;
      background: rgba(213, 182, 24, 0.1);
      border: 1px solid rgba(213, 182, 24, 0.3);
      border-radius: 8px;
      transition: all 0.2s ease;
    }

    .back-link:hover {
      background: rgba(213, 182, 24, 0.2);
      transform: translateX(-5px);
    }

    .construction {
      text-align: center;
      padding: 3rem;
      background: rgba(6, 182, 212, 0.1);
      border: 2px solid var(--cyan);
      border-radius: 16px;
    }

    .construction img {
      width: 200px;
      height: auto;
      margin-bottom: 2rem;
    }
  </style>

  <div class="area-page">
    <a href="/" class="back-link">
      ← 返回世界的軸心
    </a>

    <div class="area-header">
      <div class="area-icon">🎵</div>
      <h1 class="area-title">回音蒐藏間</h1>
      <p class="area-desc">
        多種美好的聲音在空氣中交錯著，偶爾能夠聽見某些人正在低語著。<br>
        一種難以被捕捉的球狀物體正規律的浮動， 你不清楚那究竟是什麼。
      </p>
    </div>

    <div class="construction">
      <img src="/uep/Lead.png" alt="UEP Lead" />
      <h2>內容建設中...</h2>
      <p>回聲們正在歸位，請稍候！</p>
    </div>
  </div>
</BaseLayout>