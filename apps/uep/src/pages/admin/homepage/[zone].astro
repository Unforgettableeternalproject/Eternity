---
import DesignLayout from '../../../layouts/DesignLayout.astro';
import HomepageEditor from '../../../components/editor/homepage/HomepageEditor';
import { getApiBase, TEST_MODE_COOKIE_NAME } from '../../../lib/apiBase';

// 動態 SSR 路由，不預先渲染
export const prerender = false;

// 區域對應表：slug → 顯示名稱與主題色
const ZONE_MAP: Record<string, { label: string; color: string }> = {
  history: { label: '歷史典藏庫', color: '#6b3f2a' },
  echoes: { label: '空白廣場', color: '#355c7d' },
  visuals: { label: '鏡向十字路口', color: '#5e548e' },
  concepts: { label: '概念調整房', color: '#2d6a4f' },
  storage: { label: '雜亂的書桌', color: '#3a3a3a' },
};

const { zone } = Astro.params;
const zoneInfo = zone ? ZONE_MAP[zone] : null;

// 若區域不存在，導回 admin 首頁
if (!zoneInfo) {
  return Astro.redirect('/admin');
}

const apiBase = getApiBase(
  Astro.cookies.get(TEST_MODE_COOKIE_NAME)?.value ?? null
);
---

<DesignLayout title={`首頁編輯 · ${zoneInfo.label} - U.E.P Admin`}>
  <HomepageEditor
    client:load
    area={zone!}
    zoneLabel={zoneInfo.label}
    zoneColor={zoneInfo.color}
    apiBase={apiBase}
  />
</DesignLayout>
