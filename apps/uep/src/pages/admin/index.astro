---
import DesignLayout from '../../layouts/DesignLayout.astro';

export const prerender = false;

const apiBase =
  import.meta.env.PUBLIC_CONTENT_API_URL || 'http://localhost:8788';

async function safeFetchJson(url: string): Promise<any> {
  try {
    const res = await fetch(url);
    const ct = res.headers.get('content-type') || '';
    if (!ct.includes('application/json')) return null;
    return res.json();
  } catch {
    return null;
  }
}

// Fetch data for each zone
const historyData = await safeFetchJson(`${apiBase}/api/content/history`);
const echoesData = await safeFetchJson(`${apiBase}/api/content/echoes`);
const visualsData = await safeFetchJson(`${apiBase}/api/content/visuals`);

const historyPages = historyData?.ok ? historyData.data || [] : [];
const echoesPages = echoesData?.ok ? echoesData.data || [] : [];
const visualsPages = visualsData?.ok ? visualsData.data || [] : [];

// Compute stats
const historyChapters = historyPages.filter(
  (p: any) => p.pageType === 'chapter'
).length;
const historyArcs = historyPages.filter(
  (p: any) => p.pageType === 'arc'
).length;
const historyDrafts = historyPages.filter(
  (p: any) => p.status === 'modified' || p.status === 'local_only'
).length;

const echoesTotal = echoesPages.length;
const echoesDrafts = echoesPages.filter(
  (p: any) => p.status === 'modified' || p.status === 'local_only'
).length;

const visualsGalleries = visualsPages.filter(
  (p: any) => p.pageType === 'gallery'
).length;
const visualsDrafts = visualsPages.filter(
  (p: any) => p.status === 'modified' || p.status === 'local_only'
).length;

// 首頁等級頁面（homepage type）
const allLandingPages = [
  ...historyPages
    .filter((p: any) => p.pageType === 'homepage' || p.pageType === 'page')
    .map((p: any) => ({ ...p, area: 'history' })),
  ...echoesPages
    .filter((p: any) => p.pageType === 'homepage' || p.pageType === 'page')
    .map((p: any) => ({ ...p, area: 'echoes' })),
  ...visualsPages
    .filter((p: any) => p.pageType === 'homepage' || p.pageType === 'page')
    .map((p: any) => ({ ...p, area: 'visuals' })),
];

const totalPages = historyPages.length + echoesPages.length + visualsPages.length;
const totalEditsThisWeek = [...historyPages, ...echoesPages, ...visualsPages].filter(
  (p: any) => {
    if (!p.updatedAt) return false;
    const weekAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;
    return new Date(p.updatedAt).getTime() > weekAgo;
  }
).length;

// Recent edits per zone (latest 3)
function getRecent(pages: any[]) {
  return pages
    .filter(
      (p: any) =>
        p.updatedAt && p.pageType !== 'page' && p.pageType !== 'homepage'
    )
    .sort(
      (a: any, b: any) =>
        new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime()
    )
    .slice(0, 3)
    .map((p: any) => ({
      title: p.title || p.slug,
      id: p.id,
      status: p.status,
      updatedAt: p.updatedAt,
      spoiler: p.metadata?.spoilerLevel,
    }));
}

const historyRecent = getRecent(historyPages);
const echoesRecent = getRecent(echoesPages);
const visualsRecent = getRecent(visualsPages);

function timeAgo(dateStr: string) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return '剛剛';
  if (mins < 60) return `${mins} 分鐘前`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours} 小時前`;
  const days = Math.floor(hours / 24);
  if (days === 1) return '昨天';
  return `${days} 天前`;
}

const now = new Date();
const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
const dateStr = `${now.getMonth() + 1}/${now.getDate()}`;
---

<DesignLayout title="Admin - U.E.P">
  <div class="adm">
    <!-- Top bar -->
    <header class="adm-header">
      <div class="adm-header-brand">
        <span class="adm-header-logo">U</span>
        U.E.P · ADMIN
      </div>
      <div class="adm-header-spacer"></div>
      <span class="adm-header-version">v0.4 · 觀測誌</span>
      <span class="adm-header-status">
        <span class="adm-status-dot"></span>
        ONLINE
      </span>
      <a href="/admin/logout" class="adm-header-home">登出</a>
      <a href="/" class="adm-header-home">← 回到文件站</a>
    </header>

    <!-- Main scrollable area -->
    <main class="adm-main">
      <div class="adm-content">
        <!-- Greeting -->
        <div class="adm-greeting-time">
          welcome back · {timeStr} · {dateStr}
        </div>
        <h1 class="adm-greeting-title">哈囉哈囉! (｡･∀･)ﾉﾞ</h1>
        <p class="adm-greeting-desc">
          想要編輯哪個區塊呢? 全部都整理好了喔! 你可以從下方進到對應的編輯器。
        </p>

        <!-- Quick stats strip -->
        <div class="adm-stats-strip">
          <div class="adm-stat-cell">
            <div class="adm-stat-label">總頁面</div>
            <div class="adm-stat-value">{totalPages}</div>
            <div class="adm-stat-sub">history + echoes</div>
          </div>
          <div class="adm-stat-cell">
            <div class="adm-stat-label">總章節</div>
            <div class="adm-stat-value">{historyChapters}</div>
            <div class="adm-stat-sub">{historyDrafts} 篇草稿</div>
          </div>
          <div class="adm-stat-cell">
            <div class="adm-stat-label">曲目</div>
            <div class="adm-stat-value">{echoesTotal}</div>
            <div class="adm-stat-sub">{echoesDrafts} 待發佈</div>
          </div>
          <div class="adm-stat-cell">
            <div class="adm-stat-label">本週編輯</div>
            <div class="adm-stat-value">{totalEditsThisWeek}</div>
            <div class="adm-stat-sub">近 7 天</div>
          </div>
        </div>

        <!-- Zone cards -->
        <div class="adm-zone-grid">
          <!-- History card -->
          <div class="adm-zone-card" style="border-top-color: #8A4423;">
            <div class="adm-zone-header">
              <div
                class="adm-zone-icon"
                style="border-color: #8A4423; color: #8A4423;"
              >
                ❒
              </div>
              <div class="adm-zone-info">
                <div class="adm-zone-en" style="color: #8A4423;">
                  HISTORY ARCHIVE
                </div>
                <div class="adm-zone-name">歷史典藏庫</div>
                <div class="adm-zone-desc">章節、卷、段落 — 富文本編輯</div>
              </div>
            </div>
            <div class="adm-zone-stats">
              <div>
                <span class="adm-zone-stat-val" style="color: #8A4423;"
                  >{historyArcs}</span
                ><span class="adm-zone-stat-key">篇</span>
              </div>
              <div>
                <span class="adm-zone-stat-val" style="color: #8A4423;"
                  >{historyChapters}</span
                ><span class="adm-zone-stat-key">章</span>
              </div>
              <div>
                <span class="adm-zone-stat-val" style="color: #8A4423;"
                  >{historyDrafts}</span
                ><span class="adm-zone-stat-key">草稿</span>
              </div>
            </div>
            <!-- Recent -->
            <div class="adm-zone-recent-title">最近編輯</div>
            {
              historyRecent.length > 0 ? (
                <div class="adm-zone-recent">
                  {historyRecent.map((r: any) => (
                    <a href={`/admin/edit/${r.id}`} class="adm-recent-row">
                      <span class="adm-recent-title">{r.title}</span>
                      <span
                        class={`adm-recent-status adm-recent-status--${r.status}`}
                      >
                        · {r.status}
                      </span>
                      <span class="adm-recent-time">
                        {timeAgo(r.updatedAt)}
                      </span>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="adm-zone-empty">尚無編輯紀錄</div>
              )
            }
            <div class="adm-zone-spacer"></div>
            <div class="adm-zone-actions">
              <a
                href="/admin/edit/history"
                class="adm-zone-btn-primary"
                style="background: #8A4423;"
              >
                <span>進入編輯器</span><span>→</span>
              </a>
            </div>
          </div>

          <!-- Echoes card -->
          <div class="adm-zone-card" style="border-top-color: #6B4F8E;">
            <div class="adm-zone-header">
              <div
                class="adm-zone-icon"
                style="border-color: #6B4F8E; color: #6B4F8E;"
              >
                ♪
              </div>
              <div class="adm-zone-info">
                <div class="adm-zone-en" style="color: #6B4F8E;">
                  ECHOES LIBRARY
                </div>
                <div class="adm-zone-name">回音蒐藏間</div>
                <div class="adm-zone-desc">
                  歌曲、子分類、Spoiler 鎖定 — 專屬欄位編輯
                </div>
              </div>
            </div>
            <div class="adm-zone-stats">
              <div>
                <span class="adm-zone-stat-val" style="color: #6B4F8E;"
                  >{echoesTotal}</span
                ><span class="adm-zone-stat-key">歌曲</span>
              </div>
              <div>
                <span class="adm-zone-stat-val" style="color: #6B4F8E;"
                  >{echoesDrafts}</span
                ><span class="adm-zone-stat-key">草稿</span>
              </div>
            </div>
            <!-- Recent -->
            <div class="adm-zone-recent-title">最近編輯</div>
            {
              echoesRecent.length > 0 ? (
                <div class="adm-zone-recent">
                  {echoesRecent.map((r: any) => (
                    <a href={`/admin/edit/${r.id}`} class="adm-recent-row">
                      <span class="adm-recent-title">
                        {r.title}
                        {r.spoiler && r.spoiler > 0 && (
                          <span
                            class={`adm-spoiler-badge ${r.spoiler >= 3 ? 'adm-spoiler--high' : ''}`}
                          >
                            L{r.spoiler}
                          </span>
                        )}
                      </span>
                      <span
                        class={`adm-recent-status adm-recent-status--${r.status}`}
                      >
                        · {r.status}
                      </span>
                      <span class="adm-recent-time">
                        {timeAgo(r.updatedAt)}
                      </span>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="adm-zone-empty">尚無編輯紀錄</div>
              )
            }
            <div class="adm-zone-spacer"></div>
            <div class="adm-zone-actions">
              <a
                href="/admin/edit/echoes"
                class="adm-zone-btn-primary"
                style="background: #6B4F8E;"
              >
                <span>進入編輯器</span><span>→</span>
              </a>
            </div>
          </div>

          <!-- Visuals card -->
          <div class="adm-zone-card" style="border-top-color: #5E548E;">
            <div class="adm-zone-header">
              <div
                class="adm-zone-icon"
                style="border-color: #5E548E; color: #5E548E;"
              >
                V
              </div>
              <div class="adm-zone-info">
                <div class="adm-zone-en" style="color: #5E548E;">
                  VISUALS GALLERY
                </div>
                <div class="adm-zone-name">幻影重現室</div>
                <div class="adm-zone-desc">
                  畫廊、圖片陣列、Spoiler 遮蔽 — 4 種展示風格
                </div>
              </div>
            </div>
            <div class="adm-zone-stats">
              <div>
                <span class="adm-zone-stat-val" style="color: #5E548E;"
                  >{visualsGalleries}</span
                ><span class="adm-zone-stat-key">畫廊</span>
              </div>
              <div>
                <span class="adm-zone-stat-val" style="color: #5E548E;"
                  >{visualsDrafts}</span
                ><span class="adm-zone-stat-key">草稿</span>
              </div>
            </div>
            <!-- Recent -->
            <div class="adm-zone-recent-title">最近編輯</div>
            {
              visualsRecent.length > 0 ? (
                <div class="adm-zone-recent">
                  {visualsRecent.map((r: any) => (
                    <a href={`/admin/edit/${r.id}`} class="adm-recent-row">
                      <span class="adm-recent-title">
                        {r.title}
                        {r.spoiler && r.spoiler > 0 && (
                          <span
                            class={`adm-spoiler-badge ${r.spoiler >= 3 ? 'adm-spoiler--high' : ''}`}
                          >
                            L{r.spoiler}
                          </span>
                        )}
                      </span>
                      <span
                        class={`adm-recent-status adm-recent-status--${r.status}`}
                      >
                        · {r.status}
                      </span>
                      <span class="adm-recent-time">
                        {timeAgo(r.updatedAt)}
                      </span>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="adm-zone-empty">尚無編輯紀錄</div>
              )
            }
            <div class="adm-zone-spacer"></div>
            <div class="adm-zone-actions">
              <a
                href="/admin/edit/visuals"
                class="adm-zone-btn-primary"
                style="background: #5E548E;"
              >
                <span>進入編輯器</span><span>→</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Homepage editor section -->
        <div class="adm-section-title">· 首頁編輯 ·</div>
        <div class="adm-homepage-grid">
          {
            [
              {
                area: 'history',
                label: '歷史典藏庫',
                color: 'var(--history-main)',
              },
              {
                area: 'echoes',
                label: '空白廣場',
                color: 'var(--echoes-main)',
              },
              {
                area: 'visuals',
                label: '鏡向十字路口',
                color: 'var(--visuals-main)',
              },
              {
                area: 'concepts',
                label: '概念調整房',
                color: 'var(--concepts-main)',
              },
              {
                area: 'storage',
                label: '雜亂的書桌',
                color: 'var(--storage-main)',
              },
            ].map((z) => {
              const hp = allLandingPages.find((p: any) => p.area === z.area);
              return (
                <a href={`/admin/homepage/${z.area}`} class="adm-homepage-card">
                  <span class="adm-homepage-badge" style={`color: ${z.color};`}>
                    {z.label}
                  </span>
                  <div class="adm-homepage-info">
                    <div class="adm-homepage-name">{z.area}/homepage</div>
                    <div class="adm-homepage-sub">
                      {hp?.updatedAt ? timeAgo(hp.updatedAt) : '尚未建立'}
                    </div>
                  </div>
                  <span class="adm-homepage-arrow">→</span>
                </a>
              );
            })
          }
        </div>

        <!-- Secondary tools -->
        <div class="adm-section-title">· 其他工具 ·</div>
        <div class="adm-tools-grid">
          <a href="#" class="adm-tool-card">
            <span class="adm-tool-icon">❝</span>
            <div>
              <div class="adm-tool-name">字條 / 對話</div><div
                class="adm-tool-sub"
              >
                UEP 旁白編輯
              </div>
            </div>
          </a>
          <a href="#" class="adm-tool-card">
            <span class="adm-tool-icon">◯</span>
            <div>
              <div class="adm-tool-name">地圖節點</div><div
                class="adm-tool-sub"
              >
                十二分區拓樸
              </div>
            </div>
          </a>
          <a href="/admin/media" class="adm-tool-card">
            <span class="adm-tool-icon">♫</span>
            <div>
              <div class="adm-tool-name">媒體庫</div><div class="adm-tool-sub">
                音檔 · 圖片
              </div>
            </div>
          </a>
          <a href="#" class="adm-tool-card">
            <span class="adm-tool-icon">⚙</span>
            <div>
              <div class="adm-tool-name">設定</div><div class="adm-tool-sub">
                主題 · 解鎖規則
              </div>
            </div>
          </a>
        </div>
      </div>
    </main>
  </div>
</DesignLayout>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
  }

  .adm {
    display: flex;
    flex-direction: column;
    height: 100vh;
    font-family: var(--font-sans);
  }

  /* === Header === */
  .adm-header {
    height: 56px;
    flex: 0 0 56px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 26px;
    border-bottom: 1px solid var(--hairline);
    background: var(--bg-soft);
  }

  .adm-header-brand {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-title);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .adm-header-logo {
    width: 22px;
    height: 22px;
    border-radius: 4px;
    border: 1.5px solid var(--ink-title);
    display: grid;
    place-items: center;
    font-size: 11px;
    letter-spacing: 0;
  }

  .adm-header-spacer {
    flex: 1;
  }

  .adm-header-version {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-mute);
    letter-spacing: 0.18em;
  }

  .adm-header-status {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-mute);
    letter-spacing: 0.16em;
    padding: 4px 10px;
    border: 1px solid var(--hairline-strong);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .adm-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #5b9c7a;
  }

  .adm-header-home {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-soft);
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: color 0.15s;
  }
  .adm-header-home:hover {
    color: var(--uep-gold);
  }

  /* === Main === */
  .adm-main {
    flex: 1;
    overflow-y: auto;
    padding: 48px 64px 80px;
  }

  .adm-content {
    max-width: 1180px;
    margin: 0 auto;
  }

  /* === Greeting === */
  .adm-greeting-time {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .adm-greeting-title {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 600;
    color: var(--ink-title);
    margin: 10px 0 8px;
    letter-spacing: -0.01em;
  }

  .adm-greeting-desc {
    font-family: var(--font-serif-tc);
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink-soft);
    max-width: 620px;
    margin: 0;
  }

  /* === Stats strip === */
  .adm-stats-strip {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--hairline);
  }

  .adm-stat-cell {
    padding: 20px 24px;
    background: var(--bg-card);
    border-right: 1px solid var(--hairline);
  }
  .adm-stat-cell:last-child {
    border-right: none;
  }

  .adm-stat-label {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--ink-mute);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .adm-stat-value {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 600;
    color: var(--ink-title);
    margin: 4px 0 2px;
  }

  .adm-stat-sub {
    font-family: var(--font-serif-tc);
    font-size: 12px;
    color: var(--ink-mute);
  }

  /* === Zone cards === */
  .adm-zone-grid {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }

  .adm-zone-card {
    border: 1px solid var(--hairline);
    border-top: 3px solid;
    background: var(--bg-card);
    padding: 26px 28px;
    display: flex;
    flex-direction: column;
  }

  .adm-zone-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }

  .adm-zone-icon {
    width: 52px;
    height: 52px;
    flex: 0 0 52px;
    border: 1px solid;
    font-size: 26px;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
  }

  .adm-zone-info {
    flex: 1;
  }

  .adm-zone-en {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.24em;
  }

  .adm-zone-name {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    color: var(--ink-title);
    margin-top: 2px;
  }

  .adm-zone-desc {
    font-family: var(--font-serif-tc);
    font-size: 13px;
    color: var(--ink-soft);
    margin-top: 4px;
  }

  .adm-zone-stats {
    margin-top: 22px;
    display: flex;
    gap: 24px;
    padding-top: 16px;
    border-top: 1px dashed var(--hairline);
  }

  .adm-zone-stat-val {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    margin-right: 4px;
  }

  .adm-zone-stat-key {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--ink-mute);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .adm-zone-recent-title {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--ink-mute);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-top: 18px;
    margin-bottom: 10px;
  }

  .adm-zone-recent {
    display: flex;
    flex-direction: column;
  }

  .adm-recent-row {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 12px;
    padding: 8px 0;
    border-bottom: 1px solid var(--hairline);
    align-items: center;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s;
  }
