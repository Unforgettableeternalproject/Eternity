---
export const prerender = false;

const apiBase =
  import.meta.env.PUBLIC_CONTENT_API_URL || 'http://localhost:8788';

let syncStatus: any = null;
let areas: Record<string, any[]> = {};
let historyTree: any[] = [];
let fetchError: string | null = null;

const areaNames = [
  'history',
  'echos',
  'visuals',
  'concepts',
  'storage',
  'portal',
];

try {
  const statusRes = await fetch(`${apiBase}/api/content/sync/status`);
  const statusJson = await statusRes.json();
  if (statusJson.ok) syncStatus = statusJson.data;

  // Fetch history tree separately
  try {
    const treeRes = await fetch(`${apiBase}/api/content/history/tree`);
    const treeJson = await treeRes.json();
    if (treeJson.ok) historyTree = treeJson.data || [];
  } catch {
    historyTree = [];
  }

  for (const area of areaNames) {
    if (area === 'history') {
      // For the flat count we still try the flat endpoint, but don't fail if missing
      try {
        const res = await fetch(`${apiBase}/api/content/${area}`);
        const json = await res.json();
        if (json.ok) areas[area] = json.data || [];
      } catch {
        areas[area] = [];
      }
    } else {
      try {
        const res = await fetch(`${apiBase}/api/content/${area}`);
        const json = await res.json();
        if (json.ok) areas[area] = json.data || [];
      } catch {
        areas[area] = [];
      }
    }
  }
} catch (e: any) {
  fetchError = e.message || 'Failed to connect to Content API';
}

const totalPages = Object.values(areas).reduce(
  (sum, list) => sum + list.length,
  0
);

const areaConfig: Record<
  string,
  { label: string; icon: string; color: string }
> = {
  history: { label: '歷史典藏庫', icon: '&#9783;', color: '#a855f7' },
  echos: { label: '回音蒐藏間', icon: '&#9835;', color: '#06b6d4' },
  visuals: { label: '幻影重現室', icon: '&#10022;', color: '#ec4899' },
  concepts: { label: '概念調整房', icon: '&#9000;', color: '#22c55e' },
  storage: { label: '某人的置物空間', icon: '&#9744;', color: '#f97316' },
  portal: { label: '外部基軸大廳', icon: '&#10038;', color: '#d5b618' },
};

const statusLabels: Record<string, string> = {
  synced: '已同步',
  modified: '已修改',
  local_only: '僅本地',
};

const statusColors: Record<string, string> = {
  synced: '#22c55e',
  modified: '#f59e0b',
  local_only: '#a855f7',
};

// Serialize tree for client-side JS
const historyTreeJson = JSON.stringify(historyTree);
---

<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/Logo.ico" />
    <title>內容管理 - U.E.P Admin</title>
  </head>
  <body>
    <div class="admin-app">
      <!-- 頂部列 -->
      <header class="top-bar">
        <div class="top-bar-left">
          <a href="/" class="brand">U.E.P Admin</a>
        </div>
        <div class="top-bar-center">
          <span class="total-count">{totalPages} 個頁面</span>
        </div>
        <div class="top-bar-right">
          <a href="/" class="nav-link">回到文件站</a>
        </div>
      </header>

      {
        fetchError ? (
          <div class="error-fullpage">
            <div class="error-card">
              <h2>無法連線到 Content API</h2>
              <p>{fetchError}</p>
              <p class="error-hint">
                請確認 content-api Worker 是否在運行（預設 localhost:8788）
              </p>
            </div>
          </div>
        ) : (
          <div class="admin-body">
            {/* 左側區域導航 */}
            <aside class="sidebar">
              <div class="sidebar-header">
                <span class="sidebar-label">區域</span>
              </div>
              <nav class="area-nav">
                <button class="area-nav-item active" data-area="all">
                  <span class="nav-icon" style="color: var(--gold);">
                    &#8862;
                  </span>
                  <span class="nav-label">全部</span>
                  <span class="nav-count">{totalPages}</span>
                </button>
                {areaNames.map((area) => {
                  const conf = areaConfig[area];
                  const count = areas[area]?.length || 0;
                  return (
                    <button class="area-nav-item" data-area={area}>
                      <span
                        class="nav-icon"
                        style={`color: ${conf.color}`}
                        set:html={conf.icon}
                      />
                      <span class="nav-label">{conf.label}</span>
                      <span class="nav-count">{count}</span>
                    </button>
                  );
                })}
              </nav>

              {syncStatus?.pendingUpdates?.length > 0 && (
                <div class="sidebar-section">
                  <span class="sidebar-label" style="color: #f59e0b;">
                    待更新
                  </span>
                  <div class="pending-list">
                    {syncStatus.pendingUpdates.map((p: any) => (
                      <a href={`/admin/edit/${p.id}`} class="pending-item">
                        {p.title || p.id}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </aside>

            {/* 主內容區 */}
            <main class="content-main">
              {/* 搜尋和操作列 */}
              <div class="content-toolbar">
                <div class="search-box">
                  <svg
                    width="14"
                    height="14"
                    viewBox="0 0 16 16"
                    fill="none"
                    class="search-icon"
                  >
                    <circle
                      cx="7"
                      cy="7"
                      r="5"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                    <path
                      d="M11 11l3 3"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                    />
                  </svg>
                  <input
                    type="text"
                    id="searchInput"
                    placeholder="搜尋頁面..."
                    class="search-input"
                  />
                </div>
                {/* Tree controls, only shown when history is active */}
                <div
                  class="tree-controls"
                  id="treeControls"
                  style="display:none;"
                >
                  <button class="tree-ctrl-btn" id="expandAllBtn">
                    全部展開
                  </button>
                  <button class="tree-ctrl-btn" id="collapseAllBtn">
                    全部收合
                  </button>
                </div>
              </div>

              {/* History Tree View (shown when history area is selected) */}
              <div class="panel" id="panel-history" style="display:none;">
                <div class="tree-wrapper" id="treeWrapper">
                  {historyTree.length === 0 ? (
                    <div class="empty-state">
                      <p>歷史典藏庫尚無樹狀資料</p>
                      <p class="empty-hint">
                        請確認 /api/content/history/tree 端點是否返回資料
                      </p>
                    </div>
                  ) : (
                    <div class="tree-root" id="treeRoot">
                      {/* Rendered by client JS from historyTreeJson */}
                    </div>
                  )}
                </div>
              </div>

              {/* Flat Table View (shown for all areas except history) */}
              <div class="panel" id="panel-table">
                <div class="page-table-wrapper">
                  <table class="page-table" id="pageTable">
                    <thead>
                      <tr>
                        <th class="col-title">標題</th>
                        <th class="col-area">區域</th>
                        <th class="col-status">狀態</th>
                        <th class="col-date">更新時間</th>
                      </tr>
                    </thead>
                    <tbody>
                      {areaNames.flatMap((area) =>
                        (areas[area] || []).map((page: any) => (
                          <tr
                            class="page-row"
                            data-area={area}
                            data-title={page.title?.toLowerCase() || ''}
                            data-slug={page.slug}
                          >
                            <td class="col-title">
                              <a
                                href={`/admin/edit/${page.id}`}
                                class="page-link"
                              >
                                <span class="page-title-text">
                                  {page.title || page.slug}
                                </span>
                                <span class="page-id-text">{page.id}</span>
                              </a>
                            </td>
                            <td class="col-area">
                              <span
                                class="area-tag"
                                style={`color: ${areaConfig[area]?.color || '#fff'}`}
                              >
                                {areaConfig[area]?.label || area}
                              </span>
                            </td>
                            <td class="col-status">
                              <span
                                class="status-dot"
                                style={`background: ${statusColors[page.status]}`}
                              />
                              <span class="status-text">
                                {statusLabels[page.status] || page.status}
                              </span>
                            </td>
                            <td class="col-date">
                              {new Date(page.updatedAt).toLocaleDateString(
                                'zh-TW'
                              )}
                            </td>
                          </tr>
                        ))
                      )}
                    </tbody>
                  </table>

                  {totalPages === 0 && (
                    <div class="empty-state">
                      <p>尚無任何內容</p>
                      <p class="empty-hint">
                        匯入子倉庫的內容，或直接建立新頁面
                      </p>
                    </div>
                  )}
                </div>
              </div>
            </main>
          </div>
        )
      }
    </div>

    <!-- Embed tree data for client rendering -->
    <script
      type="application/json"
      id="historyTreeData"
      set:html={historyTreeJson}
    />
    <script>
      // ─── Data ────────────────────────────────────────────────────────────────
      const treeDataEl = document.getElementById('historyTreeData');
      const historyTree: any[] = treeDataEl
        ? JSON.parse(treeDataEl.textContent || '[]')
        : [];

      const pageTypeColors: Record<string, string> = {
        zone: '#d5b618',
        chapter: '#a855f7',
        arc: '#06b6d4',
        section: '#22c55e',
        page: '#c0c0d8',
      };

      const pageTypeLabels: Record<string, string> = {
        zone: '區域',
        chapter: '章',
        arc: '篇',
        section: '段',
        page: '頁',
      };

      // Track collapsed state: nodeId -> boolean (true = collapsed)
      const collapsedState: Record<string, boolean> = {};

      // ─── Tree rendering ───────────────────────────────────────────────────────
      function renderTree(
        nodes: any[],
        parentEl: HTMLElement,
        searchQuery: string = ''
      ) {
        for (const node of nodes) {
          const hasChildren = node.children && node.children.length > 0;
          const isCollapsed = !!collapsedState[node.id];
          const depth = node.depth ?? 0;

          const titleLower = (node.title || '').toLowerCase();
          const slugLower = (node.slug || '').toLowerCase();
          const matchesSelf =
            !searchQuery ||
            titleLower.includes(searchQuery) ||
            slugLower.includes(searchQuery);

          // Check if any descendant matches
          const anyDescendantMatches = searchQuery
            ? nodeOrDescendantMatches(node, searchQuery)
            : true;

          if (!anyDescendantMatches) continue;

          const row = document.createElement('div');
          row.className = 'tree-row';
          row.dataset.nodeId = node.id;
          row.dataset.title = titleLower;
          row.dataset.slug = slugLower;
          row.style.setProperty('--depth', String(depth));

          // Indent spacer
          const indent = document.createElement('span');
          indent.className = 'tree-indent';
          indent.style.width = `${depth * 20}px`;
          row.appendChild(indent);

          // Toggle
          const toggle = document.createElement('span');
          toggle.className = 'tree-toggle';
          if (hasChildren) {
            toggle.classList.add(isCollapsed ? 'collapsed' : 'expanded');
            toggle.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              collapsedState[node.id] = !collapsedState[node.id];
              rebuildTree();
            });
          } else {
            toggle.classList.add('leaf');
          }
          row.appendChild(toggle);

          // Title link
          const link = document.createElement('a');
          link.href = `/admin/edit/${node.id}`;
          link.className =
            'tree-title' +
            (matchesSelf && searchQuery ? ' tree-title--match' : '');
          link.textContent = node.title || node.slug || node.id;
          row.appendChild(link);

          // Page type badge
          const badge = document.createElement('span');
          badge.className = 'tree-badge';
          badge.style.color = pageTypeColors[node.pageType] || '#c0c0d8';
          badge.style.borderColor =
            (pageTypeColors[node.pageType] || '#c0c0d8') + '44';
          badge.textContent =
            pageTypeLabels[node.pageType] || node.pageType || '';
          row.appendChild(badge);

          parentEl.appendChild(row);

          // Recurse into children if not collapsed
          if (hasChildren && !isCollapsed) {
            renderTree(node.children, parentEl, searchQuery);
          }
        }
      }

      function nodeOrDescendantMatches(node: any, query: string): boolean {
        const titleLower = (node.title || '').toLowerCase();
        const slugLower = (node.slug || '').toLowerCase();
        if (titleLower.includes(query) || slugLower.includes(query))
          return true;
        if (node.children) {
          for (const child of node.children) {
            if (nodeOrDescendantMatches(child, query)) return true;
          }
        }
        return false;
      }

      function rebuildTree(searchQuery: string = currentSearchQuery) {
        const root = document.getElementById('treeRoot');
        if (!root) return;
        root.innerHTML = '';
        renderTree(historyTree, root, searchQuery);
      }

      // ─── Area switching ───────────────────────────────────────────────────────
      let currentArea = 'all';
      let currentSearchQuery = '';

      const panelHistory = document.getElementById('panel-history');
      const panelTable = document.getElementById('panel-table');
      const treeControls = document.getElementById('treeControls');

      function showArea(area: string) {
        currentArea = area;

        if (area === 'history') {
          panelHistory!.style.display = 'flex';
          panelTable!.style.display = 'none';
          treeControls!.style.display = 'flex';
          rebuildTree(currentSearchQuery);
        } else {
          panelHistory!.style.display = 'none';
          panelTable!.style.display = 'block';
          treeControls!.style.display = 'none';
          filterTableRows(area, currentSearchQuery);
        }
      }

      // 初始化：預設顯示全部
      showArea('all');

      document.querySelectorAll('.area-nav-item').forEach((btn) => {
        btn.addEventListener('click', () => {
          document
            .querySelector('.area-nav-item.active')
            ?.classList.remove('active');
          btn.classList.add('active');
          const area = btn.getAttribute('data-area') || 'all';
          showArea(area);
        });
      });

      // ─── Search ───────────────────────────────────────────────────────────────
      const searchInput = document.getElementById(
        'searchInput'
      ) as HTMLInputElement | null;

      searchInput?.addEventListener('input', () => {
        currentSearchQuery = (searchInput.value || '').toLowerCase();
        if (currentArea === 'history') {
          rebuildTree(currentSearchQuery);
        } else {
          filterTableRows(currentArea, currentSearchQuery);
        }
      });

      function filterTableRows(area: string, query: string) {
        document.querySelectorAll('.page-row').forEach((row) => {
          const rowArea = row.getAttribute('data-area') || '';
          const title = row.getAttribute('data-title') || '';
          const slug = row.getAttribute('data-slug') || '';

          const matchArea = area === 'all' || rowArea === area;
          const matchSearch =
            !query || title.includes(query) || slug.includes(query);

          (row as HTMLElement).style.display =
            matchArea && matchSearch ? '' : 'none';
        });
      }

      // ─── Expand / Collapse all ────────────────────────────────────────────────
      function collectAllIds(nodes: any[], out: string[] = []): string[] {
        for (const n of nodes) {
          if (n.children?.length) {
            out.push(n.id);
            collectAllIds(n.children, out);
          }
        }
        return out;
      }

      document.getElementById('expandAllBtn')?.addEventListener('click', () => {
        const ids = collectAllIds(historyTree);
        for (const id of ids) collapsedState[id] = false;
        rebuildTree();
      });

      document
        .getElementById('collapseAllBtn')
        ?.addEventListener('click', () => {
          const ids = collectAllIds(historyTree);
          for (const id of ids) collapsedState[id] = true;
          rebuildTree();
        });

      // ─── Initial render ───────────────────────────────────────────────────────
      // Start with 'all' area showing the flat table
      showArea('all');
    </script>
  </body>
</html>

<style is:global>
  :root {
    --gold: #d5b618;
    --gold-light: #e8c547;
    --purple: #a855f7;
    --purple-light: #c084fc;
    --cyan: #06b6d4;
    --void-black: #0a0a0f;
    --text-primary: #f8f8ff;
    --text-secondary: #c0c0d8;
    --glass-border: rgba(255, 255, 255, 0.1);
    --sidebar-width: 230px;
    --topbar-height: 48px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html,
  body {
    height: 100%;
    overflow: hidden;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      'Microsoft JhengHei',
      sans-serif;
    background: var(--void-black);
    color: var(--text-primary);
    line-height: 1.6;
  }

  .admin-app {
    display: flex;
    flex-direction: column;
    height: 100vh;
  }

  /* === 頂部列 === */
  .top-bar {
    height: var(--topbar-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    background: rgba(15, 15, 25, 0.95);
    border-bottom: 1px solid var(--glass-border);
    flex-shrink: 0;
  }

  .top-bar-left,
  .top-bar-center,
  .top-bar-right {
    display: flex;
    align-items: center;
  }

  .top-bar-left {
    flex: 1;
  }
  .top-bar-right {
    flex: 1;
    justify-content: flex-end;
  }

  .brand {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--gold);
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .total-count {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .nav-link {
    font-size: 0.8rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav-link:hover {
    color: var(--gold);
  }

  /* === 主體 === */
  .admin-body {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  /* === 側邊欄 === */
  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    background: rgba(12, 12, 20, 0.95);
    border-right: 1px solid var(--glass-border);
    overflow-y: auto;
    padding: 0.75rem 0;
  }

  .sidebar-header {
    padding: 0 1rem 0.5rem;
  }

  .sidebar-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.35);
  }

  .area-nav {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .area-nav-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: 0.5rem 1rem;
    background: transparent;
    border: none;
    color: var(--text-secondary);
    font-size: 0.85rem;
    cursor: pointer;
    text-align: left;
    transition: all 0.12s;
  }

  .area-nav-item:hover {
    background: rgba(255, 255, 255, 0.04);
  }

  .area-nav-item.active {
    background: rgba(213, 182, 24, 0.08);
    color: var(--text-primary);
  }

  .area-nav-item.active .nav-label {
    font-weight: 600;
  }

  .nav-icon {
    font-size: 0.9rem;
    width: 18px;
    text-align: center;
    flex-shrink: 0;
  }

  .nav-label {
    flex: 1;
  }

  .nav-count {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.3);
    min-width: 18px;
    text-align: right;
  }

  .sidebar-section {
    padding: 1rem;
    border-top: 1px solid var(--glass-border);
    margin-top: 0.5rem;
  }

  .pending-list {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .pending-item {
    font-size: 0.8rem;
    color: #f59e0b;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    transition: background 0.12s;
  }

  .pending-item:hover {
    background: rgba(245, 158, 11, 0.1);
  }

  /* === 主內容區 === */
  .content-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .content-toolbar {
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--glass-border);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--glass-border);
    border-radius: 6px;
    padding: 0.35rem 0.75rem;
    max-width: 360px;
    flex: 1;
  }

  .search-icon {
    color: rgba(255, 255, 255, 0.3);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 0.85rem;
    outline: none;
  }

  .search-input::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  /* === Tree controls === */
  .tree-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .tree-ctrl-btn {
    font-size: 0.75rem;
    padding: 0.25rem 0.65rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border);
    border-radius: 4px;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.12s;
  }

  .tree-ctrl-btn:hover {
    background: rgba(255, 255, 255, 0.09);
    color: var(--text-primary);
  }

  /* === Panels === */
  .panel {
    flex: 1;
    overflow: hidden;
  }

  /* === Tree View === */
  .tree-wrapper {
    height: 100%;
    overflow-y: auto;
    padding: 0.5rem 0;
  }

  #panel-history {
    flex-direction: column;
  }

  .tree-root {
    display: flex;
    flex-direction: column;
  }

  .tree-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 1rem 0.3rem 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    transition: background 0.1s;
    min-height: 32px;
  }

  .tree-row:hover {
    background: rgba(255, 255, 255, 0.035);
  }

  /* Fixed-width indent spacer set by JS via --depth, but .tree-indent handles it */
  .tree-indent {
    display: inline-block;
    flex-shrink: 0;
  }

  /* CSS triangle toggle */
  .tree-toggle {
    display: inline-block;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    cursor: default;
    position: relative;
  }

  .tree-toggle.expanded {
    cursor: pointer;
