---
import DesignLayout from '../../layouts/DesignLayout.astro';
import { getApiBase, TEST_MODE_COOKIE_NAME } from '../../lib/apiBase';
import AdminTestModeControl from '../../components/admin/AdminTestModeControl';

export const prerender = false;

const apiBase = getApiBase(
  Astro.cookies.get(TEST_MODE_COOKIE_NAME)?.value ?? null
);

async function safeFetchJson(url: string): Promise<any> {
  try {
    const res = await fetch(url);
    const ct = res.headers.get('content-type') || '';
    if (!ct.includes('application/json')) return null;
    return res.json();
  } catch {
    return null;
  }
}

// 區域設定
const ZONES = [
  {
    id: 'history',
    icon: '❒',
    en: 'HISTORY ARCHIVE',
    name: '歷史典藏庫',
    color: '#8A4423',
    desc: '章節、卷、段落 — 富文本編輯',
    hasEditor: true,
  },
  {
    id: 'echoes',
    icon: '♪',
    en: 'ECHOES LIBRARY',
    name: '回音蒐藏間',
    color: '#6B4F8E',
    desc: '歌曲、子分類、Spoiler 鎖定 — 專屬欄位編輯',
    hasEditor: true,
  },
  {
    id: 'visuals',
    icon: '◈',
    en: 'VISUALS GALLERY',
    name: '幻影重現室',
    color: '#5E548E',
    desc: '畫廊、圖片陣列、Spoiler 遮蔽 — 4 種展示風格',
    hasEditor: true,
  },
  {
    id: 'concepts',
    icon: '✦',
    en: 'CONCEPT LAB',
    name: '概念調整房',
    color: '#2d6a4f',
    desc: '設定、概念、世界觀架構',
    hasEditor: true,
  },
  {
    id: 'storage',
    icon: '⬡',
    en: 'STORAGE DESK',
    name: '雜亂的書桌',
    color: '#D5B618',
    desc: '對話劇本、更新公告、思考文章 — 三種風格編輯',
    hasEditor: true,
  },
];

// 並行取得所有區域資料
const [historyData, echoesData, visualsData, conceptsData, storageData] =
  await Promise.all([
    safeFetchJson(`${apiBase}/api/content/history`),
    safeFetchJson(`${apiBase}/api/content/echoes`),
    safeFetchJson(`${apiBase}/api/content/visuals`),
    safeFetchJson(`${apiBase}/api/content/concepts`),
    safeFetchJson(`${apiBase}/api/content/storage`),
  ]);

const zonePages: Record<string, any[]> = {
  history: historyData?.ok ? historyData.data || [] : [],
  echoes: echoesData?.ok ? echoesData.data || [] : [],
  visuals: visualsData?.ok ? visualsData.data || [] : [],
  concepts: conceptsData?.ok ? conceptsData.data || [] : [],
  storage: storageData?.ok ? storageData.data || [] : [],
};

// 區域統計
function getZoneStats(
  zoneId: string,
  pages: any[]
): { val: number; key: string }[] {
  const drafts = pages.filter(
    (p: any) => p.status === 'modified' || p.status === 'local_only'
  ).length;
  switch (zoneId) {
    case 'history':
      return [
        {
          val: pages.filter((p: any) => p.pageType === 'arc').length,
          key: '篇',
        },
        {
          val: pages.filter((p: any) => p.pageType === 'chapter').length,
          key: '章',
        },
        { val: drafts, key: '草稿' },
      ];
    case 'echoes':
      return [
        { val: pages.length, key: '歌曲' },
        { val: drafts, key: '草稿' },
      ];
    case 'visuals':
      return [
        {
          val: pages.filter((p: any) => p.pageType === 'gallery').length,
          key: '畫廊',
        },
        { val: drafts, key: '草稿' },
      ];
    default:
      if (pages.length === 0) return [];
      return [
        { val: pages.length, key: '頁面' },
        { val: drafts, key: '草稿' },
      ];
  }
}

function getRecent(pages: any[]) {
  return pages
    .filter(
      (p: any) =>
        p.updatedAt && p.pageType !== 'page' && p.pageType !== 'homepage'
    )
    .sort(
      (a: any, b: any) =>
        new Date(b.updatedAt).getTime() - new Date(a.updatedAt).getTime()
    )
    .slice(0, 3)
    .map((p: any) => ({
      title: p.title || p.slug,
      id: p.id,
      status: p.status,
      updatedAt: p.updatedAt,
      spoiler: p.metadata?.spoilerLevel,
    }));
}

function timeAgo(dateStr: string) {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1) return '剛剛';
  if (mins < 60) return `${mins} 分鐘前`;
  const hours = Math.floor(mins / 60);
  if (hours < 24) return `${hours} 小時前`;
  const days = Math.floor(hours / 24);
  if (days === 1) return '昨天';
  return `${days} 天前`;
}

// 首頁頁面
const allLandingPages = Object.entries(zonePages).flatMap(([area, pages]) =>
  pages
    .filter((p: any) => p.pageType === 'homepage' || p.pageType === 'page')
    .map((p: any) => ({ ...p, area }))
);

// 組裝各區域完整資料
const zonesWithData = ZONES.map((z) => {
  const pages = zonePages[z.id] || [];
  return {
    ...z,
    pages,
    total: pages.length,
    stats: getZoneStats(z.id, pages),
    recent: getRecent(pages),
    homepage: allLandingPages.find((p: any) => p.area === z.id),
    tabStat: pages.length > 0 ? `${pages.length} 頁面` : '尚無內容',
  };
});

// 總覽統計
const totalPages = Object.values(zonePages).reduce(
  (sum, p) => sum + p.length,
  0
);
const historyChapters = (zonePages.history || []).filter(
  (p: any) => p.pageType === 'chapter'
).length;
const historyDrafts = (zonePages.history || []).filter(
  (p: any) => p.status === 'modified' || p.status === 'local_only'
).length;
const echoesTotal = (zonePages.echoes || []).length;
const echoesDrafts = (zonePages.echoes || []).filter(
  (p: any) => p.status === 'modified' || p.status === 'local_only'
).length;
const totalEditsThisWeek = Object.values(zonePages)
  .flat()
  .filter((p: any) => {
    if (!p.updatedAt) return false;
    const weekAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;
    return new Date(p.updatedAt).getTime() > weekAgo;
  }).length;

const now = new Date();
const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
const dateStr = `${now.getMonth() + 1}/${now.getDate()}`;
---

<DesignLayout title="Admin - U.E.P">
  <div class="adm">
    <!-- 頂部列 -->
    <header class="adm-header">
      <div class="adm-header-brand">
        <span class="adm-header-logo">U</span>
        U.E.P · ADMIN
      </div>
      <div class="adm-header-spacer"></div>
      <span class="adm-header-version">v0.5 · 觀測誌</span>
      <span class="adm-header-status">
        <span class="adm-status-dot"></span>
        ONLINE
      </span>
      <a href="/admin/logout" class="adm-header-link">登出</a>
      <a href="/" class="adm-header-link">← 回到文件站</a>
    </header>

    <!-- 主區域 -->
    <main class="adm-main">
      <div class="adm-content">
        <!-- 問候語 -->
        <div class="adm-greeting-time">
          welcome back · {timeStr} · {dateStr}
        </div>
        <h1 class="adm-greeting-title">哈囉哈囉! (｡･∀･)ﾉﾞ</h1>
        <p class="adm-greeting-desc">
          想要編輯哪個區塊呢? 全部都整理好了喔! 從左側選取區域，右側會顯示詳情。
        </p>

        <!-- 總覽統計 -->
        <div class="adm-stats-strip">
          <div class="adm-stat-cell">
            <div class="adm-stat-label">總頁面</div>
            <div class="adm-stat-value">{totalPages}</div>
            <div class="adm-stat-sub">全部區域</div>
          </div>
          <div class="adm-stat-cell">
            <div class="adm-stat-label">總章節</div>
            <div class="adm-stat-value">{historyChapters}</div>
            <div class="adm-stat-sub">{historyDrafts} 篇草稿</div>
          </div>
          <div class="adm-stat-cell">
            <div class="adm-stat-label">曲目</div>
            <div class="adm-stat-value">{echoesTotal}</div>
            <div class="adm-stat-sub">{echoesDrafts} 待發佈</div>
          </div>
          <div class="adm-stat-cell">
            <div class="adm-stat-label">本週編輯</div>
            <div class="adm-stat-value">{totalEditsThisWeek}</div>
            <div class="adm-stat-sub">近 7 天</div>
          </div>
        </div>

        <!-- 區域管理 — Zone Navigator -->
        <div class="adm-section-title">· 區域管理 ·</div>
        <div class="adm-zone-nav">
          <!-- 左側標籤列 -->
          <div class="adm-zone-tabs">
            {
              zonesWithData.map((z, i) => (
                <button
                  class={`adm-zone-tab ${i === 0 ? 'active' : ''}`}
                  data-zone={z.id}
                  style={`--zone-clr: ${z.color};`}
                >
                  <span
                    class="adm-tab-icon"
                    style={`color: ${z.color}; border-color: color-mix(in srgb, ${z.color} 40%, transparent);`}
                  >
                    {z.icon}
                  </span>
                  <div class="adm-tab-info">
                    <div class="adm-tab-name">{z.name}</div>
                    <div class="adm-tab-stat">{z.tabStat}</div>
                  </div>
                  <span class="adm-tab-arrow" style={`color: ${z.color};`}>
                    ›
                  </span>
                </button>
              ))
            }
          </div>

          <!-- 右側詳情面板 -->
          <div class="adm-zone-panels">
            {
              zonesWithData.map((z, i) => (
                <div
                  class={`adm-zone-panel ${i === 0 ? 'active' : ''}`}
                  id={`panel-${z.id}`}
                  style={`--zone-clr: ${z.color};`}
                >
                  {/* 區域標題 */}
                  <div class="adm-panel-header">
                    <div
                      class="adm-panel-icon"
                      style={`border-color: ${z.color}; color: ${z.color};`}
                    >
                      {z.icon}
                    </div>
                    <div class="adm-panel-info">
                      <div class="adm-panel-en" style={`color: ${z.color};`}>
                        {z.en}
                      </div>
                      <div class="adm-panel-name">{z.name}</div>
                      <div class="adm-panel-desc">{z.desc}</div>
                    </div>
                  </div>

                  {/* 區域統計 */}
                  {z.stats.length > 0 ? (
                    <div class="adm-panel-stats">
                      {z.stats.map((s) => (
                        <div class="adm-panel-stat-item">
                          <span
                            class="adm-panel-stat-val"
                            style={`color: ${z.color};`}
                          >
                            {s.val}
                          </span>
                          <span class="adm-panel-stat-key">{s.key}</span>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="adm-panel-stats adm-panel-stats--empty">
                      <span class="adm-panel-stat-key">尚無內容資料</span>
                    </div>
                  )}

                  {/* 最近編輯 — 僅有編輯器的區域 */}
                  {z.hasEditor && (
                    <div class="adm-panel-recent-section">
                      <div class="adm-panel-recent-title">最近編輯</div>
                      {z.recent.length > 0 ? (
                        <div class="adm-panel-recent">
                          {z.recent.map((r: any) => (
                            <a
                              href={`/admin/edit/${r.id}`}
                              class="adm-recent-row"
                            >
                              <span class="adm-recent-title">
                                {r.title}
                                {r.spoiler && r.spoiler > 0 && (
                                  <span
                                    class={`adm-spoiler-badge ${r.spoiler >= 3 ? 'adm-spoiler--high' : ''}`}
                                  >
                                    L{r.spoiler}
                                  </span>
                                )}
                              </span>
                              <span
                                class={`adm-recent-status adm-recent-status--${r.status}`}
                              >
                                · {r.status}
                              </span>
                              <span class="adm-recent-time">
                                {timeAgo(r.updatedAt)}
                              </span>
                            </a>
                          ))}
                        </div>
                      ) : (
                        <div class="adm-zone-empty">尚無編輯紀錄</div>
                      )}
                    </div>
                  )}

                  {/* 尚無編輯器的區域 */}
                  {!z.hasEditor && (
                    <div class="adm-panel-coming">
                      <div class="adm-coming-icon">⏳</div>
                      <div class="adm-coming-text">
                        <div class="adm-coming-title">內容編輯器開發中</div>
                        <div class="adm-coming-desc">
                          目前可透過首頁編輯器管理此區域的入口頁面
                        </div>
                      </div>
                    </div>
                  )}

                  {/* 彈性間距 */}
                  <div class="adm-panel-spacer" />

                  {/* 操作按鈕 */}
                  <div class="adm-panel-actions">
                    {z.hasEditor && (
                      <a
                        href={`/admin/edit/${z.id}`}
                        class="adm-panel-btn-primary"
                        style={`background: ${z.color};`}
                      >
                        <span>進入編輯器</span>
                        <span>→</span>
                      </a>
                    )}
                    <a
                      href={`/admin/homepage/${z.id}`}
                      class="adm-panel-btn-secondary"
                      style={`border-color: color-mix(in srgb, ${z.color} 50%, transparent); color: ${z.color};`}
                    >
                      <span>編輯區域首頁</span>
                      {z.homepage?.updatedAt && (
                        <span class="adm-btn-sub">
                          · {timeAgo(z.homepage.updatedAt)}
                        </span>
                      )}
                      <span>→</span>
                    </a>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- 快速工具 -->
        <div class="adm-section-title">· 快速工具 ·</div>
        <div class="adm-tools-grid">
          <a href="/admin/site" class="adm-tool-card">
            <span class="adm-tool-icon">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 9.5L12 3l9 6.5"></path>
                <path d="M19 13v6a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-6"></path>
              </svg>
            </span>
            <div>
              <div class="adm-tool-name">網站首頁</div>
              <div class="adm-tool-sub">文字 · 區域介紹</div>
            </div>
          </a>
          <a href="/admin/users" class="adm-tool-card">
            <span class="adm-tool-icon">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </span>
            <div>
              <div class="adm-tool-name">使用者管理</div>
              <div class="adm-tool-sub">帳號 · 進度 · 備註</div>
            </div>
          </a>
          <a href="/admin/media" class="adm-tool-card">
            <span class="adm-tool-icon">♫</span>
            <div>
              <div class="adm-tool-name">媒體庫</div>
              <div class="adm-tool-sub">音檔 · 圖片</div>
            </div>
          </a>
          <a href="/admin/settings" class="adm-tool-card">
            <span class="adm-tool-icon">⚙</span>
            <div>
              <div class="adm-tool-name">設定</div>
              <div class="adm-tool-sub">進度與註冊表</div>
            </div>
          </a>
        </div>

        <!-- 測試環境控制（Issue #41） -->
        <div class="adm-section-title">· 測試環境 ·</div>
        <div class="adm-test-mode-section">
          <AdminTestModeControl client:load />
        </div>
      </div>
    </main>
  </div>
</DesignLayout>

<!-- Tab 切換邏輯 -->
<script is:inline>
  (function () {
    var tabs = document.querySelectorAll('.adm-zone-tab');
    var panels = document.querySelectorAll('.adm-zone-panel');

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var zone = tab.dataset.zone;
        if (!zone || tab.classList.contains('active')) return;

        tabs.forEach(function (t) {
          t.classList.remove('active');
        });
        panels.forEach(function (p) {
          p.classList.remove('active');
        });

        tab.classList.add('active');
        var panel = document.getElementById('panel-' + zone);
        if (panel) panel.classList.add('active');
      });
    });
  })();
</script>

<style is:global>
  html,
  body {
    height: 100%;
    overflow: hidden;
  }

  .adm {
    display: flex;
    flex-direction: column;
    height: 100vh;
    font-family: var(--font-sans);
  }

  /* ===== Header ===== */
  .adm-header {
    height: 56px;
    flex: 0 0 56px;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 26px;
    border-bottom: 1px solid var(--hairline);
    background: var(--bg-soft);
  }

  .adm-header-brand {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-title);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .adm-header-logo {
    width: 22px;
    height: 22px;
    border-radius: 4px;
    border: 1.5px solid var(--ink-title);
    display: grid;
    place-items: center;
    font-size: 11px;
    letter-spacing: 0;
  }

  .adm-header-spacer {
    flex: 1;
  }

  .adm-header-version {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-mute);
    letter-spacing: 0.18em;
  }

  .adm-header-status {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-mute);
    letter-spacing: 0.16em;
    padding: 4px 10px;
    border: 1px solid var(--hairline-strong);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .adm-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #5b9c7a;
  }

  .adm-header-link {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-soft);
    letter-spacing: 0.12em;
    text-decoration: none;
    transition: color 0.15s;
  }
  .adm-header-link:hover {
    color: var(--uep-gold);
  }

  /* ===== Main ===== */
  .adm-main {
    flex: 1;
    overflow-y: auto;
    padding: 48px 64px 80px;
  }

  .adm-content {
    max-width: 1180px;
    margin: 0 auto;
  }

  /* ===== Greeting ===== */
  .adm-greeting-time {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .adm-greeting-title {
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 600;
    color: var(--ink-title);
    margin: 10px 0 8px;
    letter-spacing: -0.01em;
  }

  .adm-greeting-desc {
    font-family: var(--font-serif-tc);
    font-size: 15px;
    line-height: 1.8;
    color: var(--ink-soft);
    max-width: 620px;
    margin: 0;
  }

  /* ===== Stats strip ===== */
  .adm-stats-strip {
    margin-top: 32px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid var(--hairline);
  }

  .adm-stat-cell {
    padding: 20px 24px;
    background: var(--bg-card);
    border-right: 1px solid var(--hairline);
  }
  .adm-stat-cell:last-child {
    border-right: none;
  }

  .adm-stat-label {
    font-family: var(--font-mono);
    font-size: 9px;
    color: var(--ink-mute);
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .adm-stat-value {
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 600;
    color: var(--ink-title);
    margin: 4px 0 2px;
  }

  .adm-stat-sub {
    font-family: var(--font-serif-tc);
    font-size: 12px;
    color: var(--ink-mute);
  }

  /* ===== Section title ===== */
  .adm-section-title {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-mute);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-top: 36px;
    margin-bottom: 14px;
  }

  /* ===== Zone Navigator ===== */
  .adm-zone-nav {
    display: grid;
    grid-template-columns: 250px 1fr;
    border: 1px solid var(--hairline);
    min-height: 440px;
  }

  /* --- 左側標籤列 --- */
  .adm-zone-tabs {
    border-right: 1px solid var(--hairline);
    background: var(--bg-soft);
    display: flex;
    flex-direction: column;
  }

  .adm-zone-tab {
    all: unset;
    box-sizing: border-box;
    width: 100%;
    padding: 18px 16px 18px 20px;
    border-bottom: 1px solid var(--hairline);
    border-left: 3px solid transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    transition:
      background 0.15s,
      border-color 0.15s,
      box-shadow 0.2s;
  }

  .adm-zone-tab:last-child {
    border-bottom: none;
  }

  .adm-zone-tab:hover {
