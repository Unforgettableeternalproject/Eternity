---
export const prerender = false;
import DesignLayout from '../layouts/DesignLayout.astro';
---

<DesignLayout title="歷史典藏庫 - 邊際世界" zone="history">
  <!-- Full-viewport reader shell, sits inside BaseLayout's <main> -->
  <div class="reader-shell" id="readerShell">

    <!-- ═══════════════════════════════════════════
         LEFT SIDEBAR
    ═══════════════════════════════════════════ -->
    <aside class="sidebar" id="sidebar">
      <!-- Sidebar header -->
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <span class="sidebar-icon">📚</span>
          <div class="sidebar-title-block">
            <span class="sidebar-title">歷史典藏庫</span>
            <span class="sidebar-subtitle">邊際世界</span>
          </div>
        </div>
        <button class="sidebar-toggle" id="sidebarToggle" aria-label="收合側欄" title="收合側欄">
          <span class="toggle-icon">‹</span>
        </button>
      </div>

      <!-- Search bar -->
      <div class="sidebar-search">
        <span class="search-icon">🔍</span>
        <input
          type="text"
          class="search-input"
          id="treeSearch"
          placeholder="搜尋頁面…"
          autocomplete="off"
        />
      </div>

      <!-- Tree loading / error states -->
      <div class="tree-status" id="treeStatus">
        <div class="tree-loading" id="treeLoading">
          <div class="loading-spinner"></div>
          <span>載入目錄中…</span>
        </div>
        <div class="tree-error hidden" id="treeError">
          <span class="error-icon">⚠️</span>
          <span id="treeErrorMsg">無法載入目錄</span>
          <button class="retry-btn" id="treeRetry">重試</button>
        </div>
      </div>

      <!-- Tree navigation -->
      <nav class="tree-nav" id="treeNav" aria-label="內容目錄"></nav>
    </aside>

    <!-- Sidebar collapsed tab (visible when closed) -->
    <button class="sidebar-peek" id="sidebarPeek" aria-label="展開側欄" title="展開側欄">
      <span>📚</span>
    </button>

    <!-- ═══════════════════════════════════════════
         MAIN CONTENT AREA
    ═══════════════════════════════════════════ -->
    <div class="content-area" id="contentArea">

      <!-- Landing view (shown when no page is selected) -->
      <div class="landing-view" id="landingView">
        <div class="landing-inner">
          <!-- Ambient orbs -->
          <div class="orb orb-1"></div>
          <div class="orb orb-2"></div>
          <div class="orb orb-3"></div>

          <div class="landing-icon-wrap">
            <div class="landing-icon-glow"></div>
            <div class="landing-icon">📚</div>
          </div>

          <h1 class="landing-title">歷史典藏庫</h1>

          <p class="landing-desc">
            眼前的景色讓你嘆為觀止。<br />
            這裡儼然是一座大型圖書館，無數書頁正有條理地在天空中飛舞著。<br />
            你不確定這是某種魔法還是甚麼超自然力量的影響。
          </p>

          <div class="landing-divider">
            <span class="divider-line"></span>
            <span class="divider-gem">◆</span>
            <span class="divider-line"></span>
          </div>

          <div class="landing-hint">
            <span class="hint-arrow">←</span>
            <span>從左側目錄選取篇章開始閱讀</span>
          </div>

          <!-- Zone overview cards (populated by JS) -->
          <div class="zone-grid" id="zoneGrid">
            <div class="zone-grid-loading">
              <div class="loading-spinner"></div>
              <span>載入章節總覽…</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Reading view (shown when a page is selected) -->
      <div class="reading-view hidden" id="readingView">
        <!-- Breadcrumb -->
        <div class="breadcrumb" id="breadcrumb" aria-label="麵包屑導覽"></div>

        <!-- Page content -->
        <article class="reading-article" id="readingArticle">
          <div class="content-loading hidden" id="contentLoading">
            <div class="loading-spinner large"></div>
            <span>載入內容中…</span>
          </div>
          <div class="content-error hidden" id="contentError">
            <span class="error-icon">⚠️</span>
            <p id="contentErrorMsg">無法載入此頁面</p>
            <button class="retry-btn" id="contentRetry">重試</button>
          </div>
          <div class="content-body" id="contentBody"></div>
        </article>

        <!-- Navigation footer -->
        <div class="page-nav" id="pageNav">
          <button class="page-nav-btn" id="prevPageBtn" disabled>
            <span class="nav-arrow-icon">←</span>
            <div class="page-nav-label">
              <span class="nav-label-hint">上一頁</span>
              <span class="nav-label-title" id="prevPageTitle">—</span>
            </div>
          </button>
          <button class="page-nav-btn next" id="nextPageBtn" disabled>
            <div class="page-nav-label">
              <span class="nav-label-hint">下一頁</span>
              <span class="nav-label-title" id="nextPageTitle">—</span>
            </div>
            <span class="nav-arrow-icon">→</span>
          </button>
        </div>
      </div>

    </div><!-- /content-area -->
  </div><!-- /reader-shell -->
</DesignLayout>

<!-- ═══════════════════════════════════════════════════════
     CLIENT-SIDE LOGIC
═══════════════════════════════════════════════════════ -->
<script>
const API_BASE = (import.meta as any).env?.PUBLIC_CONTENT_API_URL || 'http://localhost:8788';

// ─── State ───────────────────────────────────────────────
let treeData: any[] = [];
let flatPages: any[] = [];           // only leaf nodes (sections/pages)
let currentPageId: string | null = null;
let currentRetryFn: (() => void) | null = null;

// ─── DOM references ───────────────────────────────────────
const sidebar        = document.getElementById('sidebar')!;
const sidebarToggle  = document.getElementById('sidebarToggle')!;
const sidebarPeek    = document.getElementById('sidebarPeek')!;
const treeNav        = document.getElementById('treeNav')!;
const treeLoading    = document.getElementById('treeLoading')!;
const treeError      = document.getElementById('treeError')!;
const treeErrorMsg   = document.getElementById('treeErrorMsg')!;
const treeRetry      = document.getElementById('treeRetry')!;
const treeSearch     = document.getElementById('treeSearch') as HTMLInputElement;

const landingView    = document.getElementById('landingView')!;
const readingView    = document.getElementById('readingView')!;
const zoneGrid       = document.getElementById('zoneGrid')!;

const breadcrumb     = document.getElementById('breadcrumb')!;
const readingArticle = document.getElementById('readingArticle')!;
const contentLoading = document.getElementById('contentLoading')!;
const contentError   = document.getElementById('contentError')!;
const contentErrorMsg= document.getElementById('contentErrorMsg')!;
const contentRetry   = document.getElementById('contentRetry')!;
const contentBody    = document.getElementById('contentBody')!;

const prevPageBtn    = document.getElementById('prevPageBtn') as HTMLButtonElement;
const nextPageBtn    = document.getElementById('nextPageBtn') as HTMLButtonElement;
const prevPageTitle  = document.getElementById('prevPageTitle')!;
const nextPageTitle  = document.getElementById('nextPageTitle')!;

// ─── Sidebar toggle ───────────────────────────────────────
function openSidebar() {
  sidebar.classList.remove('collapsed');
  sidebarPeek.classList.remove('visible');
  sidebarToggle.setAttribute('aria-label', '收合側欄');
  sidebarToggle.querySelector('.toggle-icon')!.textContent = '‹';
  localStorage.setItem('history-sidebar', 'open');
}

function closeSidebar() {
  sidebar.classList.add('collapsed');
  sidebarPeek.classList.add('visible');
  sidebarToggle.setAttribute('aria-label', '展開側欄');
  sidebarToggle.querySelector('.toggle-icon')!.textContent = '›';
  localStorage.setItem('history-sidebar', 'closed');
}

sidebarToggle.addEventListener('click', () => {
  if (sidebar.classList.contains('collapsed')) openSidebar();
  else closeSidebar();
});

sidebarPeek.addEventListener('click', openSidebar);

// Restore preference
if (localStorage.getItem('history-sidebar') === 'closed') closeSidebar();

// ─── Utility ─────────────────────────────────────────────
function pageTypeIcon(type: string): string {
  const map: Record<string, string> = {
    zone: '🌐', chapter: '📖', arc: '📄', section: '📃', page: '📃',
  };
  return map[type] ?? '📝';
}

function show(el: HTMLElement) { el.classList.remove('hidden'); }
function hide(el: HTMLElement) { el.classList.add('hidden'); }

// ─── Flatten tree into ordered page list (all nodes, not just leaves) ───
function flattenLeaves(nodes: any[], acc: any[] = []): any[] {
  for (const node of nodes) {
    if (node.metadata?.hidden) continue;
    acc.push(node);
    if (node.children?.length) {
      flattenLeaves(node.children.filter((c: any) => !c.metadata?.hidden), acc);
    }
  }
  return acc;
}

// ─── Resolve internal links ──────────────────────────────
// 將相對路徑（如 "arc.01/sect.01.md" 或 "chpt.-1/"）解析成對應的頁面
function resolveInternalLink(currentPageId: string, href: string): any | null {
  // 清理 href: 去掉 .md 副檔名和尾部斜線
  let clean = href.replace(/\.md$/, '').replace(/\/$/, '');
  // README 指向目錄本身
  clean = clean.replace(/\/README$/, '');

  // 嘗試方式 1: 相對於當前頁面的路徑解析
  // currentPageId 例如 "history/passage/unforgettable_story/chpt.01"
  // clean 例如 "arc.01/sect.01"
  const currentDir = currentPageId.includes('/') ? currentPageId.substring(0, currentPageId.lastIndexOf('/')) : currentPageId;
  const candidate1 = currentDir + '/' + clean;
  const candidate2 = currentPageId + '/' + clean;

  // 在 flatPages 中尋找匹配
  const found =
    flatPages.find(p => p.id === candidate1) ||
    flatPages.find(p => p.id === candidate2) ||
    // 嘗試在整個 id 裡尾部匹配
    flatPages.find(p => p.id.endsWith('/' + clean)) ||
    // 嘗試 slug 匹配
    flatPages.find(p => p.slug === clean || p.slug.endsWith('/' + clean));

  return found || null;
}

// Build ancestor path map: id → array of ancestor titles
function buildAncestorMap(nodes: any[], ancestors: string[] = []): Map<string, string[]> {
  const map = new Map<string, string[]>();
  for (const node of nodes) {
    map.set(node.id, [...ancestors]);
    if (node.children?.length) {
      const childMap = buildAncestorMap(node.children, [...ancestors, node.title]);
      childMap.forEach((v, k) => map.set(k, v));
    }
  }
  return map;
}

let ancestorMap = new Map<string, string[]>();

// ─── Fetch tree ───────────────────────────────────────────
async function fetchTree() {
  hide(treeError);
  show(treeLoading);
  treeNav.innerHTML = '';

  try {
    const res = await fetch(`${API_BASE}/api/content/history/tree`);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const json = await res.json() as { ok: boolean; data: any[] };
    if (!json.ok) throw new Error('API returned ok=false');

    treeData = json.data;
    flatPages = flattenLeaves(treeData);
    ancestorMap = buildAncestorMap(treeData);

    hide(treeLoading);
    renderTree(treeData, treeNav, 0);
    renderZoneGrid(treeData);
  } catch (err: any) {
    hide(treeLoading);
    treeErrorMsg.textContent = `無法載入目錄：${err.message}`;
    show(treeError);
  }
}

treeRetry.addEventListener('click', fetchTree);

// ─── Render tree ──────────────────────────────────────────
function renderTree(nodes: any[], container: HTMLElement, depth: number) {
  for (const node of nodes) {
    // 跳過 hidden 頁面
    if (node.metadata?.hidden === true) continue;

    const visibleChildren = (node.children || []).filter((c: any) => !c.metadata?.hidden);
    const hasChildren = visibleChildren.length > 0;
    const isLeaf = !hasChildren;

    const item = document.createElement('div');
    item.className = 'tree-item';
    item.dataset.depth = String(depth);
    item.dataset.id = node.id;

    const row = document.createElement('div');
    row.className = 'tree-row';

    if (hasChildren) {
      // Group node: chevron for expand/collapse + clickable title for content
      const chevronBtn = document.createElement('button');
      chevronBtn.className = 'tree-chevron-btn';
      chevronBtn.setAttribute('aria-label', `展開 ${node.title}`);
      chevronBtn.innerHTML = `<span class="tree-chevron">${depth === 0 ? '▾' : '▸'}</span>`;
      row.appendChild(chevronBtn);

      // Title is clickable to load content
      const titleBtn = document.createElement('button');
      titleBtn.className = 'tree-leaf tree-group-title';
      titleBtn.dataset.pageId = node.id;
      if (node.metadata?.description) titleBtn.title = node.metadata.description;
      titleBtn.innerHTML = `
        <span class="tree-item-icon">${pageTypeIcon(node.pageType)}</span>
        <span class="tree-item-title">${node.title}</span>
      `;
      row.appendChild(titleBtn);
      item.appendChild(row);

      const children = document.createElement('div');
      children.className = 'tree-children';
      children.style.display = depth === 0 ? 'block' : 'none';
      renderTree(visibleChildren, children, depth + 1);
      item.appendChild(children);

      chevronBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const expanded = chevronBtn.getAttribute('aria-expanded') === 'true';
        chevronBtn.setAttribute('aria-expanded', String(!expanded));
        chevronBtn.querySelector('.tree-chevron')!.textContent = !expanded ? '▾' : '▸';
        children.style.display = !expanded ? 'block' : 'none';
      });
      chevronBtn.setAttribute('aria-expanded', depth === 0 ? 'true' : 'false');

      titleBtn.addEventListener('click', () => loadPage(node.id, node));
    } else {
      // Leaf link
      const link = document.createElement('button');
      link.className = 'tree-leaf';
      link.setAttribute('aria-label', `閱讀 ${node.title}`);
      link.dataset.pageId = node.id;
      if (node.metadata?.description) link.title = node.metadata.description;
      link.innerHTML = `
        <span class="tree-item-icon">${pageTypeIcon(node.pageType)}</span>
        <span class="tree-item-title">${node.title}</span>
      `;
      row.appendChild(link);
      item.appendChild(row);

      link.addEventListener('click', () => loadPage(node.id, node));
    }

    container.appendChild(item);
  }
}

// ─── Render zone overview cards ───────────────────────────
function renderZoneGrid(nodes: any[]) {
  if (!nodes.length) {
    zoneGrid.innerHTML = '<p class="zone-empty">目前尚無可用章節</p>';
    return;
  }

  const cards = nodes.map(node => {
    const childCount = countDescendants(node);
    return `
      <div class="zone-card" data-id="${node.id}" role="button" tabindex="0"
           aria-label="前往 ${node.title}">
        <div class="zone-card-icon">${pageTypeIcon(node.pageType)}</div>
        <div class="zone-card-body">
          <div class="zone-card-title">${node.title}</div>
          <div class="zone-card-meta">${childCount} 個頁面</div>
        </div>
        <div class="zone-card-arrow">›</div>
      </div>
    `;
  }).join('');

  zoneGrid.innerHTML = cards;

  // Click: expand sidebar to zone + scroll there
  zoneGrid.querySelectorAll('.zone-card').forEach(card => {
    const id = (card as HTMLElement).dataset.id!;
    card.addEventListener('click', () => expandToNode(id));
    card.addEventListener('keydown', (e: Event) => {
      if ((e as KeyboardEvent).key === 'Enter') expandToNode(id);
    });
  });
}

function countDescendants(node: any): number {
  if (!node.children?.length) return 1;
  return node.children.reduce((s: number, c: any) => s + countDescendants(c), 0);
}

function expandToNode(id: string) {
  // Expand all tree-toggle ancestors, then scroll into view
  const item = treeNav.querySelector(`[data-id="${id}"]`) as HTMLElement | null;
  if (!item) return;

  // Walk up expanding parents
  let el: HTMLElement | null = item.parentElement;
  while (el && el !== treeNav) {
    if (el.classList.contains('tree-children')) {
      el.style.display = 'block';
      const toggle = el.previousElementSibling?.querySelector('.tree-toggle') as HTMLElement | null
        ?? (el.parentElement?.querySelector('.tree-toggle') as HTMLElement | null);
      if (toggle) {
        toggle.setAttribute('aria-expanded', 'true');
        const chevron = toggle.querySelector('.tree-chevron');
        if (chevron) chevron.textContent = '▾';
      }
    }
    el = el.parentElement;
  }

  // Also expand this node's own toggle if it has one
  const ownToggle = item.querySelector('.tree-toggle') as HTMLElement | null;
  if (ownToggle) {
    ownToggle.setAttribute('aria-expanded', 'true');
    const chevron = ownToggle.querySelector('.tree-chevron');
    if (chevron) chevron.textContent = '▾';
    const children = item.querySelector('.tree-children') as HTMLElement | null;
    if (children) children.style.display = 'block';
  }

  item.scrollIntoView({ behavior: 'smooth', block: 'center' });
  openSidebar();
}

// ─── Load a page ──────────────────────────────────────────
async function loadPage(id: string, node?: any) {
  currentPageId = id;

  // Switch to reading view
  hide(landingView);
  show(readingView);

  // Highlight active in tree
  treeNav.querySelectorAll('.tree-leaf').forEach(el => el.classList.remove('active'));
  const activeLeaf = treeNav.querySelector(`[data-page-id="${id}"]`);
  if (activeLeaf) {
    activeLeaf.classList.add('active');
    // Auto-expand ancestors
    expandToNode(id);
    activeLeaf.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // Build breadcrumb
  const ancestors = ancestorMap.get(id) ?? [];
  const pageTitle = node?.title ?? id;
  renderBreadcrumb([...ancestors, pageTitle]);

  // Prev / next
  updatePageNav(id);

  // Show loading
  hide(contentError);
  hide(contentBody);
  show(contentLoading);
  contentBody.innerHTML = '';

  currentRetryFn = () => loadPage(id, node);

  try {
    const res = await fetch(`${API_BASE}/api/content/${id}`);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const json = await res.json() as { ok: boolean; data: any };
    if (!json.ok) throw new Error('API returned ok=false');

    const page = json.data;
    const html = page.content?.[0]?.content ?? '';

    hide(contentLoading);
    show(contentBody);

    contentBody.innerHTML = buildContentHTML(page, html);

    // 綁定 tabs 互動
    contentBody.querySelectorAll('.tabs-container').forEach(container => {
      const btns = container.querySelectorAll('.tab-btn');
      const panels = container.querySelectorAll('.tab-panel');
      btns.forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = btn.getAttribute('data-tab');
          btns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          panels.forEach(p => {
            (p as HTMLElement).style.display = p.getAttribute('data-tab') === idx ? 'block' : 'none';
          });
        });
      });
    });

    // 綁定卡片導航
    contentBody.querySelectorAll('.content-card[data-nav-ref]').forEach(card => {
      (card as HTMLElement).style.cursor = 'pointer';
      card.addEventListener('click', () => {
        const ref = (card as HTMLElement).dataset.navRef || '';
        // ref 是相對路徑如 "unforgettable_story/" 或 "chpt.-1/"
        // 需要找到對應的頁面 ID
        const match = flatPages.find(p =>
          p.id.endsWith('/' + ref.replace(/\/$/, '')) ||
          p.slug.endsWith('/' + ref.replace(/\/$/, '')) ||
          p.slug === ref.replace(/\/$/, '')
        );
        if (match) {
          loadPage(match.id, match);
          // 也展開側邊欄對應的節點
          const treeItem = treeNav.querySelector(`[data-id="${match.id}"]`) as HTMLElement | null;
          if (treeItem) {
            let el: HTMLElement | null = treeItem.parentElement;
            while (el && el !== treeNav) {
              if (el.classList.contains('tree-children')) {
                el.style.display = 'block';
                const toggle = el.previousElementSibling?.querySelector('.tree-chevron-btn');
                if (toggle) {
                  toggle.setAttribute('aria-expanded', 'true');
                  const chevron = toggle.querySelector('.tree-chevron');
                  if (chevron) chevron.textContent = '▾';
                }
              }
              el = el.parentElement;
            }
          }
        }
      });
    });

    // 攔截內部連結 — 將相對路徑轉成 loadPage 呼叫
    contentBody.querySelectorAll('a[href]').forEach(link => {
      const href = link.getAttribute('href') || '';
      // 跳過外部連結和 javascript:
      if (href.startsWith('http') || href.startsWith('javascript:') || href.startsWith('#') || href.startsWith('mailto:')) return;

      link.addEventListener('click', (e) => {
        e.preventDefault();
        const resolved = resolveInternalLink(id, href);
        if (resolved) {
          loadPage(resolved.id, resolved);
        }
      });
      // 改成 pointer cursor
      (link as HTMLElement).style.cursor = 'pointer';
    });

    // Scroll to top
    document.getElementById('contentArea')?.scrollTo({ top: 0, behavior: 'smooth' });

    // Push history state
    const url = new URL(window.location.href);
    url.searchParams.set('page', id);
    window.history.pushState({ pageId: id }, '', url.toString());

  } catch (err: any) {
    hide(contentLoading);
    contentErrorMsg.textContent = `無法載入頁面：${err.message}`;
    show(contentError);
  }
}

function buildContentHTML(page: any, rawHtml: string): string {
  const title = page.title ?? '';
  const subtitle = page.metadata?.description ?? '';
  const subtitleHtml = subtitle
    ? `<p class="article-subtitle">${subtitle}</p>`
    : '';
  return `
    <div class="article-header">
      <h1 class="article-main-title">${title}</h1>
      ${subtitleHtml}
    </div>
    <div class="article-prose">${rawHtml || '<p class="empty-notice">此頁面尚無內容。</p>'}</div>
  `;
}

// ─── Breadcrumb ───────────────────────────────────────────
function renderBreadcrumb(crumbs: string[]) {
  breadcrumb.innerHTML = crumbs
    .map((c, i) =>
      i < crumbs.length - 1
        ? `<span class="crumb">${c}</span><span class="crumb-sep">›</span>`
        : `<span class="crumb active">${c}</span>`
    )
    .join('');
}

// ─── Prev / Next navigation ───────────────────────────────
function updatePageNav(currentId: string) {
  const idx = flatPages.findIndex(p => p.id === currentId);
  const prev = idx > 0 ? flatPages[idx - 1] : null;
  const next = idx < flatPages.length - 1 ? flatPages[idx + 1] : null;

  prevPageBtn.disabled = !prev;
  nextPageBtn.disabled = !next;
  prevPageTitle.textContent = prev?.title ?? '—';
  nextPageTitle.textContent = next?.title ?? '—';

  prevPageBtn.onclick = prev ? () => loadPage(prev.id, prev) : null;
  nextPageBtn.onclick = next ? () => loadPage(next.id, next) : null;
}

// ─── Tree search filter ───────────────────────────────────
treeSearch.addEventListener('input', () => {
  const q = treeSearch.value.trim().toLowerCase();
  treeNav.querySelectorAll<HTMLElement>('.tree-item').forEach(item => {
    const title = item.querySelector('.tree-item-title')?.textContent?.toLowerCase() ?? '';
    item.style.display = (!q || title.includes(q)) ? '' : 'none';
  });
  // Show all children when searching
  if (q) {
    treeNav.querySelectorAll<HTMLElement>('.tree-children').forEach(c => c.style.display = 'block');
  }
});

// ─── Content retry ────────────────────────────────────────
contentRetry.addEventListener('click', () => {
  if (currentRetryFn) currentRetryFn();
});

// ─── Browser back/forward ─────────────────────────────────
window.addEventListener('popstate', (e) => {
  const state = e.state as { pageId?: string } | null;
  if (state?.pageId) {
    const node = flatPages.find(p => p.id === state.pageId);
    loadPage(state.pageId, node);
  } else {
    // Back to landing
    currentPageId = null;
    show(landingView);
    hide(readingView);
    treeNav.querySelectorAll('.tree-leaf').forEach(el => el.classList.remove('active'));
  }
});

// ─── Restore from URL ─────────────────────────────────────
function restoreFromURL() {
  const params = new URLSearchParams(window.location.search);
  const pageId = params.get('page');
  if (pageId) {
    // Wait until tree is loaded then navigate
    const check = () => {
      if (flatPages.length) {
        const node = flatPages.find(p => p.id === pageId);
        loadPage(pageId, node);
      } else {
        setTimeout(check, 100);
      }
    };
    check();
  }
}

// ─── Init ─────────────────────────────────────────────────
fetchTree().then(restoreFromURL);
</script>

