{
  "name": "eternity-monorepo",
  "version": "0.9.18.36",
  "private": true,
  "description": "Bernie's personal website monorepo with Astro",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync": "node scripts/sync.mjs",
    "sync:docs": "node scripts/sync.mjs --site docs",
    "sync:root": "node scripts/sync.mjs --site root",
    "sync:all": "node scripts/sync.mjs --site all",
    "sync:push": "node scripts/sync.mjs --site all --push",
    "sync:pull": "node scripts/sync.mjs --site all --pull",
    "build:art": "node scripts/build-uep-art.mjs",
    "build:art:dry": "node scripts/build-uep-art.mjs --dry-run",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "optimize:assets:dry": "node scripts/optimize-assets.mjs --dry-run",
    "dev:discord-widget": "pnpm --filter discord-widget-sync-worker dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:workers": "pnpm --filter content-api-worker test && pnpm --filter visitor-counter-worker test && pnpm --filter discord-widget-sync-worker test",
    "test:discord-widget": "pnpm --filter discord-widget-sync-worker test",
    "test:all": "pnpm test && pnpm test:workers",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:stress": "playwright test e2e/stress.spec.ts e2e/perf.spec.ts",
    "test:load": "node scripts/load-test.mjs",
    "test:load:staging": "node scripts/load-test.mjs --target staging",
    "test:release": "pnpm test:all && pnpm test:e2e:stress",
    "test:seed": "node scripts/seed-test-env.mjs",
    "test:reset": "node scripts/reset-test-env.mjs --confirm",
    "interlink:reindex": "node scripts/reindex-interlink.mjs",
    "interlink:reindex:local": "node scripts/reindex-interlink.mjs --local",
    "interlink:reindex:test": "node scripts/reindex-interlink.mjs --test",
    "interlink:reindex:remote": "node scripts/reindex-interlink.mjs --remote",
    "lint:encoding": "node scripts/check-source-encoding.mjs",
    "check": "pnpm lint && pnpm lint:encoding && pnpm typecheck && pnpm format:check && pnpm build",
    "deploy:content-api": "pnpm --filter content-api-worker ship",
    "deploy:content-api:test": "pnpm --filter content-api-worker exec wrangler deploy --env test",
    "deploy:visitor": "pnpm --filter visitor-counter-worker ship",
    "deploy:discord-widget": "pnpm --filter discord-widget-sync-worker ship",
    "db:migrate:local": "pnpm --filter content-api-worker db:migrate:local",
    "db:migrate:remote": "pnpm --filter content-api-worker db:migrate:remote",
    "db:migrate:test": "pnpm --filter content-api-worker db:migrate:test",
    "perf": "node scripts/perf-measure.mjs",
    "perf:desktop": "node scripts/perf-measure.mjs --profile=desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@uep/config": "workspace:*",
    "eslint": "^9.17.0",
    "fontkit": "^2.0.4",
    "jsdom": "^29.1.1",
    "marked": "^18.0.4",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  }
}
