{
  "name": "eternity-monorepo",
  "version": "0.9.12.52",
  "private": true,
  "description": "Bernie's personal website monorepo with Astro",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync": "node scripts/sync.mjs",
    "sync:docs": "node scripts/sync.mjs --site docs",
    "sync:root": "node scripts/sync.mjs --site root",
    "sync:all": "node scripts/sync.mjs --site all",
    "sync:push": "node scripts/sync.mjs --site all --push",
    "sync:pull": "node scripts/sync.mjs --site all --pull",
    "dev:discord-widget": "pnpm --filter discord-widget-sync-worker dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:workers": "pnpm --filter content-api-worker test && pnpm --filter visitor-counter-worker test && pnpm --filter discord-widget-sync-worker test",
    "test:discord-widget": "pnpm --filter discord-widget-sync-worker test",
    "test:all": "pnpm test && pnpm test:workers",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:stress": "playwright test e2e/stress.spec.ts e2e/perf.spec.ts",
    "test:load": "node scripts/load-test.mjs",
    "test:load:staging": "node scripts/load-test.mjs --target staging",
    "test:release": "pnpm test:all && pnpm test:e2e:stress",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm build",
    "deploy:content-api": "pnpm --filter content-api-worker ship",
    "deploy:visitor": "pnpm --filter visitor-counter-worker ship",
    "deploy:discord-widget": "pnpm --filter discord-widget-sync-worker ship"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@uep/config": "workspace:*",
    "eslint": "^9.17.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.4",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  }
}
